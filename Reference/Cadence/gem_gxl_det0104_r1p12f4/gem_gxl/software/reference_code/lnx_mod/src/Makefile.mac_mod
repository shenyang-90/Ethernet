# Make for loadable linux module

# Enable this to see DbgMsg output
#EXTRA_CFLAGS += -DDEBUG
# Enable this to see verbose debug output
#EXTRA_CFLAGS += -DVERBOSE_DEBUG
# Or enable this to see more verbose debug output (tx & rx packet lengths)
#EXTRA_CFLAGS += -DVVERBOSE_DEBUG
# Or enable this to see more verbose debug output (packet lengths & linux rx dump)
#EXTRA_CFLAGS += -DVVVERBOSE_DEBUG

# need this for PCI NIC, including 3.4.x arm-> 3.8.x x86 mods
EXTRA_CFLAGS += -DEDD_PCI_NIC
# needed for FPGA only, comment this out for Palladium
EXTRA_CFLAGS += -DNIC_FPGA
# also define this (with NIC_FPGA) to set a different MAC address
ifdef NIC2
EXTRA_CFLAGS += -DNIC_2
endif
# enable this for BR PHY only
#EXTRA_CFLAGS += -DNIC_BR

# enable for 64-bit compilation
#EXTRA_CFLAGS += -DCEDI_64B_COMPILE

# use MSI for PCI NIC, ignored if not EDD_PCI_NIC
#EXTRA_CFLAGS += -DEDD_PCI_MSI

obj-m += cds_mac.o
cds_mac-objs := cds_eth.o edd.o edd_rx.o edd_tx.o cps_linux.o
