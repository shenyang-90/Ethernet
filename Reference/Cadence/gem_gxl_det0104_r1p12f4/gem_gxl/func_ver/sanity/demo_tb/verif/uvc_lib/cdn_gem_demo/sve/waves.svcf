preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}
preferences set user-toolbar-list {WatchList {} WaveWindow {} Console {}}

#
# Databases
#
array set dbNames ""
set dbNames(realName1) [ database require waves -hints {
	file ./waves.shm/waves.trn
	file /proj/giggle_nosnap/work/bemanuel/gem/work.demo_tb_dev/waves.shm/waves.trn
}]
if {$dbNames(realName1) == ""} {
    set dbNames(realName1) waves
}
#
# Groups
#
catch {group new -name {AXI IF} -overlay 0}
catch {group new -name {ENET IF} -overlay 0}
catch {group new -name Regs -overlay 0}
catch {group new -name {APB IF} -overlay 0}
group using {AXI IF}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.aclk}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.araddr[63:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.arvalid}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.arready}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.rdata[127:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.rvalid}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.rresp[1:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.awaddr[63:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.awvalid}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.awready}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.wdata[127:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.wvalid}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.bresp[1:0]}]} ]
group using {ENET IF}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.tx_clk}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.tx_en}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.tx_er}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.txd[7:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.rx_clk}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.rx_dv}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.rx_er}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.rxd[7:0]}]} ]
group using Regs
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.i_gem_ss.i_gem_top.i_gem_reg_top.i_gem_registers.gen_dma.i_reg_dma.dma_config[31:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.i_gem_ss.i_gem_top.i_gem_reg_top.i_gem_registers.network_config[31:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.i_gem_ss.i_gem_top.i_gem_reg_top.i_gem_registers.network_control[31:0]}]} ]
group using {APB IF}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.apb_reg_if_slave0.active.clk}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.penable}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.i_gem_wrapper.i_gem.pwrite}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.apb_reg_if_slave0.active.paddr[31:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {cdn_demo_tb.apb_reg_if_slave0.active.prdata[31:0]}]} ] \
