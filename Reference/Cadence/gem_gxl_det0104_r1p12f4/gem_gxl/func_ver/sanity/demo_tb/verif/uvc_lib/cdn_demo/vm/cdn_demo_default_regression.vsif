#include "${CDN_DEMO_PATH}/verif/uvc_lib/cdn_demo/vm/cdn_demo_group.vsif"


group cdn_demo_c_tb_regression_sanity {

   seed : 1;
   count : 1;

   pre_group_script : " \
      make -f \
         $ENV(CDN_DEMO_PATH)/verif/uvc_lib/cdn_demo/sve/Makefile \
         CDN_VIP_LIB_PATH=$DIR(session)/chain_0/cdn_vip_lib \
         C_TEST=1 \
         ENV_PATH_DISABLE_CHECK=1 \
         ARGS='-define CDN_DEMO_RAM_INTEGRATION_TEST' \
         rdl_ram_integration \
         compile_dut \
         elab \
    ";     

    // Parse the logs using the following filter files
    scan_script : "vm_scan.pl $ENV(VMANAGER_HOME)/bin/ius.flt \
                              $ENV(VMANAGER_HOME)/bin/uvm.flt \
                              $ENV(VMANAGER_HOME)/bin/specman.flt \
                              $ENV(VMANAGER_HOME)/bin/shell.flt \
                              $ENV(VMANAGER_HOME)/bin/denali.flt";

    // 1 hour timeout by default
    timeout: 3600;

    run_script: " \
       make -f $ENV(CDN_DEMO_PATH)/verif/uvc_lib/cdn_demo/sve/Makefile \
          ENV_PATH_DISABLE_CHECK=1 \
          TEST=$ATTR(test_name) \
          rdl_ram_integration \
          ENV_PATH_DISABLE_CHECK=1 \
          compile_c ;\
       make -f $ENV(CDN_DEMO_PATH)/verif/uvc_lib/cdn_demo/sve/Makefile \
          SEED=$ATTR(seed) \
          CDN_VIP_LIB_PATH=$DIR(session)/chain_0/cdn_vip_lib \
          CDN_DEMO_DUT_LIB_PATH=$DIR(group)/cdn_cdn_dut_lib \
          CDN_DEMO_VERIF_LIB_PATH=$DIR(group)/cdn_verif_lib \
          ARGS='-define CDN_DEMO_RAM_INTEGRATION_TEST' \
          UVM_VERBOSITY=UVM_HIGH \
          ENV_PATH_DISABLE_CHECK=1 \
          TEST=$ATTR(test_name) \
          simulate ;\
    ";

    test cdn_demo_c_ram_integration_test {};
    test cdn_demo_c_hello_world_test {};
    test cdn_demo_c_gpio_test {};

}

