-ansicdiag("Generate ANSI-C header") {
  -depth("Generates a header file for each address map n-levels beneath the top") "number"
  -effwidth("Reduce registers to their effective minimum width") "minwidth"
  -filename("filename of the generated code: <filename>.h") "filename"
  -trunc("truncate field/reg macro define names by trunc number of scope segments ") "trunc"
  -comment("Add's component descriptions as comments in output")
  -typeprefix("prefix name to use in global diag data type") "typeprefix"
}

