// NOTE: Please do not load this vsif directly. Instead create a new vsif:
// - #define the REGRESSION_CONFIG.
// - #define the REGRESSION_RESTRICT.
// - #include the session vsif from cdn_demo/vm.
// - #include this vsif.
// - Extend the group to add tests.
// For examples, look at the provided vsifs in the cdn_gem_demo/vm folder.
//----------------------------------------------------------------------------

group cdn_gem_demo_regression {

  // Set the seed for this group to run
  seed: 1;

  // Specify the number of runs for this group
  count: 1;

  // Set a timeout limit for the run in seconds (0 disable timeout mechanisms)
  timeout: 3600;

  // Run script
  run_script: make -f $RUN_ENV(CDN_DEMO_PATH)/verif/uvc_lib/cdn_demo/sve/Makefile \
                run \
                CDN_VIP_LIB_PATH=$DIR(session)/chain_0/cdn_vip_lib \
                CONFIG=REGRESSION_CONFIG \
                RESTRICT=REGRESSION_RESTRICT \
                UVM_VERBOSITY=UVM_NONE \
                TEST=$ATTR(test_name);

  // Parse the logs using the following filter files
  scan_script : "vm_scan.pl \
                   $ENV(VMANAGER_HOME)/bin/ius.flt \
                   $ENV(VMANAGER_HOME)/bin/uvm.flt \
                   $ENV(VMANAGER_HOME)/bin/specman.flt \
                   $ENV(VMANAGER_HOME)/bin/shell.flt \
                   $ENV(VMANAGER_HOME)/bin/denali.flt";

};

