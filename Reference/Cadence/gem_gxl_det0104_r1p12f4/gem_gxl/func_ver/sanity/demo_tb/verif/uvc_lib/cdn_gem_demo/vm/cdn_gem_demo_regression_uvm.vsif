#define REGRESSION_CONFIG pbuf_axi_uvm
#define REGRESSION_RESTRICT uvm_demotb
#include "../../cdn_demo/vm/cdn_demo_session.vsif"
#include "cdn_gem_demo_regression.vsif"

extend cdn_gem_demo_regression {
 
  // Use Cases
  test cdn_gem_demo_uc_enet_tx_1pkt_test    {seed: 1;}
  test cdn_gem_demo_uc_enet_tx_2pkts_test   {seed: 1;}
  test cdn_gem_demo_uc_enet_tx_q_fixed_test {seed: 1;}
  test cdn_gem_demo_uc_enet_rx_1pkt_test    {seed: 1;}
  test cdn_gem_demo_uc_enet_rx_3pkts_test   {seed: 1;}

  // Registers
  test cdn_gem_demo_uvm_reg_reset_test             {seed: 1;}
  test cdn_gem_demo_uvm_reg_bit_bash_test          {seed: 1;}
  test cdn_gem_demo_uvm_reg_aliasing_test          {seed: 1;}
  test cdn_gem_demo_uvm_reg_read_all_test          {seed: 1;}
  test cdn_gem_demo_uvm_reg_write_all_test         {seed: 1;}
  test cdn_gem_demo_uvm_reg_write_follow_read_test {seed: 1;}

};

