// Description: 
// Set the common session attributes for all regression runs.
//----------------------------------------------------------------------------

session demo_tb_regression_session {

   top_dir : ./regressions;

   create_debug_logs: TRUE;

   // Setting output_mode to terminal is useful for debugging.
   output_mode : terminal;
    
   // Include the FARM specific settings - this is set on the command line before starting emanager
   #include "${FARM_VSIF}"

   // Compile the VIP and make derived files
   pre_session_script: " \
      make -f \
         $ENV(CDN_DEMO_PATH)/verif/uvc_lib/cdn_demo/sve/Makefile \
         ENV_PATH_DISABLE_CHECK=1 \
         scrub \
         vip \
    ";     

}

