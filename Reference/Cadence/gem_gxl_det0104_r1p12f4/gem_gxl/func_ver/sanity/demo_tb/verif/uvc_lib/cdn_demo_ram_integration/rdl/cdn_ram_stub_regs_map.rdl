`include "cdn_ram_stub_regs.rdl"

// ------------------------------------------------------------------
// RAM STUB Address Map
// ------------------------------------------------------------------
addrmap cdn_ram_stub_addr_map {

//  accesswidth=32;

    master_apb_register_block_type                  master_apb_reg_block              @0x00000000;

    sram_test_function_register_block_type          sram_test_func_reg_block          @0x00000100;
    dp1r1w_test_function_register_block_type        dp1r1w_test_func_reg_block        @0x00000200;
    dp2r2w_test_function_register_block_type        dp2r2w_test_func_reg_block        @0x00000300;
    rf_test_function_register_block_type            rf_test_func_reg_block            @0x00000400;

    sram_be_test_function_register_block_type       sram_be_test_func_reg_block       @0x00000500;
    dp1r1w_be_test_function_register_block_type     dp1r1w_be_test_func_reg_block     @0x00000600;
    dp2r2w_be_test_function_register_block_type     dp2r2w_be_test_func_reg_block     @0x00000700;
    rf_be_test_function_register_block_type         rf_be_test_func_reg_block         @0x00000800;

};

