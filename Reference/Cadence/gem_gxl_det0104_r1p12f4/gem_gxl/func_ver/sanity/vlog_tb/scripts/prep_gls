#!/bin/csh
source ./setup_project.csh
setenv VFILE `echo 'source $env(IPF_DESIGN_FLOW_SCRIPTS)/tech_lib_setup.tcl; puts $VFILE' | tclsh`	
set SYNTH_RPT_PATH = `echo 'source ./project.tcl; puts $_REPORTS_PATH' | tclsh`
grep "meta_reg" $SYNTH_RPT_PATH/{$DESIGN}.dft_chainRegs > {$DESIGN}_tfile.txt
perl -p -i -e 's/.*\sPASS\;.*\n//g' {$DESIGN}_tfile.txt
perl -p -i -e 's/\//\./g' {$DESIGN}_tfile.txt
perl -p -i -e "s/^\s+(i_.*\.)(.*meta_reg\[.*\])/PATH tb_$DESIGN\.i_$DESIGN\.\1\\\2 -tcheck/g" {$DESIGN}_tfile.txt

if (! -e $MODULE_PATH/pnr/$STAMP/data_$CONFIG/$DESIGN.postccoptincr_func.sdf.X) then
  echo Compiling SDF ...
  ncsdfc $MODULE_PATH/pnr/$STAMP/data_$CONFIG/$DESIGN.postccoptincr_func.sdf -output $MODULE_PATH/pnr/$STAMP/data_$CONFIG/$DESIGN.postccoptincr_func.sdf.X -append_log -logfile ncsdfc.log
endif

echo Creating SDF Commandfile ...
echo 'COMPILED_sdf_file = "'$MODULE_PATH/pnr/$STAMP/data_$CONFIG/$DESIGN.postccoptincr_func.sdf.X'"',LOG_FILE = '"sdf.log", SCOPE = 'tb_${DESIGN}\:i_$DESIGN\; > sdf_cmd_file

if (! -e $MODULE_PATH/pnr/$STAMP/data_$CONFIG/libfiles.f) then
  echo $VFILE > $MODULE_PATH/pnr/$STAMP/data_$CONFIG/libfiles.f
endif
