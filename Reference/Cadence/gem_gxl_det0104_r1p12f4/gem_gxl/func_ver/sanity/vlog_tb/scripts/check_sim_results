echo
echo "TOTAL NUMBER OF REPORTS ..."
find ../func_ver/sanity/vlog_tb/reports/reports_*/. -name 'ncsim.rtl*' | wc -l

echo
echo "TOTAL NUMBER OF PASSES ..."
find ../func_ver/sanity/vlog_tb/reports/reports_*/. -name 'ncsim.rtl*' -print0 | xargs -0 egrep  "PASSED" | wc -l

echo
echo "TOTAL NUMBER OF NON PASSES ..."
find ../func_ver/sanity/vlog_tb/reports/reports_*/. -name 'ncsim.rtl*' -print0 | xargs -0 grep -c  "PASSED" |grep ":0" | wc -l

echo
echo "TESTS THAT HAVE FAILED ..."
find ../func_ver/sanity/vlog_tb/reports/reports_*/. -name 'ncsim.rtl*' -print0 | xargs -0 grep "* FAILED"

echo
echo "TESTS THAT HAVE NOT PASSED ..."
find ../func_ver/sanity/vlog_tb/reports/reports_*/. -name 'ncsim.rtl*' -print0 | xargs -0 grep -c "PASSED" |grep ":0"

echo
echo "TESTS THAT HAVE ASSERTION FAILS..."
find ../func_ver/sanity/vlog_tb/reports/reports_*/. -name 'ncsim.rtl*' -print0 | xargs -0 grep -l "ASRTST"

echo
echo "Number of jobs waiting on LSF  ..."
bjobs |wc -l
echo
echo "Jobs running on LSF  ..."
bjobs |grep RUN | sort

