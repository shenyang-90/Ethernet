--
-- This tests basic transmit functionality using random length buffers
-- at random locations
--
-- Enable transmit and interrupts, write transmit address and
-- control registers.
--
-- Check stats after time out
--
--
-- ************************************************************************** --
-- need fast bus response for 25MHz Hclk
wait_states 0
bus_grant_delay 0
sel_ahb_freq 3 -- set ahb frequency to high
set_random_seed 99;

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 00000000  -- enable all interrupts
apbwr      440 88000000  -- write transmit queue pointer 1
apbwr      444 99000000  -- write transmit queue pointer 2
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx and rx

# this will transmit 50 frames,
tx_frame  50
      number_of_bufs 1
      buffer_size    100-150
      data           random
      num_collisions  5 
      too_many_col   0
      auto_gen_int   0
      num_dma_queues 3
      fcs            YES
-- force end of test in case it doesn't stop of its own accord
end(1010000)
