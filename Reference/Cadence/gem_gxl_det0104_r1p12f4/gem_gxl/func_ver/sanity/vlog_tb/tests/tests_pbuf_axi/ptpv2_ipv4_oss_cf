--
-- Test Description
-- Test of correction field update in a sync frame
-- Enable correction field update of sync frames
--
-- Transmit frames:-
-- TX Frame 1 : PTP sync frame - TSU set to zero -- 16 lsb cleared
-- TX Frame 2 : PTP sync frame - TSU set to zero and second field different -- add a billion
-- TX Frame 3 : PTP sync frame - TSU set to 2aaaaaaaa  -- add 2aaaaaaaa to correction filed
-- TX Frame 4 : PTP sync frame - TSU set to 2aaaaaaaa and max value signalled -- transmit 7fffffffffffffff
-- TX Frame 5 : PTP follow_up frame
-- TX Frame 6 : PTP delay request frame
-- TX Frame 7 : PTP delay response frame
-- TX Frame 8 : PTP sync frame - TSU set to 2aaaaaaaa and 000a0a04 subtracted to get 2aaa0a0a6
-- TX Frame 9 : PTP sync frame - TSU set to 2aaaaaaaa and 000a0a04 subtracted with a billion added
-- TX Frame 10: PTP sync frame - TSU set to 1 sec and 2aaaaaaaa ns and 000a0a04 added
-- TX Frame 11: PTP version 1 sync frame - TSU set to 2aaaaaaaa and 000a0a04 subtracted with a billion added - no update because it is a version 1 frame
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0



--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      00 08000000  -- enable one step update of correction field
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080013  -- copy all & full duplex
apbrd      04 00080013  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000008  -- enable transmit


--******************************************************************************
-- Transmit Frames
--******************************************************************************
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 08000208  "Starting transmit frames"  -- enable one step update of the correction field (bit 27)
                        -- write tx_go and enable tx


