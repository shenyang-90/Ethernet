-- Description:
---------------
--
-- This test was created to fix an issue recorded in Jan 2013
-- with regards to SGMII mode with odd numbers of preamble bytes received
-- odd number of bytes in received frame.
-- This test receives 4 frames
--  1. frame has odd preamble and odd number bytes
--  2. frame has odd preamble and even number bytes
--  3. frame has even preamble and odd number bytes
--  4. frame has even preamble and even number bytes

--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr     200 00000040  -- disable autonegotioation
apbrd     200 00008040  -- check autoneg disabled
apbwr      04 01080c1b  -- enable jumbo, RX TCP offload, 10bit mode
apbrd      04 01080c1b  -- verify write to network config register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 55555500  -- write receive queue pointer
apbrd      18 55555500  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status


