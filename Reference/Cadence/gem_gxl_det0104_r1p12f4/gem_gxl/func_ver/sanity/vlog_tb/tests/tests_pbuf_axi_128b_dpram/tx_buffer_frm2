-- 1. Complete the second frame in the system and then make sure it starts 
--    working on frm1 again, check that when the writeback comes along it is
--    able to change states correctly between wr2 and data1 
--         
-- 2. Frame two oldest and frm1 dma activity occuring, hresp error allows frm2 to
--    be written back and frm1 lost       
--
-- 3. One whole frame in frm2 states
--
-- 4. Collision in frame two when in frm1 data state check transition back to 
--    frm2 data state and subsequent buffer recovery
--
-- 5. Queue two short frames (frame 1 and frame 2). Queue another multibuffer
--    frame (frame 1), which finishes it's first buffer just as the writeback
--    for the frame 2 occurs.
--    This test is to ensure that codecoverage see a transition between
--    TX_MAN_FRM2_WR and TX_MAN_FRM1_RD states.
-- ************************************************************************** --


wait_states 3
bus_grant_delay 3

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer



