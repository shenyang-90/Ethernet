-- Same test as tx_toe_base_64_t, but all packets are vlan tagged
--Test 1: Packets with 0 IP Options, NO DATA
--Test 2: Packets with 1 IP Option, NO DATA
--Test 3: Packets with 2 IP Options , NO DATA
--Test 4: Packets with >2 Options (number of options is EVEN), NO DATA
--Test 5: Packets with >2 Options (number of options is ODD), NO DATA
--Test 6: Packets with 0 IP Options, with DATA
--Test 7: Packets with 1 IP Option, with DATA
--Test 8: Packets with 2 IP Options , with DATA
--Test 9: Packets with >2 Options (number of options is EVEN), with DATA
--Test 10: Packets with >2 Options (number of options is ODD), with DATA
--Test 11-19: Packets with 0 Options, all MOD values of DATA covered
--Test 20-27: Packets with 1 Option, all MOD values of DATA covered

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbwr      04 00280000  -- check reset value of network config register
apbrd      04 00280000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      10 00020c04  -- enable 4k ram and tcp offload
apbwr      00 00000208  -- write tx_go and enable tx



