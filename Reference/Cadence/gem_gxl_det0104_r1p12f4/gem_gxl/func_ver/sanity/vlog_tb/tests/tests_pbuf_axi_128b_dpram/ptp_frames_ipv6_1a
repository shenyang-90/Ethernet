--
-- Test Description
-- PTP frames encapsulated in IPv6 with incorrect addresses, UDP dest
-- port or messagetype will not be detected
--
-- Transmit frames:-
-- TX Frame 1 : PTP sync frame, incorrect ethertype
-- TX Frame 2 : PTP delay request frame, incorrect address
-- TX Frame 3 : PTP pdelay_req frame, incorrect address
-- TX Frame 4 : PTP pdelay_resp frame, incorrect UDP dest port
-- TX Frame 5 : PTP sync frame event with incorrect address
-- TX Frame 6 : PTP delay request frame with incorrect UDP destination port
-- TX Frame 7 : PTP pdelay_req frame with incorrect UDP dest port
-- TX Frame 8 : PTP pdelay_resp frame with incorrect messagetype
-- TX Frame 9 : PTP delay_resp frame with incorrect messagetype
--
--------------------------------------------------------------------------------

--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  check reset state of PTP output flags
--******************************************************************************
pinsc(50) sof_tx         0
pinsc     sync_frame_tx  0
pinsc     delay_req_tx   0
pinsc     sof_rx         0
pinsc     sync_frame_rx  0
pinsc     delay_req_rx   0
pinsc     loopback       0
pinsc     half_duplex    1
pinsc     extint         0 
--******************************************************************************
-- Transmit Frames
--******************************************************************************

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      10 00020c04  -- enable 4k ram and tcp offload
apbwr      00 00000208  -- write tx_go and enable tx

