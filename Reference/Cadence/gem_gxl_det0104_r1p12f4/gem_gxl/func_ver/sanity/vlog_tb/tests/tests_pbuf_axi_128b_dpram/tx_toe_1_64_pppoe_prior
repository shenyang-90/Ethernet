-- write transmit complete status for the oldest frame 1
dma_wr 5555550c 8000804a -- write used bit




dma_rd tx_descr 55555510 98767000 -- 
dma_rd tx_descr 55555514 80008062 -- used bit read

apbrd(int)  24 00000088  -- check interrupt status - transmit complete, used
apbwr       24 00000088  -- check interrupt status - transmit complete, used
apbrd	      14 00000021  -- tx status - frame transmitted,used




-- force end of test in case it doesn't stop of its own accord
end(10000)


bus_grant_delay 0
