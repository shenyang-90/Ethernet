--
--   Description
----------------
--
--
-- This tests the ability to pause transmission after tx_lpi_en is deasserted.
--
-- First the test bench is configured for 100M operation and the transmit sys
-- wake time register is set to 0x80 or 128 which is equivalent to 128 * 320 ns or 40.96 microseconds.
-- tx_lpi_en is asserted and deasserted which will have the effect of pausing transmission for 40.96 microseconds.
-- A frame is then transmitted and it is shown it is not transmitted until the timer expires.
--
-- A similar test is then performed for gigabit operation but with response time set to 0xffff
-- or 65,535*64 = 4194.24 microcsecond which tests the full range of the counter
--
--
--
--------------------------------------------------------------------------------

-- need the following to prevent underruns in gigabit operation
wait_states 0
bus_grant_delay 0

pinsc(50) loopback 0 half_duplex 1  extint 0  user_out 00000000 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      0c 000000ff  -- write user_out bits to ff
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00080000  -- write tx_lpi_en
apbrd      60 00000000  -- EEE system wake time
apbwr      60 00000080  -- EEE system wake time 128*320= 40.96 microcsecond
apbrd      60 00000080  -- EEE system wake time
apbwr      00 00000000  -- write disable tx_lpi_en
apbrd      60 00000080  -- EEE system wake time -- wait a bit before starting transmission
apbrd      60 00000080  -- EEE system wake time
apbrd      60 00000080  -- EEE system wake time
apbwr      00 00000208  -- write tx_go and enable tx
apbwr      00 00000408  -- write tx halt immediately keeping tx enabled
                        -- this stops fetch of second frame


dma_rd 55555504 0000803e -- start of frame, length 62 bytes
dma_rd 55555500 98765000


-- supply the transmit data to the AHB interface
dma_rd 98765000 005e0001
dma_rd 98765004 d0000200
dma_rd 98765008 04e7ecbc
dma_rd 9876500c c0450008
dma_rd 98765010 00003000
dma_rd 98765014 11020000
dma_rd 98765018 8c9e7258
dma_rd 9876501c 00e0fce0
dma_rd 98765020 c1070200
dma_rd 98765024 1c00c107
dma_rd 98765028 0000e9b6
dma_rd 9876502c 640a0308
dma_rd 98765030 69630002
dma_rd 98765034 006f6373
dma_rd 98765038 8c9e0000
dma_rd 9876503c 0000fde0

pinsc (500)  user_out 11111111 --  check interrupt has not occured yet
pinsc(2100)  user_out 11111111 --  check interrupt has not occured yet


-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd             003000000000021158729e8ce0fce000
txd             000207c107c1001cb6e9000008030a64
txd             0200636973636f0000009e8ce0fdfb2c1f72



-- write transmit complete status
dma_wr 55555504 8000803e -- write used bit


apbrd(int) 24 00000080  -- check interrupt status - transmit complete
apbrd      14 00000020  -- tx status - frame transmitted, used bit set
apbrd      1c 55555508  -- transmit queue pointer not changed
apbwr      0c 000000fe  -- write user_out bits - if this happens early pinsc above will fail
apbwr      00 00000000  -- disable tx
apbwr      60 00000000  -- EEE system wake set to zero
apbrd      60 00000000  -- EEE system wake time
apbwr      04 00080403  -- set gigabit mode - this changes the clocks to 125Mhz
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00080008  -- write tx_lpi_en and enable tx
apbwr      00 00080208  -- write tx_go and enable tx
apbwr      00 00080408  -- write tx halt immediately keeping tx enabled - keep tx_lpi_en enabled
                        -- this stops fetch of second frame


dma_rd 55555504 0000803e -- start of frame, length 62 bytes
dma_rd 55555500 98765000

-- even though sys wake time is zero transmission will be paused because tx_lpi_en is asserted
apbrd      60 00000000  -- EEE system wake time
apbrd      60 00000000  -- EEE system wake time
apbrd      60 00000000  -- EEE system wake time
apbrd      60 00000000  -- EEE system wake time
apbwr      60 0000ffff  -- EEE system wake time 65,535*64= 4194.24 microcsecond
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time -- delay disabling tx_lpi_en
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbrd      60 0000ffff  -- EEE system wake time
apbwr      00 00000008  -- disable tx_lpi_en


-- supply the transmit data to the AHB interface
dma_rd 98765000 005e0001
dma_rd 98765004 d0000200
dma_rd 98765008 04e7ecbc
dma_rd 9876500c c0450008
dma_rd 98765010 00003000
dma_rd 98765014 11020000
dma_rd 98765018 8c9e7258
dma_rd 9876501c 00e0fce0
dma_rd 98765020 c1070200
dma_rd 98765024 1c00c107
dma_rd 98765028 0000e9b6
dma_rd 9876502c 640a0308
dma_rd 98765030 69630002
dma_rd 98765034 006f6373
dma_rd 98765038 8c9e0000
dma_rd 9876503c 0000fde0


pinsc  (2600)  user_out 11111110 --  check interrupt has not occured yet
pinsc(212000)  user_out 11111110 --  check interrupt has not occured yet


-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd             003000000000021158729e8ce0fce000
txd             000207c107c1001cb6e9000008030a64
txd             0200636973636f0000009e8ce0fdfb2c1f72



-- write transmit complete status
dma_wr 55555504 8000803e -- write used bit



apbrd(int) 24 00000080  -- check interrupt status - transmit complete
apbrd      14 00000020  -- tx status - frame transmitted, used bit set
apbrd      1c 55555508  -- transmit queue pointer not changed
apbwr      0c 000000fc  -- write user_out bits

pinsc(212400)  user_out 11111100 --

apbrd      60 0000ffff  -- EEE system wake time
apbwr      60 00000000  -- EEE system wake time 0 - toggle bits for code coverage
apbrd      60 00000000  -- EEE system wake time 0
apbwr      00 00080008  -- write tx_lpi_en
apbrd      60 00000000  -- EEE system wake time 0
apbwr      00 00000208  -- write tx_go and enable tx
apbwr      00 00000408  -- write tx halt immediately keeping tx enabled
                        -- this stops fetch of second frame
apbrd      60 00000000  -- EEE system wake time 0
apbwr      00 00000008  -- write disable tx_lpi_en


dma_rd 5555550c 0000803e -- start of frame, length 62 bytes
dma_rd 55555508 98765000


-- supply the transmit data to the AHB interface
dma_rd 98765000 005e0001
dma_rd 98765004 d0000200
dma_rd 98765008 04e7ecbc
dma_rd 9876500c c0450008
dma_rd 98765010 00003000
dma_rd 98765014 11020000
dma_rd 98765018 8c9e7258
dma_rd 9876501c 00e0fce0
dma_rd 98765020 c1070200
dma_rd 98765024 1c00c107
dma_rd 98765028 0000e9b6
dma_rd 9876502c 640a0308
dma_rd 98765030 69630002
dma_rd 98765034 006f6373
dma_rd 98765038 8c9e0000
dma_rd 9876503c 0000fde0


-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd             003000000000021158729e8ce0fce000
txd             000207c107c1001cb6e9000008030a64
txd             0200636973636f0000009e8ce0fdfb2c1f72


-- write transmit complete status
dma_wr 5555550c 8000803e -- write used bit


apbrd(int) 24 00000080  -- check interrupt status - transmit complete
apbrd      14 00000020  -- tx status - frame transmitted, used bit set
apbrd      1c 55555510  -- transmit queue pointer not changed
apbwr      0c 000000f8  -- write user_out bits

pinsc(213000)  user_out 11111000 --

-- check transmit statistics
apbrd     100 000000c6  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000003  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000003  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000003  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
