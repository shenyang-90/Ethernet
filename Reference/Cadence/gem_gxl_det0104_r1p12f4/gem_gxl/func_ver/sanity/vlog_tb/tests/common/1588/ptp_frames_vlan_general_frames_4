--
-- Test Description
-- See if a variety of PTP version 2 frames encapsulated in VLAN/IPv4 can be 
-- detected, 
-- with extended buffer descriptors
--
-- Transmit frames:-
-- TX Frame 1 : PTP general frame
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
-- Configuration Requirements ..
requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1
requires tsu 1
requires tsu_clk 1
requires axi 1      -- currently need axi because of launch time

-- The following ensures that whatever datawidth is selected for this test, the 
-- translator will pass through correct multiples of 32bit words for data transfers
-- (not descriptors). This relies on the test writer using the rx_descr and tx_descr to
-- differentiate between the DMA accesses.
enforce_data_width 1

-- In 32b datapaths, the 64bit descriptors are accessed not in incrementing order
-- The used bit is always read first, and written last.
-- For TX since the used bit is bit 63, the 2nd 32bit word is always read first
-- For RX since the used bit is bit 0, the 2nd 32bit word is always written first
-- This ordering is only there for 32bit modes
-- To simplify writing testcases and ensure the same test can operate on different datawidths
-- we can automatically reverse the order ...
auto_descriptor_swap 1

wait_states 0
bus_grant_delay 0


--******************************************************************************
--  check reset state of PTP output flags
--******************************************************************************
pinsc(50) sof_tx          0
pinsc     sync_frame_tx   0
pinsc     delay_req_tx    0
pinsc     pdelay_req_tx   0
pinsc     pdelay_resp_tx  0
pinsc     sof_rx          0
pinsc     sync_frame_rx   0
pinsc     delay_req_rx    0
pinsc     pdelay_req_rx   0
pinsc     pdelay_resp_rx  0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale
apbrd      08 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
init_ncr -duplex full -speed 100m -jumbo 0 -databus random -copy_all 1 -eam random -rx_toe 0

-- # Initialize the transmit and receive DMA queue pointers (random values but can add specifics if required)
-- # use arg -rx_ptr_q<Q> and tx_ptr_q<Q> to set specific ptr values rather than the default random
init_q_ptr  -num_tx_queues take_from_cfg   -num_rx_queues take_from_cfg -rx_ptr_q0 fffff000 -tx_ptr_q0 55555500

apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      d4 76543210  -- write unicast IP DA for RX PTP
apbwr      d8 fedcba98  -- write unicast IP DA for TX PTP
apbwr      00 00100000  -- disable receive and ptp unicast
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status

-- setup extended BD mode

-- # initialize the DMA specific options for random data xfers
-- #   - RX DMA data buffer size
-- #     If left without an argument, it will be completely random
-- #     Set high to force single buffer descriptor testing eg 16320
-- #     use -max_buf_size for max (multiple 64 bytes only)
-- #     use -min_buf_size for min (multiple 64 bytes only)
-- #
-- #   - Burst Length (random by default)
-- #     use -burst <num>, where num can be 1,2,4,8,16, random
-- #        
-- #   - address bus (random by default, or off if config doesnt allow)
-- #     use -addr_bus <32|64|random|take_from_cfg>     
-- #        
-- #   - extended buffer descriptors (random by default, or off if config doesnt allow)
-- #     use -ext_bd <1|0|random>     
-- #        
-- #   - force max burst mode (forces AXI to send max length bursts)
-- #     use -force_max_burst_<tx|rx> <1|0|random>    default is 0 
init_dma -ext_bd 1 -addr_bus 32  -burst random -min_buf_size 128 -max_buf_size 128 -tx_csum_offload 0


apbwr     4cc 00000024  -- tx_bd_control_reg  where last 6 bits are: ts_mode[1;0], bd_size_words
apbwr     4d0 00000004  -- rx_bd_control_reg  where last 6 bits are: ts_mode[1:0], bd_size_words
                        -- ts_mode
                        -- 00 = disabled,
                        -- 01 = ptp event frames only,
                        -- 10 = all ptp frames,
                        -- 11 = all frames

apbwr     1d0 0000003f  -- Timer seconds register  (6 bits of seconds xfered in enhanced ts)
apbwr     1d4 12345678  -- Timer nanoseconds register


--******************************************************************************
-- Transmit Frames
--******************************************************************************
apbwr      00 00100208  "Starting transmit frames"
                        -- write tx_go and enable tx and ptp unicast enable



--******************************************************************************
-- TX Frame : PTP general frame
--******************************************************************************
dma_rd tx_descr 55555500 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555504 0000807a -- end of frame, 
dma_rd tx_descr 55555508 00000000 -- launch time,
dma_rd tx_descr 5555550c 00000000 -- launch time,


dma_rd 98765000 26f7e000
dma_rd 98765004 0008e93f
dma_rd 98765008 4b358620
dma_rd 9876500c 01000081
dma_rd 98765010 00450008
dma_rd 98765014 b8082c00
dma_rd 98765018 11ff0040
dma_rd 9876501c 858b9799
dma_rd 98765020 00e06ed9
dma_rd 98765024 05908101
dma_rd 98765028 12004001
dma_rd 9876502c 02692872   -- , 9 =  general message
dma_rd 98765030 686f6c6c
dma_rd 98765034 686f6c65
dma_rd 98765038 686f6c65
dma_rd 9876503c 686f6c65
dma_rd 98765040 abab6c65
dma_rd 98765044 abababab
dma_rd 98765048 abababab
dma_rd 9876504c 0001abab
dma_rd 98765050 00000000
dma_rd 98765054 00000000
dma_rd 98765058 00000000
dma_rd 9876505c 00000000
dma_rd 98765060 00000000
dma_rd 98765064 00000000
dma_rd 98765068 00000000
dma_rd 9876506c 00000000
dma_rd 98765070 00000000
dma_rd 98765074 00000000
dma_rd 98765078 00000000


-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d5
txd     00e0f7263fe9 -- MAC DA
txd     08002086354b -- MAC SA
txd     81000001     -- VLAN TPID and TCI
txd     0800         -- Length/typeID
txd     4500         -- Version, IHL, type of service
txd     002c         -- total length = 55
txd     08b8         -- ID
txd     4000         -- flags & fragmentation
txd     ff11         -- time to live and UDP protocol
txd     9997         -- IP Header checksum
txd     8b85d96e     -- IP SA
txd     e0000181     -- IP DA
txd     9005         -- UDP source port
txd     0140         -- UDP destination port
txd     0012         -- UDP length
txd     7228         -- UDP checksum
txd     69           -- transportSpecific, messageType, 9 = general message
txd     02           -- version PTP
txd     6c6c         -- subdomain
txd     6f68656c     -- subdomain
txd     6f68656c     -- subdomain
txd     6f68656c     -- subdomain
txd     6f68656c     -- subdomain
txd     abababab     -- other stuff
txd     abababab     -- other stuff
txd     abababab     -- UUID, sequenceID
txd     01000000     -- delay request control field, flags, reserved
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     00000000     -- PAD
txd     zzzzzzzz         -- For OSS tests, we dont care about CRC checks - TB auto checks these anyway


--  check state of PTP output flags


-- write transmit complete status for the oldest frame 1
dma_wr tx_descr 55555508 d2345678 -- TS lsw  (bits[31:30] are lower 2 bits of seconds [1:0])
dma_wr tx_descr 5555550c 0000000f -- TS msw seconds[5:2]
dma_wr tx_descr 55555504 8080807a -- write used bit, check ts_written bit

dma_rd tx_descr 55555510 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555514 8000807a -- used/end of frame,
dma_rd tx_descr 55555518 00000000 -- launch time,
dma_rd tx_descr 5555551c 00000000 -- launch time,


-- check status on detection of transmit frame
apbrd(int) 24 00000088  "Frame complete"
                        -- check interrupt status - transmit sync frame
apbwr      24 00000088  -- clear interrupt status register
apbrd      14 00000021  -- check TX status register




-- check transmit statistics
apbrd(scale 18000)     100 0000007e  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000001  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000001  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000000  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors
apbrd     1A8 00000000  -- check receive IP checksum errors
apbrd     1AC 00000000  -- check receive TCP checksum errors
apbrd     1B0 00000000  -- check receive UDP checksum errors

end(100000)

