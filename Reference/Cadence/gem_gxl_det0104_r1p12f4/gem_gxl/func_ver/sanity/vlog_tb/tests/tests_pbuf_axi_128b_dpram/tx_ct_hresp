--******************************************************************************
-- initialise the GEM
--******************************************************************************

apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      18 01234000  -- write receive queue pointer
apbwr      10 000207c4  -- DMA configuration reg
apbwr	     1c ffffff00  -- write address of tx buffer descriptor in memory
apbwr     4ec 0000000f  -- reduce freq of restart trigger
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  
apbwr      04 00080002  
apbwr      40 80000030  -- enable tx cut thru with threshold = 0x30, or 48
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000208  -- enable transmit




--******************************************************************************
-- Transmit a frame with an hresp error during data in the first buffer.
-- Check that this causes an underrun, hresp error is reported in the
-- interrupt and status register and that the tx halts.
--******************************************************************************

-- supply the transmit buffer location
dma_rd tx_descr ffffff04 00000028 -- reads no eof and length
dma_rd tx_descr ffffff00 98765000 -- dma reads pointer of 98765000


dma_rd 98765000 12345678
dma_rd 98765004 11111111
dma_rd 98765008 22222222 
dma_rd 9876500c 33333333
dma_rd 98765010 44444444
dma_rd 98765014 55555555 not_ok
dma_rd 98765018 66666666
dma_rd 9876501c 77777777
dma_rd 98765020 88888888
dma_rd 98765024 99999999
-- no more data reads after this point because of hresp error.

-- hresp will cause a reset of the DMA and AXI wrapper, so nothing is transmitted

apbrd(int) 24 00000840  "TX scenario 1: Complete"
                        -- check interrupt status - HRESP not OK & buffers exh.
apbwr      24 00000840  -- clear interrupt status register
apbrd      14 00000110  -- read tx status register - HRESP not OK & buffers exh.
apbwr      14 00000110  -- clear status register
apbrd      14 00000000  -- clear status register
apbrd     134 00000000  -- check transmit underruns errors (none with pkt buff)
apbrd     134 00000000  -- check transmit underruns errors (none with pkt buff)
apbrd     134 00000000  -- check transmit underruns errors (none with pkt buff)
