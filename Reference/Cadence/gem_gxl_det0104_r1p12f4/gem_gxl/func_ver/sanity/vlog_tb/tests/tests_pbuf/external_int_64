--
-- This test shows that changes in the state of the external interrupt
-- pin will cause an interrupt.
--
-- Note interrupt will only be generated on the rising edge of
-- the external interrupt pin.
--
-- Test also ensures interrupts are recognized if they occur as
-- the interrupt status register is being read.
--
-- **************************************************************************

-- check masking and operation of external interrupt
apbrd(100) 24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts  
apbrd      30 00000000  -- check interrupt mask
apbwr      04 00280000  -- check reset value of network config register

pinsd(200) external_int 1

apbrd(int) 24 00008000  -- external interrupt
apbwr      24 00008000  -- clear interrupt status register
apbrd      24 00000000  -- check interrupt status register has been cleared
apbrd      30 00000000  -- check interrupt mask

pinsd(300) external_int 0  -- no interrupt occurs on falling edge

apbrd(400) 24 00000000  -- check no interrupts
apbrd      30 00000000  -- check interrupt mask
apbwr      2c 00008000  -- disable external interrupt
apbrd      30 00008000  -- check interrupt mask

pinsd(500) external_int 1  -- no interrupt will occur because it is masked

apbrd(600) 24 00000000  -- check no interrupts
apbrd      30 00008000  -- check interrupt mask
apbwr      28 00008000  -- enable external interrupt
apbrd      30 00000000  -- check interrupt mask
apbwr      2c 00007cff  -- disable all other interrupts
apbrd      30 00007cff  -- check interrupt mask


-- ************************************************************************** --
-- now try interrupts just at the point the interrupt status register is read
pinsd(700) external_int 0
pinsd(720) external_int 1
pinsd(725) external_int 0 
pinsd(730) external_int 1
pinsd(735) external_int 0
pinsd(744) external_int 1
pinsd(750) external_int 0
pinsd(758) external_int 1

-- Should be four interrupts
apbrd(710) 24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00008000  -- read interrupt status register (should be set)
apbwr      24 00008000  -- clear interrupt status register
apbrd      24 00000000  -- read interrupt status register (now clear)
apbrd      24 00008000  -- read interrupt status register (should be set)
apbwr      24 00008000  -- clear interrupt status register
apbrd      24 00000000  -- read interrupt status register (now clear)
apbrd      24 00008000  -- read interrupt status register (should be set)
apbwr      24 00008000  -- clear interrupt status register
apbrd      24 00000000  -- read interrupt status register (now clear)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00008000  -- read interrupt status register (should be set)
apbwr      24 00008000  -- clear interrupt status register
apbrd      24 00000000  -- read interrupt status register (now clear)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)
apbrd      24 00000000  -- read interrupt status register (not seen on this one)


