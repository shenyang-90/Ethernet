--
--   Description
----------------
--
-- Transmit 2 10KByte packets.  The PBUF is only 4Kbytes big, but cut thru
-- can be used. This means the packet can be passed through to the MAC before
-- all the packet is stored in the PBUF(once a programmable threshold 
-- is reached). 
--    In addition to testing normal operation for cut through (which will
--    be achevied mostly through random testing, we need to verify the following
--    This will be done in other tests ...
--      1) Possible underflow condition, where AHB traffic doesnt appear
--         quick enough.  Also need to test recovery from underflow
--      2) Limits of threshold, both upper and lower
--      3) Collision handling when cut through is enabled
--      4) Late collisions, too many retries when cut through is enabled
--      5) Other AHB errors when cut through is enabled
--      6) Multi buffer operation (handled through random tests)
--------------------------------------------------------------------------------
-- need this to avoid the test underflowing.
wait_states 0 
pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080402  -- set to full duplex mode, 1gb mode
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      40 80000010  -- enable tx cut thru with threshold = 0x25
apbwr      00 00000208  -- write tx_go and enable tx
#apbwr      00 00000408  -- write tx halt immediately keeping tx enabled
#                        -- this stops fetch of second frame


dma_rd tx_descr 55555504 4000a710 -- start of frame, 10KByte frame
dma_rd tx_descr 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
-- 10KByte = 2500 32 bit words, so repeat the following line 2499 times
dma_rd(2499) 98765000 67452301

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d5
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    zzzzzzzz


-- write transmit complete status for the oldest frame 1
dma_wr 55555504 c000a710 -- write used bit



apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr       24 00000080  -- write to clear
apbrd	      14 00000028  -- tx status - frame transmitted, tx go


dma_rd tx_descr 55555504 0000a710 -- start of frame, 10KByte frame
dma_rd tx_descr 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
-- 10KByte = 2500 32 bit words, so repeat the following line 2499 times
dma_rd(2499) 98765000 67452301

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d5
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    
txd    zzzzzzzz


-- write transmit complete status for the oldest frame 1
dma_wr 55555504 8000a710 -- write used bit



apbrd(int) 24 00000080 --  Transmit Complete
apbwr      24 00000080 --  Clearing Interrupt
apbrd(int) 24 00000008 --  Used bit read
apbwr      24 00000080 --  Clearing Interrupt
apbrd	      14 00000021  -- tx status - frame transmitted, tx go



dma_rd tx_descr 5555550c 8000803e -- start of frame, length 62 bytes
dma_rd tx_descr 55555508 98765000 -- dma reads pointer of 98765000



-- check transmit statistics
apbrd     100 00004e28  -- check octets transmitted bottom (20KBytes + 2xCRC)
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000002  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000002  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000002  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000000  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors


-- force end of test in case it doesn't stop of its own accord
end(500000)

bus_grant_delay 0
