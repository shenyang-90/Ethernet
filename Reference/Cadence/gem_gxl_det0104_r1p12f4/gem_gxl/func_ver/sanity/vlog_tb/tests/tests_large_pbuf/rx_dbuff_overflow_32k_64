--
-- Description
-- -----------
-- This tests the overflow detection of the packet buffer data area.
--
-- This test checks with a 16K RX packet buffer RAM in 64 bit mode.
--
-- When gem_rx_pbuf_addr == 12, the full address space = 16KBytes in 32 bit mode
--
--      RAM size   Max packets  LUT size    Data buffer size  
--        1/8          16         256 bytes     1792 bytes
--        1/4          32         512 bytes     3584 bytes
--        1/2          64        1024 bytes     7168 bytes
--        ALL         128        2048 bytes    14336 bytes
-- 
-- Functional Coverage
-- -------------------
-- · Checks operation of data buffer overflow detection in the RX packet buffer
-- · Checks operation of the rx overflow interrupt
-- · Checks the discarding of frames by the packet buffer on an overflow 
--
-- Detailed Test Description
-- -------------------------
-- 1. Setup the wait states to ensure that the overflow operation can be tested.
-- 2. Initialise the GEM for gigabit receive operation into a 64 bit DMA bus.
-- 3. Enable all interrupts.
-- 4. Check overflow of data buffer using a single frame one byte over limit.
--    Receive a large frame that is one bigger than the programmed data buffer 
--    size. This will cause an overflow of the packet buffer.
--    Check that this causes the frame to be dropped and verify that the buffer 
--    is correctly recovered for the next frame.
--    Also check that an rx overrun interrupt is raised, a receive overrun 
--    status is reported in receive status register and that the receive 
--    overrun statistics register is incremented.
-- 5. Check overflow of data buffer using a single frame way over limit.
--    Receive a large frame 64 bytes bigger than the programmed data buffer 
--    size. This will cause an overflow of the packet buffer.
--    Check that this causes the frame to be dropped and verify that the buffer 
--    is correctly recovered for the next frame.
--    Also check that an rx overrun interrupt is raised, a receive overrun 
--    status is reported in receive status register and that the receive 
--    overrun statistics register is incremented.
-- 6. Check the status and statistics registers and ensure that the above 
--    operations were handled properly.
--------------------------------------------------------------------------------


--******************************************************************************
-- 1. Setup the wait states to ensure that the overflow operation can be tested.
--******************************************************************************
wait_states     9
bus_grant_delay 7

set_random_seed 325;

--******************************************************************************
-- 2. Initialise the GEM for gigabit receive operation into a 64 bit DMA bus.
-- 3. Enable all interrupts.
--******************************************************************************

apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbwr      18 01234000  -- write receive queue pointer
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      98 12345678  -- specific address register 1 bottom
apbwr      9C 00001111  -- specific address register 1 top
apbwr      04 0028041a  -- full duplex, gigabit, 64 bit, jumbo frames
apbwr      00 00000004  -- enable receive
apbrd      20 00000000  -- check contents of the receive status register 
apbwr      48 00003fff  -- write max jumbo frame size to max value

-- Setup RX packet buffer RAM and an AHB burst length
apbwr      10 00f00301  -- 32K RX and 1-beat AHB burst


--******************************************************************************
-- 4. Check overflow of data buffer using a single frame one byte over limit.
--    Receive a large frame that is one bigger than the programmed data buffer 
--    size. This will cause an overflow of the packet buffer.
--    Check that this causes the frame to be dropped and verify that the buffer 
--    is correctly recovered for the next frame.
--    Also check that an rx overrun interrupt is raised, a receive overrun 
--    status is reported in receive status register and that the receive 
--    overrun statistics register is incremented.
--******************************************************************************

apbrdf     20 00000000  "Scenario 1: RX data buffer overflow with single frame"
                        -- check contents of the receive status register 
                        -- and trigger reception of frame



-- read the first receive queue descriptor
dma_rd          01234000    22222000

-- 1 byte too big
-- PBUF is 2^^12-1 = 4095 locns deep
-- This is 32KBytes
-- need 3 locations for status
-- packet size should be 32768 bytes to overflow, -14 for src/dest/type = 32754
-- However, the logic detects the full condition before that, due to
-- various reasons associated with hbursts etc.
-- we actually will overflow with a pkt size of 32748+14
-- NOTE THAT IF do_descr_acc == 0, then you will have to ensure you
-- are not doing multi-buffer receives
rx_frame (apb)  1
      preamble_size  14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      includerxdma   0
      do_descr_acc   0
      data_size      32748
      auto_gen_int   0
      data           random
      fcs            good

-- with the packet buffer in place overflowed packet will be dropped, so no DMA


apbrd(int) 24 00000400  "Scenario 1: Overflow"
                        -- check interrupt status - Receive overrun
apbwr      24 00000400  -- Clear it
apbrd      20 00000004  -- check receive status register - Receive overrun
apbwr      20 00000004  -- clear Receive overrun
apbrdf    1A4 00000001  -- check receive overrun statistic


-- Checks we can still receive the next good frame
rx_frame (apb)  1
      preamble_size  14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      includerxdma   1
      do_descr_acc   0
      auto_gen_int    1
      data_start_add 22222000
      data_size      50 
      data           random
      fcs            good

-- writeback
dma_wr 01234000 22222001
dma_wr 01234004 8000c044


--******************************************************************************
-- 5. Check overflow of data buffer using a single frame way over limit.
--    Receive a large frame 64 bytes bigger than the programmed data buffer 
--    size. This will cause an overflow of the packet buffer.
--    Check that this causes the frame to be dropped and verify that the buffer 
--    is correctly recovered for the next frame.
--    Also check that an rx overrun interrupt is raised, a receive overrun 
--    status is reported in receive status register and that the receive 
--    overrun statistics register is incremented.
--******************************************************************************

apbrd      20 00000002  -- check receive status register - pkt received 
apbwr      20 00000002  
apbrdf     20 00000000  "Scenario 2: RX data buffer overflow with single large frame"
                        -- check contents of the receive status register 
                        -- and trigger reception of frame

-- read the receive queue descriptor
dma_rd          01234008    33333000

rx_frame (apb)  1
      preamble_size  14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      includerxdma   0
      do_descr_acc   0
      data_size      34000
      auto_gen_int    0
      data           random
      fcs            good


-- with the packet buffer in place overflowed packet will be dropped, so no DMA


apbrd(int) 24 00000400  "Scenario 2: Overflow"
                        -- check interrupt status - Receive overrun
apbwr      24 00000400  -- Clear it
apbrd      20 00000004  -- check receive status register - Receive overrun
apbwr      20 00000004  -- clear Receive overrun
apbrd(27000)    1A4 00000001  -- check receive overrun statistic
apbrdf    1A4 00000000  -- check receive overrun statistic


-- Checks we can still receive the next good frame
rx_frame (apb)  1
      preamble_size  14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      includerxdma   1
      do_descr_acc   0
      data_size      150 
      auto_gen_int   1
      do_descr_acc   0
      data_start_add 33333000
      data           random
      fcs            good

-- writeback
dma_wr 01234008 33333001
dma_wr 0123400c 8000c0a8
dma_rd 01234010 33333001

--******************************************************************************
--6.  Check the status and statistics registers and ensure that the above 
--    operations were handled properly.
--******************************************************************************

-- check transmit statistics
apbrd     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     158 00000004  -- check frames received ok
apbrd     15C 00000004  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000001  -- check frames received 65-127
apbrd     170 00000001  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000001  -- check frames received 1024-1518
apbrd     180 00000001  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000001  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors -- checked earlier


-- force end of test in case it doesn't stop of its own accord
end(40000)

