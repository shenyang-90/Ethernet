-- Set wait states and hgrant delay
wait_states 1
bus_grant_delay 0



pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd      24 00000000  -- Check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      30 00000000  -- Check interrupt mask
apbrd     200 00009040  -- check value of pcs control register
apbwr     200 00004040  -- disable autonegotioation and enable ewrap
apbrd     200 0000c040  -- check autoneg disabled
apbwr      04 00280802  -- indicate 10m sgmii operation and 64 bit transfers
apbrd      04 00280802  -- verify write
apbwr      88 005e0001  -- specific address register 1 bottom
apbwr      8C 00000200  -- specific address register 1 top
apbwr      00 0000000c  -- enable receive & transmit

apbrd(int) 24 00000200  -- check link status change interrupt

apbwr      00 00080000  -- Enable LPI tx

apbrd(int) 24 08000000  -- check interrupt status - rx LPI indicate changed to high
apbrd      08 00000087  -- check value of network status register - LPI indicate
apbrd      08 00000087  -- check value of network status register - no clear on read
apbrd     278 00000001  -- Check LPI tx - one transition to high
apbrd     27c 00000008  -- Check LPI tx time - one transition to high
apbrd     270 00000001  -- Check LPI rx - one transition to high
apbrd     274 00000001  -- Check LPI rx time
apbwr      00 00000000  -- disable LPI tx

apbrd(int) 24 08000000  -- check interrupt status - LPI indicate state has changed to low
apbrd      08 00000007  -- check value of network status register - no LPI indicate
apbrd     270 00000000  -- Check LPI rx
apbrd     274 00000006  -- Check LPI rx time
apbrd     278 00000000  -- Check LPI tx
apbrd     27c 00000000  -- Check LPI tx time

