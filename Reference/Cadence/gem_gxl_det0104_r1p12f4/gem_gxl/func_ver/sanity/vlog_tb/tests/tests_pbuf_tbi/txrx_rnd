--
--   Description
----------------
--
-- Random TX and RX operating together - all RX packets accepted, to maximize
-- AHB B/W - also operating at gigabit speeds
--
--  This is a PCS loopback random soak style test
-- 
--------------------------------------------------------------------------------

check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 94;

sel_ahb_freq 2 
randomize_hready -descr_max 1 -data_max 1 

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      200 00009040  -- check reset value
apbwr      200 00004140  -- disable auto-negotiation prior to enabling PCS, set ewrap
apbwr      10 b9a00710
apbwr      28 fffffffd  -- enable all interrupts
apbwr      04 00080c1a  -- 64bit enable, gigabit mode, full duplex, copyallframes, tbi
apbrd      04 00080c1a  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 11111100  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 11111100  -- check transmit queue pointer
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbwr      18 ffff0000  -- write receive queue pointer
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx
-- delay for enable rx to propagate though design
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

-- check for link status change
apbrd(int) 24 00000200  -- check interrupt status - link status change

tx_frame  120
      number_of_bufs 1
      auto_gen_int   1
      buffer_size    64-1000
      pcs_loopback   1
      data           random
      fcs            YES

rx_frame (apb)  1
      preamble_size  7
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field random
      data_size      16 
      data           random
      auto_gen_int   0
      resource_err   0
      fcs            good

# Loopback mode
# The RX part here must equal number of tx frames - 1
# The RX DMA data will be taken from an array filled by the tx_frame command
# dest_addr is dont care
# preamble_size should be '7' to match what is generated
# data field is dont care
# data_size field is dont care
# fcs should be set to 'good'
rx_frame (gap)  119
      preamble_size  7
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field random
      data_size      16
      data           random
      auto_gen_int   0
      resource_err   0
      fcs            good


dma_rd rx_q_ptr ddddd000 

-- force end of test in case it doesn't stop of its own accord
end(300000)

