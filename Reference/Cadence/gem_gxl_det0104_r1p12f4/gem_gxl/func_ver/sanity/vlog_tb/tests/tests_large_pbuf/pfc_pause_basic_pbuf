-- # 7
-- ******************************************************************************* --
-- Receive a PFC pause frame where the destination address matches multicast address, 
-- type field = 0x8808, pause op-code = 0x0101 and priority enable to be set is 0x00FF.
-- ******************************************************************************* --
-- set retry_test bit to one
apbwrf       04 00083003 -- dsiable copy of pause frame bit(23) = 0,
                         -- reset retry test bit(12) = 1, 
                         -- enable pause time bit(13) = 0,
                         -- copy all frames bit(4) = 0
                         -- full-duplex bit(1) = 1,
                         -- 100Mbps speed bit(0) = 1

rxd(apb)     d50180C200000111112222222288080101
rxd            00ff0023002400250026002700280029
rxd            002a888899999999aaaaaaaabbbbbbbb
rxd            000000000000000000000000gggggggg


-- check the receive data as it is NOT written out on the AHB interface


apbrd(int)   24 00001000 -- check interrupt status - non-zero pause frame received
apbwr        24 00001000 -- Clear it
apbrd        38 00000000 -- check the value of the pause time register
apbrd        08 00000046 -- check pfc_negotiate = 1

-- counter has been loaded with new value 
pinsc(9174)   pfc_negotiate 1 rx_pfc_paused 11111111 
pinsc(9176)  pfc_negotiate 1 rx_pfc_paused 11111110 
pinsc(9178)  pfc_negotiate 1 rx_pfc_paused 11111100 
