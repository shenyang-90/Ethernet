--
-- The start of this test verifies that stacked vlan frames are supported by
-- the GEM (max of 2 vlan tags supported)
--
-- The 2nd half of this test is the same as vlan_rx, except that every frame 
-- has 2 VLAN tags
--
-- In terms of extracting priority in stacked vlan frames, this only occurs in
-- the 2nd tag (whch must equal the default VLAN tag - 0x8100)
--
-- This tests that a VLAN tagged frame can be received according
-- to 802.1Q and the priority is extracted from the tagged frame correctly
-- 
-- Enable receive and interrupts, write specific address, and
-- receive buffer descriptor location.
--
-- Drive data into the MII receive interface and provide
-- receive buffer pointer to the AHB interface.
--
-- Check the priority bits are set and that it flags a vlan/priority tagged
-- frame on receiving the complete frame.
-- 
-- ************************************************************************** --


pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      04 01080001  -- enable RX TCP offload engine.
apbrd      08 00000006  -- check reset value of network status register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 ffffff00  -- write address of receive buffer descriptor in memory
apbrd      A8 00000000  -- check reset value of type ID checking register
apbwr      A8 80004444  -- set to type field after VLAN for match
-- ENABLE STACKED VLAN
apbwr      c0 8000a5a5  -- Stacked VLAN Register

apbwr      00 00000004  -- enable receive
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame


