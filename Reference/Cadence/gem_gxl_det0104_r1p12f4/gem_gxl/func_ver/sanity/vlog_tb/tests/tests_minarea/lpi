-- Set wait states and hgrant delay
wait_states 1
bus_grant_delay 0



pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      00 00000002  -- enable internal loopback
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd      24 00000000  -- Check interrupt status
apbrd      30 dbfcf4b3  -- Check interrupt mask
apbwr      28 00000000  -- dont Enable any interrupts
apbwr      28 ffffffff  -- enable all interrupts
apbrd      30 00000000  -- Check interrupt mask
apbwr      28 00000000  -- dont Enable any interrupts
apbrd      30 00000000  -- Check interrupt mask not changed
apbwr      2c 00000000  -- dont disable any interrupts
apbrd      30 00000000  -- Check interrupt mask not changed

apbrd     270 00000000  perr -- Check LPI rx
apbrd     274 00000000  perr -- Check LPI rx time
apbrd     278 00000000  perr -- Check LPI tx
apbrd     27c 00000000  perr -- Check LPI tx time
apbwr      00 00080002  -- Enable LPI tx

apbrd(int) 24 08000000  -- check interrupt status - rx LPI indicate changed to high
apbrd     270 00000000  perr -- Check LPI rx - one transition to high
apbrd     274 00000000  perr -- Check LPI rx time
apbrd     278 00000000  perr -- Check LPI tx - one transition to high
apbrd     27c 00000000  perr -- Check LPI tx time - one transition to high
apbrd      08 00000086  -- check value of network status register - LPI indicate
apbrd      08 00000086  -- check value of network status register - no clear on read
apbwr      00 00000002  -- disable LPI tx

apbrd(int) 24 08000000  -- check interrupt status - LPI indicate state has changed to low
apbrd      08 00000006  -- check value of network status register - no LPI indicate
apbrd     270 00000000  perr -- Check LPI rx
apbrd     274 00000000  perr -- Check LPI rx time
apbrd     274 00000000  perr -- Check LPI rx time
apbrd     278 00000000  perr -- Check LPI tx - cleared on previous read
apbrd     27c 00000000  perr -- Check LPI tx time
apbrd     27c 00000000  perr -- Check LPI tx time - cleared on previous read
apbwr      2c 08000000  -- disable LPI interrupt
apbrd      30 08000000  -- Check interrupt mask


