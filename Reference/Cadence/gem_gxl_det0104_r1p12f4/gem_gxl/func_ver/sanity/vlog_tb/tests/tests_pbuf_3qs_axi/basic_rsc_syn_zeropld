-- Frame 3 (PAYLOAD)

dma_wr 22222148 00000000 e
dma_wr 2222214c 00000000
dma_wr 22222150 00000000
dma_wr 22222154 00000000
dma_wr 22222158 00000000
dma_wr 2222215c 00000000
dma_wr 22222160 00000000
dma_wr 22222164 00000000
dma_wr 22222168 00000000
dma_wr 2222216c 77880000 1

-- update cycle
-- ,IPv4 Total Length, then Ipv4 checksum, then TCP seq num, then TCP checksum - 
dma_wr 22222110 fadf7100 3  -- Update total length field here (37 + 36 = 73)
dma_wr 22222118 a8c0a998 3  -- Update IP checksum field here 
dma_wr 22222130 47ad0000 c  -- Update TCP checksum field here 
dma_wr 22222128 22ea0000 c  -- Update ACK_NUM 1st half here
dma_wr 2222212c 0000764d 3  -- ACK_NUM 2nd half here
dma_wr 2222212c 10000000 8  -- ACK bit

dma_wr rx_descr fffff004 0000807f 3 -- update total length (total length + eth hdr = 73 + 54 = 127)
dma_wr rx_descr fffff000 00000003 1 -- dma writes ownership bit Header
dma_wr rx_descr fffff000 00000027 1 -- dma writes ownership bit Payload

apbrd(int2) 404 00000002  -- check interrupt status - receive complete
