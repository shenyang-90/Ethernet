-- rx traffic policing registers
apbwr     b00  00000000 -- initially mode0 is disabled for queue0
apbwr     b04  00000000 -- initially mode0 is disabled for queue1
apbwr     b08  00000000 -- initially mode0 is disabled for queue2

apbrdf 20 00000000 

