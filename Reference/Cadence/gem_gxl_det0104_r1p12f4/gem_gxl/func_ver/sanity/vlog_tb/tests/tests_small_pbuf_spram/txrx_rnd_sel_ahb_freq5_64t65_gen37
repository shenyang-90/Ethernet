--
-- Description:
--
-- This test extends the txrx_rnd_all_64t65_64 test but adds a frequency
-- component on to the base test. All base tests use a frequency component
-- (sel_ahb_freq = 5) which equates to an AHB clock 1.5x faster than the MAC
-- rate. The following tests are derived from this test and use the folowing
-- frequency components:
--
--    txrx_rnd_freq5_64t65_64  (sel_ahb_freq = 5)  : AHB/AXI Clock 1.6-1.8x faster than MAC data rate
--    txrx_rnd_freq6_64t65_64  (sel_ahb_freq = 6)  : AHB/AXI Clock 2x       faster than MAC data rate
--    txrx_rnd_freq7_64t65_64  (sel_ahb_freq = 7)  : AHB/AXI Clock 2-8x     faster than MAC data rate
--
-- endDescription:
-- 
--------------------------------------------------------------------------------

randomize_hready -descr_min 0 -descr_max 0 -data_min 0 -data_max 0
sel_ahb_freq 5
set_random_seed 94608;
bus_grant_delay 0


-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 09040710
apbwr      28 00000008  -- enable tx used bit interrupt
apbwr      04 00080013
apbwr      1c 55555500  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      18 ffff0000  -- write receive queue pointer
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx

-- delay for enable rx to propagate though design
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrdf    20 00000000


rx_frame (apb)  1
      preamble_size  1-14
      auto_gen_int        0
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field random
      data_size      16 
      data           random
      fcs            good

rx_frame (gap)  500
   preamble_size  1-14
   auto_gen_int   0
   number_of_bufs 1
   dest_addr      broadcast
   src_addr       111122222222
   type_len_field random
   data_size      46-47
   data           random
   fcs            good

dma_rd rx_q_ptr ddddd000
tx_frame  94
      number_of_bufs 1
      num_dma_queues 1
      buffer_size    60-61
      data           random
      auto_gen_int   0
      fcs            no

apbrd(int) 24 00000008 -- TX used bit read interrupt
apbwrf     24 00000008 -- Clear the interrupt
apbwr      00 0000020c -- Write tx_go and enable tx and rx

tx_frame  63
      number_of_bufs 1
      num_dma_queues 1
      buffer_size    60-61
      data           random
      auto_gen_int   0
      fcs            yes

apbrd(int) 24 00000008 -- TX used bit read interrupt
apbwrf     24 00000008 -- Clear the interrupt
apbwr      00 0000020c -- Write tx_go and enable tx and rx

tx_frame  133
      number_of_bufs 1
      num_dma_queues 1
      buffer_size    60-61
      data           random
      auto_gen_int   0
      fcs            no

apbrd(int) 24 00000008 -- TX used bit read interrupt
apbwrf     24 00000008 -- Clear the interrupt
apbwr      00 0000020c -- Write tx_go and enable tx and rx

tx_frame  47
      number_of_bufs 1
      num_dma_queues 1
      buffer_size    60-61
      data           random
      auto_gen_int   0
      fcs            no

apbrd(int) 24 00000008 -- TX used bit read interrupt
apbwrf     24 00000008 -- Clear the interrupt
apbwr      00 0000020c -- Write tx_go and enable tx and rx

tx_frame  13
      number_of_bufs 1
      num_dma_queues 1
      buffer_size    60-61
      data           random
      auto_gen_int   0
      fcs            no

apbrd(int) 24 00000008 -- TX used bit read interrupt
apbwrf     24 00000008 -- Clear the interrupt
apbwr      00 0000020c -- Write tx_go and enable tx and rx

tx_frame  169
      number_of_bufs 1
      num_dma_queues 1
      buffer_size    60-61
      data           random
      auto_gen_int   0
      fcs            no




end (1048000)
