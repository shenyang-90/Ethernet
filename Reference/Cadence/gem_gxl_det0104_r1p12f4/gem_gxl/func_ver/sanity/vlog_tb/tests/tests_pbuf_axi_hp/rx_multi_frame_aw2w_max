-- receive and offload multiple frames before the B channel responds with 
-- anything ...

-- setup for a very high latency
fixed_latency_mode
set_rvalid_resp_latency -min 510 -max 511 
set_bvalid_resp_latency -min 510 -max 511 

set_random_seed 0;

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 ffff0000  -- write receive queue pointer
apbrd      18 ffff0000  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbrd      24 00000000  -- check interrupt status
apbwr      54 00000f0f  -- allow max length AXI pipelines
apbwr      10 000207c1  -- Use burst_sizes of just 1 to get func coverage up
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080001  -- indicate 100M operation, will check pin l8r.
apbrd      04 00080001  -- verify write to speed register..
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame



---------------------------------------
-- TEST 1: FRAME SIZE 64 BYTES (PADDED)
---------------------------------------

rx_frame (apb)  1
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      auto_gen_int   0
      data_size      16 
      data           random
      fcs            good


---------------------------------------------
-- TEST 2: TWO MINIMUM SIZE FRAMES (PADDED)
---------------------------------------------

rx_frame (gap)  5
      preamble_size  1-14
      dest_addr      unicast
      src_addr       111122222222
      type_len_field 3333
      auto_gen_int   0
      data_size      20-30 
      data           random
      fcs            good



-- supply last dma read
dma_rd rx_descr rx_q_ptr ddddd000 -- reads location of next rx buffer


-- check status 
apbrd(40000) 24 00000000  -- check interrupt status - receive complete
apbrd      20 00000002  -- check contents of the receive status register- frame received
apbrd      20 00000002  -- check it again
apbwr      20 0000fffd  -- don't clear it
apbrd      20 00000002  -- check it again
apbwr      20 00000002  -- clear it
apbrd      20 00000000  -- check it again
apbrd      38 00000000  -- check rx pause time

end(50000)

