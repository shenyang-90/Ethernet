--
-- Description
-- -----------
-- This tests the overflow detection of the packet buffer data area.
--
-- This test checks with a 8K RX packet buffer RAM.
--
--      RAM size   Max packets  LUT size    Data buffer size  
--        1024         16         256 bytes     768 bytes       
--        2048         32         512 bytes    1536 bytes       
--        4096         64        1024 bytes    3072 bytes       
--        8192        128        2048 bytes    6144 bytes       
-- 
-- Functional Coverage
-- -------------------
-- · Checks operation of data buffer overflow detection in the RX packet buffer
-- · Checks operation of the rx overflow interrupt
-- · Checks the discarding of frames by the packet buffer on an overflow 
--
-- Detailed Test Description
-- -------------------------
-- 1. Setup the wait states to ensure that the overflow operation can be tested.
-- 2. Initialise the GEM for gigabit receive operation into a 32 bit DMA bus.
-- 3. Enable all interrupts.
-- 4. Check overflow of data buffer using two frames.
--    Receive 2 frames which combined are bigger than the programmed data buffer
--    size. This will cause an overflow of the packet buffer.
--    Check that this causes the frame to be dropped and verify that the buffer 
--    is correctly recovered for the next frame.
--    Also check that an rx overrun interrupt is raised, a receive overrun 
--    status is reported in receive status register and that the receive 
--    overrun statistics register is incremented.
--5.  Check the status and statistics registers and ensure that the above 
--    operations were handled properly.
--------------------------------------------------------------------------------


--******************************************************************************
-- 1. Setup the wait states to ensure that the overflow operation can be tested.
--******************************************************************************
wait_states     9
bus_grant_delay 7


--******************************************************************************
-- 2. Initialise the GEM for gigabit receive operation into a 32 bit DMA bus.
-- 3. Enable all interrupts.
--******************************************************************************

apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register

-- Setup fault logging to check protocol errors
apbrd     e04 00000000  -- No faults (only looking at raw status)
apbwr     e40 00000000  -- Enable all protocol fault checks
apbrd     e44 00000000  -- No faults

apbwr      18 01234010  -- write receive queue pointer
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      98 12345678  -- specific address register 1 bottom
apbwr      9C 00001111  -- specific address register 1 top
apbwr      04 0008040a  -- full duplex, gigabit, 32 bit, jumbo frames
apbwr      00 00000004  -- enable receive
apbrd      20 00000000  -- check contents of the receive status register 

-- Setup RX packet buffer RAM and an AHB burst length
apbwr      10 00020301  -- 8K RX and 1-beat AHB burst


--******************************************************************************
-- 4. Check overflow of data buffer using two frames.
--    Receive 2 frames which combined are bigger than the programmed data buffer
--    size. This will cause an overflow of the packet buffer.
--    Check that this causes the frame to be dropped and verify that the buffer 
--    is correctly recovered for the next frame.
--    Also check that an rx overrun interrupt is raised, a receive overrun 
--    status is reported in receive status register and that the receive 
--    overrun statistics register is incremented.
--******************************************************************************

apbrdf     20 00000000  "Scenario 3: RX data buffer overflow with two frames"
                        -- check contents of the receive status register 
                        -- and trigger reception of frame

-- supply the receive buffer location
dma_rd 01234010 22222200 -- dma reads pointer of 22222200

