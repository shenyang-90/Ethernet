pinsd(200) tx_pause      1  -- toggle tx_pause to start PFC pause frame
pinsd(220) tx_pause_zero 1  -- drive tx_pause_zero high
pinsd(222) tx_pfc_sel    0  -- drive tx_pfc_sel low
pinsd(224) tx_pause      0  -- toggle tx_pause to start zero pause frame
pinsd(226) tx_pause_zero 0  -- drive tx_pause_zero low
pinsd(300) tx_pause      1  -- toggle tx_pause to start non zero pause frame


