apbrd           24 00000000  -- check interrupt status
apbwr           04 00080009  -- indicate 100M operation, will check pin l8r
                             -- jumbo frames enabled
apbrd           20 00000000  -- check contents of the receive status register 
apbwr           10 00020004  -- Allow rx packets of up to 1k

