apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080c10  -- indicate gigabit TBI operation and 64 bit transfers
apbrd      04 00080c10  -- check new value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 c7bafd6c  -- write receive queue pointer
apbrd      18 c7bafd6c  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      20 00000000  -- delay trigger reception of frame
apbrdf     20 00000000  -- delay trigger reception of frame

-- check for link status change
apbrd(int) 24 00000200  -- check interrupt status - link status change



