--
--   Description
----------------
--
-- This checks that an XON pause frame is sent when the receive SRAM fill level 
-- exceeds the non-zero high water mark level and an XOFF pause frame is sent when
-- the fill level falls below the low (non-zero) water mark level
--
--
-- Detailed Test Description
----------------------------
--
-- Set the receive water mark register to non zero values and then receive a frame to
-- make the SRAM fill level go up and down and see the XON and XOFF pause frames transmitted
--
-- Then increase the value of the high water mark level and show that no pause frame are
-- transmitted
--
-- Then receive a much longer frame to show a higher water mark in operation and with
-- the low fill thresh-hold higher than high threshold
--
--------------------------------------------------------------------------------

--wait_states 9 -- delay the completion of receive to give the XON pause frame time to get out
bus_grant_delay 0

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffffff0  -- write receive queue pointer
apbrd      18 fffffff0  -- check receive queue pointer
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080403  -- indicate full duplex gigabit operation, will check pin l8r.
apbrd      04 00080403  -- verify write to speed register..
apbwr      00 0000000c  -- enable receive and transmit
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      7c 00000000  -- check reset value of receive water mark register
apbwr      7c 0002000a  -- write A to the high water mark field and 2 to the low water mark in the receive water mark register
apbrd      08 00000006  -- check reset value of network status register
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame


-- drive the receive frame data into the MII interface
rxd(apb)   55d578563412111111112222222233333333
rxd            44444444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            0000000000000000000000002638309b


-- supply the receive buffer location
dma_rd fffffff0 22222004 -- dma reads pointer of 22222004


-- get the XON pause frame as the receive fill level has exceeded A
txd  55555555555555d50180C200000178563412111188080001
txd                  ffff0000000000000000000000000000
txd                  00000000000000000000000000000000
txd                  000000000000000000000000e66784ed

apbrd(int) 24 00004000  -- check interrupt status - pause frame transmitted
apbwr      24 00004000  -- clear interrupt status

-- check the receive data as it is written out on the AHB interface
dma_wr 22222004 12345678 -- store frame to memory
dma_wr 22222008 11111111
dma_wr 2222200c 22222222
dma_wr 22222010 33333333
dma_wr 22222014 44444444
dma_wr 22222018 55555555
dma_wr 2222201c 66666666
