dma_wr 22222038 00000000
dma_wr 2222203c 00000000
dma_wr 22222040 9b303826

dma_wr fffffff4 0800c040 -- dma writes rx status, local address match and 64 bytes received
dma_wr fffffff0 22222005 -- dma writes ownership bit

dma_rd fffffff8 22222004 -- reads locations of next rx buffer

apbrd(int) 24 00000002  -- check interrupt status - receive complete
apbwr      24 00000002  -- clear interrupt status

-- get the XOFF pause frame as the receive fill level is below 2
txd  55555555555555d50180C200000178563412111188080001
txd                  00000000000000000000000000000000
txd                  00000000000000000000000000000000
txd                  000000000000000000000000620c8b94


-- check status on reception of receive complete interrupt
apbrd(int) 24 00004000  -- check interrupt status - pause frame transmitted
apbwr      24 00004000  -- clear interrupt status
apbwr      7c 0002002a  -- write 2a to the high water mark field to show that this time no pause frame are transmitted
apbrd      08 00000006  -- check reset value of network status register
apbrdf     20 00000002  -- check contents of the receive status register and trigger reception of frame


