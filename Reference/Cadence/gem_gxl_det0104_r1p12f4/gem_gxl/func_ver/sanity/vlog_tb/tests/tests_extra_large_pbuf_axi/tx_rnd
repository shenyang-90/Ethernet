--
--   Description
----------------
--
-- Simple tx test for the extra large pbuf configuration. The AMBA frequency is
-- set high to allow the AMBA interface to burst as much data as possible into
-- the packet buffer.
-- 
-- 
--------------------------------------------------------------------------------

-- need fast bus response for 25MHz Hclk
wait_states 0
bus_grant_delay 0
set_random_seed 1;
sel_ahb_freq 4

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 0000ffff  -- enable all interrupts
apbwr      04 00080000  -- 
apbrd      08 00000006  -- check reset value of network status register
apbrd      10 000207c4  -- 
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx and rx

-- The packet buffer is 128k and the following frame count equests to 180k
tx_frame 180
      number_of_bufs 1
      buffer_size    1000-1048
      data           random
      fcs            YES

-- force end of test in case it doesn't stop of its own accord
end(900000)

