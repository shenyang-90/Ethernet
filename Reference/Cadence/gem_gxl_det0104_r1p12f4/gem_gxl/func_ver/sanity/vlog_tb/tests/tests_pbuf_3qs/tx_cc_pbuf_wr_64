--
-- Test Description
-- The purpose of this test is to reach a few state transitions that are
-- missing on other tests and collect a 100% block coverage figure
-- 

wait_states 0
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbwr      440 88000000  -- write transmit queue pointer 1
apbwr      444 99000000  -- write transmit queue pointer 2
apbwr      04 00280000  -- check reset value of network config register
apbrd      04 00280000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx




-- ********************************************************************
-- Test 1
-- perform a dual writeback after an AHB error in the descriptor read state
-- ********************************************************************
dma_rd 99000000 99990000 -- dma reads pointer for Queue 2
dma_rd 99000004 99990000 -- dma reads pointer for Queue 2
dma_rd 88000000 88880000 -- dma reads pointer for Queue 1
dma_rd 88000004 88880000 -- dma reads pointer for Queue 1
dma_rd 55555500 98765000 -- dma reads pointer of 98765000
dma_rd 55555504 0000803e -- start of frame, length 62 bytes


-- supply the transmit data to the AHB interface
dma_rd 98765000 00000001
dma_rd 98765004 00001001
dma_rd 98765008 00002001
dma_rd 9876500c 00003001
dma_rd 98765010 00004001
dma_rd 98765014 00005001
dma_rd 98765018 00006001
dma_rd 9876501c 00007001
dma_rd 98765020 00008001
dma_rd 98765024 00009001
dma_rd 98765028 0000a001
dma_rd 9876502c 0000b001
dma_rd 98765030 0000c001
dma_rd 98765034 0000d001
dma_rd 98765038 0000e001
dma_rd 9876503c 0000f001

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d50100000001100000012000000130000001
txd		       4000000150000001600000017000000180000001
txd		       90000001a0000001b0000001c0000001d0000001
txd		       e0000001f0e2276630



dma_wr 55555504 8000803e -- write used bit
dma_rd 99000000 99990000 -- dma reads pointer for Queue 2
dma_rd 99000004 99990000 -- dma reads pointer for Queue 2
dma_rd 88000000 88880000 -- dma reads pointer for Queue 1
dma_rd 88000004 88880000 -- dma reads pointer for Queue 1
dma_rd 55555508 98765000 not_ok -- hresp error occurred  
dma_rd 5555550c 0000803e


-- write transmit complete status
dma_wr 5555550c 9000803e -- write used bit

apbrd(int)  24 000008c0  -- check interrupt status - transmit complete
apbwr       24 000008c0  -- check interrupt status - transmit complete

apbrd	      14 00000130  -- tx status - frame transmitted, used bit set

-- ********************************************************************
-- Test 2
-- perform a dual writeback after an AHB error in the descriptor read state
-- The AHB error is on a descriptor read on a buffer mid-way through the pkt
-- ********************************************************************
apbwr       00 00000208  -- write tx_go and enable tx
dma_rd 99000000 99990000 -- dma reads pointer for Queue 2
dma_rd 99000004 99990000 -- dma reads pointer for Queue 2
dma_rd 88000000 88880000 -- dma reads pointer for Queue 1
dma_rd 88000004 88880000 -- dma reads pointer for Queue 1
dma_rd 55555508 98765000 -- dma reads pointer of 98765000
dma_rd 5555550c 0000803e -- start of frame, length 62 bytes


-- supply the transmit data to the AHB interface
dma_rd 98765000 00000001
dma_rd 98765004 00001001
dma_rd 98765008 00002001
dma_rd 9876500c 00003001
dma_rd 98765010 00004001
dma_rd 98765014 00005001
dma_rd 98765018 00006001
dma_rd 9876501c 00007001
dma_rd 98765020 00008001
dma_rd 98765024 00009001
dma_rd 98765028 0000a001
dma_rd 9876502c 0000b001
dma_rd 98765030 0000c001
dma_rd 98765034 0000d001
dma_rd 98765038 0000e001
dma_rd 9876503c 0000f001

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d50100000001100000012000000130000001
txd		       4000000150000001600000017000000180000001
txd		       90000001a0000001b0000001c0000001d0000001
txd		       e0000001f0e2276630



dma_rd 99000000 99990000 -- dma reads pointer for Queue 2
dma_rd 99000004 99990000 -- dma reads pointer for Queue 2
dma_rd 88000000 88880000 -- dma reads pointer for Queue 1
dma_rd 88000004 88880000 -- dma reads pointer for Queue 1
dma_rd 55555510 98765000  
dma_rd 55555514 00000001  -- 1 byte mbf
dma_rd 98765000 00000001
dma_rd 98765004 00000000

dma_rd 55555518 98765000 not_ok -- hresp error occurred 
dma_rd 5555551c 00008001


-- write transmit complete status
dma_wr 5555550c 8000803e  -- write used bit
dma_wr 55555514 90000001 -- write used bit

apbrd(int)  24 000008c0  -- check interrupt status - transmit complete
apbwr       24 000008c0  -- check interrupt status - transmit complete

apbrd	      14 00000130  -- tx status - frame transmitted, used bit set

-- force end of test in case it doesn't stop of its own accord
end(15000)

