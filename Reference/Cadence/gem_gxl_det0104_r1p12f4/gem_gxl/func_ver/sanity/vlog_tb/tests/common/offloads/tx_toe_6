--   Description
----------------
--
-- This test verifies the tcp protocol can pause while processing multi-buffer
-- frames
--
--
--------------------------------------------------------------------------------

-- Configuration Requirements ..
requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1

sel_ahb_freq 1 -- define host frequency. Dont care for this test

-- The following ensures that whatever datawidth is selected for this test, the 
-- translator will pass through correct multiples of 32bit words for data transfers
-- (not descriptors). This relies on the test writer using the rx_descr and tx_descr to
-- differentiate between the DMA accesses.
enforce_data_width 1

-- In 32b datapaths, the 64bit descriptors are accessed not in incrementing order
-- The used bit is always read first, and written last.
-- For TX since the used bit is bit 63, the 2nd 32bit word is always read first
-- For RX since the used bit is bit 0, the 2nd 32bit word is always written first
-- This ordering is only there for 32bit modes
-- To simplify writing testcases and ensure the same test can operate on different datawidths
-- we can automatically reverse the order ...
auto_descriptor_swap 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbwr      28 ffffffff  -- enable all interrupts
apbwr     5a0 00000007  -- give all segments to Q0
apbrd      08 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
init_ncr -duplex full -speed 100m -jumbo 0 -databus random -copy_all 1 -eam random -rx_toe 0

-- # Initialize the transmit and receive DMA queue pointers (random values but can add specifics if required)
-- # use arg -rx_ptr_q<Q> and tx_ptr_q<Q> to set specific ptr values rather than the default random
init_q_ptr  -num_tx_queues 1   -num_rx_queues 1 -rx_ptr_q0 fffff000 -tx_ptr_q0 55555500


-- # initialize the DMA specific options for random data xfers
-- #   - RX DMA data buffer size
-- #     If left without an argument, it will be completely random
-- #     Set high to force single buffer descriptor testing eg 16320
-- #     use -max_buf_size for max (multiple 64 bytes only)
-- #     use -min_buf_size for min (multiple 64 bytes only)
-- #
-- #   - Burst Length (random by default)
-- #     use -burst <num>, where num can be 1,2,4,8,16, random
-- #        
-- #   - address bus (random by default, or off if config doesnt allow)
-- #     use -addr_bus <32|64|random|take_from_cfg>     
-- #        
-- #   - extended buffer descriptors (random by default, or off if config doesnt allow)
-- #     use -ext_bd <1|0|random>     
-- #        
-- #   - force max burst mode (forces AXI to send max length bursts)
-- #     use -force_max_burst_<tx|rx> <1|0|random>    default is 0 
-- #   - tx_csum_offload (sets TX checksum offload)
-- #     use -tx_csum_offload <1|0|random>    default is 0 
init_dma -ext_bd 0 -addr_bus 32  -burst random -min_buf_size 16320 -tx_csum_offload 1

apbwr      00 00000208  -- write tx_go and enable tx


--******************************************************************************
-- Test 2.1
--    Broadcast frame, Valid TCP, even length, no IP options, no VLAN, no SNAP
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and no SNAP (bit 24 low).
-- Send as a multi-buffer frame
-- Full frame is 60 bytes long
--******************************************************************************

dma_rd tx_descr 55555500 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555504 00000003 -- start of frame, 1st buffer

dma_rd 98765000 00FFFFFF

dma_rd tx_descr 55555508 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 5555550c 00000001

dma_rd 98765000 000000FF

dma_rd tx_descr 55555510 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555514 00000004

dma_rd 98765000 0008FFFF

dma_rd tx_descr 55555518 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 5555551c 00000006

dma_rd 98765000 56341239
dma_rd 98765004 00000008

dma_rd tx_descr 55555520 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555524 00000003

dma_rd 98765000 00000045

dma_rd tx_descr 55555528 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 5555552c 00000008

dma_rd 98765000 40FADF28
dma_rd 98765004 FF068000 -- Half of IP Checksum placed here

dma_rd tx_descr 55555530 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555534 00000009

dma_rd 98765000 00A8C0FF -- OtherHalf of IP Checksum placed here
dma_rd 98765004 00A8C001
dma_rd 98765008 00000091

dma_rd tx_descr 55555538 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 5555553c 00000002

dma_rd 98765000 00001500 

dma_rd tx_descr 55555540 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555544 00000005

dma_rd 98765000 BB3D8A04 
dma_rd 98765004 0000005C 

dma_rd tx_descr 55555548 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 5555554c 0000000a

dma_rd 98765000 4D22EA60
dma_rd 98765004 44105076
dma_rd 98765008 0000FF28 -- half of TCP Checksum placed here

dma_rd tx_descr 55555550 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555554 00000000


dma_rd tx_descr 55555558 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 5555555c 00000007

dma_rd 98765000 AC0000FF -- half of TCP Checksum placed here
dma_rd 98765004 00DBDBAC -- half of TCP Checksum placed here

dma_rd tx_descr 55555560 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555564 00008002

dma_rd 98765000 0000B0B0

dma_rd tx_descr 55555568 98765000 
dma_rd tx_descr 5555556c 80008001 -- read used bit



txd         55555555555555d5 -- preamble & SDF
txd         FFFFFFFFFFFF -- MAC DA
txd         080039123456 -- MAC SA
txd         0800         -- Length/typeID
txd         4500         -- Version, IHL, type of service
txd         0028         -- total length
txd         DFFA         -- ID
txd         4000         -- flags & fragmentation
txd         8006         -- time to live and protocol
txd         98F2         -- IP Header checksum
txd         C0A80001     -- IP SA
txd         C0A80091     -- IP DA
txd         0015         -- TCP source port
txd         048A         -- TCP destination port
txd         3DBB5C60     -- Sequence number
txd         EA224D76     -- Acknowledgement Number
txd         50104428     -- Flags and window
txd         1376         -- TCP checksum
txd         0000         -- TCP urgent pointer
txd         ACACDBDBB0B0 -- options or padding
txd         589E112F     -- FCS


-- write transmit complete status for the oldest frame 1
dma_wr tx_descr 55555504 80000003 -- write used bit -- TCP status is okay

apbrd(int)  24 00000088  -- check interrupt status - transmit complete
apbwr       24 00000088  -- check interrupt status - transmit complete

apbrd	      14 00000021  -- tx status - frame transmitted,







-- force end of test in case it doesn't stop of its own accord
end(100000)
bus_grant_delay 0
