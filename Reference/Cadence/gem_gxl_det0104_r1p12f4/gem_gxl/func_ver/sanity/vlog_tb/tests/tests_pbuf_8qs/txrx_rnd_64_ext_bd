wait_states 0
check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 0;
tog_cnt_en 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- setup 64b addressing, tx_ext_bd and rx_ext_bd in ms nibble of dma config register (address 10)
-- ms nibble = 
-- 7 for 64b addressing enabled and tx and rx ext_bd enabled 
-- 4 for 64b addressing enabled
-- 3 for tx and rx ext_bd enabled
--            |
--            |
apbwr      10 39040710
apbwr     4cc 00000034  -- tx_bd_control_reg  -- tx_bd_control_reg  where last 6 bits are: ts_mode, bd_size_words
apbwr     4d0 00000034  -- rx_bd_control_reg  -- rx_bd_control_reg  where last 6 bits are: ts_mode, bd_size_words

apbwr      28 00000007  -- enable all interrupts
apbwr      04 01280402  -- 64bit enable, gigabit mode, full duplex
apbrd      04 01280402  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 11111100  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 11111100  -- check transmit queue pointer
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbwr      18 ffff0000  -- write receive queue pointer
--apbwr     320 0000007f  -- threshold
apbwr      440 88000000 -- write transmit queue pointer 1
apbwr      444 99000000 -- write transmit queue pointer 2
apbwr      448 91000000 -- write transmit queue pointer 3
apbwr      44c 92000000 -- write transmit queue pointer 4
apbwr      450 93000000 -- write transmit queue pointer 5
apbwr      454 94000000 -- write transmit queue pointer 6
apbwr      458 95000000 -- write transmit queue pointer 7
apbwr      480 f0010000 -- write receive queue pointer 1
apbwr      484 f0020000 -- write receive queue pointer 2
apbwr      488 f1020000 -- write receive queue pointer 3
apbwr      48c f2020000 -- write receive queue pointer 4
apbwr      490 f3020000 -- write receive queue pointer 5
apbwr      494 f4020000 -- write receive queue pointer 6
apbwr      498 f5020000 -- write receive queue pointer 7
apbwr      4a0 00000001 -- Buffer size Q1
apbwr      4a4 00000001 -- Buffer size Q2
apbwr      4a8 00000001 -- Buffer size Q3
apbwr      4ac 00000001 -- Buffer size Q4
apbwr      4b0 00000001 -- Buffer size Q5
apbwr      4b4 00000001 -- Buffer size Q6
apbwr      4b8 00000001 -- Buffer size Q7
apbwr      500 10000aa0 -- Screener 1
apbwr      504 10000bb1 -- Screener 2 
apbwr      508 10004cc2 -- Screener 3
apbwr      50c 10004dd3 -- Screener 4
apbwr      510 10004ee4 -- Screener 5
apbwr      514 10004ff5 -- Screener 6
apbwr      518 10004116 -- Screener 7
apbwr      51c 10004227 -- Screener 8
apbwr      520 10004330 -- Screener 9
apbwr      524 10004441 -- Screener 10
apbwr      528 10004552 -- Screener 11
apbwr      52c 10004663 -- Screener 12
apbwr      530 10004774 -- Screener 13
apbwr      534 10004885 -- Screener 14
apbwr      538 10004996 -- Screener 15
apbwr      53c 10004af7 -- Screener 16
apbwr      600 00000c06 -- enable q1 interrupts
apbwr      604 00000c06 -- enable q2 interrupts
apbwr      608 00000c06 -- enable q3 interrupts
apbwr      60c 00000c06 -- enable q4 interrupts
apbwr      610 00000c06 -- enable q5 interrupts
apbwr      614 00000c06 -- enable q6 interrupts
apbwr      618 00000c06 -- enable q7 interrupts
apbwr      61c 00000c06 -- enable q8 interrupts
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx
-- delay for enable rx to propagate though design
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

rx_frame (apb)  1
      preamble_size  1-14
      auto_gen_int        1
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field random
      data_size      16 
      data           random
      num_dma_queues      8
      ipv4_en             1
        num_ipv4_options  random
        ipv4_tos          aa
        ipv4_tos          bb
        ipv4_tos          cc
        ipv4_tos          dd
        ipv4_tos          ee
        ipv4_tos          ff
        ipv4_tos          11
        ipv4_tos          22
        ipv4_tos          33
        ipv4_tos          44
        ipv4_tos          55
        ipv4_tos          66
        ipv4_tos          77
        ipv4_tos          88
        ipv4_tos          99
        ipv4_tos          af
      fcs            good

rx_frame (gap)  300
      preamble_size  1-14
      auto_gen_int        1
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field random
      data_size      128-512 
      data           random
      num_dma_queues      8
      ipv4_en             1
        num_ipv4_options  random
        ipv4_tos          aa
        ipv4_tos          bb
        ipv4_tos          cc
        ipv4_tos          dd
        ipv4_tos          ee
        ipv4_tos          ff
        ipv4_tos          11
        ipv4_tos          22
        ipv4_tos          33
        ipv4_tos          44
        ipv4_tos          55
        ipv4_tos          66
        ipv4_tos          77
        ipv4_tos          88
        ipv4_tos          99
        ipv4_tos          af
      fcs            good

tx_frame  200
      number_of_bufs 2
      auto_gen_int   0
      buffer_size    64-256
      data           random
      num_dma_queues      8
      fcs            YES



-- force end of test in case it doesn't stop of its own accord
end(300000)

