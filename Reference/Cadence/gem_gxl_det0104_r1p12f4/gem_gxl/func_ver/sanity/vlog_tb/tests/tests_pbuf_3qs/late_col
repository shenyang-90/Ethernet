--------------------------------------------------------------------------------
--   Test Description
--   
--   This test checks the GEM late collisions threshold in 100M mode.
--   
--   Functional Coverage
--   * Tests the late collisions in 100M mode.
--   
--   Detailed Test Description
--   
--   1. Initialise the GEM for 100M mode operation.
--   2. Generate a TX frame and collide just before the late collision 
--      threshold, check that the GEM retries the frame successfully and reports
--      the frame as an early collision.
--   3. Generate a TX frame and collide just after the late collision 
--      threshold, check that the GEM retries the frame successfully and reports
--      the frame as an late collision.
--   4. check the statistic registers for correct operation.
--
-------------------------------------------------------------------------------


wait_states 1      

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- ************************************************************************** --
--   1. Initialise the GEM for 100M mode operation.
-- ************************************************************************** --
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbwr      440 88000000  -- write transmit queue pointer 1
apbwr      444 99000000  -- write transmit queue pointer 2
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      04 00081000  -- enable retry test (bit 12)
apbwr      00 00000008  -- enable transmit
apbrd      14 00000000  -- read transmit status register
apbwr      1c ffffff00  -- write address of transmit buffer descriptor in memory
apbrd      1c ffffff00  -- check transmit queue pointer
apbwr      00 00000208  -- write transmit start bit and enable tx



-- DMA will now read in frame 1
-- With TX packet buffer included all of frame is read in once and retried
-- from the packet buffer.
dma_rd 99000004 99990000 -- dma reads pointer for Queue 2
dma_rd 99000000 99990000 -- dma reads pointer for Queue 2
dma_rd 88000004 88880000 -- dma reads pointer for Queue 1
dma_rd 88000000 88880000 -- dma reads pointer for Queue 1
dma_rd ffffff04 00008030 -- reads tx control of eof and length of 48 bytes
dma_rd ffffff00 98765000 -- dma reads pointer of 98765000
dma_rd 98765000 12345678 -- reread transmit data because of collision
dma_rd 98765004 11111111
dma_rd 98765008 22222222
dma_rd 9876500c 33333333
dma_rd 98765010 44444444
dma_rd 98765014 55555555
dma_rd 98765018 66666666
dma_rd 9876501c 77777777
dma_rd 98765020 88888888
dma_rd 98765024 99999999
dma_rd 98765028 aaaaaaaa
dma_rd 9876502c bbbbbbbb

-- DMA will now move onto reading frame 2.
-- With TX packet buffer included all of frame is read in once and retried
-- from the packet buffer.
dma_rd 99000004 99990000 -- dma reads pointer for Queue 2
dma_rd 99000000 99990000 -- dma reads pointer for Queue 2
dma_rd 88000004 88880000 -- dma reads pointer for Queue 1
dma_rd 88000000 88880000 -- dma reads pointer for Queue 1
dma_rd ffffff0c 00008030 -- reads tx control of eof and length of 48 bytes
dma_rd ffffff08 98765100 -- dma reads pointer of 98765000
dma_rd 98765100 12345678
dma_rd 98765104 11111111
dma_rd 98765108 22222222
dma_rd 9876510c 33333333
dma_rd 98765110 44444444
dma_rd 98765114 55555555
dma_rd 98765118 66666666
dma_rd 9876511c 77777777
dma_rd 98765120 88888888
dma_rd 98765124 99999999
dma_rd 98765128 aaaaaaaa
dma_rd 9876512c bbbbbbbb

-- DMA will now move onto reading frame 3 (used)
dma_rd 99000004 99990000 -- dma reads pointer for Queue 2
dma_rd 99000000 99990000 -- dma reads pointer for Queue 2
dma_rd 88000004 88880000 -- dma reads pointer for Queue 1
dma_rd 88000000 88880000 -- dma reads pointer for Queue 1
dma_rd ffffff14 80000000 -- used
dma_rd ffffff10 00000000


-- ************************************************************************** --
--   2. Generate a TX frame and collide just before the late collision 
--      threshold, check that the GEM retries the frame successfully and reports
--      the frame as an early collision.
-- ************************************************************************** --

apbwr      00 00000208  -- write transmit start bit and enable tx

-- Test late collision threshold. First a collision that happens on the 64th
-- byte from beginning of preamble (should be an early collision)
txd        55555555555555d578563412111111112222222233333333
txd                        44444444555555556666666677777777
txd                        8888888899999999aaaaaaaabbbbbbbb
txd                        00000000000000x0000
txd                        88888888 -- JAM


-- Second attempt - successful
txd        55555555555555d578563412111111112222222233333333
txd                        44444444555555556666666677777777
txd                        8888888899999999aaaaaaaabbbbbbbb
txd                        0000000000000000000000002638309b

-- write used bit
dma_wr ffffff04 80008030



apbrd(int) 24 00000080  -- check interrupt status - transmit complete
apbwr      24 00000080  -- clear interrupt status
apbrd      14 0000002a  -- transmit status - frame transmitted , tx_go and collision
apbwr      14 00000022  -- clear transmit status



-- ************************************************************************** --
--   3. Generate a TX frame and collide just after the late collision 
--      threshold, check that the GEM retries the frame successfully and reports
--      the frame as an late collision.
-- ************************************************************************** --


-- Test late collision threshold. Now a collision that happens on the 65th
-- byte from beginning of preamble (should be an late collision)
txd        55555555555555d578563412111111112222222233333333
txd                        44444444555555556666666677777777
txd                        8888888899999999aaaaaaaabbbbbbbb
txd                        0000000000000000x0000
txd                        00000000 -- JAM


-- finally complete frame with no collisions
txd        55555555555555d578563412111111112222222233333333
txd                        44444444555555556666666677777777
txd                        8888888899999999aaaaaaaabbbbbbbb
txd                        0000000000000000000000002638309b

-- write used bit
dma_wr ffffff0c 80008030

apbrd(int) 24 00000088  -- check interrupt status - transmit complete & used
apbwr      24 00000088  -- clear interrupt status
apbrd      14 00000023  -- transmit status - frame transmitted , collision & used
apbwr      14 00000023  -- clear transmit status




-- ************************************************************************** --
--   4. check the statistic registers for correct operation.
-- ************************************************************************** --

-- check transmit statistics
apbrd     100 00000080  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000002  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000002  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000002  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000001  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors



end(5000)


bus_grant_delay 0
