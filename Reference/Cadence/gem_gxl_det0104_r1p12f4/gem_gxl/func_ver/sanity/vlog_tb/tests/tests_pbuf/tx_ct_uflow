--
--   Description
----------------
--
-- tests the underflow operation of the GEM PBUF DMA, when cut thru is enabled
-- We want to ensure the GEM does not lock up in any
-- way, the appropriate interrupt is set, and the DPRAM fill level is 
-- calculated appropriately (the right number of words are released)
-- Note that the DMA writeback does NOT occur when an interrupt occurs, so the
-- system does need to rely on interrupts to identify this.
-- 
-- the underflow occurs when the AHB cannot keep up with the MAC
-- In this test, the MAC is running at 100Meg mode.
-- Set the AHB wait_states to 9 to really slow it down ...
--------------------------------------------------------------------------------
wait_states 9
pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- Setup fault logging to check protocol errors
apbrd     e04 00000000  -- No faults (only looking at raw status)
apbwr     e40 00000000  -- Enable all protocol fault checks
apbrd     e44 00000000  -- No faults

apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080002  -- set to full duplex mode
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      40 80000030  -- enable tx cut thru with threshold = 0x30, or 48
apbwr      00 00000208  -- write tx_go and enable tx
#apbwr      00 00000408  -- write tx halt immediately keeping tx enabled
#                        -- this stops fetch of second frame


dma_rd 55555504 0000a710 -- start of frame, 10KByte frame
dma_rd 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
-- 10KByte = 2500 32 bit words, so should repeat the following line 2499 times
-- However, due to underflow, the full packet will not be read in ...
dma_rd(195) 98765000 67452301

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d5
txd    
txd    zzzzzzzz -- The MAC will purposely insert rubbish here

-- txd cut short due to underflow ....


-- No writeback due to underflow event
-- dma_wr 55555504 c000a710 -- write used bit

apbrd(int)  24 00000010  -- check interrupt status - Underflow event detected ...
apbwr       24 00000010  -- write to clear
apbrd       24 00000000  
apbrd       24 00000000  
apbrd	      14 00000040  -- tx status - underrun
apbwr	      14 00000040  -- Clear it


-- The underflow causes the packet buffer TX DMA to halt, so we need to
-- restart it
-- This time disable cut thru, and make sure the next packet gets errored 
-- as a result of the packet being too big for the packet buffer
apbwr      40 00000030  -- disable tx cut thru
apbwr      00 00000208  -- write tx_go and enable tx


dma_rd 55555504 0000a710 -- start of frame, 10KByte frame
dma_rd 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
-- 10KByte = 2500 32 bit words, so should repeat the following line 2499 times
-- However, size of PBUf is only 4KB, so will only write in enough to fill PBUF
dma_rd(1015) 98765000 67452301

-- No txd because of PBUF overflow

-- write transmit complete status for the oldest frame 1
dma_wr 55555504 8800a710 -- PBUF overflow (exhausted mid frame)

apbrd(int)  24 00000048  -- check interrupt status - transmit complete
apbwr       24 00000048  -- write to clear
apbrd	      14 00000011  -- tx status - error
apbwr	      14 00000011  -- Clear it

-- The overflow causes the packet buffer TX DMA to halt, so we need to
-- restart it
apbwr      00 00000208  -- write tx_go and enable tx

-- This time make sure the smaller 2KByte packet gets through 
-- Note the descriptor pointer has rewound back to the packet that caused a problem ...
dma_rd 55555504 000087d0 -- start of frame, 2KByte frame
dma_rd 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
-- 2KByte = 500 32 bit words, so should repeat the following line 499 times
dma_rd(499) 98765000 67452301

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d5
txd    
txd    
txd    zzzzzzzz


-- write transmit complete status for the oldest frame 1
dma_wr 55555504 800087d0 -- write used bit



apbrd(int)  24 00000088  -- check interrupt status - transmit complete
apbwr       24 00000088  -- write to clear
apbrd	      14 00000021  -- tx status - frame transmitted, tx go
apbwr	      14 00000021  -- Clear it



dma_rd 5555550c 8000803e -- start of frame, length 62 bytes
dma_rd 55555508 98765000 -- dma reads pointer of 98765000



-- check transmit statistics
apbrd     100 000007d4  -- check octets transmitted bottom (2KBytes + CRC)
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000001  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000001  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000001  -- check frames transmitted 1519
apbrd     134 00000001  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000000  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors

-- Check fault logging status
apbrd     e44 00030000  -- TX underflow and buffers exhausted errors were seen
apbrd     e00 00000000  -- Interrupts masked
apbrd     e04 00000020  -- Protocol fault in raw status
apbwr     e44 00030000  -- Clear fault
apbrd     e44 00000000  -- Check cleared
apbrd     e04 00000020  -- Raw interrupt still set
apbwr     e00 00000020  -- Write to clear, using non raw version here
apbrd     e00 00000000  -- No interrupts
apbrd     e04 00000000  -- No interrupts


-- force end of test in case it doesn't stop of its own accord
end(50000)

