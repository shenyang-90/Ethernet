txd    55555555555555d5   -- preamble
txd    111111111111       -- ethernet header - destination address
txd    222222222222       -- ethernet header - source address
txd    81000000           -- ethernet header - vlan
txd    86dd               -- ethernet header - ethertype

txd    60                 -- IPv6 header - version, traffic class 
txd    00                 -- IPv6 header - traffic class, flow label
txd    0000               -- IPv6 header - flow label
txd    004c               -- IPv6 header - payload length - 68 bytes - 2 x IPv6 extension + TCP header + 40 payload
txd    00                 -- IPv6 header - next header - non-TCP
txd    00                 -- IPv6 header - hop limit
txd    11111111           -- IPv6 header - source address
txd    11111111           -- IPv6 header - source address
txd    11111111           -- IPv6 header - source address
txd    11111111           -- IPv6 header - source address
txd    22222222           -- IPv6 header - destination address
txd    22222222           -- IPv6 header - destination address
txd    22222222           -- IPv6 header - destination address
txd    22222222           -- IPv6 header - destination address

txd    00                 -- IPv6 ext header - next header = 00 = non-TCP
txd    00                 -- IPv6 ext header - extension header length = 00 = 8 octets
txd    cccccccccccc       -- IPv6 ext header

txd    06                 -- IPv6 ext header - next header = 06 = TCP
txd    00                 -- IPv6 ext header - extension header length = 00 = 8 octets
txd    dddddddddddd       -- IPv6 ext header

txd    3333               -- TCP header  - Source Port
txd    4444               -- TCP header  - Destination Port
txd    123456aa           -- TCP header  - Sequence Number
txd    55555555           -- TCP header  - Acknowledgement Number
txd    0000               -- TCP header  - Data Offset, Flags
txd    0000               -- TCP header  - Window Size
txd    3079               -- TCP header  - Checksum
