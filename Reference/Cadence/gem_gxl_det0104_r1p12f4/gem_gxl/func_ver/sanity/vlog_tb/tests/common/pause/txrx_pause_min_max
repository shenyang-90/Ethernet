-- Test Description
-- This test ensures the GEM deals with runt pause frames and jumbo pause frames properly.
-- 
-- Test Coverage
-- · Ensures that the GEM will ignore pause frames that are less than 64 bytes in length.
-- · Ensures that the GEM will accept pause frames that are greater than 64 bytes in length.
--
-- Detailed Test Description
-- 1. Initialise the GEM for 100-mode operation.
-- 2. Enable receive.
-- 3. Enable reception of pause frames.
-- 4. Receive a pause frame that is only 63 bytes, the destination address 
--    matches pause frame address 0x0180C2000001, type field = 0x8808, 
--    pause op-code = 0x0001 and pause time to be set is 0x00FF.  
--    Then, transmit a frame. The GEM should ignore the pause frame 
--    and just transmit the frame.
-- 5. Receive a pause frame that is 65 bytes (greater than minimum frame size),
--    the destination address matches pause frame address 0x0180C2000001, 
--    type field = 0x8808, pause op-code = 0x0001 and pause time to be set 
--    is 0x00FF.  Then, transmit a frame. The GEM should accept the pause frame
--    and transmit a frame once the pause time is zero.
-- 6. Receive a pause frame that is 64 bytes (minimum frame size), 
--    the destination address matches pause frame address 0x0180C2000001, 
--    type field = 0x8808, pause op-code = 0x0001 and pause time to be set 
--    is 0x00FF.  Then, try to transmit a frame. The GEM should not 
--    transmit the frame until the pause timer is zero.
-- 7. Check the status and statistics registers and ensure that the 
--    above operations were handled properly.

--------------------------------------------------------------------------------

requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1

wait_states 0
bus_grant_delay 0

-- The following ensures that whatever datawidth is selected for this test, the 
-- translator will pass through correct multiples of 32bit words for data transfers
-- (not descriptors). This relies on the test writer using the rx_descr and tx_descr to
-- differentiate between the DMA accesses.
enforce_data_width 1

-- In 32b datapaths, the 64bit descriptors are accessed not in incrementing order
-- The used bit is always read first, and written last.
-- For TX since the used bit is bit 63, the 2nd 32bit word is always read first
-- For RX since the used bit is bit 0, the 2nd 32bit word is always written first
-- This ordering is only there for 32bit modes
-- To simplify writing testcases and ensure the same test can operate on different datawidths
-- we can automatically reverse the order ...
auto_descriptor_swap 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

# Initialize the network configuration register
init_ncr -duplex full -speed random -jumbo 0 -databus random -copy_all 0 -eam 0 -pause_en 1 -retry_test 0

# Initialize the transmit and receive DMA queue pointers (random values by default)
# Disables all queues not mentioned here ...
init_q_ptr  -num_tx_queues 1   -num_rx_queues 1 -rx_ptr_q0 ffffff00 -tx_ptr_q0 11111000

# Enable the interrupts
enable_ints -num_queues 1   -vector ffffffff  # enable all ints

apbrd      24 00000000  -- check interrupt status
apbwr      00 0000000C  -- enable receive and transmit
apbrd      00 0000000C  -- check receive and transmit
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      08 00000006  -- check reset value of network status register
apbrd      38 00000000  -- check the value of the pause time register

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbrd      20 00000000 num=200 -- simple delay to allow enables to propagate through the IP ..
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

-- ************************************************************************** --
-- Receive a pause frame that is only 63 bytes, the destination address 
-- matches pause frame address 0x0180C2000001, type field = 0x8808, 
-- pause op-code = 0x0001 and pause time to be set is 0x00FF.  
-- Then, transmit a frame. The GEM should ignore the pause frame 
-- and just transmit the frame.
-- ************************************************************************** --

rxd(apb)     d50180C200000111112222222288080001
rxd            00FF4444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            0000000000000000000000gggggggg

apbrd(scale 4400)   24 00000000 -- check interrupt status - pause timer zero
apbrd        38 00000000 -- check the value of the pause time register
apbrd       158 00000000 -- check no frames rxed OK (no register 1 match)
apbrd       164 00000000 -- check pause frames rxed
apbrd       184 00000001 -- check undersized frame register

-- ************************************************************************** --
-- *               Driving in frame to be transmitted                       * --
-- ************************************************************************** --

-- transmit a frame starting at one word and one byte removed from
-- the 16-byte boundary

apbwr        00 0000020C -- write tx_start

-- supply the transmit data to the AHB interface
apbwr        00 0000040C -- write tx halt bit

-- supply the transmit data to the AHB interface
dma_rd tx_descr 11111000 98765000 -- TX buffer address
dma_rd tx_descr 11111004 00018040 -- length 64, no CRC and end of frame

dma_rd 98765000 12345678
dma_rd 98765004 11111111
dma_rd 98765008 22222222
dma_rd 9876500c 33333333
dma_rd 98765010 44444444
dma_rd 98765014 55555555
dma_rd 98765018 66666666
dma_rd 9876501c 77777777
dma_rd 98765020 88888888
dma_rd 98765024 99999999
dma_rd 98765028 aaaaaaaa
dma_rd 9876502c bbbbbbbb
dma_rd 98765030 cccccccc
dma_rd 98765034 dddddddd
dma_rd 98765038 eeeeeeee
dma_rd 9876503c ffffffff

dma_wr tx_descr 11111004 80018040 -- write back ownership bit

-- check for correct preamble, SFD, data, pad and crc 
txd       55555555555555d578563412111111112222222233333333
txd		                  444444445555555566666666
txd                               777777778888888899999999
txd                               aaaaaaaabbbbbbbbcccccccc
txd                               ddddddddeeeeeeeeffffffff

-- check status on transmit complete interrupt
apbrd(int)   24 00000080 -- check interrupt status - transmit complete
apbwr        24 00000080 -- clear interrupt status
apbrd        14 00000020 -- read transmit status register - frame transmitted 
apbwr        14 00000020 -- clear transmit status register
apbrdf       108 00000001 -- check one frame txed OK

-- ************************************************************************** --
-- Receive a pause frame that is 65 bytes (greater than minimum frame size),
-- the destination address matches pause frame address 0x0180C2000001, 
-- type field = 0x8808, pause op-code = 0x0001 and pause time to be set 
-- is 0x00FF.  Then, transmit a frame. The GEM accept the pause frame
-- and transmit a frame once the pause time is zero.
-- ************************************************************************** --

rxd(apb)     d50180C200000111112222222288080001
rxd            00FF4444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            00000000000000000000000000gggggggg

apbrd(int)   24 00001000 -- check interrupt status - non-zero pause frame received
apbwr        24 00001000 -- clear interrupt status
apbrd(poll)  38 000000FF max=100  -- check the value of the pause time register (takes a while in 10M mode to update)
init_ncr -retry_test 1

apbrd(int)   24 00002000 -- check interrupt status - pause timer zero
apbwr        24 00002000 -- clear interrupt status
apbrd        38 00000000 -- check the value of the pause time register


