--
--   Test           : basic_100M_enst
--
--
--------------------------------------------------------------------------------
--
--  Summary
--
--  Need to setup system such that the TSU is running
--  Setup the Start-time, On-time, Off-time and addfragsize_count for queues
--  Check that all queues only transmit when active.
--  The design is set to 10Mbs mode and both frames can transmit within a single
--  gatestate pulse of Q0.
--
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state
set_random_seed 94;

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      04 00480400
--apbrd      04 00080000  -- check reset value of network config register
apbwr      1c 90000000 -- write transmit queue pointer 0
apbwr     440 91000000 -- write transmit queue pointer 1
apbwr     444 92000000 -- write transmit queue pointer 2
apbwr     448 93000000 -- write transmit queue pointer 3
apbwr     44c 94000000 -- write transmit queue pointer 4
apbwr     450 95000000 -- write transmit queue pointer 5
apbwr     454 96000000 -- write transmit queue pointer 6
apbwr     458 97000000 -- write transmit queue pointer 7
apbwr     45c 98000000 -- write transmit queue pointer 8
apbwr     460 99000000 -- write transmit queue pointer 9
apbwr     464 9a000000 -- write transmit queue pointer 10
apbwr     468 9b000000 -- write transmit queue pointer 11
apbwr     46c 9c000000 -- write transmit queue pointer 12
apbwr     470 9d000000 -- write transmit queue pointer 13
apbwr     474 9e000000 -- write transmit queue pointer 14
apbwr     478 9f000000 -- write transmit queue pointer 15
apbwr      04 00000402  -- set to full duplex mode and 1G
apbrd      08 00000006  -- check reset value of network status register
apbwr      f8 00000001  -- check Q0 DPRAM fill levl
apbrd      f8 00000001  -- check Q0 DPRAM fill levl

apbrd     284 6ef13fff  -- read design cfg reg to set axi test in trans.pl

--------------------------------------
----  TSU registers                 --
--------------------------------------
apbrd     1d0 00000000  -- TSU timer seconds
apbrd     1d4 00000000  -- TSU timer nanoseconds
apbrd     1d8 00000000  -- TSU timer adjust, write only
apbrd     1dc 00000000  -- TSU timer increment
apbwr     1dc 00000064  -- TSU timer increment


--------------------------------------
---- EnST registers                 --
---- Setup as follows               --
--      ___                              ___
--Q8  _|   |____________________________|   |____
--          ___                              ___
--Q9  _____|   |____________________________|   |
--              ___
--Q10 _________|   |____________________ _ _ _ 
--                  ___
--Q11 _____________|   |________________ _ _ _ 
--                      ___ 
--Q12__________________|   |____________ _ _ _ 
--                          ___
--Q13 _____________________|   |________ _ _ _ 
--                              ___
--Q14 _________________________|   |____ _ _ _ 
--                                  ___
--Q15 _____________________________|   |_ _ _ _
--             
--
---------------------------------------
apbwr     800 0000EA60  -- Q0 Start time
apbwr     820 000004B0  -- Q0 On time bytes
apbwr     840 00000000  -- Q0 Off time


apbwr     880 00000001  -- EnST Enable

apbwr(390) 00 00000208  -- write tx_go and enable tx


tx_frame  50
      number_of_bufs 1
      num_dma_queues 8
      auto_gen_int   0
      buffer_size    100-120
      data           random
      fcs            YES

-- force end of test in case it doesn't stop of its own accord
end(4000000)

bus_grant_delay 0

