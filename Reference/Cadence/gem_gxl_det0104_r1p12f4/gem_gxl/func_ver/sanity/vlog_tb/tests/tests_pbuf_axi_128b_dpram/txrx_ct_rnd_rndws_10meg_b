apbrd     20 00000000  
apbrd     20 00000000  
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

rx_frame (apb)  1
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field random
      data_size      16 
      data           random
      auto_gen_int   0
      resource_err   0
      fcs            good

rx_frame (gap)  20
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field random
      data_size      64-2000 
      data           random
      auto_gen_int   1
      resource_err   0
      fcs            good

tx_frame  20
      number_of_bufs 1
      auto_gen_int   0
      buffer_size    64-2000
      data           random
      fcs            YES


dma_rd rx_q_ptr ddddd000 

