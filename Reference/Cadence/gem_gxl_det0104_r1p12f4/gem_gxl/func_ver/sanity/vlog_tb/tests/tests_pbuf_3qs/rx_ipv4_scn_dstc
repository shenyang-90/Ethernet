--
-- setup screener type 1
-- Enable DSTC and match against 00 - send to queue 2
-- 
-- ************************************************************************** --

wait_states 0
set_random_seed 0;

pinsc(50) loopback 0 half_duplex 1 extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 f0000000  -- write receive queue pointer 0
apbwr     480 f0010000  -- write receive queue pointer 1
apbwr     484 f0020000  -- write receive queue pointer 2
apbrd      18 f0000000  -- check receive queue pointer
apbwr      10 000107c4  -- set buffer size to 64
apbwr     4a0 00000001  -- Buffer size Q1
apbwr     4a4 00000001  -- Buffer size Q1
apbwr     500 10000002  -- Screener 1 Enable DSTC and match against 00 - send to queue 2
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbwr     600 ffffffff  -- enable q1 interrupts
apbwr     604 ffffffff  -- enable q2 interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 01080001  -- indicate 100M operation, will check pin l8r.
apbrd      04 01080001  -- verify write to speed register..
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame
apbwr      A8 8000e066  -- set to type field after VLAN for match --try this JM

#
# Receive a frame which should default to q0 since DSTC = FF
#

rxd(apb)   55d5         -- preamble & SDF
rxd        ffffffffffff -- MAC DA (Broadcast)
rxd        8c736ede9900 -- MAC SA
rxd        8100e066     -- VLAN
rxd        0800         -- Length/typeID IPV4
rxd        45ff         -- Version, IHL, type of service, #2
rxd        003a         -- total length (58 bytes), #4
rxd        0000         -- ID
rxd        0000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        b658         -- IP Header checksum, #12
rxd        c0a80102     -- IP SA, #16
rxd        c0a80114     -- IP DA, #20
rxd        cccc         -- TCP source port, #22
rxd        eeee         -- TCP destination port, #24
rxd        00000001     -- Sequence number, #28
rxd        00000001     -- Acknowledgement Number, #32
rxd        501805ee     -- Flags and window, #36
rxd        d10e         -- TCP checksum, #38
rxd        0000         -- TCP urgent pointer, #40

rxd        11111111111111111111111111111111 -- Data #56
rxd        1111                             -- Data #58
rxd        0000                             -- PADDING

rxd        gggggggg     -- FCS

----------------------------------------------------------
-- Frame 1 (ETH, IP HEADER)

-- descriptor read
dma_rd f0000000 22222102 -- dma reads pointer of 22222100

-- payload write
dma_wr 22222100 FFFFFFFF -- store frame to memory
dma_wr 22222104 738cFFFF
dma_wr 22222108 0099de6e 
dma_wr 2222210c 66e00081
dma_wr 22222110 ff450008 
dma_wr 22222114 00003a00
dma_wr 22222118 06800000  
dma_wr 2222211c a8c058b6
dma_wr 22222120 a8c00201
dma_wr 22222124 cccc1401
dma_wr 22222128 0000eeee 
dma_wr 2222212c 00000100
dma_wr 22222130 18500100
dma_wr 22222134 0ed1ee05
dma_wr 22222138 11110000
dma_wr 2222213c 11111111    --end of buffer

-- descriptor write
dma_wr rx_descr f0000004 00004000
dma_wr rx_descr f0000000 22222103

dma_rd f0000000 22222140    -- dma read next buffer

dma_wr 22222140 11111111
dma_wr 22222144 11111111
dma_wr 22222148 11111111
dma_wr 2222214c 44dc0000
dma_wr 22222150 0000ece6


-- descriptor write
dma_wr rx_descr f0000004 80ae8052
dma_wr rx_descr f0000000 22222141


