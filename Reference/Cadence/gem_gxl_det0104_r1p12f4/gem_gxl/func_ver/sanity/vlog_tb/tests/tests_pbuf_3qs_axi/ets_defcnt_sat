--
--   Description
----------------
--
-- A test to saturate the dwrr/ets deficit counters. Most of the ETS testing 
-- is done in the SoC environment, but this is a very specific directed test
-- 
--------------------------------------------------------------------------------

--check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 94;

sel_ahb_freq 3 
randomize_hready -descr_max 0 -data_max 0 -read_max 0 -write_max 0
tog_cnt_en 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 01a00710
apbwr      28 00000007  -- enable all interrupts
apbwr      600 00000c06 -- enable q1 interrupts
apbwr      604 00000c06 -- enable q2 interrupts
apbwr      440 88000000 -- write transmit queue pointer 1
apbwr      444 99000000 -- write transmit queue pointer 2
apbwr      04 0028040a  -- 64bit enable, gigabit mode, full duplex
apbwr      04 0128040a  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr     580 ffffffff  -- setup all queues to use ETS
apbwr     590 ffffffff  -- setup >100% BW to all queues !
apbwr      1c 11111100  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 11111100  -- check transmit queue pointer
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx
-- delay for enable rx to propagate though design
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     284 6ef13fff  -- read design cfg reg to set axi test in trans.pl
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

-- Send some fairly large frames ...
tx_frame  40
      number_of_bufs 2
      num_dma_queues 3
      auto_gen_int   0
      buffer_size    1500
      data           random
      fcs            YES

apbwr(700)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(800)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(900)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(1000)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(1100)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(1200)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(1300)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(1400)  00 0000020c  -- write tx_go and enable tx, enable rx
apbwr(1500)  00 0000020c  -- write tx_go and enable tx, enable rx

-- force end of test in case it doesn't stop of its own accord
end(3000000)

