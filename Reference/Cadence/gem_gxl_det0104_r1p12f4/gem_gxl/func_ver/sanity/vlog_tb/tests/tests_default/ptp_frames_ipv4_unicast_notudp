rxd        76543210     -- IP DA
rxd        9005         -- UDP source port
rxd        013f         -- UDP destination port
rxd        0012         -- UDP length
rxd        7228         -- UDP checksum
rxd        60           -- transport specific, messageType
rxd        02           -- version PTP
rxd        6c6c         -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        abababab     -- other stuff
rxd        abababab     -- other stuff
rxd        abababab     -- UUID, sequenceID
rxd        00000000     -- control, subdomain
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        gggggggg     -- FCS


-- supply the receive buffer location
