--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 01080019  -- enable RX TCP offload engine and jumbo
apbrd      04 01080019  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 55555500  -- write receive queue pointer
apbrd      18 55555500  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive


--******************************************************************************
-- Test 1.1
-- Real UDP packet
--   - UDP packet with IPv6
--******************************************************************************

apbrdf     20 00000000  "Test 1.1 : UDP packet with IPv6"
                        -- trigger reception of frame

rxd(apb)   55555555555555d5 -- preamble & SDF
rxd        333300000009     -- MAC DA
rxd        08002BB5A7A8     -- MAC SA
rxd        86dd             -- IPV6 type
rxd        67000000         -- Version, Traffic Class, Flow Label  
rxd        0020             -- Payload length  (==32)                
rxd        11ff             -- Next Header=UDP, Hop Limit
rxd        FE800000         -- Source Address (1st 32)
rxd        00000000         -- Source Address (2nd 32) 
rxd        00000800         -- Source Address (3rd 32)
rxd        2BB5A7A8         -- Source Address (4th 32) 
rxd        FF020000         -- Dest Address (1st 32)
rxd        00000000         -- Dest Address (2nd 32)
rxd        00000000         -- Dest Address (3rd 32)
rxd        00000009         -- Dest Address (4th 32)
rxd        02090209         -- UDP: Destination Port = RIPng <0209>
rxd        002021a1         -- UDP: Length = 32, CheckSum = 0x21A1
rxd        01010000         -- Command:1 Request, Version No.:1 <01>,RIPng: Must Be Zero:0x0000 <0000>
rxd        00000000         -- RIPng: Entry No. :1,IPv6 Prefix:0x00000000000000000000000000000000 [Default Route]
rxd        00000000
rxd        00000000
rxd        00000000
rxd        00000010         -- RIPng: Route Tag:0x0000 <0000>, Metric:16 <10>
rxd        gggggggg         -- MAC FCS


-- supply the receive buffer location
dma_rd rx_descr 55555500 98765000 -- dma reads pointer of 98765000

-- check the receive data as it is written out on the AHB interface
dma_wr 98765000   00003333
dma_wr 98765004   00080900
dma_wr 98765008   A8A7B52B
dma_wr 9876500c   0067DD86
dma_wr 98765010   20000000
dma_wr 98765014   80FEFF11
dma_wr 98765018   00000000
dma_wr 9876501c   00000000
dma_wr 98765020   B52B0008
dma_wr 98765024   02FFA8A7
dma_wr 98765028   00000000
dma_wr 9876502c   00000000
dma_wr 98765030   00000000
dma_wr 98765034   09020900
dma_wr 98765038   20000902
dma_wr 9876503c   0101a121  -- UDP checksum goes in here
dma_wr 98765040   00000000
dma_wr 98765044   00000000
dma_wr 98765048   00000000
dma_wr 9876504c   00000000
dma_wr 98765050   00000000
dma_wr 98765054   9bf21000
dma_wr 98765058   000073f3

-- write back the intermediate queue descriptor's status
dma_wr rx_descr 55555504 00c0c05a -- dma writes rx status
dma_wr rx_descr 55555500 98765001 -- dma writes ownership bit


-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "Test 1.1 complete"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it
apbrd      20 00000002  -- check RX status register - receive complete
apbwr      20 00000002  -- clear RX status register


