-------------------------------------------------
-- tx_random test scenario for the Ethernet MAC --
-------------------------------------------------
--
-- Checks that a frame queued that is too large for the SRAM gets errored properly
--
-- ************************************************************************** --


-- need fast bus response for 25MHz Hclk
wait_states 0

bus_grant_delay 0
set_random_seed 1;

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 0000ffff  -- enable all interrupts

apbwr      04 00280000  -- change to 64bit
apbrd      08 00000006  -- check reset value of network status register
apbrd      10 000207c4  -- 
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx and rx



dma_rd tx_descr 55555500 98765f90 -- dma reads pointer of 98765000
dma_rd tx_descr 55555504 4000bfff 

dma_rd tx_descr 55555508 98765f90 -- dma reads pointer of 98765000
dma_rd tx_descr 5555550c 80008fff -- used

apbrd(int)   24 00000040  -- check interrupt status - amba error
apbwr        24 00000040  -- clear interrupt status
apbrd	     14 00000010  -- tx status - tx_data_check
apbwr        00 00000000  -- soft reset


-- force end of test in case it doesn't stop of its own accord
end(36000)

