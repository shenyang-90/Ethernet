--  6. RAS TSU duplication test -> write all 0s and all 1s into timer value
--******************************************************************************
apbwr     1d0 ffffffff  -- Timer seconds register
apbwr     1c0 ffffffff  -- Timer seconds  MSB register
apbwr     1d4 ffffffff  -- Timer nanoseconds register

apbwr(1300) 1d0 00000000  -- Timer seconds register
apbwr       1c0 00000000  -- Timer seconds  MSB register
apbwr       1d4 00000000  -- Timer nanoseconds register

-- use alternative timer increment after 0x10 incs (alt inc 0, than FF)
apbwr(1400) 1dc 00100001  -- Timer incr
apbwr(1500) 1dc 0010FF0F  -- Timer incr

apbwr       1bc ffffffff  -- Timer incr sub_nano 

apbwr(1800) 1dc 00FFFF0F  -- Timer incr

pinsd(2200)    tsu_ms 0        -- drive value into gem_tsu_ms
pinsd(2800)    tsu_inc_ctrl 00 -- drive value into gem_tsu_inc_ctrl

pinsd(3100)    tsu_ms 1        -- drive value into gem_tsu_ms

apbwr(3500)     00 00800000 -- network control - enable ext_tsu

apbrd(5000)     20 00000000  

