--
-- Inputs a UDP frame which is split into 2 frames by the UDP fragmentation offload
-- functionality, , but does not have last bit set in payload descriptor and is
-- therefore a multi buffer error
-- Checks that 2 frames are transmitted and header is read 3 times from memory
-- before mid frame error interrupt is raised
-- 2nd UDP frame with UFO is then output to verify that UFO logic was 
-- initialised on error
-- IPv4 encapsulation
--
-- ************************************************************************** --

wait_states 2
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 10000000  -- write address of transmit buffer descriptor in memory
apbrd      1c 10000000  -- check transmit queue pointer
apbwr      10 00020c04  -- little endian, tx checksums enabled
apbwr      00 00000208  -- write tx_go and enable tx

---------------------------------------------------------------------------------

-- Zero length descriptor
-- So multi buffer does not start at descriptor base
-- and we can verify that error results in reture of pointer to base
dma_rd tx_descr 10000004 00008000 -- zero length, last bit set
dma_rd tx_descr 10000000 00000000


-- FRAME 1
-- Header and payload in separate buffers with separate descriptors
-- 2 googd payload descriptor then payload descriptor with last bit and zero length field


-- Header Descriptor
dma_rd tx_descr 1000000c 00020022 -- hardware CRC, UFO enable, 34 bytes
dma_rd tx_descr 10000008 20000000 -- header buffer base address
-- Payload Descriptor
dma_rd tx_descr 10000014 00580008 -- MFS of 88 bytes, last bit clear, length 8 bytes
dma_rd tx_descr 10000010 20000022 -- payload buffer base address - follows from header buffer
-- Payload Descriptor
dma_rd tx_descr 1000001c 0058005a -- MFS of 88 bytes, last bit clear, length 90 bytes, MFS gives payload of 50, so round down to 48
dma_rd tx_descr 10000018 30000000 -- payload buffer base address
-- Payload Descriptor
dma_rd tx_descr 10000024 00008000 -- Last bit set and length field of zero
dma_rd tx_descr 10000020 00000000


-- Header buffer read
dma_rd 20000000 11111111
dma_rd 20000004 22221111
dma_rd 20000008 22222222
dma_rd 2000000c 00450008
dma_rd 20000010 00000000 
dma_rd 20000014 11000000 
dma_rd 20000018 66660000 
dma_rd 2000001c 55556666 
dma_rd 20000020 33335555 

-- Data buffer read - 8 bytes
