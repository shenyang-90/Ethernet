--
-- Inputs a maximun size UDP datagram and fragments this to meet the MFS of 1518
-- 65535 byte totla length IP 
--  = 65515 byte IP payload with 20 byte IP header
--  = 65515 byte UDP datagram
-- ************************************************************************** --

wait_states 2
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 00000000  -- write address of transmit buffer descriptor in memory
apbrd      1c 00000000  -- check transmit queue pointer
apbwr      10 00020c04  -- little endian, tx checksums enabled
apbwr      00 00000208  -- write tx_go and enable tx

-- FRAME 1
-- Header and payload in separate buffers with separate descriptors
-- 5 Payload buffers - 4 of 15Kbyte, 1 of 4075 bytes

-- Header Descriptor
dma_rd tx_descr 00000004 00020022 -- hardware CRC, UFO enable, 34 bytes - Ethernet and IPv4 header
dma_rd tx_descr 00000000 01000000 -- header buffer base address

-- Payload Descriptor
dma_rd tx_descr 0000000c 00003c00 -- MFS of 1518 bytes (default), last bit clear, length 15kbytes - UDP header and payload
dma_rd tx_descr 00000008 10000000 -- payload buffer base address

-- Payload Descriptor
dma_rd tx_descr 00000014 00003c00 -- MFS of 1518 bytes (default), last bit clear, length 15kbytes - payload
dma_rd tx_descr 00000010 20000000 -- payload buffer base address

-- Payload Descriptor
dma_rd tx_descr 0000001c 00003c00 -- MFS of 1518 bytes (default), last bit clear, length 15kbytes - payload
dma_rd tx_descr 00000018 30000000 -- payload buffer base address

-- Payload Descriptor
dma_rd tx_descr 00000024 00003c00 -- MFS of 1518 bytes (default), last bit clear, length 15kbytes - payload
dma_rd tx_descr 00000020 40000000 -- payload buffer base address

-- Payload Descriptor
dma_rd tx_descr 0000002c 00008feb -- MFS of 1518 bytes (default), last bit set, length 4075 bytes - payload
dma_rd tx_descr 00000028 50000000 -- payload buffer base address

-- Used Descriptor
dma_rd tx_descr 00000034 80000000 -- Used bit
dma_rd tx_descr 00000030 00000000

