pcs_an_rx            c10000c20000c10000c20000  

-- ********************************************************************************************* --
-- 28. Once the GEM enters AN_ENABLE state, it should start transmitting alternating /C/ codes with the Config_Reg field all zeros.
-- ********************************************************************************************* --

pcs_an_tx          0000  

dma_rd 00000000 12345678 -- DMA will read a single descriptor after RX is enabled

end(3000)
