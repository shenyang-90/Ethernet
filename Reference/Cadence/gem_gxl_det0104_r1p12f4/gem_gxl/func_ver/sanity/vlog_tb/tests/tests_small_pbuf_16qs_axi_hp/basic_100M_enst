--
--   Test           : basic_100M_enst
--
--
--------------------------------------------------------------------------------
--
--  Summary
--
--  Need to setup system such that the TSU is running
--  Setup the Start-time, On-time, Off-time and addfragsize_count for queues
--  Check that all queues only transmit when active.
--  The design is set to 100Mbs mode and both frames can transmit within a single
--  gatestate pulse of Q0.
--
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state
set_random_seed 94;

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbwr      1c 90000000 -- write transmit queue pointer 0
apbwr     440 91000000 -- write transmit queue pointer 1
apbwr     444 92000000 -- write transmit queue pointer 2
apbwr     448 93000000 -- write transmit queue pointer 3
apbwr     44c 94000000 -- write transmit queue pointer 4
apbwr     450 95000000 -- write transmit queue pointer 5
apbwr     454 96000000 -- write transmit queue pointer 6
apbwr     458 97000000 -- write transmit queue pointer 7
apbwr     45c 98000000 -- write transmit queue pointer 8
apbwr     460 99000000 -- write transmit queue pointer 9
apbwr     464 9a000000 -- write transmit queue pointer 10
apbwr     468 9b000000 -- write transmit queue pointer 11
apbwr     46c 9c000000 -- write transmit queue pointer 12
apbwr     470 9d000000 -- write transmit queue pointer 13
apbwr     474 9e000000 -- write transmit queue pointer 14
apbwr     478 9f000000 -- write transmit queue pointer 15
apbwr      04 00080003  -- set to full duplex mode and 100M
apbrd      08 00000006  -- check reset value of network status register
apbwr      f8 00000001  -- check Q0 DPRAM fill levl
apbrd      f8 00000001  -- check Q0 DPRAM fill levl
apbrd     284 6df12800  -- read design cfg reg to set axi test in trans.pl

--------------------------------------
----  TSU registers                 --
--------------------------------------
apbrd     1d0 00000000  -- TSU timer seconds
apbrd     1d4 00000000  -- TSU timer nanoseconds
apbrd     1d8 00000000  -- TSU timer adjust, write only
apbrd     1dc 00000000  -- TSU timer increment
apbwr     1dc 00000064  -- TSU timer increment


--------------------------------------
---- EnST registers                 --
---- Setup as follows               --
--      ___                                   ___
--Q0  _|   |_________________________________|   |____
--          ___                                   ___
--Q1  _____|   |_________________________________|   |
--              ___
--Q2  _________|   |_________________________
--                  ___
--Q3  _____________|   |_____________________
--                      ___
--Q4 __________________|   |_________________
--                          ___
--Q5  _____________________|   |_____________
--                              ___
--Q6  _________________________|   |_________
--                                  ___
--Q7  _____________________________|   |_____
--             
--
---------------------------------------
apbrd     800 00000000  -- Q0 Start time
apbrd     820 0001ffff  -- Q0 On time bytes
apbrd     840 00000000  -- Q0 Off time

apbwr     800 00005570  -- Q0 Start time
apbwr     820 00000100  -- Q0 On time bytes
apbwr     840 00000700  -- Q0 Off time



apbrd     804 00000000  -- Q1 Start time
apbrd     824 0001ffff  -- Q1 On time bytes
apbrd     844 00000000  -- Q1 Off time

apbwr     804 0000A570  -- Q1 Start time
apbwr     824 00000100  -- Q1 On time bytes
apbwr     844 00000700  -- Q1 Off time



apbrd     808 00000000  -- Q2 Start time
apbrd     828 0001ffff  -- Q2 On time bytes
apbrd     848 00000000  -- Q2 Off time

apbwr     808 0000F570  -- Q2 Start time
apbwr     828 00000100  -- Q2 On time bytes
apbwr     848 00000700  -- Q2 Off time



apbrd     80c 00000000  -- Q3 Start time
apbrd     82c 0001ffff  -- Q3 On time bytes
apbrd     84c 00000000  -- Q3 Off time

apbwr     80c 00014570  -- Q3 Start time
apbwr     82c 00000100  -- Q3 On time bytes
apbwr     84c 00000700  -- Q3 Off time



apbrd     810 00000000  -- Q4 Start time
apbrd     830 0001ffff  -- Q4 On time bytes
apbrd     850 00000000  -- Q4 Off time

apbwr     810 00019570  -- Q4 Start time
apbwr     830 00000100  -- Q4 On time bytes
apbwr     850 00000700  -- Q4 Off time



apbrd     814 00000000  -- Q5 Start time
apbrd     834 0001ffff  -- Q5 On time bytes
apbrd     854 00000000  -- Q5 Off time

apbwr     814 0001E570  -- Q5 Start time
apbwr     834 00000100  -- Q5 On time bytes
apbwr     854 00000700  -- Q5 Off time



apbrd     818 00000000  -- Q6 Start time
apbrd     838 0001ffff  -- Q6 On time bytes
apbrd     858 00000000  -- Q6 Off time

apbwr     818 00023570  -- Q6 Start time
apbwr     838 00000100  -- Q6 On time bytes
apbwr     858 00000700  -- Q6 Off time



apbrd     81c 00000000  -- Q7 Start time
apbrd     83c 0001ffff  -- Q7 On time bytes
apbrd     85c 00000000  -- Q7 Off time

apbwr     81c 00028570  -- Q7 Start time
apbwr     83c 00000100  -- Q7 On time bytes
apbwr     85c 00000700  -- Q7 Off time


apbwr     880 000000FF  -- EnST Enable

apbwr(390) 00 00000208  -- write tx_go and enable tx


tx_frame  10
      number_of_bufs 1
      num_dma_queues 16
      auto_gen_int   0
      buffer_size    100-120
      data           random
      fcs            YES


-- force end of test in case it doesn't stop of its own accord
end(2000000)

bus_grant_delay 0

