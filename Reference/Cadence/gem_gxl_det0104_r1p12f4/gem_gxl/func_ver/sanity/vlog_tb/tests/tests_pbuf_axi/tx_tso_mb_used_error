--
-- Inputs a TCP frame which is split into 2 frames by the TCP secmentation offload
-- functionality, but does not have last bit set in payload descriptor and is
-- therefore a multi buffer error
-- Checjs that 2 frames are transmitted and header is read 3 times from memory
-- before mid frame error interrupt is raised
-- 2nd TCP frame with TSO is then output to verify that TSO logic was 
-- initialised on error
--
-- ************************************************************************** --

wait_states 2
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 10000000  -- write address of transmit buffer descriptor in memory
apbrd      1c 10000000  -- check transmit queue pointer
apbwr      10 00020c04  -- little endian, tx checksums enabled
apbwr      00 00000208  -- write tx_go and enable tx


---------------------------------------------------------------------------------

-- Zero length descriptor
-- So multi buffer does not start at descriptor base
-- and we can verify that error results in reture of pointer to base
dma_rd tx_descr 10000004 00008000 -- zero length, last bit set
dma_rd tx_descr 10000000 00000000


-- FRAME 1
-- TSO
-- Header and payload in separate buffers with separate descriptors
-- Used bit error in second payload descriptor 
-- Two frames will be tramsmitted from 1st payload descriptor

-- Header Descriptor
dma_rd tx_descr 1000000c 00040036 -- hardware CRC, TSO enable, seq num from header, stream 0, 54 bytes
dma_rd tx_descr 10000008 20000000 -- header buffer base address
-- Payload Descriptor
dma_rd tx_descr 10000014 0032005a -- MSS of 50 bytes, last bit clear, length 90 bytes
dma_rd tx_descr 10000010 30000000 -- payload buffer base address
-- Used Descriptor
dma_rd tx_descr 1000001c 80000000 -- Used Bit
dma_rd tx_descr 10000018 00000000


