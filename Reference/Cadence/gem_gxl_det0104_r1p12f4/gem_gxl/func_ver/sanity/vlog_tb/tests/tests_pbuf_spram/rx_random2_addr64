--
-- This test is based on the original test named without _addr64 extension,
-- and has 64b ahb/axi addressing added.  
--

--------------------------------------------------------------------------------
--
-- Written by Alastair Boomer/Arthur Marris
--
-- Cadence Design Systems Ltd
-- Livingston Design Centre,
-- West Lothian.
--
-- 24Mar2003     Arthur finished it off
--
-- This shows the ability of the trans.pl to generate random
-- receive frames.
--
-- 47 frames of varying lengths are generated, 46 of which
-- are address recognized
--
-- trans.pl picks destination addresses from the values written
-- to the specific address registers.
--
-- trans.pl reads the value written to the receive queue pointer
-- and checks reads and writes to the rx buffer queue. trans.pl
-- generates random values for the rx buffer locations and sets
-- the wrap bit from time to time.
--
-- 
-- ************************************************************************** --


wait_states 2
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 01234000  -- write receive queue pointer
apbrd      18 01234000  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080001  -- indicate 100M operation - offset of 0
apbrd      04 00080001  -- verify write to speed register..
-- setup 64b addressing
apbwr      10 400207c4  -- enable 64b addressing
apbwr     4c8 98abcdef  -- MSB BD base addr tx (need this for trans.pl data generation)
apbwr     4d4 98abcdef  -- MSB BD base addr rx
apbwr     4cc 00000124  -- rx_bd_control_reg  where last 12 bits are: no_man_rd_access, no_man_wr_access, bd_size_words
apbwr     4d0 00000124  -- rx_bd_control_reg  where last 12 bits are: no_man_rd_access, no_man_wr_access, bd_size_words
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame



-----------------------------------------------------------------
-- TEST 1: ONE MINIMUM SIZE FRAMES WITH CORRECT DEST ADDR (PADDED)
-----------------------------------------------------------------

rx_frame (apb)  1
      preamble_size  1-14
      dest_addr      multicast
      src_addr       111122222222
      auto_gen_int  0
      type_len_field 3333
      data_size      20-30 
      data           random
      fcs            good


-----------------------------------------------------------------
-- TEST 2: TEN RANDOM FRAMES WITH CORRECT DEST ADDR
-----------------------------------------------------------------

rx_frame (gap)  10
      preamble_size  1-14
      dest_addr      unicast
      src_addr       random
      type_len_field random
      auto_gen_int  0
      data_size      0-1500 
      data           random
      fcs            good


-----------------------------------------------------------------
-- TEST 3: ONE RANDOM FRAME WITH INCORRECT DEST ADDR
-----------------------------------------------------------------

rx_frame (gap)  1
      preamble_size  1-14
      dest_addr      random
      src_addr       random
      auto_gen_int  0
      type_len_field random
      data_size      0-1500 
      data           random
      fcs            good

