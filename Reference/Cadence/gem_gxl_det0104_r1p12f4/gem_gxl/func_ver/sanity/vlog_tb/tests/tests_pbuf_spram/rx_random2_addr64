-----------------------------------------------------------------
-- TEST 6: FIVE DOUBLE BUFFER FRAMES WITH BROADCAST ADDR
-----------------------------------------------------------------

rx_frame (gap)  5
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       random
      type_len_field random
      auto_gen_int  0
      data_size      238 
      data           random
