--
--   Description
----------------
--
-- This test is intended to prove the basic transmit operation of the
-- GEM PCS (gigabit operation when using the TBI).
--
--
-- Functional Coverage
----------------------
-- · Checks PCS transmission with all combinations of data code group present
--   within the one frame.
-- 
--
-- Detailed Test Description
----------------------------
--
-- The auto-negotiation function is disabled (using bit-7 of the PCS Control
-- Register) prior to selecting PCS. The PCS is selected by setting the MAC
-- into Gigabit mode and setting PCS enable in the MAC network configuration
-- register.
--
-- The frame data value increments from 0 to 255 forming a 260 byte frame
-- when CRC is appended by the MAC
--
-- Check tx status and statistics once frame has been transmitted.
-- 
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state


apbwr(60)  4c 00000001  -- enable soft config fifo port bit when available
apbrd      4c 00000001  -- check enable soft config bit when available

-- check the relevant pcs registers
apbrd(100) 200 00009040  -- check reset value of pcs control register, bit-15
                         -- indicates the pcs is in reset (until enabled)
apbrd      204 00000109  -- check reset value of pcs status reg
apbrd      210 00000020  -- check reset value of pcs a-n advertisement reg
apbrd      214 00000000  -- check reset value of pcs a-n link ptnr ability reg
apbrd      218 00000004  -- check reset value of pcs a-n expansion reg
apbrd      21C 00000000  -- check reset value of pcs a-n next page reg
apbrd      220 00000000  -- check reset value of pcs a-n link partner reg
apbrd      23C 00008000  -- check reset value of pcs a-n extended status reg


-- initialise the relevant pcs registers
apbwr      200 00000040  -- disable auto-negotiation prior to enabling PCS
                         -- this resets bit 12
apbrd      200 00008040  -- check pcs control register, still reset, AN disabled


-- check and initialise the relevant mac registers
apbrd      000 00000000  -- check reset value of network control register
apbwr      028 ffffffff  -- enable all interrupts
apbrd      004 00080000  -- check reset value of network config register
apbrd      008 00000006  -- check reset value of network status register
apbwr      004 00080c02  -- set gigabit, full duplex and pcs enabled

apbrd(int)  24 00000200  -- check link status change interrupt
apbrd       14 00000000  -- check tx status
apbrd      200 00000140  -- check pcs control register, full duplex set
apbwrf     000 00000008  -- enable tx (apb trigger to trigger fifo)

