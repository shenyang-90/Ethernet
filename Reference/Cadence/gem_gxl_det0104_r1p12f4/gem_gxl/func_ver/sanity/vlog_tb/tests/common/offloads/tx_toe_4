--   Description
----------------
--
-- This tests ensures that illegally early End of packets will reset the
-- the TCP state machine correctly
--
--
--------------------------------------------------------------------------------

-- Configuration Requirements ..
requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1

sel_ahb_freq 1 -- define host frequency. Dont care for this test

-- The following ensures that whatever datawidth is selected for this test, the 
-- translator will pass through correct multiples of 32bit words for data transfers
-- (not descriptors). This relies on the test writer using the rx_descr and tx_descr to
-- differentiate between the DMA accesses.
enforce_data_width 1

-- In 32b datapaths, the 64bit descriptors are accessed not in incrementing order
-- The used bit is always read first, and written last.
-- For TX since the used bit is bit 63, the 2nd 32bit word is always read first
-- For RX since the used bit is bit 0, the 2nd 32bit word is always written first
-- This ordering is only there for 32bit modes
-- To simplify writing testcases and ensure the same test can operate on different datawidths
-- we can automatically reverse the order ...
auto_descriptor_swap 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbwr      28 ffffffff  -- enable all interrupts
apbwr     5a0 00000007  -- give all segments to Q0
apbrd      08 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
init_ncr -duplex full -speed 100m -jumbo 0 -databus random -copy_all 1 -eam random -rx_toe 0

-- # Initialize the transmit and receive DMA queue pointers (random values but can add specifics if required)
-- # use arg -rx_ptr_q<Q> and tx_ptr_q<Q> to set specific ptr values rather than the default random
init_q_ptr  -num_tx_queues 1   -num_rx_queues 1 -rx_ptr_q0 fffff000 -tx_ptr_q0 55555500


-- # initialize the DMA specific options for random data xfers
-- #   - RX DMA data buffer size
-- #     If left without an argument, it will be completely random
-- #     Set high to force single buffer descriptor testing eg 16320
-- #     use -max_buf_size for max (multiple 64 bytes only)
-- #     use -min_buf_size for min (multiple 64 bytes only)
-- #
-- #   - Burst Length (random by default)
-- #     use -burst <num>, where num can be 1,2,4,8,16, random
-- #        
-- #   - address bus (random by default, or off if config doesnt allow)
-- #     use -addr_bus <32|64|random|take_from_cfg>     
-- #        
-- #   - extended buffer descriptors (random by default, or off if config doesnt allow)
-- #     use -ext_bd <1|0|random>     
-- #        
-- #   - force max burst mode (forces AXI to send max length bursts)
-- #     use -force_max_burst_<tx|rx> <1|0|random>    default is 0 
-- #   - tx_csum_offload (sets TX checksum offload)
-- #     use -tx_csum_offload <1|0|random>    default is 0 
init_dma -ext_bd 0 -addr_bus 32  -burst random -min_buf_size 16320 -tx_csum_offload 1

apbwr      00 00000208  -- write tx_go and enable tx


