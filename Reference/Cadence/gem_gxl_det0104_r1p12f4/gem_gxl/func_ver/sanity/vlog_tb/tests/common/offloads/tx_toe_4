-- Test 4.1
--    Detect an EOP in the START state
--******************************************************************************

dma_rd tx_descr 55555500 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555504 00008010 -- start of frame



-- supply the transmit data to the AHB interface
dma_rd 98765000 FFFFFFFF -- store frame to memory
dma_rd 98765004 0008FFFF
dma_rd 98765008 56341239
dma_rd 9876500c 01000608

txd         55555555555555d5 -- preamble & SDF
txd         FFFFFFFFFFFF 
txd         080039123456 
txd         0806         
txd         0001     

txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     

txd         dbce1fce     


-- write transmit complete status for the oldest frame 1
dma_wr tx_descr 55555504 80408010 -- write used bit 

apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr       24 00000080  -- check interrupt status - transmit complete
apbrd	      14 00000028  -- tx status - frame transmitted,


