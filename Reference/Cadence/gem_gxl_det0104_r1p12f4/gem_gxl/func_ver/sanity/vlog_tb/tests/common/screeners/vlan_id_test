--
--   Description
----------------
--
-- This is a common random test that can run across compatible configurations
-- The following items are randomized ...
--    Frame length    - from 64bytes to max offered by configuration
--    Screener values - for randomized receive matching (based on #screeners and queues from configuration)
--    Queue           - for transferring frames across queues randomly (randomized up to #queues from configuration)
--    Bus width       - AXI/AHB Up to maximum offered through configuration
--    Burst Length    - AXI/AHB 
--    RX DMA Buffer Size 
--    Address Bus Width
--    Extended BD
--    
--
--
-- 
--------------------------------------------------------------------------------

-- define config compatibility (names are the verilog defines in the defs file without the IP prefix)
requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1
requires num_dma_queues 3             -- at least 3 queues required ...
requires num_type2_screeners 3        -- at least 3 screeners ...
requires num_scr2_compare_regs 3      -- at least 3 comp regs ...

#set_random_seed 1; -- seed can also be now set from calling script but this will override it

# The following function sets the bandwidth on the host side
# By default, the host clock frequency is randomized between
# 
#tb_set_host_bw

-- Set AHB clock freq to 250MHz
-- At 32bit, this means we have maximum bandwidth of 8Gbit/s shared between
-- TX and RX. Randomize hready, keeping the maximum to 5 (averages around 2.5)
-- to ensure no RX overflows occur, and max line rate is acheivable on TX
sel_ahb_freq 3 
randomize_hready -descr_max 5 -data_max 5 -read_max 5 -write_max 5
tog_cnt_en 1
bus_grant_delay 0 -- This sets hgrant to 1 always (for AHB configs!)

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

# Initialize the transmit and receive DMA queue pointers (random values but can add specifics if required)
# use arg -rx_ptr_q<Q> and tx_ptr_q<Q> to set specific ptr values rather than the default random
init_q_ptr  -num_tx_queues take_from_cfg   -num_rx_queues take_from_cfg


# Initialize the screener type 1 registers (random values)
# Note this will automatically force the transactor later on to
# randomly create frames that match on these screeners, thus routing
# frames to receive queues ..
init_screener_type1 -num_type1_screeners take_from_cfg   -num_rx_queues take_from_cfg 


# initialize the DMA specific options for random data xfers
#   - RX DMA data buffer size
#     If left without an argument, it will be completely random
#     Set high to force single buffer descriptor testing eg 16320
#     use -max_buf_size for max (multiple 64 bytes only)
#     use -min_buf_size for min (multiple 64 bytes only)
#
#   - Burst Length (random by default)
#     use -burst <num>, where num can be 1,2,4,8,16, random
#        
#   - address bus (random by default, or off if config doesnt allow)
#     use -addr_bus <32|64|random|take_from_cfg>     
#        
#   - extended buffer descriptors (random by default, or off if config doesnt allow)
#     use -ext_bd <1|0|random>     
#        
#   - force max burst mode (forces AXI to send max length bursts)
#     use -force_max_burst_<tx|rx> <1|0|random>    default is 0 
init_dma -ext_bd random -addr_bus random  -burst random -min_buf_size 16320


# Enable the interrupts
# This is per queue, 
# Valid args are ..
#    -num_queues <1-16|take_from_cfg>
#    -vector <the actual interrupt vector as per userguide>
enable_ints -num_queues take_from_cfg   -vector 00000082  # enable TX and RX complete



# Initialize the network configuration register
# Args are
#   -eam      <1|0|random>, default = 0. This is external address matching
#   -duplex   <full|half|random>, default = random
#   -speed    <1g|100m|10m|random>, default = random
#   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
#   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
#   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
init_ncr -duplex full -speed random -copy_all 1 -jumbo random -databus take_from_cfg

-- Setup the screeners
-- [3:0]  - Selected Queue
-- [7:4]  - VLAN priority 
-- [8]    - VLAN enable 
-- [11:9] - ethertype reg#
-- [12]   - ethertype match enable
-- [17:13]- compa reg#
-- [18]   - compa match enable
-- [23:19]- compb reg#
-- [24]   - compb match enable
-- [29:25]- compc reg#
-- [30]   - compc match enable
apbwr      540 00040002  -- Screener2 reg 0, comp reg = 0 (will be C-TAG comp)
apbwr      544 00042011  -- Screener2 reg 1, comp reg = 1 (will be S-TAG comp)
apbwr      548 00044021  -- Screener2 reg 2, comp reg = 2 (will be C-TAG comp)

-- In this test, we are testing the compare_vlan_id field only
-- so bit 10 of the comp reg word 1 should always be set
-- and bit 7 should be random ..
-- the other bits can be 0 ..
-- set the mask to just check 12 bits of the tag (not the CFI or priority)
-- set the comp value to be fixed values ..
apbwr      700 12340fff  -- Compare reg 0a 
apbwr      704 00000400  -- Compare reg 0b  -- C-TAG comp
apbwr      708 23450fff  -- Compare reg 1a
apbwr      70c 00000480  -- Compare reg 1b  -- S-TAG comp
apbwr      710 34560fff  -- Compare reg 2a
apbwr      714 00000400  -- Compare reg 2b  -- C-TAG comp

-- Set stacked VLAN tag ..
apbwr      c0 800088a8  -- write stacked vlan ...

apbwr      00  00000004  -- enable receive
apbrd      20  00000000 num=200 -- simple delay to allow enables to propagate through the IP ..
apbrdf     20  00000000  -- check contents of the receive status register and trigger reception of frame


-- first frame
rx_frame (apb)  1

      #------------------------------
      # Ethernet Header
      preamble_size       1-14
      dest_addr           copy_all
      src_addr            111122222222
      vlan1_en            random
      vlan1_type          8100
      vlan1_type          88a8
      vlan1_field         1234
      vlan2_en            random
      vlan2_type          8100
      vlan2_type          88a8
      vlan2_field         1234
      vlan2_field         2345
      vlan2_field         3456
      type_len_field      random

      #------------------------------
      # Level 3/4 Stuff
      ipv4_en             random
        num_ipv4_options  random
      ipv6_en             random
      udp_en              0

      #------------------------------
      # Payload
      data_size           16-100
      data                random

      #------------------------------
      debug_print_frame   1
      num_dma_queues      take_from_cfg
      auto_gen_int        1
      fcs                 good


rx_frame (gap)  50

      #------------------------------
      # Ethernet Header
      preamble_size       1-14
      dest_addr           copy_all
      src_addr            111122222222
      vlan1_en            random
      vlan1_type          8100
      vlan1_type          88a8
      vlan1_field         1234
      vlan1_field         2345
      vlan1_field         1234
      vlan2_field         2345
      vlan2_field         3456
      vlan2_en            random
      vlan2_type          8100
      vlan2_type          88a8
      vlan2_field         1234
      vlan2_field         2345
      vlan2_field         3456
      type_len_field      random

      #------------------------------
      # Level 3 Stuff
      ipv4_en             random
        num_ipv4_options  random
      ipv6_en             random
      udp_en              0

      #------------------------------
      # Payload
      data_size           16-100
      data                random

      #------------------------------
      debug_print_frame   1
      num_dma_queues      take_from_cfg
      auto_gen_int        1
      fcs                 good


-- force end of test in case it doesn't stop of its own accord
end(3000000)

