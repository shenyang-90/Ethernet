--
-- Test Description
-- This test checks the reporting mechanism of the gem_rx module for IP, UDP 
-- and TCP frames with good checksums, but the frames have other errors.
-- 
-- Functional Coverage
-- * Checks that the GEM only reports a good IP frame, when the whole of the
--   frame is correctly decoded.
-- 
-- Detailed Test Description
--  1. Initialise suitable wait states for the test.
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--  3. Send several IP frames with good checksums, but have other errors.
--
-- Test 5.1
--    Broadcast frame, Valid TCP with good checksum, but is shorter than
--    minimum frame size.
--    The frame should be discarded and an undersize error recorded.
-- Test 5.2
--    Broadcast frame, Valid UDP with good checksum, but is shorter than
--    minimum frame size.
--    The frame should be discarded and an undersize error recorded.
-- Test 5.3
--    Broadcast frame, Valid TCP with good checksum, but has a symbol error.
--    The frame should be discarded and an symbol error recorded.
-- Test 5.4
--    Broadcast frame, Valid UDP with good checksum, but has a symbol error.
--    The frame should be discarded and an symbol error recorded.
-- Test 5.5
--    Broadcast frame, Valid TCP with good checksum, but has a CRC error.
--    The frame should be discarded and an CRC error recorded.
-- Test 5.6
--    Broadcast frame, Valid UDP with good checksum, but has a CRC error.
--    The frame should be discarded and an CRC error recorded.
-- Test 5.7
--    Broadcast frame, Valid TCP with good checksum, but is greater than the
--    maximum frame size.
--    The frame should be discarded and an excessive length error recorded.
-- Test 5.8
--    Broadcast frame, Valid UDP with good checksum, but is greater than the
--    maximum frame size.
--    The frame should be discarded and an excessive length error recorded.
--
--  4. Receive a good frames to trigger an interrupt.
--  5. Check statistics for correct values from above tests.
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
-- Configuration Requirements ..
requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1
requires rx_sram_size 1600

sel_ahb_freq 2 -- define host frequency. Dont care for this test

-- The following ensures that whatever datawidth is selected for this test, the 
-- translator will pass through correct multiples of 32bit words for data transfers
-- (not descriptors). This relies on the test writer using the rx_descr and tx_descr to
-- differentiate between the DMA accesses.
enforce_data_width 1

-- In 32b datapaths, the 64bit descriptors are accessed not in incrementing order
-- The used bit is always read first, and written last.
-- For TX since the used bit is bit 63, the 2nd 32bit word is always read first
-- For RX since the used bit is bit 0, the 2nd 32bit word is always written first
-- This ordering is only there for 32bit modes
-- To simplify writing testcases and ensure the same test can operate on different datawidths
-- we can automatically reverse the order ...
auto_descriptor_swap 1

wait_states 3
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbrd      08 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
init_ncr -duplex full -speed 100m -jumbo 0 -databus take_from_cfg -copy_all 1 -eam random -rx_toe 1

-- # Initialize the transmit and receive DMA queue pointers (random values but can add specifics if required)
-- # use arg -rx_ptr_q<Q> and tx_ptr_q<Q> to set specific ptr values rather than the default random
init_q_ptr  -num_tx_queues take_from_cfg   -num_rx_queues take_from_cfg -rx_ptr_q0 fffff000 -tx_ptr_q0 55555500

apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive
apbrd      00 zzzzzzzz num=15 -- repeat read 15 times to ensure rx enable is propagated through design



--******************************************************************************
--  3. Send several IP frames with good checksums, but have other errors.
--******************************************************************************


--******************************************************************************
-- Test 5.1
--    Broadcast frame, Valid TCP with good checksum, but is shorter than
--    minimum frame size.
--    The frame should be discarded and an undersize error recorded.
--******************************************************************************

apbrdf     20 00000000  "Tests 5.1 to 5.8 : IP, good checksums, other errors"
                        -- trigger reception of frame


rxd(apb)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        0028         -- total length
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        98F2         -- IP Header checksum
rxd        C0A80001     -- IP SA
rxd        C0A80091     -- IP DA
rxd        0015         -- TCP source port
rxd        048A         -- TCP destination port
rxd        3DBB5C60     -- Sequence number
rxd        EA224D76     -- Acknowledgement Number
rxd        50104428     -- Flags and window
rxd        1376         -- TCP checksum
rxd        0000         -- TCP urgent pointer
rxd        ACACDBDBB0   -- options or padding
rxd        AAAF8871     -- FCS


-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
filterc da FFFFFFFFFFFF sa 563412390008 type 0800 ipsa 0100A8C0 ipda 9100A8C0


-- supply the receive buffer location
dma_rd rx_descr fffff000 22222100 -- dma reads pointer of 22222100


