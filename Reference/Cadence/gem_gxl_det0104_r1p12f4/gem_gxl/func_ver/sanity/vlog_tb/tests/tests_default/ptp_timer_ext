--
-- Test Description
-- Check TSU timer values - timer is controlled through external dignals
--
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register


-- check TSU timer and PTP event frame register
apbrd     1e0 00000000  -- PTP event frame transmitted seconds register
apbrd     1e4 00000000  -- PTP event frame transmitted nanoseconds register
apbrd     1e8 00000000  -- PTP event frame received seconds register
apbrd     1ec 00000000  -- PTP event frame received nanoseconds register
apbrd     1f0 00000000  -- peer event frame transmitted seconds register
apbrd     1f4 00000000  -- peer event frame transmitted nanoseconds register
apbrd     1f8 00000000  -- peer event frame received seconds register
apbrd     1fc 00000000  -- peer event frame received nanoseconds register
apbrd     1d0 00000000  -- Timer seconds register
apbrd     1d4 00000000  -- Timer nanoseconds register
apbrd     1d8 00000000  -- Timer adjust
apbrd     1dc 00000000  -- Timer increment


--******************************************************************************
--  3. Check Timer increment -
--     Set different gem_tsu_inc_ctrl and gem_tsu_ms values.
--******************************************************************************

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- nanseconds increment of 1 is expected
pinsd(500)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(505)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(550)    1d4 00000001    -- Timer nanoseconds register
apbrd(575)    1d0 00000000    -- Timer seconds register
apbrd(600)    1d4 00000001    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- nanoseconds increment of 1 is expected
pinsd(700)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(705)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(750)    1d4 00000002    -- Timer nanoseconds register
apbrd(775)    1d0 00000000    -- Timer seconds register
apbrd(800)    1d4 00000002    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 2 for one tsu_clk cycle,
-- nanoseconds decrement of 1 is expected
pinsd(900)    tsu_inc_ctrl 10 -- drive value into gem_tsu_inc_ctrl
pinsd(905)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(950)    1d4 00000001    -- Timer nanoseconds register
apbrd(975)    1d0 00000000    -- Timer seconds register
apbrd(1000)   1d4 00000001    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 2 for one tsu_clk cycle,
-- nanoseconds decrement of 1 is expected
pinsd(1100)   tsu_inc_ctrl 10 -- drive value into gem_tsu_inc_ctrl
pinsd(1105)   tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(1150)   1d4 00000000    -- Timer nanoseconds register
apbrd(1175)   1d0 00000000    -- Timer seconds register
apbrd(1200)   1d4 00000000    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- nanoseconds increment of 1 is expected
pinsd(1300)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(1305)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(1350)    1d4 00000001    -- Timer nanoseconds register
apbrd(1375)    1d0 00000000    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- nanoseconds increment of 1 is expected
pinsd(1400)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(1405)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(1450)    1d4 00000002    -- Timer nanoseconds register
apbrd(1475)    1d0 00000000    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 0 for one tsu_clk cycle,
-- seconds increment of 1 is expected while nanoseconds are cleared
pinsd(1500)    tsu_inc_ctrl 00 -- drive value into gem_tsu_inc_ctrl
pinsd(1505)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(1550)    1d4 00000000    -- Timer nanoseconds register
apbrd(1575)    1d0 00000001    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 0 for one tsu_clk cycle,
-- seconds increment of 1 is expected while nanoseconds are cleared
pinsd(1600)    tsu_inc_ctrl 00 -- drive value into gem_tsu_inc_ctrl
pinsd(1605)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(1650)    1d4 00000000    -- Timer nanoseconds register
apbrd(1675)    1d0 00000002    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- nanoseconds increment of 1 is expected
pinsd(1700)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(1705)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(1750)    1d4 00000001    -- Timer nanoseconds register
apbrd(1775)    1d0 00000002    -- Timer seconds register
apbrd(1800)    1cc 00000000    -- Timer sync strobe nanoseconds register
apbrd(1825)    1c8 00000000    -- Timer sync strobe seconds register

-- set gem_tsu_ms and gem_tsu_inc_ctrl to 0 for one tsu_clk cycle,
-- no change of timer value in slave mode and timer value is copied to
-- sync strobe registers
pinsd(1899)    tsu_ms 0        -- drive value into gem_tsu_ms
pinsd(1900)    tsu_inc_ctrl 00 -- drive value into gem_tsu_inc_ctrl
pinsd(1905)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
pinsd(1906)    tsu_ms 1        -- drive value into gem_tsu_inc_ctrl
apbrd(1950)    1d4 00000001    -- Timer nanoseconds register
apbrd(1975)    1d0 00000002    -- Timer seconds register
apbrd(2000)    1cc 00000001    -- Timer sync strobe nanoseconds register
apbrd(2025)    1c8 00000002    -- Timer sync strobe seconds register


-- Timer increment = 0 and alternative increment = 2 very 2nd cycle
apbwr(2050)    1dc 00010200

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- it is expected that nanseconds is first odd and then even
apbrd(2455)    1d4 0000004d    -- Timer nanoseconds register
pinsd(2500)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(2505)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(2575)    1d0 00000002    -- Timer seconds register
apbrd(2600)    1d4 0000006a    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- it is expected that nanseconds is odd again
pinsd(2700)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(2705)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(2755)    1d4 0000008b    -- Timer nanoseconds register
apbrd(2775)    1d0 00000002    -- Timer seconds register
apbrd(2800)    1d4 00000093    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 2 for one tsu_clk cycle,
-- it is expected that nanseconds is even again
pinsd(2900)    tsu_inc_ctrl 10 -- drive value into gem_tsu_inc_ctrl
pinsd(2905)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(2955)    1d4 000000b2    -- Timer nanoseconds register
apbrd(2975)    1d0 00000002    -- Timer seconds register
apbrd(3000)    1d4 000000ba    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 2 for one tsu_clk cycle,
-- it is expected that nanseconds is odd again
pinsd(3100)   tsu_inc_ctrl 10 -- drive value into gem_tsu_inc_ctrl
pinsd(3105)   tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(3155)   1d4 000000d9    -- Timer nanoseconds register
apbrd(3175)   1d0 00000002    -- Timer seconds register
apbrd(3200)   1d4 000000e1    -- Timer nanoseconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- it is expected that nanseconds is even again
pinsd(3300)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(3305)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(3355)    1d4 00000102    -- Timer nanoseconds register
apbrd(3375)    1d0 00000002    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- it is expected that nanseconds is odd again
pinsd(3400)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(3405)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(3455)    1d4 00000117    -- Timer nanoseconds register
apbrd(3475)    1d0 00000002    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 0 for one tsu_clk cycle,
-- seconds increment of 1 is expected while nanoseconds was cleared
pinsd(3500)    tsu_inc_ctrl 00 -- drive value into gem_tsu_inc_ctrl
pinsd(3505)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(3555)    1d4 00000006    -- Timer nanoseconds register
apbrd(3575)    1d0 00000003    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 0 for one tsu_clk cycle,
-- seconds increment of 1 is expected while nanoseconds was cleared
pinsd(3600)    tsu_inc_ctrl 00 -- drive value into gem_tsu_inc_ctrl
pinsd(3605)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(3655)    1d4 00000006    -- Timer nanoseconds register
apbrd(3675)    1d0 00000004    -- Timer seconds register

-- set gem_tsu_inc_ctrl to 1 for one tsu_clk cycle,
-- it is expected that nanseconds is odd again
-- syn strobe registers unchanged
pinsd(3700)    tsu_inc_ctrl 01 -- drive value into gem_tsu_inc_ctrl
pinsd(3705)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
apbrd(3755)    1d4 0000001b    -- Timer nanoseconds register
apbrd(3775)    1d0 00000004    -- Timer seconds register
apbrd(3800)    1cc 00000001    -- Timer sync strobe nanoseconds register
apbrd(3825)    1c8 00000002    -- Timer sync strobe seconds register

-- set gem_tsu_ms and gem_tsu_inc_ctrl to 0 for one tsu_clk cycle,
-- no change of timer value in slave mode and timer value is copied to
-- sync strobe registers
pinsd(3899)    tsu_ms 0        -- drive value into gem_tsu_ms
pinsd(3900)    tsu_inc_ctrl 00 -- drive value into gem_tsu_inc_ctrl
pinsd(3905)    tsu_inc_ctrl 11 -- drive value into gem_tsu_inc_ctrl
pinsd(3906)    tsu_ms 1        -- drive value into gem_tsu_inc_ctrl
apbrd(3955)    1d4 00000043    -- Timer nanoseconds register
apbrd(3975)    1d0 00000004    -- Timer seconds register
apbrd(4005)    1cc 0000003b    -- Timer sync strobe nanoseconds register
apbrd(4025)    1c8 00000004    -- Timer sync strobe seconds register


end(10000)


