--
-- Test Description
-- This test checks the operation of the RX TCP offload engine, with IP frames
-- with SNAP and ethernet encapsulation, which have bad IP, UDP or TCP checksums
-- 
-- Functional Coverage
-- * Checks that the TOE recognises that these are TCP or UDP frames
--   and therefore checks the TCP/UDP checksum.
-- * Checks that the TOE can detect bad IP, TCP and UDP checksums for both 
--   odd and even length frames.
-- * Checks that the GEM discards frames with bad checksums.
-- 
-- Detailed Test Description
--  1. Initialise suitable wait states for the test.
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 64-bit DMA data bus.
--  3. Send several IP frames with either SNAP or ethernet encapsulation, which
--     have bad IP, TCP or UDP checksums.
--
-- Test 3.1
--    Broadcast frame, Min length IP, no VLAN or SNAP, no IP options, TCP,
--    incorrect IP checksum.
--    The frame should be discarded, with bad status, and a bad IP checksum
--    recorded in the statistics registers.
-- Test 3.2
--    Broadcast frame, IP packet, no VLAN or SNAP, with IP options, no TCP or
--    UDP, incorrect IP checksum.
--    The frame should be discarded, with bad status, and a bad IP checksum
--    recorded in the statistics registers.
-- Test 3.3
--    Broadcast frame, IP packet, no VLAN or SNAP, no IP options, correct IP
--    checksum, TCP, incorrect TCP checksum.
--    The frame should be discarded, with bad status, and a bad TCP checksum
--    recorded in the statistics registers.
-- Test 3.4
--    Broadcast frame, IP packet, VLAN and SNAP, IP options, correct IP
--    checksum, UDP, incorrect UDP checksum.
--    The frame should be discarded, with bad status, and a bad UDP checksum
--    recorded in the statistics registers.
-- Test 3.5
--    Broadcast frame, Otherwise valid IP packet where the end of Ethernet
--    data comes before the expected end of the IP header.
--    The frame should be discarded, with bad status, and a bad IP checksum
--    recorded in the statistics registers.
-- Test 3.6
--    Broadcast frame, Otherwise valid UDP packet where the end of Ethernet
--    data comes before the expected end of the UDP data.
--    The frame should be discarded, with bad status, and a bad UDP checksum
--    recorded in the statistics registers.
-- Test 3.7
--    Broadcast frame, Max length (1518 octets including CRC) TCP packet with
--    incorrect TCP checksum.
--    The frame should be discarded, with bad status, and a bad TCP checksum
--    recorded in the statistics registers.
-- Test 3.8
--    Broadcast frame, Min length IP, VLAN, SNAP, no IP options, UDP,
--    incorrect IP checksum.
--    The frame should be discarded, with bad status, and a bad IP checksum
--    recorded in the statistics registers.
--
--  4. Receive a good frame to trigger an interrupt and check stats.
--  5. Check statistics for correct values from above tests.
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 3
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 64-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 01280001  -- enable RX TCP offload engine.
apbrd      04 01280001  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive



--******************************************************************************
--  3. Send several IP frames with either SNAP or ethernet encapsulation, which
--     have bad IP, TCP or UDP checksums.
--******************************************************************************



--******************************************************************************
-- Test 3.1
--    Broadcast frame, Min length IP, no VLAN or SNAP, no IP options, TCP,
--    incorrect IP checksum.
--    The frame should be discarded, with bad status, and a bad IP checksum
--    recorded in the statistics registers.
--******************************************************************************

apbrdf     20 00000000  "Test 3.1 to 3.7 : various frames, all with bad checksums"
                        -- trigger reception of frame

rxd(apb)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        0028         -- total length
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        98E2         -- IP Header checksum
rxd        C0A80001     -- IP SA
rxd        C0A80091     -- IP DA
rxd        0015         -- TCP source port
rxd        048A         -- TCP destination port
rxd        3DBB5C60     -- Sequence number
rxd        EA224D76     -- Acknowledgement Number
rxd        50104428     -- Flags and window
rxd        1376         -- TCP checksum
rxd        0000         -- TCP urgent pointer
rxd        BA9876543210 -- data
rxd        97E1CE6B     -- FCS

-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
filterc da FFFFFFFFFFFF sa 563412390008 type 0800 ipsa 0100A8C0 ipda 9100A8C0


-- supply the receive buffer location
dma_rd fffff000 22222100 -- dma reads pointer of 22222100


-- bad IP checksum recognised here and rest of DMA is discarded.

