--
--   Description
----------------
--
-- Receive 2 10KByte packets.  The PBUF is only 4Kbytes big, but cut thru
-- can be used. This means the packet can be passed through to the MAC before
-- all the packet is stored in the PBUF(once a programmable threshold 
-- is reached). 
--    In addition to testing normal operation for cut through (which will
--    be achevied mostly through random testing, we need to verify the following
--    This will be done in other tests ...
--      1) Possible overflow condition, where AHB traffic doesnt appear
--         quick enough.  Also need to test recovery from overflow
--      2) Limits of threshold, both upper and lower
--      3) Other AHB errors when cut through is enabled
--      4) Multi buffer operation (handled through random tests)
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state
randomize_hready
sel_ahb_freq 3

-- check and initialise the relevant registers
apbwr(100)      28 ffffffff  -- enable all interrupts
apbrd           24 00000000  -- check interrupt status
apbwr           04 0008041b  -- gigabit, full_duplex, copy all frames, jumbo frames
apbrd           20 00000000  -- check contents of the receive status register 
apbwr           10 00a00304  -- Allow rx packets of up to 8k
apbwr           18  55555500    -- set address of the receive queue descriptor
apbwr           00  00000004    -- enable receive
apbwr           44  80000010  -- enable rx cut thru with threshold = 0x25
apbwr           98  3f12c678    -- specific address register 3 bottom
apbwrf          9c  0000938c    -- specific address register 3 top

rxd(apb)    55555555555555d5
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    gggggggg


dma_rd 55555500 60000000


-- supply the receive data to the AHB interface
-- 10KByte = 2500 32 bit words, so repeat the following line 2499 times
dma_wr(2499) 60000000 67452301
dma_wr       60002710 zzzzzzzz -- CRC

dma_wr 55555504    0000e714 -- dma writes the intermediate buffer's status
dma_wr 55555500    60000001 -- dma writes ownership bit

-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "SCENARIO 1. complete - received 10000byte frame"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it
apbrd      20 00000002  -- check contents of the receive status register- frame received
apbwr      20 00000002  -- clear it
apbrd      20 00000000  -- check it again


rxd(gap) 55555555555555d5
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    
rxd    gggggggg


dma_rd 55555508 60000000

dma_wr(2499) 60000000 67452301 -- DATA
dma_wr       60002710 zzzzzzzz -- CRC

dma_wr 5555550c    0000e714 -- dma writes the intermediate buffer's status
dma_wr 55555508    60000001 -- dma writes ownership bit

-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "SCENARIO 2. complete - received 10000byte frame"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it
apbrd      20 00000002  -- check contents of the receive status register- frame received
apbwr      20 00000002  -- clear it
apbrd      20 00000000  -- check it again


dma_rd 55555510 60000000

-- check transmit statistics
apbrd     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00004e28  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000002  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000002  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000002  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors


-- force end of test in case it doesn't stop of its own accord
end(500000)

bus_grant_delay 0
