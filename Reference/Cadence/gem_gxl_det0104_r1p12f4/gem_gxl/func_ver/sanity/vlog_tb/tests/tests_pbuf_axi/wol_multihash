apbrd      08 00000006  -- check reset value of network status register
apbwr      04 000800c1  -- Enable uni & multi-cast matching and setup speed bit.
apbrd      04 000800c1  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      80 00000020  -- write hash index value bottom
apbwr      84 00000000  -- write hash index value top (hash index of 5)
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 0fffffff  -- enable all interrupts except WOL
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive



