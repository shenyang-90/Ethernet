--
--   Description
--
-- This test checks the receive functionality for gigabit burst mode.
-- 
-- Functional coverage
-- -------------------
-- · Ensures the proper implementation for the reception of frame bursts.
-- · Ensures that the receive functionality of the GEM can handle break in and 
--   break out of frame bursts. (i.e. The GEM can receive a frame burst. Then, 
--   receive a normal sized frame. Finally, receive a new frame burst.) 
-- 
-- Detailed Test Description
-- -------------------------
-- 1. Initialise the GEM for gigabit operation.
-- 2. In burst mode, receive a frame with minimum frame size plus extension. 
--      Then, receive two minimum sized frames.  
-- 3. In normal mode, receive a frame with minimum frame size plus extension.
-- 4. In burst mode receive a frame with minimum frame size plus extension. 
--      Then, receive two minimum sized frames.  
-- 5. In normal mode, receive a frame with minimum frame size plus extension.
-- 6. Check status registers and statistic registers and ensure that the above 
--    operations did not result in any errors.
-- 
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

apbwr(60)  4c 00000001  -- enable soft config fifo port bit when available
apbrd      4c 00000001  -- check enable soft config bit when available

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbrd      08 00000006  -- check reset value of network status register
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080401  -- indicate 1G operation
apbrd      04 00080401  -- verify write to speed register..
apbrd      20 00000000  -- check contents of the receive status register and trigger reception of frame
apbwr      88 12345678  -- set the local address register to
apbwr      8c 00001111  --   ensure the incoming frame is recieved
apbwr      90 12345679  -- set the local address register to
apbwr      94 00001111  --   ensure the incoming frame is recieved

