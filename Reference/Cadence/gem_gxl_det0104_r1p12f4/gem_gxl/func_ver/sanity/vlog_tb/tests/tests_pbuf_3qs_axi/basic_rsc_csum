-- this test takes an existing known good TCP frame, splits it into
-- 2 segments, and then we comapre the coalesced checksum fields with
-- what we expected

--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 01080001  -- enable RX TCP offload engine.
apbwr      18 f0000000  -- write receive queue pointer for Q0
apbrd      18 f0000000  -- check receive queue pointer for Q0
apbwr     480 f0010000  -- write receive queue pointer for Q1
apbwr     484 fffff000  -- write receive queue pointer for Q2
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbwr      600 ffffffff  -- enable q1 interrupts
apbwr      604 ffffffff  -- enable q2 interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive
apbwr      10 00010724  -- enable header data splitting enable
apbwr      58 0000ffff  -- enable rsc on all queues
apbwr     4a0 000000ff  -- Buffer size Q1
apbwr     4a4 000000ff  -- Buffer size Q2


-- Setup a screener , using compare reg 0, vlan match disabled, queue = 2
apbwr      540 00040002  

-- Setup compare reg, offset = 0, comparing from end of L3 header
apbwr      700 8A041500  -- Compare value
apbwr      704 00000300  -- Compare control, dont use mask

apbrdf     20 00000000  

# Lets receive 2 frames that will match on compare reg 0, therefore
# match screener 0. Queue 2 will therefore receive this frame.
# Since RSC is enabled on queue 2, we will expect these to be coalesced.

rxd(apb)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service, #2
rxd        0048         -- total length (72 bytes), #4
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        98d2         -- IP Header checksum, #12
rxd        C0A80001     -- IP SA, #16
rxd        C0A80091     -- IP DA, #20
rxd        0015         -- TCP source port, #22
rxd        048A         -- TCP destination port, #24
rxd        00000001     -- Sequence number, #28
rxd        00000000     -- Acknowledgement Number, #32
rxd        50004428     -- Flags and window, #36
rxd        E519         -- TCP checksum, #38
rxd        0000         -- TCP urgent pointer, #40

rxd        ffffffffffffffffffffffffffffffff -- Data #56
rxd        ffffffffffffffffffffffffffffffff -- Data #72
rxd        00112233                         -- PAD
rxd        0011                             -- PAD

rxd        gggggggg     -- FCS


# Receive frame 2
rxd(gap)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service, #2
rxd        002d         -- total length (45 bytes), #4
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        98ed         -- IP Header checksum, #12
rxd        C0A80001     -- IP SA, #16
rxd        C0A80091     -- IP DA, #20
rxd        0015         -- TCP source port, #22
rxd        048A         -- TCP destination port, #24
rxd        00000021     -- Sequence number, (+32) #28
rxd        EA224D76     -- Acknowledgement Number, #32
rxd        50104428     -- Flags and window, #36
rxd        AE6A         -- TCP checksum, #38
rxd        0000         -- TCP urgent pointer, #40

rxd        ffffffffff                       -- Data #45
rxd        998877                           -- PAD

rxd        gggggggg     -- FCS

# Receive the same frame again ...



----------------------------------------------------------
-- Buffer 1 (ETH, IP HEADER)

-- descriptor read
dma_rd fffff000 22222102 -- dma reads pointer of 22222100

-- payload write
dma_wr 22222100 FFFFFFFF -- store frame to memory
dma_wr 22222104 0008FFFF
dma_wr 22222108 56341239
dma_wr 2222210c 00450008
dma_wr 22222110 fadf4800  -- total length field here
dma_wr 22222114 06800040
dma_wr 22222118 a8c0d298  -- IP checksum field here
dma_wr 2222211c a8c00100
dma_wr 22222120 15009100
dma_wr 22222124 00008a04 
dma_wr 22222128 00000100  -- ACK_NUM 1st half here
dma_wr 2222212c 00500000  -- ACK_NUM 2nd half here
dma_wr 22222130 19e52844  -- TCP checksum field here
dma_wr 22222134 ffff0000

-- descriptor write
dma_wr fffff004 00034036 
dma_wr fffff000 22222102 -- dma writes ownership bit
----------------------------------------------------------


----------------------------------------------------------
-- Buffer 2 (PAYLOAD)

-- descritpor read
dma_rd fffff000 22222126 -- dma reads pointer of 22222100

-- payload write
dma_wr 22222124 ffffffff
dma_wr 22222128 ffffffff
dma_wr 2222212c ffffffff
dma_wr 22222130 ffffffff
dma_wr 22222134 ffffffff
dma_wr 22222138 ffffffff
dma_wr 2222213c ffffffff
dma_wr 22222140 ffffffff
-- dma_wr 22222144 b8d10a62 -- CRC and pad dropped

-- descriptor write
dma_wr fffff004 80808060 -- *** note the length field here includes the pad - consider changing
dma_wr fffff000 22222126 -- dma writes descriptor, but without used bit!

----------------------------------------------------------------------------
-- Coalesce the 2nd frames payload ...
-- will continue from the end of the last ... Note the byte strobes

dma_wr 22222144 ffffffff f
dma_wr 22222148 000000ff 1

-- update cycle
-- ,IPv4 Total Length, then Ipv4 checksum, then TCP seq num, then TCP checksum - 
dma_wr 22222110 fadf4d00 3  -- Update total length field here (72 + 5 = 77)
dma_wr 22222118 a8c0cd98 3  -- Update IP checksum field here 
dma_wr 22222130 6cac0000 c  -- Update TCP checksum field here 
dma_wr 22222128 22ea0000 c  -- Update ACK_NUM 1st half here
dma_wr 2222212c 0000764d 3  -- ACK_NUM 2nd half here
dma_wr 2222212c 10000000 8  -- ACK_BIT


-- descr wr update
--dma_wr rx_descr fffff004 0000805b 3 -- update total length (total length + eth hdr = 77 + 14 = 91)
--dma_wr rx_descr fffff000 00000027 1 -- dma writes ownership bit

--apbrd(int2) 404 00000002  -- check interrupt status - receive complete
--apbwr       404 00000002  
--apbrd       20 00000002  
--apbwr       20 00000002 
--apbrd       20 00000000  

apbrd(2000) 404 00000000  


end(5000)


