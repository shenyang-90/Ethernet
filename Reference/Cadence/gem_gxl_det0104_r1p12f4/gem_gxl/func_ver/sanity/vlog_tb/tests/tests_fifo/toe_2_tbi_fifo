-- check the receive data as it is written out on the FIFO interface
--          CONTROL  MOD  STATUS[39:0]    DATA
fifo_wr      1010     0   xxxxxxxxxx    FFFFFFFF
fifo_wr      1000     0   xxxxxxxxxx    0008FFFF
fifo_wr      1000     0   xxxxxxxxxx    56341239
fifo_wr      1000     0   xxxxxxxxxx    00450008
fifo_wr      1000     0   xxxxxxxxxx    FADF2800
fifo_wr      1000     0   xxxxxxxxxx    06800040
fifo_wr      1000     0   xxxxxxxxxx    A8C0F298
fifo_wr      1000     0   xxxxxxxxxx    A8C00100
fifo_wr      1000     0   xxxxxxxxxx    15009100
fifo_wr      1000     0   xxxxxxxxxx    BB3D8A04
fifo_wr      1000     0   xxxxxxxxxx    22EA605C
fifo_wr      1000     0   xxxxxxxxxx    1050764D
fifo_wr      1000     0   xxxxxxxxxx    76132844
fifo_wr      1000     0   xxxxxxxxxx    ACAC0000
