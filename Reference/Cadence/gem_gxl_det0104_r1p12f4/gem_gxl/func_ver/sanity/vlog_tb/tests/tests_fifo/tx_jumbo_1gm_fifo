--
--   Description
-- 
-- The transmit functionality is tested for sending jumbo frames 
-- in 1000 mode of operation
-- 
-- Functional Coverage
----------------------
-- · Ensures that the GEM can transmit jumbo frames up to 16384 bytes long.
-- · Ensures that the GEM cannot transmit jumbo frames over 16384 bytes long.
-- 
-- Detailed Test Description
----------------------------
-- 1. Initialise the gem for 1000 mode operation.
-- 2. Transmit a frame that is 10241 bytes long.
-- 3. Transmit a frame that is 10240 bytes long.
-- 4. Check the status and statistics registers and ensure 
--     that the above operations were handled properly.
-- 
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      00 00000008  -- enable transmit
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00090409  -- indicate 1G operation, jumbo frames enabled,
                        --  length field checking enabled
apbrd      04 00090409  -- verify write to speed register..
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

