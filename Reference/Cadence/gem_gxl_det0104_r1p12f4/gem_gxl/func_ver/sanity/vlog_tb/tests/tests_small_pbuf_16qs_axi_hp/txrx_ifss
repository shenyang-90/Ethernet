--
-- Basic Background Test for Incsiv Functional Safety (IFSS) simulations
--
-- 5 random frames are transmitted to Q0-Q2
-- 5 random frames are received to Q0-Q2
-- 
--------------------------------------------------------------------------------

-- Set the seed for the test ...
-- set_random_seed 0;

-- enable automatic ifss Checker function
-- It will also automatically check interrupts.
-- set to one when error injected
set_auto_fault_checker 1;;

-- Set AHB clock freq to 250MHz
-- At 32bit, this means we have maximum bandwidth of 8Gbit/s shared between
-- TX and RX. Randomize hready, keeping the maximum to 5 (averages around 2.5)
-- to ensure no RX overflows occur, and max line rate is acheivable on TX
sel_ahb_freq 3 
randomize_hready -descr_max 5 -data_max 5 -read_max 5 -write_max 5

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 01a00710
apbwr      28 C0000fff  -- enable all interrupts
apbwr      600 00000fff -- enable q1 interrupts
apbwr      604 00000fff -- enable q2 interrupts
apbwr      e08 00000000 -- enable ASF interrupts (write to mask)
apbwr     440 91000000 -- write transmit queue pointer 1
apbwr     444 92000000 -- write transmit queue pointer 2
apbwr     448 93000000 -- write transmit queue pointer 3
apbwr     44c 94000000 -- write transmit queue pointer 4
apbwr     450 95000000 -- write transmit queue pointer 5
apbwr     454 96000000 -- write transmit queue pointer 6
