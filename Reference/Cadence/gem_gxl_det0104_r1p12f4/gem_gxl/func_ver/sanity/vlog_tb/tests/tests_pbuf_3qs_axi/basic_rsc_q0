rxd        C0A80091     -- IP DA, #20
rxd        0015         -- TCP source port, #22
rxd        048A         -- TCP destination port, #24
rxd        0000004a     -- Sequence number, (+36) #28
rxd        EA224D76     -- Acknowledgement Number, #32
rxd        50184428     -- Flags and window (PSH), #36
rxd        ad1b         -- TCP checksum, #38
rxd        0000         -- TCP urgent pointer, #40

rxd        ffffffffffffffffffffffffffffffff -- Data #56
rxd        ffffffffffffffffffffffffffffffff -- Data #72
rxd        ffffffff                         -- Data #76
rxd        998877                           -- PAD

rxd        gggggggg     -- FCS

