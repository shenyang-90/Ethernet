--
-- Test Description
-- This test verifies the operation of Wake-on-LAN using specific address 1
-- filter matches
-- 
-- Functional Coverage
-- * Checks that WoL is asserted for specific address 1 matches.
-- * Checks that WoL is not asserted for specific address 2-4 matches.
-- * Checks the operation of the WoL enable mask.
-- * Checks the operation of the "wol" output.
-- * Checks that the WoL is asserted for both good and bad frames.
--
-- 
-- Detailed Test Description
--  1. Initialise suitable wait states for the test.
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--  3. Send the DUT various frames to test specific address 1 filter detection 
--     for WoL:
--
-- Test 1: Specific address 1 match that generates WoL
--     Enable the local address wake up event enable bit in the WoL register.
--     Send a good receive frame that matches the specific address 1.
--     Verify that the wol output is asserted for 64 clock cycles and that the
--     frame is successfully received.
--
-- Test 2: Specific address 1 match, but mask disabled
--     Disable the local address wake up event enable bit in the WoL register.
--     Send a good receive frame that matches the specific address 1.
--     Verify that the wol output is not asserted but that the frame is 
--     successfully received.
--
-- Test 3: Not specific address 1 matched
--     Enable the local address wake up event enable bit in the WoL register.
--     Send a good receive frame that does not match the specific address 1,
--     but matches on specific address 2-4.
--     Verify that the wol output is not asserted but that the frame is 
--     successfully received.
--
-- Test 4: Bad CRC that generates WoL
--     Enable the local address wake up event enable bit in the WoL register.
--     Send a receive frame with bad CRC that matches the specific address 1.
--     Verify that the wol output is asserted for 64 clock cycles and that the
--     frame dropped with a CRC error.
--
-- Test 5: Too short that generates WoL
--     Enable the local address wake up event enable bit in the WoL register.
--     Send a short (60 bytes) receive frame matching the specific address 1.
--     Verify that the wol output is asserted for 64 clock cycles and that the
--     frame dropped with a undersize error.
--
-- Test 6: Good VLAN frame that generates WoL
--     Enable the local address wake up event enable bit in the WoL register.
--     Send a good VLAN tagged receive frame matching the specific address 1.
--     Verify that the wol output is asserted for 64 clock cycles and that the
--     frame is successfully received.
--
--  4. Check statistics for correct values from above tests.
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 3
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080001  -- Setup speed bit.
apbrd      04 00080001  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive



--******************************************************************************
--  3. Send the DUT various frames to test specific address 1 filter detection 
--     for WoL:
--******************************************************************************

--  check reset state of Wake-on-LAN output
pinsc(50) wol 0



--******************************************************************************
-- Test 1: Specific address 1 match that generates WoL
--     Enable the local address wake up event enable bit in the WoL register.
--     Send a good receive frame that matches the specific address 1.
--     Verify that the wol output is asserted for 64 clock cycles and that the
--     frame is successfully received.
--******************************************************************************

apbwr      B8 00041213  -- enable WoL specific address 1
apbrdf     20 00000000  "Test 1 : Specific address 1 match that generates WoL"
                        -- trigger reception of frame


rxd(apb)   55d5         -- preamble & SDF
rxd        785634121111 -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID (IP)
rxd        4500         -- Version, IHL, type of service
rxd        002A         -- total length
rxd        0000         -- ID
rxd        0000         -- flags & fragmentation
rxd        0A01         -- time to live and protocol
rxd        81E1         -- IP Header checksum
rxd        86BF0B52     -- IP SA
rxd        86BF1622     -- IP DA
rxd        080089A2     -- Data
rxd        00010001     -- Data
rxd        01234567     -- Data
rxd        89ABCDEF     -- Data
rxd        01234567     -- Data
rxd        01234567     -- Data
rxd        89AB         -- Data
rxd        gggggggg     -- FCS


-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
filterc da 111112345678 sa 563412390008 type 0800


-- supply the receive buffer location
dma_rd fffff000 22222100 -- dma reads pointer of 22222100

-- check the receive data as it is written out on the AHB interface
dma_wr 22222100 12345678 -- store frame to memory
dma_wr 22222104 00081111
dma_wr 22222108 56341239
dma_wr 2222210c 00450008
dma_wr 22222110 00002A00
dma_wr 22222114 010A0000
dma_wr 22222118 BF86E181
dma_wr 2222211c BF86520B

pinsc(int) wol 1  -- check wol pin is high
apbrd(int) 24 10000000  -- check interrupt status - WOL interrupt

dma_wr 22222120 00082216
dma_wr 22222124 0100A289
dma_wr 22222128 23010100
dma_wr 2222212c AB896745
dma_wr 22222130 2301EFCD
dma_wr 22222134 23016745
dma_wr 22222138 AB896745
dma_wr 2222213c 030e3b64

dma_wr fffff004 0800c040 -- dma writes rx status,
                         -- start & end of frame
                         -- local 1 match
                         -- No VLAN tag detected
                         -- 64 bytes received
dma_wr fffff000 22222101 -- dma writes ownership bit


pinsc(int) wol 1  -- check wol pin is high


-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "Test 1 complete"
                        -- check interrupt status - receive complete
apbrd      20 00000002  -- check RX status register - receive complete
apbwr      20 00000002  -- clear RX status register




