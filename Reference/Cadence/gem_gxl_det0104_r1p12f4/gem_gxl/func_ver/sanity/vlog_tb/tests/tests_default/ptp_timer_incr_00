--------------------------------------------------------------------------------
--
-- Test Description
-- Check TSU timer values - ns is cleared, seconds is incremented every clock
--
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0

pinsd(50) tsu_inc_ctrl 00
pinsd(55) tsu_ms 1

--******************************************************************************
--  2. Check reset values of registers and setup interrupts.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register


-- check TSU timer and PTP event frame register
apbrd     1e0 00000000  -- PTP event frame transmitted seconds register
apbrd     1e4 00000000  -- PTP event frame transmitted nanoseconds register
apbrd     1e8 00000000  -- PTP event frame received seconds register
apbrd     1ec 00000000  -- PTP event frame received nanoseconds register
apbrd     1f0 00000000  -- peer event frame transmitted seconds register
apbrd     1f4 00000000  -- peer event frame transmitted nanoseconds register
apbrd     1d0 0000000d  -- Timer seconds register

apbrd     1dc 00000000  -- Timer increment



--******************************************************************************
--  3. Check Timer increment -
--     Set different increment values and alternative increment values
--******************************************************************************

-- Timer increment = 2 and alternative increment = 255 very 49th cycle
apbwr     1dc 0030ff02

apbrd     1d4 00000000  -- Timer nanoseconds register
apbrd     1d8 00000000  -- Timer adjust
apbrd     1f8 00000000  -- peer event frame received seconds register
apbrd     1fc 00000000  -- peer event frame received nanoseconds register

-- medium change
apbrd(410)   1d4 00000000  -- Timer nanoseconds register
apbrd(430)   1d4 00000000  -- Timer nanoseconds register
apbrd(450)   1d4 00000000  -- Timer nanoseconds register
apbrd(470)   1d4 00000000  -- Timer nanoseconds register

-- Timer increment = 254 and alternative increment = 1 very 3rd cycle
apbwr        1dc 000201fe
apbrd(612)   1d0 0000006d  -- Timer seconds register
apbrd(652)   1d0 00000075  -- Timer seconds register
apbrd(672)   1d0 00000079  -- Timer seconds register
apbrd(692)   1d0 0000007d  -- Timer seconds register

-- Timer increment = 1 and alternative increment = 0 very 2nd cycle
apbwr        1dc 00010001  -- Timer increment 1 decimal
apbrd(812)   1d0 00000095  -- Timer seconds register
apbrd(832)   1d0 00000099  -- Timer seconds register
apbrd(852)   1d0 0000009d  -- Timer seconds register
apbrd(872)   1d0 000000a1  -- Timer seconds register

-- Timer increment = 0 and alternative increment = 20 very 20th cycle
apbwr        1dc 00141400  -- Timer increment 0 decimal
apbrd(962)   1d0 000000b1  -- Timer seconds register
apbrd(982)   1d0 000000b5  -- Timer seconds register
apbrd(1007)  1d0 000000b9  -- Timer seconds register
apbrd(1022)  1d0 000000bd  -- Timer seconds register


end(10000)


