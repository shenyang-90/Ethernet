--
-- Tests several different combinations of short frames with an without pad
-- enabled to ensure padding applied correctly to desired frame.
-- Several frames designed to be short enough to fit into single word of FIFO
-- and are not valid IEEE 802.3 frames, however this test is merely making sure
-- the design doesn't break.
--
-- ************************************************************************** --
ten_meg_bit  -- 10Mbit/s operation (2.5Mhz tx_clk and rx_clk, 50MHz Pclk and Hclk)

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx

-- FRAME 1

dma_rd 55555504 00018002 -- no crc, start of frame, length 2 bytes
dma_rd 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
dma_rd 98765000 87554893

-- check for correct preamble, SFD, data
txd    55555555555555d59348

-- write transmit complete status for frame
dma_wr 55555504 80018002 -- write used bit

apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbrd	    14 00000028  -- tx status - frame transmitted, tx_go

-- END OF FRAME 1


