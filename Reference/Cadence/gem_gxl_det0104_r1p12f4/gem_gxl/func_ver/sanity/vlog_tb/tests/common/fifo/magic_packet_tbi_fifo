--
-- Test Description
-- Checks response to magic packet in 1Gbits/s TBI FIFO mode
-- 
-- Functional Coverage
-- * Checks that synchronisation FF bytes can be recognised anywhere in frame
-- * Checks that magic packet only accepted if spec_add1 is repeated 16 times
-- * Checks that magic packet can be seen if not aligned to 16-bit boundary
-- 
-- Detailed Test Description
--  1. Initialise suitable wait states for the test.
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in TBI mode into a 32-bit FIFO data bus.
--  3. Receive a correctly addressed frame that almost has a magic packet in it
--     and check that wol is not asserted.
--  4. Receive a correctly addressed frame that almost has a magic packet in it
--     at a non 16-bit alignment and check that wol is not asserted.
--  5. Receive a correctly addressed frame that has a magic packet but with
--     CRC/symbol error and check that wol is not asserted.
--  6. Receive a correctly addressed frame that has a magic packet and check for
--     wol assertion
--  7. Receive a correctly addressed frame that has a magic packet at a non 
--     16-bit alignment and check for wol assertion
--  8. Turn off the magic packet WoL mask and receive a good frame which has
--     a magic packet. Check that the frame is received and wol is not asserted.
--  9. Receive a good frame which is not a magic packet to ensure everything
--     is OK and check the wol is not asserted.
-- 10. Set the local addresss to all F's (broadcast) and receive a good broadcast
--     frame which contains a magic packet. Check that magic packet is asseted.
-- 11. Check statistics for correct values from above tests.
--
-- ************************************************************************** --

--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
-- Configuration Requirements ..
requires ext_fifo_interface 1
requires no_pcs 0
wait_states     0
bus_grant_delay 0



--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
apbrd(100) 00 00000000  -- check reset value of network control register

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd     184 00000000 -- ignore this read

apbwr     200 00000040  -- disable autonegotioation
apbrd     184 00000000 -- ignore this read

apbrd      08 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
-- #   -pcs_en   <1|0|random>, default = 0. Enables SGMII PCS
-- #   -pause_en <1|0|random>, default = 0. Enables pausing of transmission
-- #   -dont_copy_pause <1|0|random>, default = 0. Controls whether pause frames are copied
init_ncr -sgmii_en 0 -pcs_en 1 -retry_test 0 -copy_all 0 -duplex half -speed 1g -jumbo 0 -databus 32 -eam 0 -rx_toe 0 -pause_en 0 -dont_copy_pause 0 -multicast_hash 0 -unicast_hash 0

apbwr      B8 00010000  -- enable WoL magic packet mask
apbwr      00 00000004  -- enable receive
apbrd      00 zzzzzzzz repeat=15 -- repeat read 15 times to ensure rx enable is propagated through design
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      20 00000000  -- delay trigger for PCS syncing
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame


