--
-- Test Description
--
-- These are just some PTP frames that have verious errors in them to check
-- the decoder does not decode them as PTP frames. Crucial for code coverage
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  check reset state of PTP output flags
--******************************************************************************
pinsc(50) sof_tx         0
pinsc     sync_frame_tx  0
pinsc     delay_req_tx   0
pinsc     sof_rx         0
pinsc     sync_frame_rx  0
pinsc     delay_req_rx   0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 01080413  -- 
apbrd      04 01080413  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      18 fffff000  -- write receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts


--******************************************************************************
-- RX Frame 1 : PTP not primary or pdelay frame,
--******************************************************************************

apbrdf     20 00000000  -- Frame 3 : PTP pdelay_req frame
                        -- trigger reception of frame


rxd(apb)   5555555555d5     -- preamble & SDF
rxd        00e0f7263fe9     -- MAC DA
rxd        08002bb5a7a8     -- MAC SA
rxd        86dd             -- Length/typeID
rxd        67000000         -- Version, Traffic Class, Flow Label  
rxd        002c             -- Payload length  (==44)                
rxd        11ff             -- Next Header=UDP, Hop Limit
rxd        fe800000         -- Source Address (1st 32)
rxd        00000000         -- Source Address (2nd 32) 
rxd        00000800         -- Source Address (3rd 32)
rxd        2bb5a7a8         -- Source Address (4th 32) 
rxd        ff020000         -- Dest Address (1st 32)
rxd        00000000         -- Dest Address (2nd 32)
rxd        00000000         -- Dest Address (3rd 32)
rxd        0000006a         -- Dest Address (4th 32)
rxd        0209014f         -- UDP: Source and Destination Port
rxd        002cc0e2         -- UDP: Length, CheckSum
rxd        62               -- transport specific, messageType
rxd        000000           -- subdomain
rxd        00000000         -- subdomain
rxd        00000000         -- subdomain
rxd        00000000         -- subdomain
rxd        00000000         -- subdomain
rxd        00000000         -- other stuff
rxd        00000000         -- other stuff
rxd        00000000         -- UUID, sequenceID
rxd        00000010         -- sync frame control field, flags, reserved
rxd        gggggggg         -- MAC FCS


-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
filterc da e93f26f7e000 sa a8a7b52b0008 type 86dd


-- supply the receive buffer location
dma_rd fffff000 98767002 -- dma reads pointer of 98767000

-- check the receive data as it is written out on the AHB interface
dma_wr 98767000 26f7e000
dma_wr 98767004 0008e93f
dma_wr 98767008 a8a7b52b
dma_wr 9876700c 0067dd86
dma_wr 98767010 2c000000
dma_wr 98767014 80feff11
dma_wr 98767018 00000000
dma_wr 9876701c 00000000
dma_wr 98767020 b52b0008
dma_wr 98767024 02ffa8a7
dma_wr 98767028 00000000
dma_wr 9876702c 00000000
dma_wr 98767030 00000000
dma_wr 98767034 09026a00
dma_wr 98767038 2c004f01
dma_wr 9876703c 0062e2c0
dma_wr 98767040 00000000
dma_wr 98767044 00000000
dma_wr 98767048 00000000
dma_wr 9876704c 00000000
dma_wr 98767050 00000000
dma_wr 98767054 00000000
dma_wr 98767058 00000000
dma_wr 9876705c 00000000
dma_wr 98767060 zzzzzzzz
dma_wr 98767064 zzzzzzzz


dma_wr fffff004 00c0c066 -- dma writes rx status
dma_wr fffff000 98767003 -- dma writes ownership bit

-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "Frame 3 complete"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- clear interrupt status register
apbrd      20 00000002  -- check RX status register - receive complete
apbwr      20 00000002  -- clear RX status register

dma_rd fffff000 98767002 -- dma reads pointer of 98767000




end(12000)


