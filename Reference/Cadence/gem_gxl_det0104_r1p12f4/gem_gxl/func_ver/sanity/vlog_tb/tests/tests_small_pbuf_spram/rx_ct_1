check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 94;

sel_ahb_freq 3 
wait_states 0

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- setup 64b addressing, tx_ext_bd and rx_ext_bd in ms nibble of dma config register (address 10)
-- ms nibble = 
-- 7 for 64b addressing enabled and tx and rx ext_bd enabled 
-- 4 for 64b addressing enabled
-- 3 for tx and rx ext_bd enabled
--            |
--            |
apbwr      10 39a00710  -- enable mode (see above for ms nibble definition)

apbwr      28 fffffffd  -- enable all interrupts
apbwr      04 0008040a  -- 32bit enable, gigabit mode, full duplex
apbrd      04 0008040a  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      88 22222222  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbwr      18 ffff0000  -- write receive queue pointer
apbwr      480 f0010000 -- write receive queue pointer 1
apbwr      484 f0020000 -- write receive queue pointer 2
apbwr      488 f1020000 -- write receive queue pointer 3
apbwr      48c f2020000 -- write receive queue pointer 4
apbwr      490 f3020000 -- write receive queue pointer 5
apbwr      494 f4020000 -- write receive queue pointer 6
apbwr      498 f5020000 -- write receive queue pointer 7
apbwr      00 00000004  -- write  enable rx
apbwr     40 80000040  -- enable tx cut thru with threshold
apbwr     44 80000040  -- enable rx cut thru with threshold
-- delay for enable rx to propagate though design
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

rx_frame (apb)  1
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      num_dma_queues    8
      type_len_field random
      data_size      1000 
      data           random
      auto_gen_int   0
      resource_err   0
      fcs            good

hready_stop 2600 10195
rx_frame (gap)  1
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      num_dma_queues    8
      type_len_field random
      data_size      500
      data           random
      auto_gen_int   0
      resource_err   0
      fcs            good

dma_rd rx_q_ptr ddddd000 

-- force end of test in case it doesn't stop of its own accord
end(300000)

