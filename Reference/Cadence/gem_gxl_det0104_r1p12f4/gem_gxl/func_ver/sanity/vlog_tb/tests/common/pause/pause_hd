-- Test Description
-- This test ensures that the GEM can deal with pause frames eventhough it is 
-- operating in half duplex mode.
--
-- Functional Coverage
-- * Ensures that the reception of a pause frame won't inhibit the GEM from 
--   transmitting a normal frame.
-- * Ensures that the GEM cannot transmit a pause frame in half duplex mode.
-- Detailed test description
-- Note:  The retry test pin is set in the network configuration register to change the decrementer time from 512 bit period to 1 bit period to make the test quicker.
--
-- Pause time frame structure: 
-- Destination address	Source address	Type (GEM control frame)	Pause opcode 	Pause time
-- 0x0180C2000001	6 bytes	0x8808	0x0001	2 bytes
-- 
-- 1. Initialise the GEM for 100 mode operation.
-- 2. Check reset state of registers.
-- 3. Enable receive, transmit and all interrupts.
-- 4. Set pause enable bit in the network configuration register
-- 5. Receive a pause frame where the destination address matches pause frame address 
--    0x0180C2000001, type field = 0x8808, pause op-code = 0x0001 and pause time to be set is
--    0x00ff.  
-- 6. Transmit a minimum sized frame. (Should be transmitted immediately)
-- 7. Try to transmit a pause frame by the software control method.
-- 8. Try to transmit a pause frame by the hardware control method.
-- 9. Check the status and statistics registers and ensure that the above operations 
--     were handled properly
--------------------------------------------------------------------------------

requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1
requires axi 1

pinsc(10) loopback 0 half_duplex 1  extint 0 --  check reset state
bus_grant_delay 0 -- This sets hgrant to 1 always

-- The following ensures that whatever datawidth is selected for this test, the 
-- translator will pass through correct multiples of 32bit words for data transfers
-- (not descriptors). This relies on the test writer using the rx_descr and tx_descr to
-- differentiate between the DMA accesses.
enforce_data_width 1

-- In 32b datapaths, the 64bit descriptors are accessed not in incrementing order
-- The used bit is always read first, and written last.
-- For TX since the used bit is bit 63, the 2nd 32bit word is always read first
-- For RX since the used bit is bit 0, the 2nd 32bit word is always written first
-- This ordering is only there for 32bit modes
-- To simplify writing testcases and ensure the same test can operate on different datawidths
-- we can automatically reverse the order ...
auto_descriptor_swap 1

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

# Initialize the network configuration register
init_ncr -duplex half -speed 100m -databus random -pause_en 1 -copy_all 0

# Initialize the transmit and receive DMA queue pointers (random values by default)
# Disables all queues not mentioned here ...
init_q_ptr  -num_tx_queues 1   -num_rx_queues 1 -rx_ptr_q0 ffffff00 -tx_ptr_q0 55555500

# Enable the interrupts
enable_ints -num_queues 1   -vector ffffffff  # enable all ints

apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      08 00000006  -- check reset value of network status register
apbrd      38 00000000  -- check the value of the pause time register
apbwr      00 0000000C  -- enable receive and transmit
apbrd      00 0000000C num=100  -- check receive and transmit (repeat to ensure it has propagated through IP)

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame
pinsd(apb) loopback 0  --  this does nothing, needed to align the pin driver TB with the appropriate part of this test. 

-- ************************************************************************** --
-- 5. Receive a pause frame where the destination address matches pause frame address 
--    0x0180C2000001, type field = 0x8808, Pause op-code = 0x0001 and pause time 
--    to be set is 0xFFFF. (Frame should not be copied to memory)
-- ************************************************************************** --

rxd(apb)     d50180C200000111112222222288080001
rxd            00FF4444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            000000000000000000000000gggggggg

-- wait to receive a pause frame then try to transmit whilst the 
-- pause time is non-zero
apbrd(int)   24 00001000 -- check interrupt status - non-zero pause frame received
apbwr        24 00001000 -- clear interrupt status
apbrd        38 00000000 -- check the value of the pause time register (not loaded)


-- ************************************************************************** --
-- 6. Transmit a minimum sized frame. (Should be transmitted immediately)
-- ************************************************************************** --
apbwr      00 0000020c  -- write tx_go and enable tx
apbwr      00 0000040c  -- write tx halt immediately keeping tx enabled
                        -- this stops fetch of second frame

dma_rd tx_descr 55555500 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555504 0000803e -- start of frame, length 62 bytes


-- supply the transmit data to the AHB interface
dma_rd 98765000 005e0001
dma_rd 98765004 d0000200
dma_rd 98765008 04e7ecbc
dma_rd 9876500c c0450008
dma_rd 98765010 00003000
dma_rd 98765014 11020000
dma_rd 98765018 8c9e7258
dma_rd 9876501c 00e0fce0
dma_rd 98765020 c1070200
dma_rd 98765024 1c00c107
dma_rd 98765028 0000e9b6
dma_rd 9876502c 640a0308
dma_rd 98765030 69630002
dma_rd 98765034 006f6373
dma_rd 98765038 8c9e0000
dma_rd 9876503c 0000fde0


-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce000
txd		       000207c107c1001cb6e9000008030a64
txd		       0200636973636f0000009e8ce0fdfb2c1f72



-- write transmit complete status for the oldest frame 1
dma_wr 55555504 8000803e -- write used bit

-- Should get a transmit complete before pause time has expired
apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr       24 00000080  -- clear interrupt status
apbrd	    14 00000020  -- tx status - frame transmitted, used bit set

init_ncr -retry_test 1  -- speed up pause timer
apbrd       38 00000000  -- check the value of the pause time register (still zero)

-- ************************************************************************** --
-- 7. Try to transmit a pause frame by the software control method.
-- ************************************************************************** --

apbwr(scale 8000)  00 0000080C  -- tx pause and enable transmit and receive
apbrd(scale 15000) 24 00000000  -- check interrupt status   
apbrdf             24 00000000  -- check interrupt status   

-- ************************************************************************** --
-- 8. Try to transmit a pause frame by the hardware control method.
-- ************************************************************************** --

pinsd(apb) tx_pause_zero 1   -- drive tx_pause_zero high to use zero quantum
apbrd(scale 18000) 24 00000000  -- check interrupt status 
apbrdf            24 00000000  -- check interrupt status   
pinsd(apb) tx_pause 1    -- toggle tx_pause to start pause frame tx

apbrd(scale 21000)  24 00000000  -- check interrupt status   

-- check transmit statistics
apbrd(scale 12000) 100 00000042  -- check octets transmitted bottom
apbrd	  104 00000000  -- check octets transmitted top
apbrd	  108 00000001  -- check frames transmitted ok
apbrd	  10C 00000000  -- check broadcast frames transmitted
apbrd	  110 00000001  -- check multicast frames transmitted
apbrd	  114 00000000  -- check pause frames transmitted
apbrd	  118 00000000  -- check frames transmitted 64
apbrd	  11C 00000001  -- check frames transmitted 65-127
apbrd	  120 00000000  -- check frames transmitted 128-255
apbrd	  124 00000000  -- check frames transmitted 256-511
apbrd	  128 00000000  -- check frames transmitted 512-1023
apbrd	  12C 00000000  -- check frames transmitted 1024-1518
apbrd	  130 00000000  -- check frames transmitted 1519
apbrd	  134 00000000  -- check transmit underruns errors
apbrd	  138 00000000  -- check single collisions frames
apbrd	  13C 00000000  -- check multiple collisions frames
apbrd	  140 00000000  -- check excessive collisions frames
apbrd	  144 00000000  -- check late collisions frames
apbrd	  148 00000000  -- check deferred frames
apbrd	  14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd	  150 00000000  -- check octets received bottom
apbrd	  154 00000000  -- check octets received top
apbrd	  158 00000000  -- check frames received ok
apbrd	  15C 00000000  -- check broadcast frames received
apbrd	  160 00000000  -- check multicast frames received
apbrd	  164 00000001  -- check pause frames received
apbrd	  168 00000000  -- check frames received 64
apbrd	  16C 00000000  -- check frames received 65-127
apbrd	  170 00000000  -- check frames received 128-255
apbrd	  174 00000000  -- check frames received 256-511
apbrd	  178 00000000  -- check frames received 512-1023
apbrd	  17C 00000000  -- check frames received 1024-1518
apbrd	  180 00000000  -- check frames received 1519
apbrd	  184 00000000  -- check undersize frame errors
apbrd	  188 00000000  -- check excessive receive length errors
apbrd	  18C 00000000  -- check receive jabbers errors
apbrd	  190 00000000  -- check FCS errors
apbrd	  194 00000000  -- check receive length errors
apbrd	  198 00000000  -- check receive symbol errors
apbrd	  19C 00000000  -- check alignment errors
apbrd	  1A0 00000000  -- check receive resource errors
apbrdf    1A4 00000000  -- check receive overrun errors

-- ************************************************************************** --
-- force end of test in case it doesn't stop of its own accord
end(scale 25000)
