apbwr      558 0004c061  -- Screener2 reg 6, vlan enabled, comp reg = 6
apbwr      55c 0004e072  -- Screener2 reg 7, vlan enabled, comp reg = 7

-- In this test, the oofset type is always TYPE, and the mask is fixed
-- we are testing the offset field here
apbwr      700 12345678  -- Compare reg 0a
apbwr      704 00000380  -- Compare reg 0b, offset is 0
apbwr      708 23456789  -- Compare reg 1a
apbwr      70c 00000381  -- Compare reg 1b, offset is 1
apbwr      710 3456789a  -- Compare reg 2a
apbwr      714 00000382  -- Compare reg 2b, offset is 2
apbwr      718 456789ab  -- Compare reg 3a
apbwr      71c 00000383  -- Compare reg 3b, offset is 3
apbwr      720 56789abc  -- Compare reg 4a
apbwr      724 000003ff  -- Compare reg 4b, offset is 127 (max)
apbwr      728 6789abcd  -- Compare reg 5a
apbwr      72c 000003fe  -- Compare reg 5b, offset is 126 
apbwr      730 789abcde  -- Compare reg 6a
apbwr      734 000003ea  -- Compare reg 6b, offset is even and in full range (106 dec)
apbwr      738 89abcdef  -- Compare reg 7a
apbwr      73c 000003a1  -- Compare reg 7b, offset is odd and in full range (33 dec)

apbwr      00  00000004  -- enable receive
apbrd      24  00000000  -- check interrupt status
apbwr      28  ffffffff  -- enable all interrupts
apbrd      24  00000000  -- check interrupt status
apbwr      600 ffffffff  -- enable q1 interrupts
apbwr      604 ffffffff  -- enable q2 interrupts
apbrd      04  00080000  -- check reset value of network config register
apbrd      08  00000006  -- check reset value of network status register
apbwr      04  00080413  -- indicate 1gb operation, will check pin l8r.
apbrd      04  00080413  -- verify write to speed register..
