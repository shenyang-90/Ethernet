apbwr     4a0 00000001  -- Buffer size Q1
apbwr     4a4 00000001  -- Buffer size Q2
-- Setup the screeners
-- [3:0]  - Selected Queue
-- [7:4]  - VLAN priority 
-- [8]    - VLAN enable 
-- [11:9] - ethertype reg#
-- [12]   - ethertype match enable
-- [17:13]- compa reg#
-- [18]   - compa match enable
-- [23:19]- compb reg#
-- [24]   - compb match enable
-- [29:25]- compc reg#
-- [30]   - compc match enable
apbwr      540 00040002  -- Screener2 reg 0, vlan enabled, comp reg = 0
apbwr      544 00042011  -- Screener2 reg 1, vlan enabled, comp reg = 1
apbwr      548 00044020  -- Screener2 reg 2, vlan enabled, comp reg = 2
apbwr      54c 00046032  -- Screener2 reg 3, vlan enabled, comp reg = 3
