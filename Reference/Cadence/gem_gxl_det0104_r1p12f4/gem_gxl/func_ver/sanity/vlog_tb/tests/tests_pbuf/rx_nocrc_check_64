-- 05Jun2002     Arthur started it off
--
-- This tests the rx_no_crc_check bit in the network configuration
-- register. When set frames can be received with bad crc.
--
-- Receive two frames. The first with bad crc and the second with
-- good. Show that they are both received OK.
--
-- Receive a jumbo frame (6144 bytes) with bad crc. 
-- Check that the length is reported correctly and that the bad FCS status 
-- is not set as it is now used for the length field.
--
-- ************************************************************************** --


-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 00020304  -- Allow rx packets of up to 8k
apbwr      18 aaaaaaa0  -- write receive queue pointer
apbwr      00 0000000c  -- enable tx and rx
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 04280001  -- set rx_no_crc_check bit and 100M mode
apbrd      08 00000006  -- check reset value of network status register
apbwr      88 12345678  -- specific address register 1 bottom
apbwrf     8C 00001111  -- specific address register 1 top



-- drive the receive frame data into the MII interface
rxd(apb)   55d578563412111111112222222233333333
rxd            44444444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            000000000000000000000000badbadcc   -- bad crc


-- supply the receive buffer location
dma_rd aaaaaaa0 22222000 -- dma reads pointer of 22222000


-- check the receive data as it is written out on the AHB interface
dma_wr 22222000 12345678 -- store frame to memory
dma_wr 22222004 11111111
dma_wr 22222008 22222222
dma_wr 2222200c 33333333
dma_wr 22222010 44444444
dma_wr 22222014 55555555
dma_wr 22222018 66666666
dma_wr 2222201c 77777777
dma_wr 22222020 88888888
dma_wr 22222024 99999999
dma_wr 22222028 aaaaaaaa
dma_wr 2222202c bbbbbbbb
dma_wr 22222030 00000000
dma_wr 22222034 00000000
dma_wr 22222038 00000000
dma_wr 2222203c ccaddbba

dma_wr aaaaaaa0 22222001 -- dma writes ownership bit
dma_wr aaaaaaa4 0800e040 -- dma writes rx status, BAD FCS bit set (bit[13]), local address match and 64 bytes received

dma_rd aaaaaaa8 44440000 -- reads locations of next rx buffer


-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it


-- drive the receive frame data into the MII interface
rxd(gap)   55d578563412111111112222222233333333
rxd            44444444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            0000000000000000000000002638309b  -- good crc


-- check the receive data as it is written out on the AHB interface
dma_wr 44440000 12345678 -- store frame to memory
dma_wr 44440004 11111111
dma_wr 44440008 22222222
dma_wr 4444000c 33333333
dma_wr 44440010 44444444
dma_wr 44440014 55555555
dma_wr 44440018 66666666
dma_wr 4444001c 77777777
dma_wr 44440020 88888888
dma_wr 44440024 99999999
dma_wr 44440028 aaaaaaaa
dma_wr 4444002c bbbbbbbb
dma_wr 44440030 00000000
dma_wr 44440034 00000000
dma_wr 44440038 00000000
dma_wr 4444003c 9b303826

dma_wr aaaaaaa8 44440001 -- dma writes ownership bit
dma_wr aaaaaaac 0800c040 -- dma writes rx status, local address match and 64 bytes received

dma_rd aaaaaab0 44440008 -- reads locations of next rx buffer


-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it


-- check transmit statistics
apbrd     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
