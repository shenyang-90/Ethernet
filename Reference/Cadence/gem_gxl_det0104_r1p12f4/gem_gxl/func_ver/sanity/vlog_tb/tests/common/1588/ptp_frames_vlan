--
-- Test Description
-- See if a RX PTP sync frame with vlan TAG is detected
--
-- Receive frames:-
-- RX Frame 1 : PTP sync frame with VLAN 
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
-- Configuration Requirements ..
requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1
requires tsu 1
requires tsu_clk 1

-- The following ensures that whatever datawidth is selected for this test, the 
-- translator will pass through correct multiples of 32bit words for data transfers
-- (not descriptors). This relies on the test writer using the rx_descr and tx_descr to
-- differentiate between the DMA accesses.
enforce_data_width 1

-- In 32b datapaths, the 64bit descriptors are accessed not in incrementing order
-- The used bit is always read first, and written last.
-- For TX since the used bit is bit 63, the 2nd 32bit word is always read first
-- For RX since the used bit is bit 0, the 2nd 32bit word is always written first
-- This ordering is only there for 32bit modes
-- To simplify writing testcases and ensure the same test can operate on different datawidths
-- we can automatically reverse the order ...
auto_descriptor_swap 1

wait_states 0
bus_grant_delay 0


--******************************************************************************
--  check reset state of PTP output flags
--******************************************************************************
pinsc(50) sof_tx         0
pinsc     sync_frame_tx  0
pinsc     delay_req_tx   0
pinsc     sof_rx         0
pinsc     sync_frame_rx  0
pinsc     delay_req_rx   0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale
apbrd      08 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
init_ncr -duplex full -speed 100m -jumbo 0 -databus random -copy_all 1 -eam random -rx_toe 0

-- # Initialize the transmit and receive DMA queue pointers (random values but can add specifics if required)
-- # use arg -rx_ptr_q<Q> and tx_ptr_q<Q> to set specific ptr values rather than the default random
init_q_ptr  -num_tx_queues take_from_cfg   -num_rx_queues take_from_cfg -rx_ptr_q0 fffff000 -tx_ptr_q0 55555500

apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive
apbrd      00 zzzzzzzz repeat=15 -- repeat read 15 times to ensure rx enable is propagated through design
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status


--******************************************************************************
-- RX Frame 1 : PTP sync frame
--******************************************************************************

apbrdf     20 00000000  "Frame 1 : PTP sync frame - VLAN"
                        -- trigger reception of frame

rxd(apb)   55d5         -- preamble & SDF
rxd        011b19000000 -- MAC DA
rxd        00e0f7263fe9 -- MAC SA
rxd        81000001     -- VLAN TPID and TCI
rxd        88f7         -- Length/typeID
rxd        60           -- transportSpecific, messageType
rxd        656c6c       -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        abababab     -- other stuff
rxd        abababab     -- other stuff
rxd        abababab     -- UUID, sequenceID
rxd        00000000     -- sync frame control field, flags, reserved
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        gggggggg     -- FCS


--  check state of PTP output flags

-- check the correct DA, SA, type, and VID are
-- present on the filter interface
filterc da 000000191b01 sa e93f26f7e000  type 88f7 ptp_sync 1

-- supply the receive buffer location
dma_rd rx_descr fffff000 22222100 -- dma reads pointer of 22222100

-- check the receive data as it is written out on the AHB interface
dma_wr 22222100 00191b01 -- store frame to memory
dma_wr 22222104 e0000000
dma_wr 22222108 e93f26f7
dma_wr 2222210c 01000081  
dma_wr 22222110 6560f788
dma_wr 22222114 686f6c6c
dma_wr 22222118 686f6c65
dma_wr 2222211c 686f6c65
dma_wr 22222120 686f6c65
dma_wr 22222124 abab6c65
dma_wr 22222128 abababab
dma_wr 2222212c abababab
dma_wr 22222130 0000abab
dma_wr 22222134 00000000
dma_wr 22222138 00000000
dma_wr 2222213c 00000000
dma_wr 22222140 00000000
dma_wr 22222144 00000000
dma_wr 22222148 00000000
dma_wr 2222214c 00000000
dma_wr 22222150 00000000
dma_wr 22222154 00000000
dma_wr 22222158 00000000
dma_wr 2222215c 00000000
dma_wr 22222160 00000000
dma_wr 22222164 00000000
dma_wr 22222168 00000000
dma_wr 2222216c 00000000
dma_wr 22222170 00000000
dma_wr 22222174 00000000
dma_wr 22222178 a0570000
dma_wr 2222217c 00002acb

dma_wr rx_descr fffff000 22222101 -- dma writes ownership bit
dma_wr rx_descr fffff004 0020c07e -- dma writes rx status, (bit[21] = VLAN TAG idnentifier)



-- check status on detection of receive sync frame
apbrd(int) 24 00080000  "Frame 1 detected"
                        -- check interrupt status - receive sync frame
apbwr      24 00080000  -- clear interrupt status register
apbrd      20 00000000  -- check RX status register

-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "Frame 1 complete"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- clear interrupt status register
apbrd      20 00000002  -- check RX status register - receive complete
apbwr      20 00000002  -- clear RX status register



-- supply the receive buffer location
dma_rd rx_descr fffff008 22222100 -- 


-- check transmit statistics
apbrd(scale 22000)     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 0000007e  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000001  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000001  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000001  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors
apbrd     1A8 00000000  -- check receive IP checksum errors
apbrd     1AC 00000000  -- check receive TCP checksum errors
apbrd     1B0 00000000  -- check receive UDP checksum errors

end(100000)

