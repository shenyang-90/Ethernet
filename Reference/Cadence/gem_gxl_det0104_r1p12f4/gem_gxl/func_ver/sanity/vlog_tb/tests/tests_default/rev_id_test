--
--   Description      Direct test of the module id register 
--                    The point of this is an independent test that can
--                    be easily modified for new releases ...
--
--------------------------------------------------------------------------------

-- Check reset
apbwr(100) fc 00020200 --      the module id

-- write all 5's and all a's to alternate registers
apbwr     0fc 55555555  -- write all 5's to Module ID register
apbrd      fc 4207010c  -- check value of Module ID register

apbwr      fc aaaaaaaa  -- write all a's to Module ID register
apbrd      fc 4207010c  -- check value of Module ID register

apbwr      fc ffffffff  -- write all f's to Module ID register
apbrd      fc 4207010c  -- check value of Module ID register
