--
-- This test is based on the original test named without _addr64 extension,
-- and has 64b ahb/axi addressing added.  
--
--------------------------------------------------------------------------------
--
--   Description
----------------
--
-- This tests basic transmit functionality in nibble mode at 100Mbits/s.
--
--
-- Functional Coverage
----------------------
-- · Checks transmission with all combinations of data code group present
--   within the one frame using 100Mbits/s mode.
-- 
--
-- Detailed Test Description
----------------------------
--
-- Enable transmit and interrupts, write transmit address and
-- control registers.
--
-- Supply transmit data to the AHB interface and check the
-- transmitted data, pad and crc.
--
-- On reception of the transmit complete interrupt check the
-- interrupt and trasnmit status registers and the statistics
-- registers
--
-- This tests a frame supplied with known CRC:-
--
--    01 00 5E 00 00 02 Destination 
--    00 D0 BC EC E7 04 Source 
--    08 00 Protocol Type 
--    45 C0 00 30 00 00 00 00 02 11 IP Header 
--    58 72 IP Header Checksum 
--    9E 8C E0 FC E0 00 
--    00 02 
--    07 C1 Source Port 
--    07 C1 Destination Port 
--    00 1C Length 
--    B6 E9 UDP Checksum 
--
--    00 00 08 03 0A 64 02 00 63 69 73 63 6F 00 00 00 9E 8C E0 FD 
--    UDP Data 
--    FB 2C 1F 72 Frame Checksum 
--
--
--    Raw Packet Data 
--
--    01 00 5e 00 00 02 00 d0 bc ec e7 04 08 00 45 c0 
--    00 30 00 00 00 00 02 11 58 72 9e 8c e0 fc e0 00 
--    00 02 07 c1 07 c1 00 1c b6 e9 00 00 08 03 0a 64 
--    02 00 63 69 73 63 6f 00 00 00 9e 8c e0 fd fb 2c 1f 72
--
-- 
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080002  -- set to full duplex mode
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer

-- setup 64b addressing
apbrd      10 000207c4  -- check dma config reg initial value
apbwr      10 400207c4  -- enable 64b addr width (set bit[30] = 1)

apbwr     4c8 98abcdef  -- MSB BD base addr
apbwr     4cc 00000124  -- tx_bd_control_reg  where last 12 bits are: no_man_rd_access, no_man_wr_access, bd_size_words
apbwr     4d0 00000124  -- rx_bd_control_reg  where last 12 bits are: no_man_rd_access, no_man_wr_access, bd_size_words

apbwr      00 00000208  -- write tx_go and enable tx
#apbwr      00 00000408  -- write tx halt immediately keeping tx enabled
#                        -- this stops fetch of second frame
dma_rd tx_descr 98abcdef55555504 0000807e -- start of frame
dma_rd tx_descr 98abcdef55555500 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 98abcdef55555508 12345678 -- dma reads pointer msw


-- supply the transmit data to the AHB interface
dma_rd 1234567898765000 005e0001
dma_rd 1234567898765004 d0000200
dma_rd 1234567898765008 04e7ecbc
dma_rd 123456789876500c c0450008
dma_rd 1234567898765010 00003000
dma_rd 1234567898765014 11020000
dma_rd 1234567898765018 8c9e7258
dma_rd 123456789876501c 00e0fce0
dma_rd 1234567898765020 c1070200
dma_rd 1234567898765024 1c00c107
dma_rd 1234567898765028 0000e9b6
dma_rd 123456789876502c 640a0308
dma_rd 1234567898765030 69630002
dma_rd 1234567898765034 006f6373
dma_rd 1234567898765038 8c9e0000
dma_rd 123456789876503c 0000fde0
dma_rd 1234567898765040 005e0001
dma_rd 1234567898765044 d0000200
dma_rd 1234567898765048 04e7ecbc
dma_rd 123456789876504c c0450008
dma_rd 1234567898765050 00003000
dma_rd 1234567898765054 11020000
dma_rd 1234567898765058 8c9e7258
dma_rd 123456789876505c 00e0fce0
dma_rd 1234567898765060 c1070200

dma_rd 1234567898765064 1c00c107
dma_rd 1234567898765068 0000e9b6
dma_rd 123456789876506c 640a0308
dma_rd 1234567898765070 69630002
dma_rd 1234567898765074 006f6373
dma_rd 1234567898765078 8c9e0000
dma_rd 123456789876507c 0000fde0


-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce000
txd		       000207c107c1001cb6e9000008030a64
txd		       0200636973636f0000009e8ce0fd0000
txd          01005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce000
txd		       000207c107c1001cb6e9000008030a64
txd		       0200636973636f0000009e8ce0fdb560d634



-- write transmit complete status for the oldest frame 1
dma_wr 98abcdef55555504 8000807e -- write used bit



apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr  24 00000080  -- write to clear
apbrd	    14 00000028  -- tx status - frame transmitted, tx go


-- increment BD by 4 for extended BD (..555508 and ...55550c will be used to store TX TS)
dma_rd tx_descr 98abcdef55555514 0000803e -- start of frame, length 62 bytes
dma_rd tx_descr 98abcdef55555510 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 98abcdef55555518 87654321 -- dma reads pointer of MSW


-- supply the transmit data to the AHB interface
dma_rd 8765432198765000 005e0001
dma_rd 8765432198765004 d0000200
dma_rd 8765432198765008 04e7ecbc
dma_rd 876543219876500c c0450008
dma_rd 8765432198765010 00003000
dma_rd 8765432198765014 11020000
dma_rd 8765432198765018 8c9e7258
dma_rd 876543219876501c 00e0fce0
dma_rd 8765432198765020 c1070200
dma_rd 8765432198765024 1c00c107
dma_rd 8765432198765028 0000e9b6
dma_rd 876543219876502c 640a0308
dma_rd 8765432198765030 69630002
dma_rd 8765432198765034 006f6373
dma_rd 8765432198765038 8c9e0000
dma_rd 876543219876503c 0000fde0


-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce000
txd		       000207c107c1001cb6e9000008030a64
txd		       0200636973636f0000009e8ce0fdfb2c1f72



-- write transmit complete status for the oldest frame 1
dma_wr 98abcdef55555514 8000803e -- write used bit

dma_rd tx_descr 98abcdef55555524 8000807e -- start of frame, length 62 bytes - used bit set
dma_rd tx_descr 98abcdef55555520 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 98abcdef55555528 11223344 -- dma reads pointer of 00000000

apbrd(int)  24 00000088  -- check interrupt status - transmit complete
apbwr  24 00000080  -- write to clear
apbrd	    14 00000021  -- tx status - frame transmitted, used bit set




-- check transmit statistics
apbrd     100 000000c4  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000002  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000002  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000001  -- check frames transmitted 65-127
apbrd     120 00000001  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000000  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors


-- force end of test in case it doesn't stop of its own accord
end(5000)

bus_grant_delay 0

