-- Inputs a UDP frame which is split into 2 frames by the UDP fragmentation offload
-- functionality
-- IPv4 encapsulation
--
-- ************************************************************************** --

wait_states 2
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 10000000  -- write address of transmit buffer descriptor in memory
apbrd      1c 10000000  -- check transmit queue pointer
apbwr      10 00020c04  -- little endian, tx checksums enabled
apbwr      00 00000208  -- write tx_go and enable tx

-- FRAME 1
-- Header and payload in separate buffers with separate descriptors

-- Header Descriptor
dma_rd tx_descr 10000004 00020022 -- hardware CRC, UFO enable, 34 bytes
dma_rd tx_descr 10000000 20000000 -- header buffer base address
-- Payload Descriptor
dma_rd tx_descr 1000000C 00580008 -- MFS of 88 bytes, last bit clear, length 8 bytes
dma_rd tx_descr 10000008 20000022 -- payload buffer base address - follows from header buffer
-- Payload Descriptor
dma_rd tx_descr 10000014 0058805a -- MFS of 88 bytes, last bit set, length 90 bytes, MFS gives payload of 50, so round down to 48
dma_rd tx_descr 10000010 30000000 -- payload buffer base address
-- Used Descriptor
dma_rd tx_descr 1000001C 80000000 -- Used Bit
dma_rd tx_descr 10000018 00000000


-- Header buffer read
dma_rd 20000000 11111111
dma_rd 20000004 22221111
dma_rd 20000008 22222222
dma_rd 2000000c 00450008
dma_rd 20000010 00000000 
dma_rd 20000014 11000000 
dma_rd 20000018 66660000 
dma_rd 2000001c 55556666 
dma_rd 20000020 33335555 

-- Data buffer read - 8 bytes
dma_rd 20000020 33335555 
dma_rd 20000024 52004444
dma_rd 20000028 88880000

-- Header buffer read
dma_rd 20000000 11111111
dma_rd 20000004 22221111
dma_rd 20000008 22222222
dma_rd 2000000c 00450008
dma_rd 20000010 00000000 
dma_rd 20000014 11000000 
dma_rd 20000018 66660000 
dma_rd 2000001c 55556666 
dma_rd 20000020 00005555 

-- Data buffer read - 48 bytes
dma_rd 30000000 11111111
dma_rd 30000004 11111111
dma_rd 30000008 11111111
dma_rd 3000000c 11111111
dma_rd 30000010 11111111 
dma_rd 30000014 11111111 
dma_rd 30000018 11111111 
dma_rd 3000001c 11111111 
dma_rd 30000020 11111111 
dma_rd 30000024 11111111
dma_rd 30000028 11111111 
dma_rd 3000002c EEEEEEEE 

-- Header buffer read
dma_rd 20000000 11111111
dma_rd 20000004 22221111
dma_rd 20000008 22222222
dma_rd 2000000c 00450008
dma_rd 20000010 00000000 
dma_rd 20000014 11000000 
dma_rd 20000018 66660000 
dma_rd 2000001c 55556666 
dma_rd 20000020 00005555 

-- Data buffer read - 42 bytes - starting from end of first small frame
dma_rd 30000030 22222222
dma_rd 30000034 22222222
dma_rd 30000038 22222222
dma_rd 3000003c 22222222
dma_rd 30000040 22222222 
dma_rd 30000044 22222222 
dma_rd 30000048 22222222 
dma_rd 3000004c 22222222 
dma_rd 30000050 22222222 
dma_rd 30000054 22222222
dma_rd 30000058 3333ffff 


-- Fragmented frame 1

txd    55555555555555d5   -- preamble
txd    111111111111       -- ethernet header - destination address
txd    222222222222       -- ethernet header - source address
txd    0800               -- ethernet header - ethertype

txd    45                 -- IPv4 header - version, IHL 
txd    00                 -- IPv4 header - DSCP, ECN
txd    001C               -- IPv4 header - Total Length
txd    0000               -- IPv4 header - Identification
txd    2000               -- IPv4 header - Flags, Fragment Offset - MF Bit set
txd    00                 -- IPv4 header - Time to live
txd    11                 -- IPv4 header - Protocol
txd    235b               -- IPv4 header - Header Checksum
txd    66666666           -- IPv4 header - Source Address
txd    55555555           -- IPv4 header - Destination Address

txd    3333               -- UDP header  - Source Port
txd    4444               -- UDP header  - Destination Port
txd    0052               -- UDP header  - Length
txd    0000               -- UDP header  - Checksum

txd    0000000000000000   -- padding
txd    0000000000000000   -- padding
txd    0000               -- padding
txd    f7d8592b           -- FCS



-- Fragmented frame 2

txd    55555555555555d5   -- preamble
txd    111111111111       -- ethernet header - destination address
txd    222222222222       -- ethernet header - source address
txd    0800               -- ethernet header - ethertype

txd    45                 -- IPv4 header - version, IHL 
txd    00                 -- IPv4 header - DSCP, ECN
txd    0044               -- IPv4 header - Total Length
txd    0000               -- IPv4 header - Identification
txd    2001               -- IPv4 header - Flags, Fragment Offset - MF Bit set
txd    00                 -- IPv4 header - Time to live
txd    11                 -- IPv4 header - Protocol
txd    2332               -- IPv4 header - Header Checksum
txd    66666666           -- IPv4 header - Source Address
txd    55555555           -- IPv4 header - Destination Address

txd    11111111111111111111
txd    11111111111111111111
txd    11111111111111111111
txd    11111111111111111111
txd    11111111eeeeeeee
txd    6ecc842d           -- FCS



-- Fragmented frame 3

txd    55555555555555d5   -- preamble
txd    111111111111       -- ethernet header - destination address
txd    222222222222       -- ethernet header - source address
txd    0800               -- ethernet header - ethertype

txd    45                 -- IPv4 header - version, IHL 
txd    00                 -- IPv4 header - DSCP, ECN
txd    003e               -- IPv4 header - Total Length
txd    0000               -- IPv4 header - Identification
txd    0007               -- IPv4 header - Flags, Fragment Offset - MF Bit clear
txd    00                 -- IPv4 header - Time to live
txd    11                 -- IPv4 header - Protocol
txd    4332               -- IPv4 header - Header Checksum
txd    66666666           -- IPv4 header - Source Address
txd    55555555           -- IPv4 header - Destination Address

txd    22222222222222222222
txd    22222222222222222222
txd    22222222222222222222
txd    22222222222222222222
txd    ffff
txd    d55764ab           -- FCS

-- write transmit complete status for frame
dma_wr 10000004 80020022 -- write used bit

-- check frame completion interrupts

apbrd(int)  24 00000088  -- check interrupt status - transmit complete, stop bit
apbwr       24 00000088  -- clear interrupt status
apbrd	    14 00000021  -- tx status - frame transmitted, stop bit



-- force end of test in case it doesn't stop of its own accord
end(20000)

