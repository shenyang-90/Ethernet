wait_states 0
bus_grant_delay 0
set_random_seed 1;

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 0000ffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx and rx
apbwr     4ec 00000000  -- write restart counter



tx_frame  250
      number_of_bufs 1-10
      buffer_size    1-100
      auto_gen_int   0
      data           random
      fcs            YES


apbwr(1000)     4ec 00000001  -- write restart counter
apbwr(2000)     4ec 00000002  -- write restart counter
apbwr(3000)     4ec 00000003  -- write restart counter
apbwr(4000)     4ec 00000004  -- write restart counter
apbwr(5000)     4ec 00000005  -- write restart counter
apbwr(6000)     4ec 00000006  -- write restart counter
apbwr(7000)     4ec 00000007  -- write restart counter
apbwr(8000)     4ec 00000008  -- write restart counter
apbwr(10000)    4ec 00000009  -- write restart counter
apbwr(14000)    4ec 0000000a  -- write restart counter
apbwr(22000)    4ec 0000000b  -- write restart counter
apbwr(38000)    4ec 0000000c  -- write restart counter
apbwr(70000)    4ec 0000000d  -- write restart counter
apbwr(134000)   4ec 0000000e  -- write restart counter
apbwr(270000)   4ec 0000000f  -- write restart counter


apbrd(530000) 24 00000088  -- check interrupt status - transmit complete, used bit read
apbwr         24 00000088  -- clear interrupt status
apbrd	      14 00000021  -- tx status - frame transmitted, used bit set


-- force end of test in case it doesn't stop of its own accord
end(540000)

