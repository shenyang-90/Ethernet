--
--   Description
----------------
--
-- Random TX and RX operating together - all RX packets accepted, to maximize
-- AHB B/W - also operating at gigabit speeds
--
-- This is an 802.3br random test running with TBI interface
-- This is a test in which we are stimulating the MMSL making it receive some 
-- Verify/Respond packets and we also write some restart_ver to make sure that
-- the verification handshake can succeed after writing that register.
--------------------------------------------------------------------------------

sel_ahb_freq 2 

randomize_hready -read_max 4 -write_max 4
--check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 45;
--tog_cnt_en 1

-- Disable txd checking for this test
set_tx_data_check   0;


pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100)  00 00000000  -- check reset value of network control register
apbwr      04 0128041a  -- 64bit enable, gigabit mode, full duplex, no PCS yet ...
apbwr    1004 0128041a  
apbwr     f00 00000088  -- enable pre-empt, invert_mcrc set
apbwr      10 01a00701
apbwr    1010 01a00701
apbwr    1018 f0020000  -- write receive queue pointer 2
apbwr    101c 99000000  -- write transmit queue pointer 2
apbrd    101c 99000000  -- check transmit queue pointer

-- initialise the relevant pcs registers
apbrd      200 00009140  -- check reset value
apbwr      200 00000140  -- disable auto-negotiation prior to enabling PCS

apbwr     f1c ffffffff  -- Enabling all the interrupts for MMSL
apbwr      28 00000200  -- enable PCS interrupt
apbwr      1c 11111100  -- write address of transmit buffer q0 descriptor in memory
apbwr     440 88000000  -- write transmit queue pointer 1
apbwr     444 99000000  -- repeat transmit queue pointer 2, just need this for TB (pkt generator)
apbwr      18 ffff0000  -- write receive queue pointer
apbwr     480 f0010000  -- write receive queue pointer 1
apbwr     484 f0020000  -- repeat receive queue pointer 2, just need this for TB (pkt generator)
apbrd      08 00000006  -- check reset value of network status register
apbrd      1c 11111100  -- check transmit queue pointer

apbwr     4a0 00000001  -- Buffer size Q1
apbwr     4a4 000000a0  -- Buffer size Q2 -- just need this for TB (pkt generator)

apbwr      540 00040000  -- Screener2 reg 0, comp reg = 0
apbwr      544 00042011  -- Screener2 reg 1, comp reg = 1
apbwr      548 00044022  -- Screener2 reg 2, comp reg = 2
apbwr      54c 00046033  -- Screener2 reg 3, comp reg = 3

apbwr      700 000000ff  -- Compare reg 0a
apbwr      704 00000000  -- Compare reg 0b, offset is 0
apbwr      708 000100ff  -- Compare reg 1a
apbwr      70c 00000000  -- Compare reg 1b, offset is 0
apbwr      710 000200ff  -- Compare reg 2a
apbwr      714 00000000  -- Compare reg 2b, offset is 0
apbwr      718 000300ff  -- Compare reg 3a
apbwr      71c 00000000  -- Compare reg 3b, offset is 0

apbwr      04 01280c1a  -- 64bit enable, gigabit mode, full duplex, add PCS  ...
apbwr    1004 01280c1a  

apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd    284 6ef13fff  -- read design cfg reg to set axi test in trans.pl
apbrdf    20 00000000  -- check contents of the receive status register 
                       -- and trigger reception of frame

apbwr      00 00000004  -- enable rx
apbwr    1000 00000004  -- enable rx

apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  

-- check for link status change
apbrd(int) 24 00000200  -- check interrupt status - link status change
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx
apbwr    1000 0000020c  -- write tx_go and enable tx, enable rx

---------- Receiving a WRONG (in the payload) respond packet 
pcs_rxd(apb)      5555555555551900000000000000000000
pcs_rxd           0000000000000000000000000000000000000000
pcs_rxd           0000000000000000000000000000000000000000
pcs_rxd           000000000000000000010889edfbgg 

--------------------------------------------
-- reading the mmsl int status register ----
--------------------------------------------

apbrd(mmsl_int) f18 00000001 -- mmsl_int_status    : rcv_r_error
apbrd      f04 00000028 -- mmsl_status        : rcv_r_error and verify_status = SEND_VERIFY
apbrd      f08 00000000 -- mmsl_err_stats     : Nothing
apbwr      f18 00000001 -- clearing mmsl_int

-- Receiving another WRONG Respond packet (incomplete)
pcs_rxd(gap)      555555555555551900000000000000000000
pcs_rxd           0000000000000000000000000000000000000000  
pcs_rxd           0000000000000000000000000000000000000000  
pcs_rxd           0000000000000000gg 

--------------------------------------------
-- reading the mmsl int status register ----
--------------------------------------------

apbrd(mmsl_int) f18 00000001 -- mmsl_int_status    : rcv_r_error
apbrd      f04 0000002c -- mmsl_status        : rcv_r_error and verify_status = WAIT_FOR_RESPOND
apbrd      f08 00000000 -- mmsl_err_stats     : Nothing
apbwr      f18 00000001 -- clearing mmsl_int

-- Receiving a CORRECT Respond packet
pcs_rxd(gap)      555555555555551900000000000000000000
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           000000000000000000000889edfbgg 

-- Receiving first a WRONG a verify packet
pcs_rxd(gap)      5555555555550700000000000000000000
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           000000000000000000000889edffgg 

--------------------------------------------
-- reading the mmsl int status register ----
--------------------------------------------

apbrd(mmsl_int) f18 00000002 -- mmsl_int_status    : rcv_v_error
apbrd      f04 00000051 -- mmsl_status        : rcv_v_error, verify_status = VERIFIED, pre_active
apbrd      f08 00000000 -- mmsl_err_stats     : Nothing
apbwr      f18 00000002 -- clearing mmsl_int

-- Receiving another WRONG Verify packet
pcs_rxd(gap)      555555555555550700000000000000000000
pcs_rxd           0000000000000000000000000000000000000000  
pcs_rxd           0000000000000000000000000000000000000000  
pcs_rxd           0000000000000000gg 

--------------------------------------------
-- reading the mmsl int status register ----
--------------------------------------------

apbrd(mmsl_int) f18 00000002 -- mmsl_int_status    : rcv_v_error
apbrd      f04 00000051 -- mmsl_status        : rcv_v_error, verify_status = VERIFIED, pre_active
apbrd      f08 00000000 -- mmsl_err_stats     : Nothing
apbwr      f18 00000002 -- clearing mmsl_int

-- Receiving a CORRECT verify packet now
pcs_rxd(gap)      555555555555550700000000000000000000
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           000000000000000000000889edfbgg 

apbwr (700) f00 00000098 -- Writing restart_ver, invert_mcrc set
apbrd (710) f04 00000008 -- Reading Verify status to SEND_VERIFY

-- Receiving a CORRECT verify packet now
pcs_rxd(gap)      555555555555550700000000000000000000
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           000000000000000000000889edfbgg 


-- Receiving a CORRECT Respond packet
pcs_rxd(gap)      555555555555551900000000000000000000
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           0000000000000000000000000000000000000000 
pcs_rxd           000000000000000000000889edfbgg 
                      
