--
--   Description
----------------
--
-- Check that the MAC TX lockup interrupt is set when TX does not get out of the
-- line side interface as expected.
-- Done by setting the lockup time value to an artificially low value.
--
--
-- 
--------------------------------------------------------------------------------

--check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 94;

-- Set AHB clock freq to 250MHz
-- At 32bit, this means we have maximum bandwidth of 8Gbit/s shared between
-- TX and RX. Randomize hready, keeping the maximum to 5 (averages around 2.5)
-- to ensure no RX overflows occur, and max line rate is acheivable on TX
sel_ahb_freq 3 
randomize_hready -descr_max 5 -data_max 5 -read_max 5 -write_max 5
tog_cnt_en 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 01a00710  -- DMA config register
apbwr      28 c0000000  -- enable only lockup interrupts
apbwr      440 88000000 -- write transmit queue pointer 1
apbwr      444 99000000 -- write transmit queue pointer 2
apbwr      480 f0010000 -- write receive queue pointer 1
apbwr      484 f0020000 -- write receive queue pointer 2
apbwr      04 0008040a  -- 64bit enable, gigabit mode, full duplex
apbwr      04 0108040a  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 11111100  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 11111100  -- check transmit queue pointer
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbwr      4a0 00000001 -- Buffer size Q1
apbwr      4a4 00000001 -- Buffer size Q1
apbwr      500 31234aa0 -- Screener 1
apbwr      504 32345bb1 -- Screener 2 
apbwr      508 33456cc1 -- Screener 3
apbwr      50c 35678dd1 -- Screener 4
apbwr      510 36789ee1 -- Screener 5
apbwr      514 3789aff1 -- Screener 6
apbwr      518 389ab112 -- Screener 7
apbwr      51c 39abc222 -- Screener 8
apbwr      520 3abcd332 -- Screener 9
apbwr      524 3bcde442 -- Screener 10
apbwr      528 3cdef552 -- Screener 11
apbwr      52c 3def0662 -- Screener 12
apbwr      530 3ef01772 -- Screener 13
apbwr      534 3f012880 -- Screener 14
apbwr      538 3f5f5991 -- Screener 15
apbwr      53c 33d3daf2 -- Screener 16
apbwr      18 ffff0000  -- write receive queue pointer

-- Set up the ASF interrupt for lockup detection.
-- Note that at this point we are not enabling the actual ASF interrupt since we can 
-- also check the value on the ASF raw interrupt register.
apbwr     e34 00000000  -- Unmask all transaction timeout fault sources.

-- Reduce lockup detection values to artificially low values for MAC TX
apbwr      68 f7ff0000  -- Set prescale value to 0, results in toggle every cycle.
apbwr      6c 0004ffff  -- TX lockup time to 4 cycles.
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx
apbrd     284 6ef13fff  -- read design cfg reg to set axi test in trans.pl

tx_frame  1
      number_of_bufs 2
      num_dma_queues 3
      auto_gen_int   0
      buffer_size    250
      data           random
      fcs            YES


apbrd(int)  24  80000000  -- Interrupt status lockup detected.
apbwr       24  80000000  -- Write to clear
apbrd       24  00000000  -- Check cleared.

-- Check the ASF registers
apbrd           e00 00000000  -- No interrupts, still masked
apbrd           e04 00000010  -- Raw interrupt status, trans_to
apbrdf          e38 00000001  -- Trans TO fault status, also trigger pinsc

pinsc(apb)  asf_trans_to_err 1 ethernet_int 0

apbwr           e34 ffffffff  -- Mask all transaction timeout fault sources.

-- Trigger an ASF interrupt by unmasking trans to
apbwr           e08 00000000  -- Just unmask all ASF interrupts
apbrd(asf_fint) e00 00000010  -- ASF Interrupt default is fatal.
apbrdf          e04 00000010  -- No change to raw interrupt

pinsc(apb)  asf_trans_to_err 1 ethernet_int 0 asf_int_fatal 1

apbrd           e10 0000007f
apbwr           e10 00000000  -- Downgrade all ASF interrupts to non-fatal
apbrd(asf_int)  e00 00000010  -- ASF Interrupt non-fatal.
apbrdf          e04 00000010  -- No change to raw interrupt

pinsc(apb)  asf_trans_to_err 1 ethernet_int 0 asf_int_fatal 0 asf_int_nonfatal 1

apbwr           e00 000000ef  -- Write to clear - not the actual interrupt bit
apbrd           e00 00000010  -- No change
apbwr           e00 00000010  -- Write to clear
apbrdf          e00 00000000  -- Cleared

pinsc(apb)  asf_trans_to_err 0 ethernet_int 0 asf_int_fatal 0 asf_int_nonfatal 0

apbrd           e38 00000001  -- Trans TO fault status still unchanged
apbwr           e38 fffffffe  -- No change
apbrd           e38 00000001  -- Trans TO fault status still unchanged
apbwr           e38 00000001  -- Write to clear
apbrd           e38 00000000  -- Cleared.

-- The ASF interrupts are synchronised differently from the main GEM interrupts. The GEM interrupts
-- are edge detected whereas the ASF interrupts are level sensitive so we should never see the GEM
-- interrupt get set again until the lockup source clears. The ASF interrupt will trigger again as
-- soon as we unmask the trans_to source mask.
apbwr           e34 00000000  -- Unmask all transaction timeout fault sources.
apbrd(asf_int)  e00 00000010  -- Re-triggered
apbrdf          e04 00000010  -- Raw status
apbrdf          e38 00000001  -- Trans TO fault status set again

pinsc(apb)  asf_trans_to_err 1 ethernet_int 0 asf_int_fatal 0 asf_int_nonfatal 1

apbwr           00  00000000  -- Disable GEM
apbrd           00  00000000  -- Delay for propagation
apbrd           00  00000000  -- Delay for propagation
apbrd           00  00000000  -- Delay for propagation
apbrd           00  00000000  -- Delay for propagation
apbwr           e38 00000001  -- Write to clear
apbrd           e38 00000000  -- Cleared.
apbwr           e04 00000010  -- Write to clear via raw status register
apbrdf          e00 00000000  -- Cleared

pinsc(apb)  asf_trans_to_err 0 ethernet_int 0 asf_int_fatal 0 asf_int_nonfatal 0


-- force end of test in case it doesn't stop of its own accord
end(8000)

