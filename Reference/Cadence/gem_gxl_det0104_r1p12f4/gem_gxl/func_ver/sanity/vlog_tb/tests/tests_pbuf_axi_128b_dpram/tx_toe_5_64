dma_rd 22222218 00000000
dma_rd 2222221c 11000000
dma_rd 22222220 00000000
dma_rd 22222224 00000000
dma_rd 22222228 00000000
dma_rd 2222222c 00000000


txd        55555555555555d5         -- preamble & SDF
txd        FFFFFFFFFFFF -- MAC DA
txd        080039123456 -- MAC SA
txd        05db         -- Length/typeID
txd        aaaa         
txd        0300         
txd        0000         
txd        0800         -- Length/typeID
txd        4401         -- Version, IHL, type of service
txd        0000     
txd        0000     
txd        0000     
txd        0011     
txd        0000     
txd        0000     

txd        00000000     
txd        00000000     
txd        00000000     
txd        00000000     
txd        00000000     
txd        00000000     

txd        93b5fe75     -- FCS


-- write transmit complete status for the oldest frame 1
dma_wr 5555550c 80308030 -- write used bit 


apbrd(int)  24 00000088  -- check interrupt status - transmit complete
apbwr       24 00000088  -- check interrupt status - transmit complete
apbrd	      14 00000021  -- tx status - frame transmitted,



dma_rd tx_descr 55555510 98767000 -- 
