--
--   Description
----------------
--
-- This tests covers all remaining paths to the IDLE state
-- Includes transition from VLAN2 to IDLE through IP1 and SNAP4 to IP2 through
-- IP1
--
--
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbwr      04 00280000  -- check reset value of network config register
apbrd      04 00280000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      10 00020c04  -- enable 4k ram and tcp offload
apbwr      00 00000208  -- write tx_go and enable tx


--******************************************************************************
-- Test 5.1
--    VLAN2 packet and IP packet
--******************************************************************************

dma_rd tx_descr 55555500 22222200 -- dma reads pointer of 98765000
dma_rd tx_descr 55555504 0000802c -- start of frame


-- supply the transmit data to the AHB interface
dma_rd 22222200 FFFFFFFF -- store frame to memory
dma_rd 22222204 0008FFFF
dma_rd 22222208 56341239
dma_rd 2222220c 01000081
dma_rd 22222210 01050008
dma_rd 22222214 00000000
dma_rd 22222218 11000000
dma_rd 2222221c 00000000
dma_rd 22222220 00000000
dma_rd 22222224 00000000
dma_rd 22222228 00000000
dma_rd 2222222c 00000000


txd        55555555555555d5         -- preamble & SDF
txd        FFFFFFFFFFFF -- MAC DA
txd        080039123456 -- MAC SA
txd        8100         -- Length/typeID
txd        0001         -- VLAN tag
txd        0800         -- Length/typeID
txd        0501         -- Version, IHL, type of service
txd        0000     
txd        0000     
txd        0000     
txd        0011     
txd        0000     
txd        0000     

txd        00000000     
txd        00000000     
txd        00000000     
txd        00000000     
txd        00000000     
txd        00000000     
txd        00000000     

txd        0f226175     -- FCS


-- write transmit complete status for the oldest frame 1
dma_wr 55555504 8030802c -- write used bit 

apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr       24 00000080  -- check interrupt status - transmit complete
apbrd	      14 00000028  -- tx status - frame transmitted,

