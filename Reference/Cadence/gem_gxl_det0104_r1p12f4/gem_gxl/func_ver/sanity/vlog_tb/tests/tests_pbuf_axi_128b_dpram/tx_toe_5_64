--    SNAP4 via IP1 to IDLE
--******************************************************************************

dma_rd tx_descr 55555508 22222200 -- dma reads pointer of 98765000
dma_rd tx_descr 5555550c 00008030 -- start of frame


-- supply the transmit data to the AHB interface
