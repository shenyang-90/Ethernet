--
--   Description
--
-- Ensures that the mac can transmit a frames greater than 16k bytes in length
-- and that it is correctly reported in the statistics registers
--
-- Functional Coverage
-- -------------------
--
-- · check that the mac can transmit frames >16k bytes
-- · ensure octects transmitted is recorded as 16k bytes
--
-- Detailed Test Description
-- -------------------------
-- 
-- 1. Transmit a 16k + 1 = 16385 byte frame.
-- 2. Check statistics - octets transmitted should show 16383 (0x3fff)
--
--------------------------------------------------------------------------------
wait_states 0

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

--******************************************************************************
-- Normal Gigabit Operation

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00280400  -- network config register - 1gig mode, 64 bit ahb
apbwr      00 00000008  -- write enable tx 
apbrd      04 00280400  -- check network config register

