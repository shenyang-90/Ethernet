--
-- Test Description
-- See if a variety of PTP version 2 unicast frames encapsulated in IPv4 can't
-- be detected because unicast disabled, some have incorrect addresses
--
-- Receive frames:-
-- RX Frame 1 : PTP sync frame
-- RX Frame 2 : PTP delay request frame
-- RX Frame 3 : PTP sync frame but DA address not unicast - not recognized
-- RX Frame 4 : PTP pdelay_req frame
-- RX Frame 5 : PTP pdelay_resp frame
-- RX Frame 6 : PTP sync frame DA address not unicast - not recognized
-- RX Frame 7 : PTP sync frame DA address not unicast - not recognized
--
-- Transmit frames:-
-- TX Frame 1 : PTP sync frame
-- TX Frame 2 : PTP delay request frame
-- TX Frame 3 : PTP pdelay_req frame 
-- TX Frame 4 : PTP pdelay_resp frame 
-- TX Frame 5 : PTP sync frame event with incorrect address
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  check reset state of PTP output flags
--******************************************************************************
pinsc(50) sof_tx          0
pinsc     sync_frame_tx   0
pinsc     delay_req_tx    0
pinsc     pdelay_req_tx   0
pinsc     pdelay_resp_tx  0
pinsc     sof_rx          0
pinsc     sync_frame_rx   0
pinsc     delay_req_rx    0
pinsc     pdelay_req_rx   0
pinsc     pdelay_resp_rx  0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
