-- Test Description
-- Check received PFC pause frame on DMA inetrface
-- Transmit PFC pause frame with reg1 addreass matching through DMA inetrface																																																																		   tion.
-- Transmit PFC pause frame with multicast addreass matching through DMA inetrface
-- Check that pause frame tx'ed interrupt is NOT set and
-- frame tx'ed interrupt is set. 
-- Check that pause frame tx'ed stats register is NOT incremented and 
-- frame tx'ed stats register is incremented.																																																																		   tion.
--
--------------------------------------------------------------------------------


pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 ffffff00  -- write address of receive buffer descriptor in memory
apbrd      18 ffffff00  -- check receive queue pointer
apbwr      00 0001000c  -- enable receive & transmit & PFC pause frame reception
apbrd      00 0001000c  -- enable receive & transmit & PFC pause frame reception
apbwr      04 00083003  -- set enable pause time bit(13)
apbrd      04 00083003  -- check network configuration register
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      08 00000006  -- check reset value of network status register
apbrd      38 00000000  -- check the value of the pause time register

-- The next two commands point to the location of the receive buffer descriptor
-- queue in memory

apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

-- ******************************************************************************* --
-- Receive a PFC pause frame where the destination address matches register 1, 
-- type field = 0x8808, pause op-code = 0x0101 and priority enable to be set is 0x0008.
-- Try to transmit a valid frame with valid CRC.  However, the frame should not 
-- be transmitted until the pause time counter is zero.  Once the pause 
-- time counter is zero the frame should be transmitted properly.
-- ******************************************************************************* --

rxd(apb)     d578563412111111112222222288080101
rxd            00084444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            000000000000000000000000gggggggg


-- supply the receive buffer location
dma_rd ffffff00 22222004 -- dma reads pointer of 22222004


-- check the receive data as it is written out on the AHB interface
dma_wr 22222004 12345678 -- store frame to memory
dma_wr 22222008 11111111
dma_wr 2222200c 22222222
dma_wr 22222010 01010888
dma_wr 22222014 44440800
dma_wr 22222018 55555555
dma_wr 2222201c 66666666
dma_wr 22222020 77777777
dma_wr 22222024 88888888
dma_wr 22222028 99999999
dma_wr 2222202c aaaaaaaa
dma_wr 22222030 bbbbbbbb
dma_wr 22222034 00000000
dma_wr 22222038 00000000
dma_wr 2222203c 00000000
dma_wr 22222040 951aa796


dma_wr ffffff04 0800c040 -- checks for local address match, 64 bytes 
dma_wr ffffff00 22222005 -- dma writes ownership bit
dma_rd ffffff08 22222204 -- reads locations of next rx buffer

apbrd(int)   24 00001000 -- check interrupt status - non-zero pause frame received & frame rx'ed
apbwr        24 00001000 -- clear interrupt status
apbrd(int)   24 00000002 -- check interrupt status - non-zero pause frame received & frame rx'ed
apbwr        24 00000002 -- clear interrupt status
apbrd        38 00000000 -- check the value of the pause time register (-1 due to delay through packet buffer)
apbrd       158 00000001 -- check frames rxed OK (register 1 match)


-- ************************************************************************** --
-- *               Driving in frame to be transmitted                       * --
-- ************************************************************************** --

apbwr        1c 11111000 -- write transmit queue pointer register
apbwr        00 0000020C -- write tx_start
apbrd        14 00000000 -- read transmit status register
apbwr        00 0000040C -- write tx_halt to ensure dma does not fetch next frame
                         -- right away
                         
                         
-- transmit PFC pause frame with reg 1 matching from DMA
-- supply the transmit data to the AHB interface
dma_rd 11111004 00018040 -- length 64, no CRC and end of frame
dma_rd 11111000 98765000 -- TX buffer address


dma_rd 98765000 12345678
dma_rd 98765004 11111111
dma_rd 98765008 22222222
dma_rd 9876500c 01010888
dma_rd 98765010 0200ff00
dma_rd 98765014 06000400
dma_rd 98765018 0a000800
dma_rd 9876501c 0e000c00
dma_rd 98765020 88880f00
dma_rd 98765024 99999999
dma_rd 98765028 aaaaaaaa
dma_rd 9876502c bbbbbbbb
dma_rd 98765030 cccccccc
dma_rd 98765034 dddddddd
dma_rd 98765038 eeeeeeee
dma_rd 9876503c ffffffff

dma_wr 11111004 80018040 -- write back ownership bit to tx descriptor


-- check for correct preamble, SFD, data, pad and crc 
-- (wait for pause time zero interrupt before checking)
txd       55555555555555d578563412111111112222222288080101
txd		                  00ff0002000400060008000a
txd                               000c000e000f888899999999
txd                               aaaaaaaabbbbbbbbcccccccc
txd                               ddddddddeeeeeeeeffffffff


-- check status on transmit complete interrupt
apbrd(int)   24 00000080 -- check interrupt status - transmit complete
apbwr        24 00000080 -- clear interrupt status
apbrd        14 00000020 -- read transmit status register - frame transmitted 
apbwr        14 00000020 -- clear transmit status register
apbrd       108 00000001 -- check one frame txed OK
apbrd	     38 00000000  -- check rx pause time


-- ************************************************************************** --
-- *               Driving in frame to be transmitted                       * --
-- ************************************************************************** --

apbwr        00 0000020C -- write tx_start
apbrd        14 00000000 -- read transmit status register
apbwr        00 0000040C -- write tx_halt to ensure dma does not fetch next frame
                         -- right away


-- transmit PFC pause frame with multicast address matching from DMA
dma_rd 1111100c 00018040 -- length 64, no CRC and end of frame
dma_rd 11111008 98765000 -- read next descriptor

dma_rd 98765000 00c28001 
dma_rd 98765004 11110100
dma_rd 98765008 22222222
dma_rd 9876500c 01010888
dma_rd 98765010 4444ff00
dma_rd 98765014 55555555
dma_rd 98765018 66666666
dma_rd 9876501c 77777777
dma_rd 98765020 88888888
dma_rd 98765024 99999999
dma_rd 98765028 aaaaaaaa
dma_rd 9876502c bbbbbbbb
dma_rd 98765030 cccccccc
dma_rd 98765034 dddddddd
dma_rd 98765038 eeeeeeee
dma_rd 9876503c ffffffff

dma_wr 1111100c 80018040 -- write back ownership bit to tx descriptor

-- check for correct preamble, SFD, data, pad and crc 
txd       55555555555555d50180c200000111112222222288080101
txd		                  00ff44445555555566666666
txd                               777777778888888899999999
txd                               aaaaaaaabbbbbbbbcccccccc
txd                               ddddddddeeeeeeeeffffffff



-- check status on transmit complete interrupt
apbrd(int)   24 00000080 -- check interrupt status - transmit complete
apbwr        24 00000080 -- clear interrupt status
apbrd        14 00000020 -- read transmit status register - frame transmitted
apbwr        14 00000020 -- clear transmit status register
apbrd        14 00000000 -- read transmit status register 
apbrd        38 00000000 -- check rx pause time
apbrd       158 00000000 -- check frames rxed OK (No register 1 match)

-- check transmit statistics
apbrd     100 00000080  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000001  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000001  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000002  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000040  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000001  -- check pause frames received
apbrd     168 00000001  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrdf    1A4 00000000  -- check receive overrun errors




-- ************************************************************************** --
end(15000)
