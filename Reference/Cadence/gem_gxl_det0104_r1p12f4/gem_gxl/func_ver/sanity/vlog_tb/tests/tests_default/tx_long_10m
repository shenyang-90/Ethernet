-- This tests transmission of a frame greater than max length.
--
-- Enable transmit and interrupts, write transmit address and
-- control registers.
--
-- Supply transmit data to the AHB interface and check the
-- transmitted data, pad and crc.
--
-- On reception transmit complete interrupt check the
-- interrupt and trasnmit status registers and the statistics
-- registers
--
--

ten_meg_bit  -- 10Mbit/s operation (2.5Mhz tx_clk and rx_clk, 50MHz Pclk and Hclk)

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000008  -- enable transmit and receive
apbrd      14 00000000  -- read transmit status register


-- The next two commands point to the location of the transmit buffer descriptor
-- queue in memory
apbwr	   1c ffffff00  -- write address of transmit buffer descriptor in memory
apbrd	   1c ffffff00  -- check receive queue pointer

-- supply the transmit buffer location
dma_rd ffffff04 00008600 -- end of frame and 1548 bytes
dma_rd ffffff00 99999000 -- dma reads pointer of 99999000

-- Start the transmission by setting the go bit in network control register
apbwr      00 00000208  -- write transmit start bit and enable tx and rx




