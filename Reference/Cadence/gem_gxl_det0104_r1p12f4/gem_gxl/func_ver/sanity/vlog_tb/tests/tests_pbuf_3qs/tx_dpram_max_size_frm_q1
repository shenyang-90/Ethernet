
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbwr      600 ffffffff  -- enable all interrupts
apbwr      604 ffffffff  -- enable all interrupts
apbwr	     1c  000a0000  -- write address of transmit buffer descriptor in memory
apbwr      440 100a0000  -- write transmit queue pointer 1
apbwr      444 200a0000  -- write transmit queue pointer 2
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000008  -- enable transmit and receive
apbrd      14 00000000  -- read transmit status register

-- Start the transmission by setting the go bit in network control register
apbwr      00 00000208  -- write transmit start bit and enable tx and rx


-- The TX DPRAM size is 8KBytes, split into 4 segments of 2KBytes each
-- The DPRAM region for queue 1 has 1 segment, = 2KBytes

-- -------------------------------------------------------------------
-- 1.First make sure we can transmit a frame of 1900 bytes ...

dma_rd 200a0004 8000876c -- end of frame and 1900 bytes
dma_rd 200a0000 22222000 -- dma reads pointer of 99999000
dma_rd 100a0004 0000876c -- end of frame and 1900 bytes
dma_rd 100a0000 22222000 -- dma reads pointer of 99999000
dma_rd 000a0004 02435674 -- dma reads pointer for Queue 1,should be ignored

-- read the data
dma_rd(474) 22222000 a5a5a5a5 -- read frame from memory

txd        55555555555555d5
txd        
txd        
txd        
txd        
txd        
txd        zzzzzzzz

-- write used bit
dma_wr 100a0004 8000876c

dma_rd 200a0004 80000000 -- used bit read
dma_rd 200a0000 00000000 --
dma_rd 100a000c 80000000 -- used bit read
dma_rd 100a0008 00000000 --
dma_rd 000a0004 80000000 -- used bit read
dma_rd 000a0000 00000000 --

apbrd(int1) 400 00000080  -- check interrupt status - transmit complete
apbwr       400 00000080  -- clear interrupt status
apbrd       14 00000020  -- read transmit status register - frame transmitted and tx_go
apbwr       14 00000020  -- read transmit status register - frame transmitted and tx_go
apbrd       20 00000000  -- check contents of the receive status register
apbwr       00 00000208  -- write transmit start bit and enable tx and rx

-- -------------------------------------------------------------------
-- 2.Now make sure we cant transmit a frame of 2000 bytes in 1 buffer ...

dma_rd 200a0004 800087d0 -- end of frame and 2000 bytes
dma_rd 200a0000 22222000 -- dma reads pointer of 99999000
dma_rd 100a000c 000087d0 -- end of frame and 2000 bytes
dma_rd 100a0008 22222000 -- dma reads pointer of 99999000
dma_rd 000a0004 02435674 -- dma reads pointer for Queue 1,should be ignored

-- read the data up till the buffer gets full ....
-- The burst will be cancelled once the data is actually writen to the 
-- internal DPRAM, but this is a few cycles after the AHB read access
--, so quite a few AHB reads are performed first. -this means in this
-- case all of the data is actually read from AHB
dma_rd(499) 22222000 a5a5a5a5 -- read 500 words (1 less than max)

-- whan a single frame is too large, this is seen as a serious problem
-- at this point, the frame is rejected and an interrupt is delivered

dma_wr 100a000c 880087d0

apbrd(int1) 400 00000040  -- check interrupt status 
apbwr       400 00000040  -- clear interrupt status
apbrd       14 00000011  -- read transmit status register
apbwr       14 00000011  -- read transmit status register
apbrd       20 00000000  -- check contents of the receive status register
apbwr       00 00000208  -- write transmit start bit and enable tx and rx

-- -------------------------------------------------------------------
-- 2.Now make sure we can transmit a frame of 1988 bytes in 1 buffer ...
-- This is the maximum we can fit into the region

dma_rd 200a0004 800087c6 -- end of frame and 1988 bytes
dma_rd 200a0000 22222000 -- dma reads pointer of 99999000
dma_rd 100a000c 000087c6 -- end of frame and 1988 bytes
dma_rd 100a0008 22222000 -- dma reads pointer of 99999000
dma_rd 000a0004 02435674 -- dma reads pointer for Queue 1,should be ignored

-- read the data up till the buffer gets full ....
dma_rd(497) 22222000 a5a5a5a5 -- read 498 words

txd        55555555555555d5
txd        
txd        
txd        
txd        
txd        
txd        zzzzzzzz

dma_wr 100a000c 800087c6

dma_rd 200a0004 80000000 -- used bit read
dma_rd 200a0000 00000000 --
dma_rd 100a0014 80000000 -- used bit read
dma_rd 100a0010 00000000 --
dma_rd 000a0004 80000000 -- used bit read
dma_rd 000a0000 00000000 --

apbrd(int1) 400 00000080  -- check interrupt status - transmit complete
apbwr       400 00000080  -- clear interrupt status
apbrd       14 00000020  -- read transmit status register - frame transmitted and tx_go
apbwr       14 00000020  -- read transmit status register - frame transmitted and tx_go
apbrd       20 00000000  -- check contents of the receive status register
