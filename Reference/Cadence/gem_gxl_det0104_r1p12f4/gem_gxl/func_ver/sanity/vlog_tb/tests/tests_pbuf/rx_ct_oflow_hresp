-- In this cut thru test, the packet being written to AHB causes
-- an overflow in the MAC side of the PBUF.  In addition, an AHB error 
-- on the packet occurs

wait_states 2
sel_ahb_freq 1 
bus_grant_delay 2
pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 09a20010
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 00000000  -- write receive queue pointer
apbrd      18 00000000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      44 80000010  -- enable rx cut thru with threshold = 0x15
apbwr      04 0008040a  -- gigabit, enable jumbo
apbrd      04 0008040a  -- verify write to speed register..
apbrd      20 00000000  -- check contents of the receive status register and trigger reception of frame

-- delay for enable rx to propagate though design
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbwr     00 00000004  -- enable receive
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrdf    20 00000000  


---------------------------------------
-- TEST 1: FRAME SIZE 64 BYTES (PADDED)
---------------------------------------

dma_rd 00000000 f0000000

-- 64 byte frame
rx_frame (apb)  1
      preamble_size  14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      includerxdma   0
      data_size      50 
      data           random
      fcs            good

-- Data
dma_wr(16) f0000000 zzzzzzzz -- not checking the data

-- Writeback
dma_wr 00000004 8000c044
dma_wr 00000000 f0000001

-------------------------------------------------------------
-- With a single packet, lets overflow the PBUF
-------------------------------------------------------------

rx_frame (gap)  1
      preamble_size  14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      data_size      10000
      includerxdma   0
      auto_gen_int   0 
      data           random
      fcs            good

-- descriptor reads
dma_rd 00000008 f0000000

dma_wr(436) f0000000 zzzzzzzz -- PKT 1

-- 5 more AHB writes available before overflow occurs.  However, on the next
-- one we get an HRESP error...
dma_wr f00006d4 zzzzzzzz not_ok
dma_wr f00006d8 zzzzzzzz 
dma_wr f00006dc zzzzzzzz 
dma_wr f00006e0 zzzzzzzz 
--dma_wr f00006d4 zzzzzzzz 



--dma_wr 0000000c 8000e722
--dma_wr 00000008 f0000001


apbrd(int) 24 00000400 -- Overflow
apbwr      24 00000400

-- Interrupts 
apbrd(int) 24 00000800 --HRESP
apbwr      24 00000800







-- receive and process a good frame to ensure everything has recovered ...
dma_rd 00000008 f0000000 -- reads location of next rx buffer


rx_frame (gap)  1
      preamble_size  14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      includerxdma   0
      auto_gen_int   0 
      data_size      50 
      data           random
      fcs            good

-- Data
dma_wr(16) f0000000 zzzzzzzz -- not checking the data

-- Writeback
dma_wr 0000000c 8000c044
dma_wr 00000008 f0000001

apbrd(int) 24 00000002
apbwr 24 00000002

dma_rd 00000010 dddddddd -- reads location of next rx buffer


-- check status 
apbrd      24 00000000  -- check interrupt status - receive complete
apbrd      20 0000000f  -- check contents of the receive status register- frame overflow
apbrd      20 0000000f  -- check it again
apbwr      20 0000fffd  -- don't clear it
apbrd      20 00000002  -- check it again
apbwr      20 00000002  -- clear it
apbrd      20 00000000  -- check it again
apbrd      38 00000000  -- check rx pause time

-- check transmit statistics
apbrd     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors


-- force end of test in case it doesn't stop of its own accord
end(50000)

