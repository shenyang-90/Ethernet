--
--   Description
----------------
--
-- Test interrupt moderation in default configuration in 10M, 100M and 1G modes
--
-- In each case turn on transmit interrupt moderation and send three frames 
-- at the end of the third frame an interrupt will occur for the used bit being 
-- read then there will be a pause until the interrupt moderation times out and
-- then a single tx complete interrupt will occur.
--
-- The interrupt moderation timer starts after transmission of the first frame
-- and subsequent transmit frames will have no affect on it.
--
-- The user io out bits are set and checked after the interrupt has been read
-- to verify the interrupts dop not occur early.
--
-- The clock period is 40 ns for both 10m and 100m modes so the for the 10M
-- config 80ns periods are counted rather than 800ns.
--
-- The test has now been extended to test SGMII 1G, 100M and 10M operation.
-- this tests tx_clk speeds of 125MHz, 12.5MHz and 1.25MHz
--
-- 20th February 2017 extended to test interrupt threshold moderation with
-- transmission of five frames
--
--------------------------------------------------------------------------------

-- need the following to prevent underruns in gigabit operation
wait_states 0
bus_grant_delay 0


pinsc(50) loopback 0 half_duplex 1  extint 0  user_out 00000000 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      0c 000000ff  -- write user_out bits to ff
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080002  -- set to full duplex mode - bit 0 is 0 so design thinks its in 10meg mode even though the clocks are running at 25MHz
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      5c 00000000  -- interrupt moderation
apbwr      5c 00ff0003  -- interrupt moderation 255 * 80ns = 20.4 us (80 rather than 800 because clock applied is 25MHz even though 10Meg is indicated)
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx

-- send three frames and then get used bit read interrupt
dma_rd 55555504 0000803e -- start of frame, length 62 bytes
dma_rd 55555500 98765000


