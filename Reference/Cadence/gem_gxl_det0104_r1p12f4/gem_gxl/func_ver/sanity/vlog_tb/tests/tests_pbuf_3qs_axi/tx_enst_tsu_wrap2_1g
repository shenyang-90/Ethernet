--
--   Test           : tx_enst_tsu_wrap_1g
--
--
--------------------------------------------------------------------------------
--
--  Summary
--  This test will specifically check that the core will still work when the TSU 
--  will pass from 1 sec, 999'999'999 ns to 2 sec
--------------------------------------------------------------------------------

-- 64 bit,
-- gigabit, 
-- 250Mhz AHB

sel_ahb_freq 2 

randomize_hready -read_max 5 -write_max 5
--check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 0;
--tog_cnt_en 1

-- Disable txd checking for this test
set_tx_data_check   0;


pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr     440 88000000  -- write transmit queue pointer 1
apbwr     444 99000000  -- write transmit queue pointer 2
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 0128041a  -- 64bit enable, gigabit mode, full duplex
apbrd      08 00000006  -- check reset value of network status register
apbwr      f8 00000001  -- check Q0 DPRAM fill levl
apbrd      f8 00000001  -- check Q0 DPRAM fill levl
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbrd     284 6ef13fff  -- read design cfg reg to set axi test in trans.pl

--------------------------------------
----  TSU registers                 --
--------------------------------------
apbrd     1d0 00000000  -- TSU timer seconds
apbwr     1d0 00000001  -- TSU timer seconds -- 1 sec
apbwr     1d4 3b9a9f08  -- TSU timer nanoseconds -- 999'989'000
apbrd     1d8 00000000  -- TSU timer adjust, write only
apbrd     1dc 00000000  -- TSU timer increment
apbwr     1dc 00000064  -- TSU timer increment


--------------------------------------
---- EnST registers                 --
---- Setup as follows               --
--      ___
--Q0  _|   |_________|
--          ___
--Q1  _____|   |____
--              ___
--Q2  _________|   |
--
---------------------------------------
apbwr     800 7b9ac67c  -- Q0 pmac Start time -- 1'999'999'100
apbwr     820 00000800  -- Q0 pmac On time 
apbwr     840 00001000  -- Q0 pmac Off time

apbwr     804 7b9b067c  -- Q1 pmac Start time
apbwr     824 00000800  -- Q1 pmac On time 
apbwr     844 00001000  -- Q1 pmac Off time

apbwr     808 7b9b467c  -- Q0 emac Start time
apbwr     828 00000800  -- Q0 emac On time 
apbwr     848 00001000  -- Q0 emac Off time

apbwr     880 00000007  -- EnST Enable

apbwr(390) 00 00000208  -- write tx_go and enable tx


tx_frame  50
      number_of_bufs 1
      num_dma_queues 3
      auto_gen_int   0
      buffer_size    100-120
      data           random
      fcs            YES

-- force end of test in case it doesn't stop of its own accord
end(60000)

bus_grant_delay 0









