apbwr        24 00002000 -- Clear it
apbrd        38 00000000 -- check the value of the pause time register
apbrdf       08 00000006 -- check pfc_negotiate = 0

pinsc(apb)  pfc_negotiate 0 rx_pfc_paused 00000000

