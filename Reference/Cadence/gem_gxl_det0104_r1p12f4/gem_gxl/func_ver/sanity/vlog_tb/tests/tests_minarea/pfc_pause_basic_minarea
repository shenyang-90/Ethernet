fifo_wr      1000     0   00xxxxxxxxxx    11111111
fifo_wr      1000     0   00xxxxxxxxxx    22222222
fifo_wr      1000     0   00xxxxxxxxxx    01000888
fifo_wr      1000     0   00xxxxxxxxxx    4444ff00
fifo_wr      1000     0   00xxxxxxxxxx    55555555
fifo_wr      1000     0   00xxxxxxxxxx    66666666
fifo_wr      1000     0   00xxxxxxxxxx    77777777
fifo_wr      1000     0   00xxxxxxxxxx    88888888
fifo_wr      1000     0   00xxxxxxxxxx    99999999
fifo_wr      1000     0   00xxxxxxxxxx    aaaaaaaa
fifo_wr      1000     0   00xxxxxxxxxx    bbbbbbbb
fifo_wr      1000     0   00xxxxxxxxxx    00000000
fifo_wr      1000     0   00xxxxxxxxxx    00000000
fifo_wr      1000     0   00xxxxxxxxxx    00000000
fifo_wr      1001     0   000010000040    54e952d2


apbrd(int)   24 00001002 -- check interrupt status - non-zero pause frame received & frame rx'ed
apbwr        24 00001002 -- Clear it 
apbrd       158 00000000 perr -- check frames rxed OK (register 1 match)
apbrd        38 000000ff -- check the value of the pause time register
                         -- This will be updated in PCLK by the time we get an interrupt
                         -- as we have to wait for the DMA to complete.  Note that by 
                         -- time the interrupt happens, it has already decremented

