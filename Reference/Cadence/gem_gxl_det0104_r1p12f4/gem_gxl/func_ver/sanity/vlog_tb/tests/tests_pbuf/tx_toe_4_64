--   Description
----------------
--
-- This tests ensures that illegally early End of packets will reset the
-- the TCP state machine correctly
--
--
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state
sel_ahb_freq 3

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbwr      04 00280000  -- check reset value of network config register
apbrd      04 00280000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      10 00020c04  -- enable 4k ram and tcp offload
apbwr      00 00000208  -- write tx_go and enable tx


--******************************************************************************
-- Test 4.1
--    Detect an EOP in the START state
--******************************************************************************

dma_rd 55555500 98765000 -- dma reads pointer of 98765000
dma_rd 55555504 00008010 -- start of frame


-- supply the transmit data to the AHB interface
dma_rd 98765000 FFFFFFFF -- store frame to memory
dma_rd 98765004 0008FFFF
dma_rd 98765008 56341239
dma_rd 9876500c 01000608

txd         55555555555555d5 -- preamble & SDF
txd         FFFFFFFFFFFF 
txd         080039123456 
txd         0806         
txd         0001     

txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     
txd         00000000     

txd         dbce1fce     


-- write transmit complete status for the oldest frame 1
dma_wr 55555504 80408010 -- write used bit 

apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr       24 00000080  -- check interrupt status - transmit complete
apbrd	      14 00000028  -- tx status - frame transmitted,


