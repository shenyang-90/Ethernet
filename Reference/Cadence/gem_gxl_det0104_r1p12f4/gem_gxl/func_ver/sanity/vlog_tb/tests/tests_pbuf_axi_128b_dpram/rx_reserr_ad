      fcs                 good

rx_frame (gap)  1
      preamble_size       1-14
      dest_addr           broadcast
      src_addr            111122222222
      type_len_field      0080
      data_size           16-32
      data                random
      debug_print_frame   0
      resource_err        1
      num_dma_queues      1
      auto_gen_int        0
      fcs                 good

dma_rd rx_descr f0000000 00000001
rx_frame (gap)  1
      preamble_size       1-14
      dest_addr           broadcast
