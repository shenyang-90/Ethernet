# try 5 consecutive good frames without resource errors, then 3 frames
# with resource errors, then 10 without
apbrd(3000) 04 0108040a  -- Delay
apbrdf     04 0108040a  -- set trigger for next frame
rx_frame (apb)  5
      preamble_size       1-14
      dest_addr           broadcast
      src_addr            111122222222
      type_len_field      0080
      data_size           16-32
      data                random
      debug_print_frame   0
