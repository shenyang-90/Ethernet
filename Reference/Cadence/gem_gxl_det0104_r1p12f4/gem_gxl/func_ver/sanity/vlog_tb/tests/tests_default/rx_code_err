rxd                     44444444555555556666666677777777
rxd                     8888888899999999aaaaaaaabbbbbbbb
rxd                     ccccccccddddddddeeeeeeee
rxd                     9e6207c3  -- good CRC


dma_rd fffff000 22222000 -- dma reads pointer of 22222000


-- frame dropped because of symbol error
-- No further DMA because symbol error occurs before address match.




