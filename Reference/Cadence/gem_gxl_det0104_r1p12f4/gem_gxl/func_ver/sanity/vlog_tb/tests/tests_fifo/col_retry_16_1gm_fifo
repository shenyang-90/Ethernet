--
--   Description
-- 
-- This test ensures that the GEM properly deals with excessive collisions 
-- in 1 gigabit mode.
-- 
-- Functional Coverage
-- -------------------
-- · Ensures that the GEM flags a collision frame statistic when more 
--     than 15 collisions occur in 1 gigabit mode.  
-- · Ensures that the GEM will not retransmit a frame when more than 15 
--     collisions occur.
-- · Ensures that the GEM is able to transmit a frame after it is properly 
--     reconfigured.
-- 
-- Detailed Test Description
-- -------------------------
-- 1.  Check reset state of loopback, half_duplex, and extint pins.
-- 2.  Initialise GEM for 1 gigabit operation.
-- 3.  Transmit a frame and at the beginning of the data portion of 
--      the frame cause a collision.
-- 4.  The GEM should back-off and sometime later re-try to 
--      retransmit the frame.
-- 5.  Repeat steps 4 and 5 fifteen more times.
-- 6.  After the 16th collision the frame should not be transmitted and 
--      a flag for excessive collisions should be set. Also, there should be 
--      16 collision frames logged in the collision frames statistic register.
-- 7.  Check status and statistics registers and ensure that the above 
--      operations were handled properly.
-- 8.  Transmit a frame.
-- 9.  Check status and statistics registers and ensure that the above 
--      operations were handled properly.
--
--------------------------------------------------------------------------------

--******************************************************************************
-- 1.  Check reset state of loopback, half_duplex, and extint pins.

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

--******************************************************************************
-- 2.  Initialise GEM for 1 gigabit operation.

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00081400  -- network config register - 1gig mode
                        -- reduce backoff time to zero
apbwr      00 00000008  -- write enable tx
apbrdf     00 00000008  -- confirm tx enable (apb trigger to trigger FIFO)

--******************************************************************************
-- 3.  Transmit a frame and at the beginning of the data portion of 
--      the frame cause a collision.

-- transmit a 64 (0x40) byte frame:
-- preamble: '0x55555555555555'
-- sfd:      '0xd5'
-- destaddr: '0x57df3b51cefe' unicast frame
-- srcaddr:  '0x5f18183e23d6'
-- typeid:   '0xb62f'
-- data:      46 bytes
-- crc:       autogenerated
--
-- Supply data to TX FIFO interface
--
-- CONTROL =  <RESERVED>, NO CRC, FLUSH, UNDERFLOW, RDY, ERR, SOP, EOP.
--
--              CONTROL     MOD   STATUS      DATA

fifo_rd(apb)    00001010      0   00000000    3b51cefe
fifo_rd         00001000      0   00000100    23d657df
fifo_rd         00001000      0   00000000    5f18183e
fifo_rd         00001000      0   00000000    b5222fb6
fifo_rd         00001000      0   00000000    41ccd444
fifo_rd         00001000      0   00000000    b6c1f9ed
fifo_rd         00001000      0   00000000    fe49dc11
fifo_rd         00001000      0   00000000    37f8a9fd
fifo_rd         00001000      0   00000000    a4466f14
fifo_rd         00001000      0   00000000    bf7f3137
fifo_rd         00001000      0   00000000    dbd2372d
fifo_rd         00001000      0   00000000    fa542f81
fifo_rd         00001000      0   00000000    b8594db4
fifo_rd         00001000      0   00000000    39fae96b
fifo_rd         00001001      0   00000000    e6925aaa

