apbrdf    20 00000000  -- check contents of the receive status register 
                       -- and trigger reception of frame

rx_frame (apb)  1
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      num_dma_queues    8
      type_len_field random
      data_size      16 
      data           random
      auto_gen_int   1
      resource_err   0
      fcs            good

rx_frame (gap)  200
      preamble_size  1-14
      dest_addr      broadcast
