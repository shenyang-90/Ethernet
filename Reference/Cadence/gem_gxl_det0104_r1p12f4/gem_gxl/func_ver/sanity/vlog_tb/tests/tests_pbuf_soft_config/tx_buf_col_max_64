--wait_states 1
--bus_grant_delay 4

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      00 00000008  -- enable transmit 
apbwr      28 ffffffff  -- enable all interrupts
apbwr      04 00281000  -- set retry_test in network config register
apbrd      04 00281000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register

-- ************************************************************************** --
-- Setup a multi-buffer transmit queue in memory

apbwr      1c 55555000  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555000  -- check transmit queue pointer
apbwr      00 00000208  -- Start the transmission by setting the go bit in network control register

