--
--   Description
----------------
--
-- This tests basic transmit functionality in gigabit mode, using the DMA
-- with 64-bit wide databus.
--
--
-- Functional Coverage
----------------------
-- · Checks transmission with all combinations of data code group present
--   within the one frame using the DMA with 64-bit wide databus.
-- 
--
-- Detailed Test Description
----------------------------
--
-- Enable transmit and interrupts, write transmit address and
-- control registers.
--
-- Supply transmit data to the AHB interface and check the
-- transmitted data, pad and crc.
--
-- On reception of the transmit complete interrupt check the
-- interrupt and trasnmit status registers and the statistics
-- registers
--
-- This tests a frame supplied with known CRC:-
--
--    01 00 5E 00 00 02 Destination 
--    00 D0 BC EC E7 04 Source 
--    08 00 Protocol Type 
--    45 C0 00 30 00 00 00 00 02 11 IP Header 
--    58 72 IP Header Checksum 
--    9E 8C E0 FC E0 00 
--    00 02 
--    07 C1 Source Port 
--    07 C1 Destination Port 
--    00 1C Length 
--    B6 E9 UDP Checksum 
--
--    00 00 08 03 0A 64 02 00 63 69 73 63 6F 00 00 00 9E 8C E0 FD 
--    UDP Data 
--    FB 2C 1F 72 Frame Checksum 
--
--
--    Raw Packet Data 
--
--    01 00 5e 00 00 02 00 d0 bc ec e7 04 08 00 45 c0 
--    00 30 00 00 00 00 02 11 58 72 9e 8c e0 fc e0 00 
--    00 02 07 c1 07 c1 00 1c b6 e9 00 00 08 03 0a 64 
--    02 00 63 69 73 63 6f 00 00 00 9e 8c e0 fd fb 2c 1f 72
--
-- 
--------------------------------------------------------------------------------

wait_states 0
bus_grant_delay 0




pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbwr      04 00280000  -- check reset value of network config register
apbrd      04 00280000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
--apbwr      04 00480400  -- network config register - 1gig mode, 128 bit ahb
apbwr      04 00280400  -- network config register - 1gig mode, 64 bit ahb
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx
--apbwr      00 00000408  -- write tx halt immediately keeping tx enabled
                        -- this stops fetch of second frame


dma_rd tx_descr 55555500 98765000 -- dma reads pointer of 98765000
dma_rd tx_descr 55555504 0000807e -- start of frame


