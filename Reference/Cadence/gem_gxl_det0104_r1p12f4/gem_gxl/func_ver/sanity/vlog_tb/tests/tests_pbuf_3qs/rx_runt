apbrdf      20 00000000  -- check contents of the receive status register- frame received


--***********************************************************************--
-- 11. Receive a frame with 6 bytes of preamble, SFD, the MAC destination 
--     address and an arbitrary source address. (Should be discarded)
--***********************************************************************--

rxd(apb)         555555555555d5785634121111fd6cc3a62b42

-- check status on reception of receive complete interrupt
apbrd(4000) 24 00000000  -- check interrupt status - receive complete
apbrd       20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 12. Enable the GEM for gigabit operation.
--***********************************************************************--
apbwr      04 00080400  -- enable gigabit mode
apbrd      04 00080400  -- check that gigabit mode is enabled
apbrdf     04 00080400  -- check that gigabit mode is enabled

--***********************************************************************--
-- 13. Receive a frame with 6 bytes of preamble. (Should be discarded)
--***********************************************************************--

rxd(apb)         555555555555

-- check status on reception of receive complete interrupt
apbrd(4500) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 14. Receive a frame with 6 bytes of preamble, and SFD. (Should be discarded)
--***********************************************************************--

rxd(apb)         555555555555d5

-- check status on reception of receive complete interrupt
apbrd(5000) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 15. Receive a frame with 6 bytes of preamble, SFD, and the MAC destination 
--     address. (Should be discarded)
--***********************************************************************--

rxd(apb)         555555555555d5785634121111

-- check status on reception of receive complete interrupt
apbrd(5500) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received


--***********************************************************************--
-- 16. Receive a frame with 6 bytes of preamble, SFD, the MAC destination 
--     address and an arbitrary source address. (Should be discarded)
--***********************************************************************--

rxd(apb)         555555555555d5785634121111fd6cc3a62b42


-- check status on reception of receive complete interrupt
apbrd(6000) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 17. Receive a frame with 6 bytes of preamble plus extension. (Should be discarded)
--***********************************************************************--

rxd(apb_x)         555555555555

-- check status on reception of receive complete interrupt
apbrd(6500) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 18. Receive a frame with 6 bytes of preamble, and SFD plus extension. (Should be discarded)
--***********************************************************************--

rxd(apb_x)         555555555555d5

-- check status on reception of receive complete interrupt
apbrd(7000) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 19. Receive a frame with 6 bytes of preamble, SFD, and the MAC destination 
--     address plus extension. (Should be discarded)
--***********************************************************************--

rxd(apb_x)         555555555555d5785634121111

-- check status on reception of receive complete interrupt
apbrd(7500) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received


--***********************************************************************--
-- 20. Receive a frame with 6 bytes of preamble, SFD, the MAC destination 
--     address and an arbitrary source address plus extension. (Should be discarded)
--***********************************************************************--

rxd(apb_x)         555555555555d5785634121111fd6cc3a62b42

-- check status on reception of receive complete interrupt
apbrd(8000) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received


--***********************************************************************--
-- 21. Receive a valid minimum length frame which is copied to memory
--***********************************************************************--

rxd(apb_x)         555555555555d578563412111111112222222233333333
rxd                              44444444555555556666666677777777
rxd                              8888888899999999aaaaaaaabbbbbbbb
rxd                              ccccccccddddddddeeeeeeeegggggggg

dma_wr 443582ec 12345678
dma_wr 443582f0 11111111
dma_wr 443582f4 22222222
dma_wr 443582f8 33333333
dma_wr 443582fc 44444444
dma_wr 44358300 55555555
dma_wr 44358304 66666666
dma_wr 44358308 77777777
dma_wr 4435830c 88888888
dma_wr 44358310 99999999
dma_wr 44358314 aaaaaaaa
dma_wr 44358318 bbbbbbbb
dma_wr 4435831c cccccccc
dma_wr 44358320 dddddddd
dma_wr 44358324 eeeeeeee
dma_wr 44358328 c307629e

dma_wr c7bafd70 0800c040 -- writeback status - start & end, local 1, 64 bytes
dma_wr c7bafd6c 443582ed -- writeback used bit

-- check status on reception of receive complete interrupt
apbrd(int)  24 00000002  -- check interrupt status - receive complete
apbwr       24 00000002  -- clear it
apbrd       20 00000002  -- check contents of the receive status register- frame received


--***********************************************************************--
-- 22. Check statistic registers and ensure above operation was handled 
--     properly.
--***********************************************************************--

-- check transmit statistics
