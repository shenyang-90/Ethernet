-- Test Description
-- This test ensures the GEM in 10/100/1000 mode deals with runt frames properly.
-- 
-- Functional coverage
-- · Ensures that in 10/100 mode that received frames that are less than 64 bytes are discarded.
-- · Ensures that in 1000 mode that received frames that are less than 64 bytes plus extension
--   are discarded.
--
-- Detailed Test Description
-- 1. Initialise the GEM for 100-mode operation.
-- 2. Enable copy all frames.
-- 3. Receive a frame that is 15 bytes long. (Should be discarded)
-- 4. Receive a frame that is 13 bytes long. (Should be discarded)
-- 5. Receive a frame that is 4 bytes long. (Should be discarded)
-- 6. Receive a frame that is 3 bytes long. (Should be discarded)
-- 7. Disable copy all frames.
-- 8. Receive a frame with 6 bytes of preamble. (Should be discarded)
-- 9. Receive a frame with 6 bytes of preamble, and SFD. (Should be discarded)
-- 10. Receive a frame with 6 bytes of preamble, SFD, and the MAC destination 
--     address. (Should be discarded)
-- 11. Receive a frame with 6 bytes of preamble, SFD, the MAC destination 
--     address and an arbitrary source address. (Should be discarded)
-- 12. Enable the GEM for gigabit operation.
-- 13. Receive a frame with 6 bytes of preamble. (Should be discarded)
-- 14. Receive a frame with 6 bytes of preamble, and SFD. (Should be discarded)
-- 15. Receive a frame with 6 bytes of preamble, SFD, and the MAC destination 
--     address. (Should be discarded)
-- 16. Receive a frame with 6 bytes of preamble, SFD, the MAC destination 
--     address and an arbitrary source address. (Should be discarded)
-- 17. Receive a frame with 6 bytes of preamble plus extension. (Should be 
--     discarded)
-- 18. Receive a frame with 6 bytes of preamble, and SFD plus extension. 
--     (Should be discarded)
-- 19. Receive a frame with 6 bytes of preamble, SFD, and the MAC destination 
--     address plus extension. (Should be discarded)
-- 20. Receive a frame with 6 bytes of preamble, SFD, the MAC destination 
--     address and an arbitrary source address plus extension. (Should be discarded)
-- 21. Receive a valid minimum length frame which is copied to memory
-- 22. Check statistic registers and ensure above operation was handled 
--     properly.
--------------------------------------------------------------------------------

wait_states 0
bus_grant_delay 0

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 c7bafd6c  -- write receive queue pointer
apbrd      18 c7bafd6c  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080011  -- indicate 100M operation, copy all frames, will check pin l8r.
apbrd      04 00080011  -- verify write to speed register..
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame


--***********************************************************************--
-- 3. Receive a frame that is 15 bytes long. (Should be discarded)
--***********************************************************************--

rxd(apb)         5555d5785634121111fd6cc3a62b42aabbcc

-- read the first receive queue descriptor
dma_rd c7bafd6c 443582ec

-- check status on reception of receive complete interrupt
apbrd(490) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 4. Receive a frame that is 13 bytes long. (Should be discarded)
--***********************************************************************--

rxd(apb)         5555d5785634121111fd6cc3a62b42aa

-- check status on reception of receive complete interrupt
apbrd(1000) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 5. Receive a frame that is 4 bytes long. (Should be discarded)
--***********************************************************************--

rxd(apb)         5555d578563412


-- check status on reception of receive complete interrupt
apbrd(1500) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 6. Receive a frame that is 3 bytes long. (Should be discarded)
--***********************************************************************--

rxd(apb)         5555d5785634


-- check status on reception of receive complete interrupt
apbrd(2000) 24 00000000  -- check interrupt status - receive complete
apbrd      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 7. Disable copy all frames.
--***********************************************************************--

apbwrf      04 00080001  -- indicate 100M operation, disable copy all frames, will check pin l8r.

--***********************************************************************--
-- 8. Receive a frame with 6 bytes of preamble. (Should be discarded)
--***********************************************************************--

rxd(apb)         555555555555

-- check status on reception of receive complete interrupt
apbrd(2500) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 9. Receive a frame with 6 bytes of preamble, and SFD. (Should be discarded)
--***********************************************************************--

rxd(apb)         555555555555d5

-- check status on reception of receive complete interrupt
apbrd(3000) 24 00000000  -- check interrupt status - receive complete
apbrdf      20 00000000  -- check contents of the receive status register- frame received

--***********************************************************************--
-- 10. Receive a frame with 6 bytes of preamble, SFD, and the MAC destination 
--     address. (Should be discarded)
--***********************************************************************--

