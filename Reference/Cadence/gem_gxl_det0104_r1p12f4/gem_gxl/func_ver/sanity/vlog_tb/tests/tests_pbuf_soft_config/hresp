-- not been successfully stored in the buffer.
-- txd    55555555555555d578563412111111112222222233333333
-- txd                    44444444555555556666666677
-- txd                    77777777 -- jam (underrun)



-- write used bit and tx error
dma_wr ffffff04 90000028 


apbrd(int) 24 00000840  "TX scenario 1: Complete"
                        -- check interrupt status - HRESP not OK & buffers exh.
