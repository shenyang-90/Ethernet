--
--   Description
----------------
--
-- This test is based on tx_und_err_fifo test in fifo configuration
-- but has the additional tx fifo interface as well as the DMA
-- configured.
--
-- Send good and underrun frames into the tx fifo interface only
--
-- Functional Coverage
----------------------
-- · Checks transmission with good and underrun frames on fifo port
--    
--
-- Detailed Test Description
----------------------------
--
-- Enable transmit and interrupts, write control registers.
--
-- Supply transmit data to the FIFO interface and check the
-- transmitted data, pad and crc.
--
-- On reception of the transmit complete interrupt check the
-- interrupt and trasnmit status registers and the statistics
-- registers/
--
-- Underrun frames sent will not produce underrun interrupt or
-- interrupt status or underrun statistics as only DMA frames
-- produce underrun indication in this configuration.
--
-- Check underrun indicate is indicated directly to the tx_fifo 
-- interface on the tx_r_status bus.
--
-- This tests a frame supplied with known CRC:-
--
--
-- 
--------------------------------------------------------------------------------
--******************************************************************************
--  1. Initialise suitable FIFO latencies and delays for the test.

-- Note: adding these values changes the expected values when undeflow frame
-- is sent ( ie removing these means the unflow frame expected values need to 
-- change, but these are errored frames anyway) 
--******************************************************************************
fifo_latency      3
fifo_under_delay  3
fifo_status_delay 5



pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
-- set tx_go to 0,config reg bit[9],for FIFO only test 
-- (otherwise DMA descriptors will be read when DMA is present)
apbwrf     00 00000008  -- write tx_go and enable tx (apb trigger to trigger FIFO)

-- frame  1
-- Supply data to TX FIFO interface
--
-- CONTROL =  <RESERVED>, NO CRC, FLUSH, UNDERFLOW, RDY, ERR, SOP, EOP.
