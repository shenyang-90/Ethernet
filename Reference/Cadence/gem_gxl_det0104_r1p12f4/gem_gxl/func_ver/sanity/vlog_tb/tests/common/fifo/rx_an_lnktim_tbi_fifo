--
--   Description
----------------
--   The purpose of this test is to verify that the implemented link_timer is 
--   within 10ms to 20ms.
--
-- Detailed Test Description
----------------------------
-- 1. Initialise the GEM for Gigabit Operation with PCS enabled. Furthermore, Auto-Negotiation is 
--    enabled.
-- 2. The GEM should transmit alternating /C/ codes with the Config_Reg field all zeros.  The GEM
--    will continue to do this until the link timer counts up to 0x98968 (this value will give 
--    a link counter time of 10ms   0x98968 (625000 dec.) times 16ns per clock cycle equalling
--    10ms)
-- 3. After the link timer in the GEM reaches 0x98968, the GEM should then transmit alternating /C/
--    codes with the Conf_Reg field incdicating the same values that are in the PCS auto-negotiation 
--    advertisement register.
-- 4. Check the PCS registers.

--------------------------------------------------------------------------------

-- Configuration Requirements ..
requires ext_fifo_interface 1
requires no_pcs 0
pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- ********************************************************************************************* --
-- 1. Initialise the GEM for Gigabit Operation with PCS enabled. Furthermore, Auto-Negotiation is 
--    enabled.
-- ********************************************************************************************* --

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbrd      08 00000006  -- check reset value of network status register
apbrd     184 00000000 -- ignore this read


-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
-- #   -pcs_en   <1|0|random>, default = 0. Enables SGMII PCS
-- #   -pause_en <1|0|random>, default = 0. Enables pausing of transmission
-- #   -dont_copy_pause <1|0|random>, default = 0. Controls whether pause frames are copied
init_ncr -sgmii_en 0 -pcs_en 1 -retry_test 0 -copy_all 0 -duplex half -speed 1g -jumbo 0 -databus 32 -eam 0 -rx_toe 0 -pause_en 0 -dont_copy_pause 0 -multicast_hash 0 -unicast_hash 0

apbwr      00 00200004  -- enable receive - and set alt_sgmii_mode to demonstrate this will have no affect because sgmii_mode has not been selected
apbrd      00 zzzzzzzz repeat=15 -- repeat read 15 times to ensure rx enable is propagated through design
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 03020100  -- specific address register 1 bottom
apbwr      8C 00000504  -- specific address register 1 top
apbrd     184 00000000 -- ignore this read

apbrd     204 00000109  -- check pcs status register
apbrdf      20 00000000  -- check receive status register and trigger reception


-- ********************************************************************************************* --
-- 2. The GEM should transmit alternating /C/ codes with the Config_Reg field all zeros.  The GEM
--    will continue to do this until the link timer counts up to 0x98968 (this value will give 
--    a link counter time of 10ms   0x98968 (625000 dec.) times 16ns per clock cycle equalling
--    10ms)
-- ********************************************************************************************* --

pcs_an_tx             0000  

-- ********************************************************************************************* --
-- 3. After the link timer in the GEM reaches 0x98968, the GEM should then transmit alternating /C/
--    codes with the Conf_Reg field incdicating the same values that are in the PCS auto-negotiation 
--    advertisement register.
-- ********************************************************************************************* --

pcs_an_tx             2000 

-- ********************************************************************************************* --
-- 4. Check the PCS registers.
-- *********************************************************************************************

apbrd(500000)  204 00000109  -- check pcs status register
apbrd          184 00000000 -- ignore this read

apbrd          184 00000000 -- ignore this read

apbrd          184 00000000 -- ignore this read

apbrd          210 00000020  -- check pcs auto-neg. advertisment register
apbrd          214 00000000  -- check pcs auto-neg. link partner advertisment register
apbrd          218 00000004  -- check pcs auto-neg. expansion register 
apbrd          21c 00000000  -- check pcs auto-neg. next page register
apbrd          220 00000000  -- check pcs auto-neg. link partner next page register
apbrd          23C 00008000  -- check pcs auto-neg. extended status register
end(1100000)
