--     Enable the ARP wake up event enable bit in the WoL register and program
--     the WoL target address match register.
--     Send a good receive ARP request frame with correct type and operation 
--     fields and a target address that matches the value programmed.
--     Verify that the wol output is asserted for 64 clock cycles and that the
--     frame is successfully received.
--******************************************************************************

apbwr      B8 00021213  -- enable WoL ARP and write expected target protocol address
apbrdf     20 00000000  "Test 1 : Good ARP that generates WoL"
                        -- trigger reception of frame


rxd(apb)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        123456789abc -- MAC SA
rxd        0806         -- Length/typeID
