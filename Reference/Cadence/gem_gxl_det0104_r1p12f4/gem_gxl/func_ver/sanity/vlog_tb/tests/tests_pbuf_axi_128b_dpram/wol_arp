dma_wr 22222104 3412FFFF
dma_wr 22222108 bc9a7856
dma_wr 2222210c 01000608
dma_wr 22222110 04060008
dma_wr 22222114 01000100
dma_wr 22222118 05040302
dma_wr 2222211c 09080706
dma_wr 22222120 0d0c0b0a
dma_wr 22222124 11100f0e
dma_wr 22222128 00001312
dma_wr 2222212c 00000000
dma_wr 22222130 00000000
dma_wr 22222134 00000000
dma_wr 22222138 00000000
dma_wr 2222213c b9437dd2

dma_wr rx_descr fffff004 8000c040 -- dma writes rx status,
                         -- start & end of frame
                         -- broadcast match
                         -- No VLAN tag detected
                         -- 64 bytes received
dma_wr rx_descr fffff000 22222101 -- dma writes ownership bit


pinsc(490) wol 1  -- check wol pin is high


-- check status on reception of receive complete interrupt
