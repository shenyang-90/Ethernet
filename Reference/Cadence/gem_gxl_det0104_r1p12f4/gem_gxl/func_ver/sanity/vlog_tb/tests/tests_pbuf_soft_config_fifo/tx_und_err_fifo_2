--
-- Test Description
-- This test is based on tx_und_err_fifo from fifo configuration
-- which has been split into three test as follows
-- tx_und_err_fifo_2 performs the test setup and
-- performs parts 11 and 12 of the original test.
-- This test checks the operation of the TX exposed FIFO interface (read).
-- 
-- Functional Coverage
-- * Checks the operation of the tx_r_underflow signal
-- * Checks the operation of the tx_r_err signal
-- 
-- Detailed Test Description
--  1. Initialise suitable FIFO latencies and delays for the test.
--  2. Enable fifo interface using apb write.
--     Check reset values of registers and setup interrupts and then enable 
--     transmit in 100M half duplex mode from a 128-bit FIFO data bus.
--
--  tx_r_err testing
--  ----------------
--  Note that no interrupts are generated by tx_r_err when using exposed
--  FIFO interface.
-- 11. Transmit a 64 byte frame. On the second FIFO read operation, signal an
--     error by driving the tx_r_err signal.
--     Ensure that the TX MAC terminates ongoing transmission correctly,
--     but that no interupts or status is reported.
-- 12. Transmit a 64 byte frame. On the last FIFO read operation, signal an
--     error by driving the tx_r_err signal.
--     Ensure that the TX MAC terminates ongoing transmission correctly,
--     but that no interupts or status is reported.

-- 21. Check statistics for above operations.
--
--------------------------------------------------------------------------------




--******************************************************************************
--  1. Initialise suitable FIFO latencies and delays for the test.
--******************************************************************************
fifo_latency      3
fifo_under_delay  3
fifo_status_delay 5



--******************************************************************************
--  2. Check reset values of registers and setup interrupts and then enable 
--     transmit in 100M half duplex mode from a 128-bit FIFO data bus.
--******************************************************************************
apbwr(60)  4c 00000001  -- enable soft config fifo port bit when available
apbrd      4c 00000001  -- check enable soft config bit when available

apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbwr      04 00680000  -- enable 100M mode into 128-bit bus
apbwr      00 00000008  -- enable transmit
apbrd      14 00000000  -- check tx status, wait for tx_go when enabled
apbrd      14 00000008  -- check tx status, always tx_go when enabled



--******************************************************************************
-- 11. Transmit a 64 byte frame. On the second FIFO read operation, signal an
--     error by driving the tx_r_err signal.
--     Ensure that the TX MAC terminates ongoing transmission correctly,
--     but that no interupts or status is reported.
--******************************************************************************

apbrdf      14 00000008  "Scenario 8: TX FIFO ERR - mid frame"
                        -- check tx status, always tx_go in fifo mode
                        -- and trigger data ready for first frame

-- Supply data to TX FIFO interface
--
-- CONTROL =  <RESERVED>, NO CRC, FLUSH, UNDERFLOW, RDY, ERR, SOP, EOP.
--
--              CONTROL   MOD  STATUS          DATA
fifo_rd(apb)         01001010   0   00000000     8877665544332211
fifo_rd         01001000   0   00000000    10ffeeddccbbaa99 
fifo_rd         01001000   0   00000000     1817161514131211 
fifo_rd         01001100   0   00000000    201f1e1d1c1b1a19  -- ERROR
fifo_rd         01001000   0   00001000     2827262524232221 -- UNDERFLOW STATUS
fifo_rd         01001000   0   00000000    302f2e2d2c2b2a29  
fifo_rd         01001000   0   00000000     3837363534333231
fifo_rd         01001001   0   00000000    403f3e3d3c3b3a39 


-- check for correct preamble, SFD, data, pad and crc
txd   55555555555555d5112233445566778899aabbccddeeff 
txd                   1011121314151617               -- cut off here
txd                   88888888 -- 32 bit JAM sequence


-- No status
apbrd(900)      24 00000000  "Scenario 8: Complete"
                        -- check interrupt status - clear





---******************************************************************************
-- 12. Transmit a 64 byte frame. On the last FIFO read operation, signal an
--     error by driving the tx_r_err signal.
--     Ensure that the TX MAC terminates ongoing transmission correctly,
--     but that no interupts or status is reported.
--******************************************************************************

apbrdf     14 00000008  "Scenario 9: TX FIFO ERR - EOP"
                        -- check tx status, always tx_go in fifo mode
                        -- and trigger data ready for first frame

-- Supply data to TX FIFO interface
--
-- CONTROL =  <RESERVED>, NO CRC, FLUSH, UNDERFLOW, RDY, ERR, SOP, EOP.
--
--              CONTROL   MOD  STATUS          DATA
fifo_rd(apb)    01001010   0   00000000     8877665544332211
fifo_rd         01001000   0   00000000    10ffeeddccbbaa99 
fifo_rd         01001000   0   00000000     1817161514131211
fifo_rd         01001000   0   00000000    201f1e1d1c1b1a19 
fifo_rd         01001000   0   00000000     2827262524232221
fifo_rd         01001000   0   00000000    302f2e2d2c2b2a29 
fifo_rd         01001100   0   00000000     3837363534333231 -- ERROR
fifo_rd         01001001   0   00001000    403f3e3d3c3b3a33  -- UNDERFLOW STATUS


-- check for correct preamble, SFD, data, pad and crc
txd   55555555555555d5112233445566778899aabbccddeeff10
txd                   1112131415161718191a1b1c1d1e1f20
txd                   2122232425262728292a2b2c2d2e2f       -- cut off here
txd                   00000000 -- 32 bit JAM sequence


-- No status
apbrd(2000)      24 00000000  "Scenario 9: Complete"
                        -- check interrupt status - clear










--******************************************************************************
-- 21. Check statistics for above operations.
--******************************************************************************

-- check transmit statistics
apbrd(1000)     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000000  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors



-- force end of test in case it doesn't stop of its own accord
end(10000)

