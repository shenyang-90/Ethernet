--
-- Case 1: Queue up two frames then signal a halt before any writeback occurs
--         check that the writebacks for both frames occur in the correct order
--         frm1 then frm2
--
--
-- Case 2: Queue up two frames and signal a collision in the first frame.
--         Check that frame one is recovered. Halt occurs because of 
--         used bit read mid frame on second frame during first attempt.
--
--
-- Case 3: Queue up two frames and signal a collision in the first frame.
--         Check that frame one is recovered. This time halt occurs 
--         because of write to control reg.
--
--
-- Case 4: Queue up three frames and signal a collision in the second frame
--         after frame one has written back and a used bit has been read 
--         from frame three (second buffer). Check that frame two is retried 
--         and then try frame three again (OK this time).
--
--
-- Case 5: Queue up three frames allow the first one to writeback descriptor
--         and then set the halt in frame three check that the writebacks occur
--         in the correct order, frm2 then frm3
--
-- ************************************************************************** --


wait_states 0
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer



