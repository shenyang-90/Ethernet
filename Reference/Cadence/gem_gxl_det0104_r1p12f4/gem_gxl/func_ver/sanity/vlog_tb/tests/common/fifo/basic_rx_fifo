--
--   Description
----------------
--
-- This checks reception of a single specifically address
-- matched minimum length frame in nibble mode at 100Mbits/s
-- using the exposed FIFO interface.
--
--
-- Functional Coverage
----------------------
-- · This checks reception of a single specifically address
--   matched minimum length frame in nibble mode at 100Mbits/s
--   using the exposed FIFO interface.
-- 
-- 
--
-- Detailed Test Description
----------------------------
--
-- Enable receive and interrupts, write specific address
--
-- Drive data into the MII receive interface.
--
-- Check the receive data and status as it is written to the
-- FIFO interface
--
-- On the receive complete interrupt check status
--
-- 
--------------------------------------------------------------------------------


-- Configuration Requirements ..
requires ext_fifo_interface 1
pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

apbwr      00 00000004  -- enable receive
apbrd      00 zzzzzzzz repeat=15 -- repeat read 15 times to ensure rx enable is propagated through design
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      08 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
-- #   -pcs_en   <1|0|random>, default = 0. Enables SGMII PCS
-- #   -pause_en <1|0|random>, default = 0. Enables pausing of transmission
-- #   -dont_copy_pause <1|0|random>, default = 0. Controls whether pause frames are copied
init_ncr -sgmii_en 0 -pcs_en 0 -retry_test 0 -copy_all 0 -duplex half -speed 100m -jumbo 0 -databus 32 -eam 0 -rx_toe 0 -pause_en 0 -dont_copy_pause 0 -multicast_hash 0 -unicast_hash 0

apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

-- drive the receive frame data into the MII interface
rxd(apb)   55d578563412111111112222222233333333
rxd            44444444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            0000000000000000000000002638309b


-- check the receive data as it is written out on the FIFO interface
--          CONTROL  MOD  STATUS[39:0]    DATA
fifo_wr      1010     0   xxxxxxxxxx    12345678
fifo_wr      1000     0   xxxxxxxxxx    11111111
fifo_wr      1000     0   xxxxxxxxxx    22222222
fifo_wr      1000     0   xxxxxxxxxx    33333333
fifo_wr      1000     0   xxxxxxxxxx    44444444
fifo_wr      1000     0   xxxxxxxxxx    55555555
fifo_wr      1000     0   xxxxxxxxxx    66666666
fifo_wr      1000     0   xxxxxxxxxx    77777777
fifo_wr      1000     0   xxxxxxxxxx    88888888
fifo_wr      1000     0   xxxxxxxxxx    99999999
fifo_wr      1000     0   xxxxxxxxxx    aaaaaaaa
fifo_wr      1000     0   xxxxxxxxxx    bbbbbbbb
fifo_wr      1000     0   xxxxxxxxxx    00000000
fifo_wr      1000     0   xxxxxxxxxx    00000000
fifo_wr      1000     0   xxxxxxxxxx    00000000
fifo_wr      1001     0   0010000040    9b303826


-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  -- check interrupt status - receive complete
apbwr       24 ffffffff  -- clear interrupt
apbrd      20 00000002  -- check contents of the receive status register- frame received
apbrd      20 00000002  -- check it again
apbwr      20 0000fffd  -- don't clear it
apbrd      20 00000002  -- check it again
apbwr      20 00000002  -- clear it
apbrd      20 00000000  -- check it again
apbrd      38 00000000  -- check rx pause time

-- check transmit statistics
apbrd     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000040  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000001  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000001  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors


-- force end of test in case it doesn't stop of its own accord
end(100000)
