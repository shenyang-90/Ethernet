--
--   Test           : col_test
--
--   Author         : Steven Ho
--
--   Date           : 12 Oct 2015
--
--------------------------------------------------------------------------------
--   Test Description
--   
--   This test ensures that the GEM properly deals with collisions in TBI
--   mode, where the PCS is generating the collision signal to the MAC.
--   
--   Functional Coverage
--   * Checks that the PCS correctly generates the col signal to the TX MAC.
--   
--   Detailed Test Description
--   
--  INITIALISATION
-- 1. Setup DMA wait states for the test.
-- 2. Initialise the GEM for 1Gbits/s, TBI, 64-bit DMA mode, with 
--    autonegotiation disabled.
-- 3. Enable all interrupts, and then enable both transmit and receive.
-- 4. Reduce back off time to one slot-time by writing bit 12 of the config
--    register and activate col_test feature.
--
-- 5. Start transmitting a frame of 64 bytes (single DMA buffer).
--    MAC should attempt to transmit the frame 16 times before giving up.
--
-- 6. Check excessive retry interrupt status
-- 
-- 7. Check statistics for the above operations.
--------------------------------------------------------------------------------

-- ************************************************************************** --
-- 1. Setup DMA wait states for the test.
-- ************************************************************************** --
wait_states     0
bus_grant_delay 0


-- ************************************************************************** --
-- 2. Initialise the GEM for 1Gbits/s, TBI, 64-bit DMA mode, with 
--    autonegotiation disabled.
-- 3. Enable all interrupts, and then enable both transmit and receive.
-- 4. Reduce back off time to one slot-time by writing bit 12 of the config
--    register
-- ************************************************************************** --

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr     200 00000040  -- disable autonegotiation
apbrd     200 00008040  -- check autoneg disabled
apbwr      98 12345678  -- specific address register 1 bottom
apbwr      9C 00001111  -- specific address register 1 top
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00281c00  -- reduce backoff time to one slot time, enable gigbait
                        -- TBI mode into 64 bits
apbrd      04 00281c00  -- check write to network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd      14 00000000  -- read transmit status register
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 aaaaa000  -- write receive queue pointer
apbrd      18 aaaaa000  -- check receive queue pointer
apbwr      1c 55555000  -- write address of transmit buffer descriptor
apbrd      1c 55555000  -- check transmit queue pointer


-- check for link status change
apbrd(int) 24 00000200  -- check interrupt status - link status change



-- Activate col_test feature
apbwr     200 000000c0  -- col_test and 1G mode with no AN


-- ************************************************************************** --
-- 5. Start transmitting a frame of 64 bytes (single DMA buffer).
--    PCS is setup to indicate collision to the MAC every time a frame is
--    transmitted.
-- ************************************************************************** --

-- start transmission
apbwr      00 0000000c  -- enable transmit & receive
apbwr      00 0000020c  -- write transmit start bit and enable tx & receive
apbwr      00 0000040c  -- write transmit halt bit (just one frame transmitted)


-- supply the transmit buffer location
dma_rd 55555000 98765000 -- dma reads pointer of 98765000
dma_rd 55555004 0000803c -- eof, length=60, plus CRC.

dma_rd 98765000 12345678  -- read transmit data
dma_rd 98765004 00000001
dma_rd 98765008 22222222
dma_rd 9876500c 33333333
dma_rd 98765010 44444444
dma_rd 98765014 55555555
dma_rd 98765018 66666666
dma_rd 9876501c 77777777
dma_rd 98765020 88888888
dma_rd 98765024 99999999
dma_rd 98765028 aaaaaaaa
dma_rd 9876502c bbbbbbbb
dma_rd 98765030 cccccccc
dma_rd 98765034 dddddddd
dma_rd 98765038 eeeeeeee
dma_rd 9876503c 00000000 -- pad to 64 bit

-- tx frame repeated 16 times as collision each time...
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam
pcs_txd(s)     55555555555555d578787878j -- jam


-- writeback used bit after 16 attempts
dma_wr 55555004 a000803c -- eof, length=64, no CRC. too many retries


-- ************************************************************************** --
-- 6. Check interrupt status for excessive retries
-- ************************************************************************** --

apbrd(int) 24 00000020  -- check interrupt status - too many retries


-- ************************************************************************** --
-- 7. Check statistics for the above operations.
-- ************************************************************************** --
-- check transmit statistics
apbrd     100 00000000  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000000  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000000  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000000  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000000  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000001  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000000  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors


-- force end of test in case it doesn't stop of its own accord
end(55000)
