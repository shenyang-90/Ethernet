dma_wr 11111004 80008034 -- write back ownership bit to tx descriptor

-- ************************************************************************** --
-- *               Driving in frame to be transmitted  through DMA interface* --
-- ************************************************************************** --
apbwr      00 0202000c  -- Send PFC Pause frame 


apbrd(int)   24 00004000 -- read int status (pause frame transmitted)
apbwr        24 00004000 -- read int status (tx complete)
apbrd(int)   24 00000080 -- read int status (tx complete)
apbwr        24 00000080 -- read int status (tx complete)
apbwr        00 0200020C -- write tx_start
apbwr        00 0200040C -- write tx_halt to ensure dma does not fetch next frame
                         -- right away


dma_rd 1111100c 0000803c -- length 64, end of frame
