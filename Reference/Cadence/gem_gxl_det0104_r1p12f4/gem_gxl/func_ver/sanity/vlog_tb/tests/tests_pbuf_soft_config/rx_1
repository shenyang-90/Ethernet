apbrd      20 00000002  -- check contents of the receive status register- frame received
apbwr      20 00000002  -- receive status register- clear frame received
apbrd      18 01234000  -- check receive queue pointer

apbrdf     20 00000000  "Scenario 6: complete"
                        -- check contents of the receive status register
                        -- and trigger reception of frame

rxd(gap)     d578563412111111112222222233330007
rxd            44444444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            000000000000000000000000gggggggg


-- *****************************************************************************
--   11. Receive a frame.  The buffer descriptor read has the ownership bit set.
--       Therefore, this frame should be discarded. The rx used bit read
--       interrupt should be set.
-- *****************************************************************************

apbrd      20 00000000  "Scenario 7: Used bit again"

dma_rd 01234000 55550001 -- still set 

apbrd(int) 24 00000004  "Scenario 7: complete"
                        -- check interrupt status - rx buffer not available
apbwr      24 00000004  -- Clear it
apbrdf     24 00000000  -- check interrupt status clear
apbrd      20 00000001  -- receive status register- buffer unavailable
apbwr      20 00000001  -- receive status register- clear buffer unavailable




