dma_wr 01234014 8000C042 -- dma writes rx status, broadcast and 66 bytes received
dma_wr 01234010 5555000f -- dma writes ownership bit

apbrd(int) 24 00000002  "Scenario 5: complete"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it


-- *****************************************************************************
--   10. Read another receive buffer descriptor with the used bit set. This
--       should cause a rx used bit read interrupt to be set. Also, the
--       receive status register should indicate that a receive buffer was
--       not available.
-- *****************************************************************************

dma_rd 01234000 66660001 -- next rx buffer ownership bit is set

