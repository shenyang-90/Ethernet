dma_wr 44440044 61aff133
dma_wr 44440048 00000002

dma_wr 0123400c 8000C041 -- dma writes rx status, broadcast and 65 bytes received
dma_wr 01234008 44440009 -- dma writes ownership bit

dma_rd 01234010 5555000e -- reads locations of next rx buffer - wrap bit set


apbrd(int) 24 00000002  "Scenario 3: complete"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it
apbrd      20 00000002  -- check contents of the receive status register- frame received
apbwr      20 00000002  -- clear rx status register
apbrd      18 01234010  -- check receive queue pointer



