-- set  retry test bit to 1                  --
-- counter decrement every rx_clck cycle     --
-- ============================================

-------------
-- Frame 1 --
-------------
-- ************************************************************************** --
-- Receive a non-zero PFC pause frame 
-- priority enable =0x00FF.
-- PFC pause time for priority 0 = 0x0010
-- PFC pause time for priority 1 = 0x0011
-- PFC pause time for priority 2 = 0x0012
-- PFC pause time for priority 3 = 0x0013
-- PFC pause time for priority 4 = 0x0014
-- PFC pause time for priority 5 = 0x0015
-- PFC pause time for priority 6 = 0x0016
-- PFC pause time for priority 7 = 0x0017
-- ************************************************************************** --
apbwrf       04 00083003 -- dsiable copy of pause frame bit(23) = 0,
                         -- reset retry test bit(12) = 1, 
                         -- keep enable pause time bit(13) = 1,
                         -- copy all frames bit(4) = 0
                         -- full-duplex bit(1) = 1,
                         -- 100Mbps speed bit(0) = 1
                        

rxd(apb)     d50180C200000111112222222288080101
rxd            00FF0010001100120013001400150016
rxd            0017888899999999aaaaaaaabbbbbbbb
rxd            000000000000000000000000gggggggg


apbrd(int)   24 00001000 -- check interrupt status - non-zero pause frame received

-- event counts increment by 2 every rx_clk clock cycle
-- counter decrement every rx_clck cycle
pinsc(461) pfc_negotiate 1 rx_pfc_paused 11111111  -- all counters loaded with new pause time
pinsc(492) pfc_negotiate 1 rx_pfc_paused 11111110  -- counter0 decrements to 0 
pinsc(494) pfc_negotiate 1 rx_pfc_paused 11111100  -- counter1 decrements to 0 
pinsc(496) pfc_negotiate 1 rx_pfc_paused 11111000  -- counter2 decrements to 0 
pinsc(498) pfc_negotiate 1 rx_pfc_paused 11110000  -- counter3 decrements to 0 
pinsc(500) pfc_negotiate 1 rx_pfc_paused 11100000  -- counter4 decrements to 0 
pinsc(502) pfc_negotiate 1 rx_pfc_paused 11000000  -- counter5 decrements to 0 
pinsc(504) pfc_negotiate 1 rx_pfc_paused 10000000  -- counter6 decrements to 0 
pinsc(507) pfc_negotiate 1 rx_pfc_paused 00000000  -- counter7 decrements to 0 

apbrd(508) 24 00000000   -- check that PFC counter time out does not generate interrupt
apbrdf       08 00000046 -- check pfc_negotiate = 1, trigger next PFC frame on rxd

