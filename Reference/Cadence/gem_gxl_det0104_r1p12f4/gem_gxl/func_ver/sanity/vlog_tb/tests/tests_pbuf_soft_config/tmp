--
-- Written by Alastair Boomer/Arthur Marris
--
-- Cadence Design Systems Ltd
-- Livingston Design Centre,
-- West Lothian.
--
-- 21Mar2003     Arthur finished it off
--
-- This shows the ability of the trans.pl to generate random
-- receive frames.
--
-- 17 frames of varying lengths are generated, 14 of which
-- are address recognized
--
-- trans.pl picks destination addresses from the values written
-- to the specific address registers.
--
-- trans.pl reads the value written to the receive queue pointer
-- and checks reads and writes to the rx buffer queue. trans.pl
-- generates random values for the rx buffer locations and sets
-- the wrap bit from time to time.
--
-- 
-- ************************************************************************** --

wait_states 0
set_random_seed 8;

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 ffff0000  -- write receive queue pointer
apbrd      18 ffff0000  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 fffffffd  -- enable  interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080002  -- 100M, full duplex
apbrd      04 00080002  -- verify write to speed register..
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 0000020c  -- enable receive and transmit
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame



---------------------------------------
-- TEST 1: FRAME SIZE 128 BYTES (PADDED)
---------------------------------------

rx_frame (apb)  5
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      type_len_field 3333
      data_size      48 
      data           random
      resource_err   0
      auto_gen_int   0
      fcs            good

tx_frame  5
      number_of_bufs 1
      buffer_size    30-100
      data           random
      auto_gen_int   1
      fcs            YES

-- supply last dma read
dma_rd rx_q_ptr ddddd000 



-- check transmit statistics
--apbrd(5000)     100 00000000  -- check octets transmitted bottom
--apbrd     104 00000000  -- check octets transmitted top
--apbrd     108 00000000  -- check frames transmitted ok
--apbrd     10C 00000000  -- check broadcast frames transmitted
--apbrd     110 00000000  -- check multicast frames transmitted
--apbrd     114 00000000  -- check pause frames transmitted
--apbrd     118 00000000  -- check frames transmitted 64
--apbrd     11C 00000000  -- check frames transmitted 65-127
--apbrd     120 00000000  -- check frames transmitted 128-255
--apbrd     124 00000000  -- check frames transmitted 256-511
--apbrd     128 00000000  -- check frames transmitted 512-1023
--apbrd     12C 00000000  -- check frames transmitted 1024-1518
--apbrd     130 00000000  -- check frames transmitted 1519

--apbrd(20000)     134 00000000  -- check transmit underruns errors
--apbrd     138 00000000  -- check single collisions frames
--apbrd     13C 00000000  -- check multiple collisions frames
--apbrd     140 00000000  -- check excessive collisions frames
--apbrd     144 00000000  -- check late collisions frames
--apbrd     148 00000000  -- check deferred frames
--apbrd     14C 00000000  -- check carrier sense errors
--
---- check receive statistics
----apbrd     150 0000112c  -- check octets received bottom
----apbrd     154 00000000  -- check octets received top
----apbrd     158 0000000e  -- check frames received ok
----apbrd     15C 00000001  -- check broadcast frames received
----apbrd     160 00000001  -- check multicast frames received
--apbrd     164 00000000  -- check pause frames received
----apbrd     168 00000004  -- check frames received 64
----apbrd     16C 00000003  -- check frames received 65-127
----apbrd     170 00000002  -- check frames received 128-255
----apbrd     174 00000001  -- check frames received 256-511
----apbrd     178 00000003  -- check frames received 512-1023
----apbrd     17C 00000001  -- check frames received 1024-1518
----apbrd     180 00000000  -- check frames received 1519
--apbrd     184 00000000  -- check undersize frame errors
--apbrd     188 00000000  -- check excessive receive length errors
--apbrd     18C 00000000  -- check receive jabbers errors
--apbrd     190 00000000  -- check FCS errors
--apbrd     194 00000000  -- check receive length errors
--apbrd     198 00000000  -- check receive symbol errors
--apbrd     19C 00000000  -- check alignment errors
--apbrd     1A0 00000000  -- check receive resource errors
--apbrd     1A4 00000000  -- check receive overrun errors

-- force end of test in case it doesn't stop of its own accord
end(50000)

bus_grant_delay 0
