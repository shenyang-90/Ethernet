-- Test Description
-- This tests ensures the gem_dma_rx module state machine exits out of each
-- state when the receive is disabled in the GEM.
-- 
-- Functional Coverage  																																																																											  tion.
-- · Ensures the state machine in gem_dma_rx exits out of each state when
--   receive is disabled in the GEM.
-- · Ensures proper code coverage results. 
-- 
-- Detailed Test Description
-- 1. Initialise GEM.
-- 2. Enable the GEM. Start receiving a minimum sized frame. However,
--    a used bit is read in the rx buffer descriptor.  This will cause the 
--    GEM to stay in state one in the gem_dma_rx state machine. Now, disable
--    receive and this will cause the state machine to go back to idle.
-- 3. Reenable receive and disable it again immediately. The state machine
--    in gem_dma_rx should be in state two when receive is disabled. This will
--    cause the state machine to return to the idle state. 
-- 4. Reenable receive several times and then disable it. The state machine
--    in gem_dma_rx should be in state three when receive is disabled. This will
--    cause the state machine to return to the idle state.
-- 5. Reenable receive and receive a minimum length frame. Half way through reception
--    of the frame disable receive. The state machine in the gem_dma_rx should be in state
--    four when receive is disabled. This will cause the state machine to return to the idle state.
-- 6. Check the statistic registers.
-- 
-- 
--------------------------------------------------------------------------------

-- basic_rx test scenario for the Ethernet MAC --
randomize_hready -descr_min 0 -descr_max 5 -data_min 0 -data_max 3 -read_max 5 -write_max 5
bus_grant_delay 0
--------------------------------------------------------------------------------
-- 1. Initialise GEM.
-- 2. Enable the GEM. Start receiving a minimum sized frame. However,
--    a used bit is read in the rx buffer descriptor.  This will cause the 
--    GEM to stay in state one in the gem_dma_rx state machine. Now, disable
--    receive and this will cause the state machine to go back to idle.
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(80)  00 00000000  -- check reset value of network control register
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      10 000207c8  -- DMA configuration reg - set burst length to 8
apbwr      18 fffffff0  -- write receive queue pointer
apbrd      18 fffffff0  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080001  -- indicate 100M operation, will check pin l8r.
apbwr      00 00000000  -- disable receive 
apbrd      04 00080001  -- verify write to speed register..
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame


-- drive the receive frame data into the GMII interface
rxd(apb)   55d578563412111111112222222233333333
rxd            44444444555555556666666677777777
rxd            8888888899999999aaaaaaaabbbbbbbb
rxd            0000000000000000000000002638309b

-- supply the receive buffer location
--dma_rd rx_descr fffffff0 22222005 -- dma reads pointer of 22222005

--------------------------------------------------------------------------------
-- 3. Reenable receive and disable it again immediately. The state machine
--    in gem_dma_rx should be in idle state when receive is disabled. This will
--    cause the state machine to return to the idle state. 
--------------------------------------------------------------------------------

apbwr      00 00000004  -- enable receive
apbwr      00 00000000  -- disable receive

-- supply the receive buffer location
--dma_rd rx_descr fffffff0 22222004 -- dma reads pointer of 22222004


--------------------------------------------------------------------------------
-- 4. Reenable receive and receive a minimum length frame. Half way through reception
--    of the frame disable receive. The state machine in the gem_dma_rx should be in state
--    1 when receive is disabled. This will cause the state machine to return to the idle state.
--------------------------------------------------------------------------------

-- setup the dma interface
apbwr(1000)     18  21c4a8a4    -- set address of the receive queue descriptor
apbwr           00  00000004    -- enable receive

-- add the destination address to a local address match register
apbwr           88  12345678    -- specific address register 1 bottom
apbwrf          8c  00001111    -- specific address register 1 top
apbwr(1318)     00  00000000    -- disable receive

-- receive a 64 (0x40) byte frame:
