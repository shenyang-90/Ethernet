-- sfd:      '0xd5' 
-- destaddr: '0x111112345678' unicast
-- srcaddr:  '0xb42d8eebaaa6' 
-- idfield:  '0xd143'  typeid field
-- data:      46 bytes
-- crc:       autogenerated

