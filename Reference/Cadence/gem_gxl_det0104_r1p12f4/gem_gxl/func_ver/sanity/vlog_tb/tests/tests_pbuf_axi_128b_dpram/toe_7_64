-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
filterc da FFFFFFFFFFFF sa 563412390008 type 0800 ipsa FFFFFFFF ipda FFFFFFFF


-- check the receive data as it is written out on the AHB interface
dma_wr 22222100 FFFFFFFF -- store frame to memory
dma_wr 22222104 0008FFFF
dma_wr 22222108 56341239
dma_wr 2222210c AAAA4600
dma_wr 22222110 00000003
dma_wr 22222114 00490008
dma_wr 22222118 FADF3800
dma_wr 2222211c 06800040
dma_wr 22222120 FFFFC81A
dma_wr 22222124 FFFFFFFF
dma_wr 22222128 FDFBFFFF
dma_wr 2222212c 00000000
dma_wr 22222130 00000000
dma_wr 22222134 00000000
dma_wr 22222138 15000000
dma_wr 2222213c BB3D8A04
dma_wr 22222140 22EA605C
dma_wr 22222144 1050764D
dma_wr 22222148 59952844
dma_wr 2222214c 00000000
dma_wr 22222150 00000000
dma_wr 22222154 9F23114F

dma_wr rx_descr fffff000 22222101 -- dma writes ownership bit
                         -- start & end of frame
                         -- broadcast match
                         -- IP & TCP checksums OK
                         -- SNAP detected
                         -- no VLAN tag detected
                         -- 88 bytes received
dma_wr rx_descr fffff004 8180c058 -- dma writes rx status,


-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "Tests 7.1 to 7.2 complete"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it
apbrd      20 00000002  -- check RX status register - receive complete
apbwr      20 00000002  -- clear RX status register
apbwr      04 01280009  -- Disable length field checking, enable jumbo frames



