--
-- Test Description
-- This test checks the handling of different lengths of IP frames.
-- 
-- Functional Coverage
-- * Checks that the GEM correctly handles SNAP frame length fields.
-- * Checks that the GEM can handle theoretical maximum (0xFFFF).
-- * Checks that the GEM can handle jumbo (0x1800) - 6.144k.
-- * Checks that the GEM can handle zero length (0x0000).
-- * Checks that the GEM can handle various options lengths.
-- 
-- Detailed Test Description
--  1. Initialise suitable wait states for the test.
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 64-bit DMA data bus.
--  3. Send several good IP frames with various lengths.
--
-- Test 7.1
--    Broadcast frame, SNAP with length field checking enabled. Length field
--    does not match length measured.
--    The frame should be discarded with a length field error recorded.
-- Test 7.2
--    Broadcast frame, SNAP, TCP with good checksums. Length field checking
--    enabled and length field does match length measured.
--    The frame should be successfully stored.
-- Test 7.3
--    Broadcast frame, TCP, total length = 0xFFFF, but frame 64 bytes,
--    IP checksum is good.
--    The frame should be discarded and an TCP checksum error recorded.
-- Test 7.4
--    Broadcast frame, TCP, total length = 0x0000, but frame 64 bytes,
--    IP checksum is good.
--    The frame should be discarded and an TCP checksum error recorded.
-- Test 7.5
--    Broadcast frame, TCP, total length = 0x27EE (maximum length jumbo frame),
--    IP checksum is good, jumbo enabled.
--    The frame should be successfully stored.
--
--  4. Check statistics for correct values from above tests.
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 3
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 64-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 01280001  -- enable RX TCP offload engine.
apbrd      04 01280001  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive
apbwr      10 00020304  -- Allow rx packets of up to 6.144k



--******************************************************************************
--  3. Send several good IP frames with various lengths.
--******************************************************************************


--******************************************************************************
-- Test 7.1
--    Broadcast frame, SNAP, TCP with good checksums. Length field checking
--    enabled and length field does not match length measured.
--    The frame should be discarded with a length field error recorded.
--******************************************************************************

apbwr      04 01290001  -- Enable length field checking
apbrdf     20 00000000  "Test 7.1 to 7.2 : length field checking on SNAP"
                        -- trigger reception of frame

rxd(apb)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0099         -- Length/typeID
rxd        AAAA         -- DSAP and SSAP
rxd        0300         -- Control / Protocol ID[7:0]
rxd        0000         -- Protocol ID [23:8]
rxd        0800         -- Length/typeID
rxd        4900         -- Version, IHL, type of service
rxd        0038         -- total length
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        1AC8         -- IP Header checksum
rxd        FFFFFFFF     -- IP SA
rxd        FFFFFFFF     -- IP DA
rxd        FBFD0000     -- IP options
rxd        00000000     -- IP options
rxd        00000000     -- IP options
rxd        00000000     -- IP options
rxd        0015         -- TCP source port
rxd        048A         -- TCP destination port
rxd        3DBB5C60     -- Sequence number
rxd        EA224D76     -- Acknowledgement Number
rxd        50104428     -- Flags and window
rxd        9559         -- TCP checksum
rxd        0000         -- TCP urgent pointer
rxd        000000000000 -- options or padding
rxd        gggggggg     -- FCS


-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
filterc da FFFFFFFFFFFF sa 563412390008 type 0800 ipsa FFFFFFFF ipda FFFFFFFF


-- supply the receive buffer location
dma_rd rx_descr fffff000 22222100 -- dma reads pointer of 22222100

-- frame discarded here because of bad TCP checksum

