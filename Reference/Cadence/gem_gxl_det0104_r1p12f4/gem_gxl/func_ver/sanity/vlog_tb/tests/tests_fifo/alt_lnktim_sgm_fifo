--
--   Description
----------------
--   The purpose of this test is to verify that in alternative sgmii mode 
--   configuration dat of 4001 is driven almost immediately.
--
--
-- Detailed Test Description
----------------------------
-- 1. Initialise the GEM for Gigabit Operation with PCS enabled. Furthermore, Auto-Negotiation is 
--    enabled.
-- 2. The GEM should transmit alternating /C/ codes with the Config_Reg field all zeros.  The GEM
--    will continue to do this until the AN_Restart state is entered at which point ACK
--    is driven high

--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- ********************************************************************************************* --
-- 1. Initialise the GEM for Gigabit Operation with PCS enabled. Furthermore, Auto-Negotiation is 
--    enabled.
-- ********************************************************************************************* --

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd     200 00009040  -- check value of pcs control register
apbwr      04 08080c00  -- Put MAC into sgmii, gigabit mode with TBI. 
apbrd      04 08080c00  -- Check value of network config register
apbwr      00 00200004  -- enable receive and set alt sgmii mode
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 03020100  -- specific address register 1 bottom
apbwr      8C 00000504  -- specific address register 1 top
apbrd     200 00001040  -- check value of pcs control register
apbrd     204 00000109  -- check pcs status register
apbrdf     20 00000000  -- check receive status register and trigger reception


-- ********************************************************************************************* --
-- 2. The GEM should transmit alternating /C/ codes with the Config_Reg field all zeros. 
-- ********************************************************************************************* --

pcs_an_tx             0000  

-- ********************************************************************************************* --
-- 3. After the AN_RESTART state is entered the following is driven
-- ********************************************************************************************* --

pcs_an_tx             0140 


-- ********************************************************************************************* --
-- 4. Terminate the simulation very early
--    If 0140 is not driven the test will fail with "PCS_TXD not done"
-- ********************************************************************************************* --
end(200)
