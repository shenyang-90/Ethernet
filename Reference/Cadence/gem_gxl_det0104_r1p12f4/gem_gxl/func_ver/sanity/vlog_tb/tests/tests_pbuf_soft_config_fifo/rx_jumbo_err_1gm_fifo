--------------------------------------------------------------------------------
--
--   Description
--
-- The receive functionality is tested for accepting jumbo frames 
-- in 1000 mode of operation
-- 
-- Functional Coverage
----------------------
-- · Ensures that the GEM can properly deal with jumbo frames that have 
--   errors in them in 1000 mode of operation.
-- 
-- Detailed Test Description
----------------------------
--    
-- Receiving Jumbo Frames with errors in 1000 mode:
-- 1. Receive a jumbo frame that is 2000 bytes long with a bad crc.
-- 2. Receive a jumbo frame that is 1537 bytes long with an invalid 
--    length field.
-- 3. Receive a good, jumbo frame of 4096 bytes then check the status and 
--    statistics registers and ensure that the above operations were 
--    handled properly.
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

apbwr(60)  4c 00000001  -- enable soft config fifo port bit when available
apbrd      4c 00000001  -- check enable soft config bit when available

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 44332211  -- specific address register 2 bottom
apbwr      94 00006655  -- specific address register 2 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00090409  -- indicate 1G operation, jumbo frames enabled,
                        --  length field checking enabled
apbrd      04 00090409  -- verify write to speed register..
apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

