--
--   Description
----------------
--
-- This shows the GEM receiving data at 100Mbps in SGMII mode
--
--
-- 
--
-- Detailed Test Description
----------------------------
--
-- The auto-negotiation function is disabled (using bit-7 of the PCS Control
-- Register) prior to selecting PCS. The PCS is selected by setting PCS enable
-- in the MAC network configuration register and the speed bit but not setting
-- the gigabit bit.
--
-- Four frames are received. The input data needs to be repeated 10 times
-- 
--------------------------------------------------------------------------------

-- Configuration Requirements ..
requires ext_fifo_interface 1
requires no_pcs 0
pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state


-- check the relevant pcs registers
apbrd(100) 184 00000000 -- ignore this read


-- this is the event count that will initialize the scaler for event counts. it will cause any future scaling to only scale
-- the counts after start_scale
start_scale

                         -- indicates the pcs is in reset (until enabled)
apbrd      204 00000109  -- check reset value of pcs status reg
apbrd      210 00000020  -- check reset value of pcs a-n advertisement reg
apbrd      214 00000000  -- check reset value of pcs a-n link ptnr ability reg
apbrd      218 00000004  -- check reset value of pcs a-n expansion reg
apbrd      21C 00000000  -- check reset value of pcs a-n next page reg
apbrd      220 00000000  -- check reset value of pcs a-n link partner reg
apbrd      23C 00008000  -- check reset value of pcs a-n extended status reg


-- initialise the relevant pcs registers
apbwr      200 00000040  -- disable auto-negotiation prior to enabling PCS


-- check and initialise the relevant mac registers
apbrd      000 00000000  -- check reset value of network control register
apbwr      000 00000004  -- enable rx
apbrd      00 zzzzzzzz repeat=15 -- repeat read 15 times to ensure rx enable is propagated through design
apbwr      028 ffffffff  -- enable all interrupts
apbrd      008 00000006  -- check reset value of network status register

-- # Initialize the network configuration register
-- #   -eam      <1|0|random>, default = 0. This is external address matching
-- #   -duplex   <full|half|random>, default = random
-- #   -speed    <1g|100m|10m|random>, default = random
-- #   -jumbo    <1|0|random>, default = random. This wont affect the RX transactor below, but will automatically cause jumbos to be dropped.
-- #   -copy_all <1|0|random>, default = 0. If 0, ensure you initialize the dest_addr in the rx transactor to something that will match
-- #   -databus  <32|64|128|take_from_cfg|random>, default = random, bus <= config.  The max value is the value set in dma_bus_width in gem_defs.v
-- #   -rx_toe   <1|0|random>, default = 0. Enables RX TCP/IP checksum offload
-- #   -pcs_en   <1|0|random>, default = 0. Enables SGMII PCS
-- #   -pause_en <1|0|random>, default = 0. Enables pausing of transmission
-- #   -dont_copy_pause <1|0|random>, default = 0. Controls whether pause frames are copied
init_ncr -sgmii_en 1 -pcs_en 1 -retry_test 0 -copy_all 1 -duplex full -speed 100m -jumbo 0 -databus 32 -eam 0 -rx_toe 0 -pause_en 0 -dont_copy_pause 0 -multicast_hash 0 -unicast_hash 0


