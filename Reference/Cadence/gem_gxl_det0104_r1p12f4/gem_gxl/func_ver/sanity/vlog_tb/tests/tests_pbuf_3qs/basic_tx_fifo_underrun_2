--
--   Description
----------------
--
-- Based on basic_tx_fifo_underrun but added random DMA frames at the same time
--
-- Send good and underrun frames into the tx fifo interface while sending
-- DMA frames
--
-- Functional Coverage
----------------------
-- · Checks transmission with good and underrun frames on fifo port
--    
--
-- Detailed Test Description
----------------------------
--
-- Enable transmit and interrupts, write control registers.
--
-- Supply transmit data to the FIFO interface and check the
-- transmitted data, pad and crc.
-- Supply transmit data to the DMA and check the transmitted 
-- data, pad and crc.
--
-- On reception of the transmit complete interrupt check the
-- interrupt and trasnmit status registers and the statistics
-- registers/
--
-- Underrun frames sent from the tx_fifo interface will not produce 
-- underrun interrupt or interrupt status or underrun statistics 
-- but DMA frames will produce underrun indication in this 
-- configuration.
--
-- Check underrun indicate is indicated directly to the tx_fifo 
-- interface on the tx_r_status bus.
--
-- This tests a frame supplied with known CRC:-
-- 
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 0000ffff  -- enable all interrupts
apbwr      440 88000000  -- write transmit queue pointer 1
apbwr      444 99000000  -- write transmit queue pointer 2
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer  ( force fifo to send first burst of frames before dma frames)
apbwr      00 00000208  -- write tx_go and enable tx and rx


apbrd(3000)     1d8 00000000  -- dummy reads from write only register
apbrdf     1d8 00000000  -- dummy reads from write only register and trigger for fifo frame


-- test 10 frames of random number of buffers with random data at random buffer locations
tx_frame  10
      number_of_bufs 1-10
      buffer_size    1-100
      data           random
      auto_gen_int   0
      num_dma_queues 3
      fix_queue_num  2
      fcs            YES


