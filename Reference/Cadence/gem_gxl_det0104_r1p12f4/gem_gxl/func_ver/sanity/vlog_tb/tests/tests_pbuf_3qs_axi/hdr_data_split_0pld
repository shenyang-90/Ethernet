
--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 010a0001  -- enable RX TCP offload engine, strip CRC.
apbwr      18 f0000000  -- write receive queue pointer for Q0
apbrd      18 f0000000  -- check receive queue pointer for Q0
apbwr     480 f0010000  -- write receive queue pointer for Q1
apbwr     484 fffff000  -- write receive queue pointer for Q2
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbwr      600 ffffffff  -- enable q1 interrupts
apbwr      604 ffffffff  -- enable q2 interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive
apbwr      10 00010724  -- enable header data splitting enable
apbwr     4a0 000000ff  -- Buffer size Q1
apbwr     4a4 000000ff  -- Buffer size Q2


-- Setup a screener , using compare reg 0, vlan match disabled, queue = 2
apbwr      540 00040002  

-- Setup compare reg, offset = 0, comparing from end of L3 header
apbwr      700 8A041500  -- Compare value
apbwr      704 00000300  -- Compare control, dont use mask

apbrdf     20 00000000  

# Lets receive 2 frames that will match on compare reg 0, therefore
# match screener 0. Queue 2 will therefore receive this frame.
# Since RSC is enabled on queue 2, we will expect these to be coalesced.

rxd(apb)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4700         -- Version, IHL, type of service, #2
rxd        0030         -- total length (48 bytes), #4
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        96ea         -- IP Header checksum, #12
rxd        C0A80001     -- IP SA, #16
rxd        C0A80091     -- IP DA, #20
rxd        00000000     -- IP OPtion
rxd        00000000     -- IP OPtion
rxd        0015         -- TCP source port, #22
rxd        048A         -- TCP destination port, #24
rxd        01000000     -- Sequence number, #28
rxd        EA224D76     -- Acknowledgement Number, #32
rxd        50104428     -- Flags and window, #36
rxd        ac91         -- TCP checksum, #38
rxd        0000         -- TCP urgent pointer, #40

rxd        gggggggg     -- FCS

rxd(gap)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service, #2
rxd        004d         -- total length (77 bytes), #4
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        98cd         -- IP Header checksum, #12
rxd        C0A80001     -- IP SA, #16
rxd        C0A80091     -- IP DA, #20
rxd        0015         -- TCP source port, #22
rxd        048A         -- TCP destination port, #24
rxd        01000000     -- Sequence number, #28
rxd        EA224D76     -- Acknowledgement Number, #32
rxd        50104428     -- Flags and window, #36
rxd        ad6b         -- TCP checksum, #38
rxd        0000         -- TCP urgent pointer, #40

rxd        ffffffffffffffffffffffffffffffff -- Data #56
rxd        ffffffffffffffffffffffffffffffff -- Data #72
rxd        ffffffffff                       -- Data #77
rxd        00112233                         -- PAD
rxd        0011                             -- PAD

rxd        gggggggg     -- FCS



