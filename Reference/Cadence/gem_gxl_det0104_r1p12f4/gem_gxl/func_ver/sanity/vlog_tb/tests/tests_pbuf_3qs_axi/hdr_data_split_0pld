-- Buffer 1 (ETH, IP HEADER)

-- descritpor read
dma_rd fffff000 22222102 -- dma reads pointer of 22222100

-- payload write
dma_wr 22222100 FFFFFFFF -- store frame to memory
dma_wr 22222104 0008FFFF
dma_wr 22222108 56341239
dma_wr 2222210c 00470008
dma_wr 22222110 fadf3000  -- total length field here
dma_wr 22222114 06800040
dma_wr 22222118 a8c0ea96  -- IP checksum field here
dma_wr 2222211c a8c00100
dma_wr 22222120 00009100
dma_wr 22222124 00000000
dma_wr 22222128 15000000
dma_wr 2222212c 00018a04
dma_wr 22222130 22ea0000  -- ACK_NUM 1st half here
dma_wr 22222134 1050764d  -- ACK_NUM 2nd half here
dma_wr 22222138 91ac2844  -- TCP checksum field here
dma_wr 2222213c 00000000

-- descriptor write
dma_wr fffff004 8080c03e
dma_wr fffff000 22222103 -- dma writes ownership bit
----------------------------------------------------------

apbrd(int2) 404 00000002  -- check interrupt status - receive complete
apbwr       404 00000002  
