-- we are testing the offset field here
apbwr      700 12345678  -- Compare reg 0a
apbwr      704 00000280  -- Compare reg 0b, offset is 0
apbwr      708 23456789  -- Compare reg 1a
apbwr      70c 00000281  -- Compare reg 1b, offset is 1
apbwr      710 3456789a  -- Compare reg 2a
apbwr      714 00000282  -- Compare reg 2b, offset is 2
apbwr      718 456789ab  -- Compare reg 3a
apbwr      71c 00000283  -- Compare reg 3b, offset is 3
apbwr      720 56789abc  -- Compare reg 4a
apbwr      724 000002ff  -- Compare reg 4b, offset is 127 (max)
apbwr      728 6789abcd  -- Compare reg 5a
apbwr      72c 000002fe  -- Compare reg 5b, offset is 126 
apbwr      730 789abcde  -- Compare reg 6a
apbwr      734 000002ea  -- Compare reg 6b, offset is even and in full range (106 dec)
apbwr      738 89abcdef  -- Compare reg 7a
apbwr      73c 000002a1  -- Compare reg 7b, offset is odd and in full range (33 dec)

