--
-- Test Description
-- See if a variety of PTP frames version 1 encapsulated in IPv4 can be detected
-- Some have incorrect addresses
--
-- Receive frames:-
-- RX Frame 1 : PTP sync frame
-- RX Frame 2 : PTP delay request frame
-- RX Frame 3 : PTP sync frame but DA address with LSB zero - not recognized
-- RX Frame 4 : PTP sync frame  DA address with LSBs 2
-- RX Frame 5 : PTP sync frame  DA address with LSBs 3
-- RX Frame 6 : PTP sync frame  DA address with LSBs 4
-- RX Frame 7 : PTP sync frame  DA address with LSBs 5 - not recognized
--
-- Transmit frames:-
-- TX Frame 1 : PTP sync frame
-- TX Frame 2 : PTP delay request frame
-- TX Frame 3 : PTP sync frame event with different address
-- TX Frame 4 : PTP sync frame event with incorrect address
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  check reset state of PTP output flags
--******************************************************************************
pinsc(50) sof_tx        0
pinsc     sync_frame_tx 0
pinsc     delay_req_tx  0
pinsc     sof_rx        0
pinsc     sync_frame_rx 0
pinsc     delay_req_rx  0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080013  -- copy all & full duplex
apbrd      04 00080013  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status


--******************************************************************************
-- RX Frame 1 : PTP sync frame
--******************************************************************************

apbrdf     20 00000000  "Frame 1 : PTP sync frame"
                        -- trigger reception of frame



rxd(apb)   55d5         -- preamble & SDF
rxd        00e0f7263fe9 -- MAC DA
rxd        08002086354b -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        002c         -- total length = 55
rxd        08b8         -- ID
rxd        4000         -- flags & fragmentation
rxd        ff11         -- time to live and UDP protocol
