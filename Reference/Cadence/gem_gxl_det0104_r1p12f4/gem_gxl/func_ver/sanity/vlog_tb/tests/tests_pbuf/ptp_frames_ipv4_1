rxd        e0000181     -- IP DA
rxd        9005         -- UDP source port
rxd        013f         -- UDP destination port
rxd        0012         -- UDP length
rxd        7228         -- UDP checksum
rxd        00016c6c     -- version PTP, version network
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        6f68656c     -- subdomain
rxd        abababab     -- other stuff
rxd        abababab     -- other stuff
rxd        abababab     -- UUID, sequenceID
rxd        00000000     -- sync frame control field, flags, reserved
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        00000000     -- PAD
rxd        gggggggg     -- FCS


--  check state of PTP output flags
pinsc(540) sof_tx        0
pinsc      sync_frame_tx 0
pinsc      delay_req_tx  0
pinsc      sof_rx        1
pinsc      sync_frame_rx 1
pinsc      delay_req_rx  0

-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
