--
--   Description
----------------
--
-- This checks PFC pause frame priority enable and the pause counters.
--
--
-- Functional Coverage
----------------------
-- This checks that the 8 PFC counters are independently updated of new PFC pause 
-- frames. A counter is loaded on reception of a non-zero PFC frame with priority
-- enable is set for this counter. The next frame is a zero PFC frame with
-- priority enable is set for all other counters. The counter is not overloaded.
-- Then there is a zero PFC frame with priority enable is set for the counter and
-- it will be overloaded.
-- All 8 counters are tested with this sequence in 'debug fast mode' 
-- (retry test bit set to 1). 
-- 
--
--------------------------------------------------------------------------------


pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

apbwr(60)  4c 00000001  -- enable soft config fifo port bit when available
apbrd      4c 00000001  -- check enable soft config bit when available

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register

apbwr      00 0001000C  -- enable receive/transmit and PFC pause frame reception
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080001  -- indicate 100M operation, will check pin l8r.
apbrd      04 00080001  -- verify write to speed register..
apbrd      20 00000000  -- check contents of the receive status register and trigger reception of frame


-- ============================================
--               Test Counter0               --
-- ============================================

-------------
-- Frame 1 --
-------------
-- ************************************************************************** --
-- Receive a non-zero PFC pause frame 
-- priority enable =0x0001.
-- PFC pause time for priority 0 = 0xffff
-- PFC pause time for priority 1 = 0x0000
-- PFC pause time for priority 2 = 0x0000
-- PFC pause time for priority 3 = 0x0000
-- PFC pause time for priority 4 = 0x0000
-- PFC pause time for priority 5 = 0x0000
-- PFC pause time for priority 6 = 0x0000
-- PFC pause time for priority 7 = 0x0000
-- ************************************************************************** --

-- ============================================
-- set  retry test bit to 1                  --
-- counter decrement every rx_clck cycle     --
-- ============================================
apbwrf       04 00083003 -- dsiable copy of pause frame bit(23) = 0,
                         -- reset retry test bit(12) = 1, 
                         -- keep enable pause time bit(13) = 1,
                         -- copy all frames bit(4) = 0
                         -- full-duplex bit(1) = 1,
                         -- 100Mbps speed bit(0) = 1
                        

rxd(apb)     d50180C200000111112222222288080101
rxd            0001ffff000000000000000000000000 
rxd            0000888899999999aaaaaaaabbbbbbbb
rxd            000000000000000000000000gggggggg


apbrd(int)   24 00001000 -- check interrupt status - non-zero pause frame received
apbwr        24 00001000 -- clear it

-- event counts increment by 2 every rx_clk clock cycle
-- counter decrement every rx_clck cycle
pinsc(461) pfc_negotiate 1 rx_pfc_paused 00000001  -- counter0 loaded

apbrdf       08 00000046 -- check pfc_negotiate = 1, trigger next PFC frame on rxd

