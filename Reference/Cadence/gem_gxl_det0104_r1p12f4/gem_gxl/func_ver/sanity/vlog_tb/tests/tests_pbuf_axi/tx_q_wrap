-- 24Nov2001     martinj Added for new implementation of wrapping mid frame
-- 
-- This test checks that the design can transmit buffers which wrap mid frame.
--
-- Test Procedure:
--
-- For all of these tests, frames are multi-buffer using a tx queue pointer 
-- base address of 0xEFFFFFF0. This will check that address generation 
-- for tx queue descriptors is formed by true 32 bit addition from the 
-- queue pointer base address.
--
-- Try wrapping mid frame and check that writeback happens to correct start 
-- address.
--
-- Try wrapping mid frame when a used bit is set as well.
-- Check that writeback happens to correct start address (will underrun).
--
-- Try a collision after wrapping mid frame.
-- Check that retry starts at beginning again.
--
-- Check Statistics
--
-- ************************************************************************** --

wait_states 0

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c effffff0  -- write address of transmit buffer descriptor in memory
apbrd      1c effffff0  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx


-- ************************************************************************** --
-- Send two frames, the first with a wrap, followed by a second with a wrap 
-- and used bit mid frame.
-- ************************************************************************** --


-- ************************************************************************** --
-- First frame:
-- Try wrapping mid frame and check that writeback happens to correct start 
-- address.

-- first do a zero length buffer frame to make sure start of real test
-- isn't at base address
dma_rd tx_descr effffff4 00008000 -- end of frame set, length 0 bytes
dma_rd tx_descr effffff0 98765000 -- dma reads pointer of 98765000



--start of real data buffer
dma_rd tx_descr effffffc 00000020 -- length 32 bytes
dma_rd tx_descr effffff8 98765000 -- dma reads pointer of 98765000
dma_rd 98765000 11111111
dma_rd 98765004 22222222
dma_rd 98765008 33333333
dma_rd 9876500c 44444444
dma_rd 98765010 55555555
dma_rd 98765014 66666666
dma_rd 98765018 77777777
dma_rd 9876501c 88888888

dma_rd tx_descr f0000004 00000020 -- length 32 bytes
dma_rd tx_descr f0000000 98765100 -- dma reads pointer of 98765100
dma_rd 98765100 99999999
dma_rd 98765104 aaaaaaaa
dma_rd 98765108 bbbbbbbb
dma_rd 9876510c cccccccc
dma_rd 98765110 dddddddd
dma_rd 98765114 eeeeeeee
dma_rd 98765118 ffffffff
dma_rd 9876511c 00000000

dma_rd tx_descr f000000c 40000020 -- wrap set mid frame, length 32 bytes
dma_rd tx_descr f0000008 98765200 -- dma reads pointer of 98765200
dma_rd 98765200 11111111
dma_rd 98765204 22222222
dma_rd 98765208 33333333
dma_rd 9876520c 44444444
dma_rd 98765210 55555555
dma_rd 98765214 66666666
dma_rd 98765218 77777777
dma_rd 9876521c 88888888

dma_rd tx_descr effffff4 00000020 -- length 32 bytes
dma_rd tx_descr effffff0 98765300 -- dma reads pointer of 98765300 (wrapped!)
dma_rd 98765300 99999999
dma_rd 98765304 aaaaaaaa
dma_rd 98765308 bbbbbbbb
dma_rd 9876530c cccccccc
dma_rd 98765310 dddddddd
dma_rd 98765314 eeeeeeee
dma_rd 98765318 ffffffff
dma_rd 9876531c 00000000

dma_rd tx_descr effffffc 00000020 -- length 32 bytes
dma_rd tx_descr effffff8 98765400 -- dma reads pointer of 98765400
dma_rd 98765400 11111111
dma_rd 98765404 22222222
dma_rd 98765408 33333333
dma_rd 9876540c 44444444
dma_rd 98765410 55555555
dma_rd 98765414 66666666
dma_rd 98765418 77777777
dma_rd 9876541c 88888888

dma_rd tx_descr f0000004 40008020 -- wrap set and end of frame set, length 32 bytes
dma_rd tx_descr f0000000 98765500 -- dma reads pointer of 98765500
dma_rd 98765500 99999999
dma_rd 98765504 aaaaaaaa
dma_rd 98765508 bbbbbbbb
dma_rd 9876550c cccccccc
dma_rd 98765510 dddddddd
dma_rd 98765514 eeeeeeee
dma_rd 98765518 ffffffff
dma_rd 9876551c 00000000


-- write transmit complete status
dma_wr effffffc 80000020 -- write used bit

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d511111111222222223333333344444444
txd                    55555555666666667777777788888888
txd                    99999999aaaaaaaabbbbbbbbcccccccc
txd                    ddddddddeeeeeeeeffffffff00000000
txd                    11111111222222223333333344444444
txd                    55555555666666667777777788888888
txd                    99999999aaaaaaaabbbbbbbbcccccccc
txd                    ddddddddeeeeeeeeffffffff00000000
txd                    11111111222222223333333344444444
txd                    55555555666666667777777788888888
txd                    99999999aaaaaaaabbbbbbbbcccccccc
txd                    ddddddddeeeeeeeeffffffff00000000
txd                    e3b0d9f1 -- crc



-- ************************************************************************** --
-- Second frame:
-- Try wrapping mid frame when a used bit is set as well.
-- Check that writeback happens to correct start address (will underrun).

-- first do a zero length buffer frame to make sure start of real test
-- isn't at base address
dma_rd tx_descr effffff4 00008000 -- end of frame set, length 0 bytes
dma_rd tx_descr effffff0 98765000 -- dma reads pointer of 98765000


dma_rd tx_descr effffffc 00000010 -- length 16 bytes
dma_rd tx_descr effffff8 98765000 -- dma reads pointer of 98765000
dma_rd 98765000 11111111
dma_rd 98765004 22222222
dma_rd 98765008 33333333
dma_rd 9876500c 44444444

dma_rd tx_descr f0000004 0000000c -- length 12 bytes
dma_rd tx_descr f0000000 98765100 -- dma reads pointer of 98765100
dma_rd 98765100 55555555
dma_rd 98765104 66666666
dma_rd 98765108 77777777

dma_rd tx_descr f000000c 0000000c -- length 12 bytes
dma_rd tx_descr f0000008 98765100 -- dma reads pointer of 98765100
dma_rd 98765100 55555555
dma_rd 98765104 66666666
dma_rd 98765108 77777777

dma_rd tx_descr f0000014 0000000c -- length 12 bytes
dma_rd tx_descr f0000010 98765100 -- dma reads pointer of 98765100
dma_rd 98765100 55555555
dma_rd 98765104 66666666
dma_rd 98765108 77777777

dma_rd tx_descr f000001c c000000c -- wrap set mid frame, length 12 bytes, used bit read
dma_rd tx_descr f0000018 98765200 -- dma reads pointer of 98765200
                         -- will not wrap because used bit is set. Instead
                         -- queue pointer will return to beginning of frame.



-- write transmit complete status
dma_wr effffffc 88000010 -- write used bit (NO tx underrun & exhausted mid frame)


--------------------------------------------------------------------------------
-- With the packet buffer present, the frame is never passed to the TX MAC,
-- so no TXD to monitor...
--------------------------------------------------------------------------------

