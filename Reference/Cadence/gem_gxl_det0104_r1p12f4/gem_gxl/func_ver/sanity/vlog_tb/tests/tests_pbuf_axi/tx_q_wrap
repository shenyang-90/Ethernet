-- txd    55555555555555d511111111222222223333333344444444
-- txd                    55555555666666667777777755555555
-- txd                    66666666777777775555555566666666
-- txd                    77777777
-- txd                    77 -- JAM (underrun)


-- Interrupts for both frames happen at the same time
apbrd(int) 24 00000080  -- check interrupt status - complete, exhausted & mid frm
apbwr      24 00000080  -- clear interrupt status
apbrd(int) 24 00000048  -- check interrupt status - complete, exhausted & mid frm
apbwr      24 00000048  -- clear interrupt status
apbrd      14 00000031  -- read transmit status register - complete, buffers exhausted & mid frame
apbwr      14 00000031  -- clear tx status






