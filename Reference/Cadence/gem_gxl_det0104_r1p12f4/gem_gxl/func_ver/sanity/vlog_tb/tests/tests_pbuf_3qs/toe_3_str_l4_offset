--
-- Test Description
-- Multiple min sized UDP frames back to back
--  4. Check statistics for correct values from above tests.
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 3
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      10 00020104  -- enable endian swap mode
apbwr      04 00000403  -- 
apbrd      04 00000403  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffff018  -- write receive queue pointer
apbrd      18 fffff018  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00400004  -- enable receive
apbwr      00 00400004  -- enable receive



--******************************************************************************
--  3. Send several IP frames with either SNAP or ethernet encapsulation, which
--     have good IP checksum and are valid TCP or UDP with good checksums.
--******************************************************************************



--******************************************************************************
-- Test 2.1
--    1 normal UDP frame followed by 3 Truncated UDP frames back to back
--******************************************************************************

apbrdf     20 00000000  "Test 2.4 : Valid UDP, odd, no VLAN, SNAP, options"
                        -- trigger reception of frame

rxd(200)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        001F         -- total length
rxd        0000         -- ID
rxd        0000         -- flags & fragmentation
rxd        0A11         -- time to live and protocol
rxd        81DC         -- IP Header checksum
rxd        86BF0B52     -- IP SA
rxd        86BF1622     -- IP DA
rxd        0000         -- UDP source port
rxd        0000         -- UDP destination port
rxd        000B         -- UDP length
rxd        68B1         -- UDP checksum
rxd        12345678     -- UDP data
rxd        9ABCDEF0     -- UDP data
rxd        00000000     -- UDP data
rxd        00000000     -- UDP data
rxd        0000B038     -- UDP data
rxd        00A50000     -- UDP data
rxd        00000000     -- UDP data
rxd        00000000     -- UDP data
rxd        00000000     -- UDP data
rxd        00000000     -- UDP data
rxd        78C294FD     -- Good FCS

rxd(gap)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        8100         -- Length/typeID
rxd        0001         -- VLAN tag
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        001F         -- total length
rxd        0000         -- ID
rxd        0000         -- flags & fragmentation
rxd        0A11         -- time to live and protocol
rxd        81DC         -- IP Header checksum
rxd        86BF0B52     -- IP SA
rxd        86BF1622     -- IP DA
rxd        gggggggg     -- Good FCS
rxd(gap)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        001F         -- total length
rxd        0000         -- ID
rxd        0000         -- flags & fragmentation
rxd        0A11         -- time to live and protocol
rxd        81DC         -- IP Header checksum
rxd        86BF0B52     -- IP SA
rxd        86BF1622     -- IP DA
rxd        gggggggg     -- Good FCS
rxd(gap)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        001F         -- total length
rxd        0000         -- ID
rxd        0000         -- flags & fragmentation
rxd        0A11         -- time to live and protocol
rxd        81DC         -- IP Header checksum
rxd        86BF0B52     -- IP SA
rxd        86BF1622     -- IP DA
rxd        gggggggg     -- Good FCS


-- supply the receive buffer location
dma_rd fffff018 22222400 -- dma reads pointer of 22222400

-- check the receive data as it is written out on the AHB interface
dma_wr 22222400 FFFFFFFF -- store frame to memory
dma_wr 22222404 0008FFFF
dma_wr 22222408 56341239
dma_wr 2222240c 00450008
dma_wr 22222410 00001F00
dma_wr 22222414 110A0000
dma_wr 22222418 BF86DC81
dma_wr 2222241c BF86520B
dma_wr 22222420 00002216
dma_wr 22222424 0B000000
dma_wr 22222428 3412B168
dma_wr 2222242c BC9A7856
dma_wr 22222430 0000F0DE
dma_wr 22222434 00000000
dma_wr 22222438 00000000
dma_wr 2222243c A50038B0
dma_wr 22222440 00000000
dma_wr 22222444 00000000
dma_wr 22222448 00000000
dma_wr 2222244c 00000000
dma_wr 22222450 00110000
dma_wr 22222454 00000000

dma_wr fffff01c 8000c056 
dma_wr fffff018 22222401 


-- check status on reception of receive complete interrupt
apbrd(int) 24 00000002  "Test 2.4 complete"
                        -- check interrupt status - receive complete
apbwr      24 00000002  -- Clear it
apbrd      20 00000002  -- check RX status register - receive complete
apbwr      20 00000002  -- clear RX status register



end(40000)


