-- ********************************************************************************************* --

apbwr(int)     21c 0000a7ff  -- setup pcs auto-nego. next page register
apbrd          21c 0000a7ff  -- check pcs auto-nego. next page register
apbrd           24 00020000  -- check interrupt status register - PCS next page request interrupt set 
apbrd          200 00001040  -- check pcs control register
apbrd          204 00000109  -- check pcs status register
apbrd          204 00000109  -- check pcs status register
