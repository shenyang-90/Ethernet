dma_rd ffffff20 99990000 -- dma reads pointer for Queue 2
dma_rd ffffff24 99990000 -- dma reads pointer for Queue 2 - used bit is high
dma_rd ffffff10 98765000 -- dma reads pointer for Queue 1
dma_rd ffffff14 4000807e -- dma reads pointer for Queue 1 - used bit is low
dma_rd 55555508 98764000 -- 
dma_rd 5555550c 0000807e -- dma reads pointer for Queue 0 - used bit is low


