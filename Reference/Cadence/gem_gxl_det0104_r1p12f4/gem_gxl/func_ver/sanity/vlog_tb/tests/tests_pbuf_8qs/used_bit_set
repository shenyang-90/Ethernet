-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce000
txd		       000207c107c1001cb6e9000008030a64
txd		       0200636973636f0000009e8ce0fd0000
txd                    01005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce000
txd		       000207c107c1001cb6e9000008030a64
txd		       0200636973636f0000009e8ce0fdb560d634



-- write transmit complete status for the oldest frame 1
dma_wr ffffff14 c000807e -- write used bit to queue 1



apbrd(int1)  400 00000080  -- check interrupt status - transmit complete
