apbrd(int7)  418 00000080  -- check interrupt status - transmit complete
apbwr        418 00000080  -- write to clear
apbrd        418 00000000  -- check clear

apbrd       24 00000008  -- check interrupt status - used bit set
apbwr       24 00000008  -- write to clear




