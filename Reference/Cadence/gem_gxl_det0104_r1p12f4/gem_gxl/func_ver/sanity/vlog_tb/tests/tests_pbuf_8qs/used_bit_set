-- wait_states 5 -- set the number of AHB wait states

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00  00000000  -- check reset value of network control register
apbwr      28  ffffffff  -- enable all interrupts q0
apbwr      600 ffffffff  -- enable all interrupts q1
apbwr      604 ffffffff  -- enable all interrupts q2
apbwr      608 ffffffff  -- enable all interrupts q3
apbwr      60c ffffffff  -- enable all interrupts q4
apbwr      610 ffffffff  -- enable all interrupts q5
apbwr      614 ffffffff  -- enable all interrupts q6
apbwr      618 ffffffff  -- enable all interrupts q7
apbwr      1c  55555508  -- write transmit queue pointer 0
apbwr      440 ffffff10  -- write transmit queue pointer 1
apbwr      444 ffffff20  -- write transmit queue pointer 2
apbwr      448 ffffff30  -- write transmit queue pointer 3
apbwr      44c ffffff40  -- write transmit queue pointer 4
apbwr      450 ffffff50  -- write transmit queue pointer 5
apbwr      454 ffffff60  -- write transmit queue pointer 6
apbwr      458 ffffff70  -- write transmit queue pointer 7
apbrd      04  00080000  -- check reset value of network config register
apbwr      04  00280002  -- set to full duplex mode, 64 bit
apbrd      08  00000006  -- check reset value of network status register
apbrd      1c  55555508  -- check transmit queue pointer
apbwr      00  00000208  -- write tx_go and enable tx

-- First transmit from Queue 1 - 
-- Queue 1 and Queue 0 have the used bit = 0
-- Queue 7:2 have the used bit = 1

dma_rd ffffff70 99990000 -- dma reads pointer for Queue 7
dma_rd ffffff74 99990000 -- dma reads pointer for Queue 7 - used bit is high
dma_rd ffffff60 99990000 -- dma reads pointer for Queue 6
