-- Frame 2  (PAYLOAD)
-- will continue from the end of the last ... Note the byte strobes

dma_wr 22222148 ffffff00 e
dma_wr 2222214c ffffffff
dma_wr 22222150 ffffffff
dma_wr 22222154 ffffffff
dma_wr 22222158 ffffffff
dma_wr 2222215c ffffffff
dma_wr 22222160 ffffffff
dma_wr 22222164 ffffffff
dma_wr 22222168 ffffffff
dma_wr 2222216c 7788ffff 1

-- update cycle
-- ,IPv4 Total Length, then Ipv4 checksum, then TCP seq num, then TCP checksum - 
dma_wr rx_descr 22222110 fadf7100 3  -- Update total length field here (77 + 36 = 113)
dma_wr rx_descr 22222118 a8c0a998 3  -- Update IP checksum field here
dma_wr rx_descr 22222130 46ae0000 c  -- Update TCP checksum field here
dma_wr rx_descr 22222128 22ea0000 c  -- Update ACK_NUM 1st half here
dma_wr rx_descr 2222212c 0000764d 3  -- ACK_NUM 2nd half here
dma_wr rx_descr 2222212c 10000000 8  -- ACK bit


-- TCP flag was detected in the 3rd frame, so we should stop coalescing and 
-- send descriptor writeback update.
-- All we need to do is update the descriptor length and set the last,used
-- bits

dma_wr rx_descr fffff004 0000807f 3 -- update total length (total length + eth hdr = 113 + 14 = 127)
dma_wr rx_descr fffff000 00000003 1 -- dma writes ownership bit Header
dma_wr rx_descr fffff000 00000027 1 -- dma writes ownership bit Payload

apbrd(int2) 404 00000002  -- check interrupt status - receive complete
apbwr       404 00000002  
apbrd       20 00000003  
apbwr       20 00000003 
apbrd       20 00000000  


