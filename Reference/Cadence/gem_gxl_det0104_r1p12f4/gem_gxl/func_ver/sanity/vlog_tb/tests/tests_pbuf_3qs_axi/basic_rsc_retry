-- Frame 1 (PAYLOAD)

-- descriptor read
dma_rd fffff000 22222127 -- dma reads pointer of 22222100
--apbrd(int2) 404 00000004  -- check interrupt status - RX read bit used
--apbwr       404 00000004  
dma_rd fffff000 22222126 -- dma reads pointer of 22222100


-- payload write
dma_wr 22222124 ffffffff
dma_wr 22222128 ffffffff
dma_wr 2222212c ffffffff
dma_wr 22222130 ffffffff
dma_wr 22222134 ffffffff
dma_wr 22222138 ffffffff
dma_wr 2222213c ffffffff
dma_wr 22222140 ffffffff
dma_wr 22222144 ffffffff
dma_wr 22222148 221100ff 1
-- dma_wr 22222148 b8d10a62 -- CRC and pad dropped

-- descriptor write
dma_wr rx_descr fffff004 80808065 
dma_wr rx_descr fffff000 22222126 -- dma writes descriptor, but without used bit!

