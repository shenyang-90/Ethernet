-- through as normal
-- descriptor read

dma_rd fffff000 22222103 -- dma reads pointer of 22222100
dma_rd fffff000 22222102 -- dma reads pointer of 22222100

dma_wr 22222100 FFFFFFFF -- store frame to memory
dma_wr 22222104 0008FFFF
dma_wr 22222108 56341239
dma_wr 2222210c 00450008
dma_wr 22222110 fadf4c00  -- total length field here
dma_wr 22222114 06800040
dma_wr 22222118 a8c0ce98  -- IP checksum field here
dma_wr 2222211c a8c00100
dma_wr 22222120 15009100
dma_wr 22222124 00008a04
dma_wr 22222128 22ea4a00  -- ACK_NUM 1st half here
dma_wr 2222212c 1450764d  -- ACK_NUM 2nd half here
dma_wr 22222130 1fad2844  -- TCP checksum field here
dma_wr 22222134 ffff0000

-- descriptor write
dma_wr rx_descr fffff004 00034036 
