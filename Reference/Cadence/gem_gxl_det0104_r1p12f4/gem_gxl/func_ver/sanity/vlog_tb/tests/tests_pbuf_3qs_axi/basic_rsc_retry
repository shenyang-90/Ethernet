-- Frame 1 (ETH, IP HEADER)

-- descriptor read
dma_rd fffff000 22222103 -- dma reads pointer of 22222100
                         -- read bit set

--apbrd(int2) 404 00000004  -- check interrupt status - RX read bit used
--apbwr       404 00000004  
dma_rd fffff000 22222102 -- dma reads pointer of 22222100

-- payload write
dma_wr 22222100 FFFFFFFF -- store frame to memory
dma_wr 22222104 0008FFFF
dma_wr 22222108 56341239
dma_wr 2222210c 00450008
dma_wr 22222110 fadf4d00  -- total length field here
dma_wr 22222114 06800040
dma_wr 22222118 a8c0cd98  -- IP checksum field here
dma_wr 2222211c a8c00100
dma_wr 22222120 15009100
dma_wr 22222124 00008a04
dma_wr 22222128 22ea0100  -- ACK_NUM 1st half here
dma_wr 2222212c 1050764d  -- ACK_NUM 2nd half here
dma_wr 22222130 6aae2844  -- TCP checksum field here
dma_wr 22222134 ffff0000

-- descriptor write
dma_wr fffff004 00034036 
dma_wr fffff000 22222102 -- dma writes ownership bit not set
