--
-- Test Description
-- Modify ptp_timer test case to check additonal tsu count bits.
-- Check TSU timer values - increment, adjust (subtract and add)
--
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register

apbrd     1c8 00000000  -- timer sync strobe seconds [31:0]
apbrd     1c4 00000000  -- timer sync strobe seconds [47:32]   
apbrd     1cc 00000000  -- timer sync strobe nanoseconds [29:0]
   
apbwr     1bc 00000000  -- 1588 timer increment (sub ns 16-bits)
apbwr     1dc fedcba98  -- 1588 timer increment (nsec [23:0]
   
pinsd(350) tsu_ms 0
pinsd(400) tsu_inc_ctrl 0
pinsd(450) tsu_inc_ctrl 11

   
apbrd(600) 1c8 00000000  -- timer sync strobe seconds [31:0] (Read Only)
apbrd      1c4 00000000  -- timer sync strobe seconds [47:32] (Read Only)   
apbrd      1cc 00001d18  -- timer sync strobe nanoseconds [29:0] (Read Only)
apbrd      1c4 00000000  -- timer sync strobe seconds [47:32] (Read Only)   
   
--   `define gem_tsu_timer_adjust         11'h1d8   -- 1588 timer adjust  ???






end(10000)


