                        -- interrupt status - transmit complete and tx buffer used
apbrd      24 00000000  -- check interrupt status is now clear
apbrd      14 00000021  -- transmit status register - transmit complete and tx buffer used
apbrd      14 00000021  -- check it again
apbwr      14 0000ffde  -- don't clear it
apbrd      14 00000021  -- check it again
apbwr      14 00000001  -- clear used bit
apbrd      14 00000020  -- check it again
