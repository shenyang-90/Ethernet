--
-- Test Description
-- See if a variety of PTP version 2 unicast frames encapsulated in IPv4 can't
-- be detected because unicast disabled, some have incorrect addresses
--
-- Receive frames:-
-- RX Frame 1 : PTP sync frame
-- RX Frame 2 : PTP delay request frame
-- RX Frame 3 : PTP sync frame but DA address not unicast - not recognized
-- RX Frame 4 : PTP pdelay_req frame
-- RX Frame 5 : PTP pdelay_resp frame
-- RX Frame 6 : PTP sync frame DA address not unicast - not recognized
-- RX Frame 7 : PTP sync frame DA address not unicast - not recognized
--
-- Transmit frames:-
-- TX Frame 1 : PTP sync frame
-- TX Frame 2 : PTP delay request frame
-- TX Frame 3 : PTP pdelay_req frame 
-- TX Frame 4 : PTP pdelay_resp frame 
-- TX Frame 5 : PTP sync frame event with incorrect address
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 00080013  -- copy all & full duplex
apbrd      04 00080013  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      d4 76543210  -- write unicast IP DA for RX PTP
apbwr      d8 fedcba98  -- write unicast IP DA for TX PTP
--apbwr      d8 fedcba98  -- write unicast IP DA for TX PTP
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status
apbrd      24 00000000  -- delay - check interrupt status

--******************************************************************************
-- Transmit Frames
--******************************************************************************
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00100208  "Starting transmit frames"
                        -- write tx_go and enable tx and ptp unicast enable



