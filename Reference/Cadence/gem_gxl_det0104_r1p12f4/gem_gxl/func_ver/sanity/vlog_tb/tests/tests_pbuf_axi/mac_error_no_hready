--
-- Test Description
-- This test checks the operation of the RX TCP offload engine, with IP frames
-- with SNAP and ethernet encapsulation, which have good IP checksum and are
-- valid TCP or UDP frames with good checksums
-- 
-- Functional Coverage
-- * Checks that the TOE recognises that these are TCP or UDP frames
--   and therefore checks the TCP/UDP checksum.
-- * Checks that the TOE can correctly compute TCP and UDP checksums for both 
--   odd and even length frames.
-- * Checks that the GEM can correctly report different types of encapsulation
--   and IP frames.
-- 
-- Detailed Test Description
--  1. Initialise suitable wait states for the test.
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--  3. Send several IP frames with either SNAP or ethernet encapsulation, which
--     have good IP checksum and are valid TCP or UDP with good checksums.
--
-- Test 2.1
--    Broadcast frame, Valid TCP, even length, no IP options, no VLAN, no SNAP
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and no SNAP (bit 24 low).
-- Test 2.2
--    Broadcast frame, Valid TCP, odd length, IP options, no VLAN or SNAP
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and no SNAP (bit 24 low).
-- Test 2.3
--    Broadcast frame, Valid TCP, Max length IP options, IP header 60 bytes,
--    VLAN, no SNAP.
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and no SNAP (bit 24 low).
-- Test 2.4
--    Broadcast frame, Valid UDP, odd length, no IP options, no VLAN, no SNAP
--    The frame should be copied to memory, with status indicating IP & UDP
--    checksums checked (bits [23:22] = 11) and no SNAP (bit 24 low).
-- Test 2.5
--    Broadcast frame, UDP null checksum, VLAN, SNAP (checksum is last data)
--    The frame should be copied to memory, with status indicating IP & UDP
--    checksums checked (bits [23:22] = 11) and SNAP (bit 24 high).
-- Test 2.6
--    Broadcast frame, Valid IP + TCP (no VLAN, no SNAP), Max length (1518
--    octets including CRC)
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and no SNAP (bit 24 low).
-- Test 2.7
--    Broadcast frame, Valid IP + TCP (no VLAN, with SNAP, type/length = 0x5DC)
--    Long packet, consistent with type/length = 0x5DC.
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and SNAP (bit 24 high).
-- Test 2.8
--    Broadcast frame, UDP null checksum, VLAN, SNAP (checksum is not last data)
--    The frame should be copied to memory, with status indicating IP & UDP
--    checksums checked (bits [23:22] = 11) and SNAP (bit 24 high).
-- Test 2.9
--    Broadcast frame, UDP null checksum, VLAN, SNAP, zero UDP length.
--    The frame should be copied to memory, with status indicating IP & UDP
--    checksums checked (bits [23:22] = 11) and SNAP (bit 24 high).
-- Test 2.10
--    Broadcast frame, Valid TCP, even length, no IP options, no VLAN, no SNAP.
--    TCP sequence number field is 32'h00000000, which corresponds to NULL
--    UDP checksum value. Test ensures NULL UDP is ignored.
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and no SNAP (bit 24 low).
--
--  4. Check statistics for correct values from above tests.
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 3
bus_grant_delay 3


--******************************************************************************
--  2. Check reset values of registers and setup interrupts
--     and then enable receive in 100M mode into a 32-bit DMA data bus.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 01080001  -- enable RX TCP offload engine.
apbrd      04 01080001  -- verify write to network config register.
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      00 00000004  -- enable receive



--******************************************************************************
--  3. Send several IP frames with either SNAP or ethernet encapsulation, which
--     have good IP checksum and are valid TCP or UDP with good checksums.
--******************************************************************************


--******************************************************************************
-- Test 2.1
--    Broadcast frame, Valid TCP, even length, no IP options, no VLAN, no SNAP
--    The frame should be copied to memory, with status indicating IP & TCP
--    checksums checked (bits [23:22] = 10) and no SNAP (bit 24 low).
--******************************************************************************

apbrdf     20 00000000  "Test 2.1 : Valid TCP, even, no VLAN, SNAP, options"
                        -- trigger reception of frame


rxd(apb)   55d5         -- preamble & SDF
rxd        FFFFFFFFFFFF -- MAC DA
rxd        080039123456 -- MAC SA
rxd        0800         -- Length/typeID
rxd        4500         -- Version, IHL, type of service
rxd        0028         -- total length
rxd        DFFA         -- ID
rxd        4000         -- flags & fragmentation
rxd        8006         -- time to live and protocol
rxd        98F3         -- IP Header checksum
rxd        C0A80001     -- IP SA
rxd        C0A80091     -- IP DA
rxd        0015         -- TCP source port
rxd        048A         -- TCP destination port
rxd        3DBB5C60     -- Sequence number
rxd        EA224D76     -- Acknowledgement Number
rxd        50104428     -- Flags and window
rxd        1376         -- TCP checksum
rxd        0000         -- TCP urgent pointer
rxd        ACACDBDBB0B0 -- options or padding
rxd        gggggggg     -- FCS


-- check the correct DA, SA, type, VID, IP SA and IP DA are
-- present on the filter interface
filterc da FFFFFFFFFFFF sa 563412390008 type 0800 ipsa 0100A8C0 ipda 9100A8C0

hready_stop 0 250 

-- supply the receive buffer location
dma_rd rx_descr fffff000 22222100 -- dma reads pointer of 22222100

---- check the receive data as it is written out on the AHB interface
--dma_wr 22222100 FFFFFFFF -- store frame to memory
--dma_wr 22222104 0008FFFF
--dma_wr 22222108 56341239
--dma_wr 2222210c 00450008
--dma_wr 22222110 FADF2800
--dma_wr 22222114 06800040
--dma_wr 22222118 A8C0F298
--dma_wr 2222211c A8C00100
--dma_wr 22222120 15009100
--dma_wr 22222124 BB3D8A04
--dma_wr 22222128 22EA605C
--dma_wr 2222212c 1050764D
--dma_wr 22222130 76132844
--dma_wr 22222134 ACAC0000
--dma_wr 22222138 B0B0DBDB
--dma_wr 2222213c 2F119E58
--
--dma_wr rx_descr fffff004 8080c040 -- dma writes rx status,
--                         -- start & end of frame
--                         -- broadcast match
--                         -- IP & TCP checksums OK
--                         -- no SNAP detected
--                         -- no VLAN tag detected
--                         -- 64 bytes received
--dma_wr rx_descr fffff000 22222101 -- dma writes ownership bit
--
--dma_rd rx_descr fffff008 22222100 -- dma reads pointer of 22222100
--
-- check status on reception of receive complete interrupt
apbrd(5000) 24 00000000  "Test 2.1 complete"
                        -- check interrupt status - receive complete
apbwr      24 00000000  -- Clear it
apbrd      20 00000000  -- check RX status register - receive complete
apbwr      20 00000000  -- clear RX status register




--******************************************************************************
--  4. Check statistics for correct values from above tests.
--******************************************************************************

-- check transmit statistics
apbrd     1A8 00000001  -- check receive IP checksum errors
apbrd     1AC 00000000  -- check receive TCP checksum errors
apbrd     1B0 00000000  -- check receive UDP checksum errors

dma_rd rx_descr fffff008 12345678 -- Supply final descriptor - this is not used for any data buffers, but the EDMA tries to keep its buffer full so it reads it
end(6000)


