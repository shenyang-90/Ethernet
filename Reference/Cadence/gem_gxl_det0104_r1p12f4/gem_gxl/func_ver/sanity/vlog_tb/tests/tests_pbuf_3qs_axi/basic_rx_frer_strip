--
--   Description
----------------
--
-- This checks reception of duplicate frames for 802.1CB operation using 
-- redundancy tag field.
-- Same as basic_rx_frer test but redundancy tags are stripped out.
--
-- Functional Coverage
----------------------
-- · 
-- 
-- 
--
-- Detailed Test Description
----------------------------
--
-- Use perl functions to auto generate frames including RX, DMA and APB activity.
--
-- 
--------------------------------------------------------------------------------

wait_states 0

-- Set AHB clock freq to 250MHz
-- At 32bit, this means we have maximum bandwidth of 8Gbit/s shared between
-- TX and RX. Randomize hready, keeping the maximum to 5 (averages around 2.5)
-- to ensure no RX overflows occur, and max line rate is acheivable on TX
sel_ahb_freq 3 

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 01a00710  -- DMA config
apbrd      18 00000000  -- check reset value of receive queue pointer
apbwr      18 10000000  -- write receive queue pointer
apbrd      18 10000000  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      04 0028040a  -- 64bit enable, gigabit mode, full duplex

-- Enable stacked vlan support as we may randomise the number and position of the
-- vlan tags...
apbwr     0c0 800088a8  -- Stacked VLAN support. Should match both this and 8100.

-- Set up the screener registers
-- Match against Source MAC address: 11:11:22:22:22:22 and VLAN ID 0x210
-- First compare register set to compare 0x22221111 with no masking. Offset 6.
-- Second compare register set to compare 0x2222 with mask of 0xffff. Offset 10.
-- Third compare register set to compare 0x1002 with mask of 0xff0f. Offset 18.

-- Note that since the R-TAG is stripped out, when the data reaches the screener compare, 
-- the first VLAN will always be in a known position so it can be compared directly like 
-- normal data.
apbwr     700 22221111  -- Compare registers
apbwr     704 00000206
apbwr     708 2222ffff
apbwr     70c 0000000a
apbwr     710 1002ff0f
apbwr     714 00000012

-- Screener Type2 register 0.
-- Enable Compare A=0, B=1, C=2,
-- 0 1 00010 1 00001 1 00000 0000 00000 0000
apbwr     540 050c0000  -- Screener type 2 setup

-- Program the FRER registers
apbwr     8a0 00000002  -- FRER Timeout value. This is 2x8192x8ns.
apbrd     8a0 00000002
apbwr     8a4 c000fafa  -- Strip redundancy tag and type set to 0xfafa
apbrd     8a4 c000fafa
apbwr     8c0 f0000000  -- Stream 0 setup A. Enable, Vec, Timeout, RTag.
apbrd     8c0 f0000000
apbwr     8c4 00001000  -- Stream 0 setup B. Default set to 16-bit sequence number.
apbrd     8c4 00001000

apbrdf     20 00000000  -- check contents of the receive status register and trigger reception of frame

-- Note 
-- First frame to stream 0 with sequence number 0x0, this is not duplicated.
rx_frame (apb)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      vlan2_en          random      -- Randomly stack VLANs
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_rtag_seqnum  0000
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good


-- Follow by incrementing sequence of 10 frames these are duplicated and should be automatically discarded.
rx_frame (gap)  10
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      frer_loc          random
      frer_rtag_en      1
      frer_auto_dup     1
      frer_rtag_seqnum  inc     -- Increment sequence number of each frame from previous
      type_len_field    random
      data_size         42
      data              random
      fcs               good

-- Duplicate of the last sequence number, this should be discarded as well.
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      0       -- No interrupt expected
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      frer_loc          random
      frer_rtag_en      1
      frer_rtag_seqnum  dup     -- Duplicate last sequence number
      frer_discard      true    -- Expect to be discarded.
      includerxdma      0       -- No DMA activity expected
      type_len_field    random
      data_size         42
      data              random
      fcs               good

-- Follow by incrementing sequence of 5 frames these are not duplicated.
rx_frame (gap)  5
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      frer_loc          random
      frer_rtag_en      1
      frer_rtag_seqnum  inc
      includerxdma      1       -- Reset flag to expect DMA activity
      type_len_field    random
      data_size         42
      data              random
      fcs               good

-- Now receive sequence of 64 incrementing frames without duplicates. This has effect of flushing out the 
-- history vectors so we can check statistics based on above test sequence.
rx_frame (gap)  64
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      frer_loc          random
      frer_rtag_en      1
      frer_rtag_seqnum  inc
      type_len_field    random
      data_size         42
      data              random
      fcs               good

-- A further 64 frames with no redundancy tags. These should still be passed up the stack and not result
-- in any changes to the CB statistics.
rx_frame (gap)  64
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      type_len_field    random
      data_size         42
      data              random
      fcs               good


-- check receive statistics
apbrd     158 00000090  -- check frames received ok

-- Check CB statistics
apbrd     8c8 00000006  -- Stats A for CB function 0. 0 Rogue, 6 latent errors.
apbrd     8cc 00000000  -- Stats B for CB function 0. 0 timeouts, 0 out of order frames.
apbrd     8d8 00000000  -- Stats A for CB function 1. Not used in this test.
apbrd     8dc 00000000  -- Stats B for CB function 1. Not used in this test.
apbrd     8e8 00000000  -- Stats A for CB function 2. Not used in this test.
apbrd     8ec 00000000  -- Stats B for CB function 2. Not used in this test.

-- Stats should be cleared on read...
apbrd     8c8 00000000  -- Stats A for CB function 0. 
apbrd     8cc 00000000  -- Stats B for CB function 0. 
apbrd     8d8 00000000  -- Stats A for CB function 1. 
apbrd     8dc 00000000  -- Stats B for CB function 1. 
apbrd     8e8 00000000  -- Stats A for CB function 2. 
apbrd     8ec 00000000  -- Stats B for CB function 2. 


-- Now additionally check to see if timeout mechanism works...
-- The above 64 FRER frames should still be in the history vector so usually if we 
-- receive any duplicates they should be discarded. Check this first.
apbrdf    8cc 00000000  -- Stats B for CB function 0. 0 timeouts, 0 out of order frames.

rx_frame (apb)  1
      preamble_size     1-14
      auto_gen_int      0       -- No interrupt expected
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      frer_loc          random
      frer_rtag_en      1
      frer_rtag_seqnum  dup     -- Duplicate last sequence number
      frer_discard      true    -- Expect to be discarded.
      includerxdma      0       -- No DMA activity expected
      type_len_field    random
      data_size         42
      data              random
      fcs               good

-- Now do sufficient normal (non-FRER) frames to allow function to timeout...
rx_frame (gap)  256
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      includerxdma      1       -- Reset flag
      type_len_field    random
      data_size         42
      data              random
      fcs               good

apbrd     8cc 00010000  -- Stats B for CB function 0. 1 timeouts, 0 out of order frames.

-- The following frame although is a duplicate of above but because a timeout had occurred
-- the history has been cleared so this should be received.
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      frer_loc          random
      frer_rtag_en      1
      frer_rtag_seqnum  dup     -- Duplicate last sequence number
      type_len_field    random
      data_size         42
      data              random
      fcs               good

-- Now flush out with sequence of 64 incrementing frames without duplicates.
rx_frame (gap)  64
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1
      vlan1_field       2210
      vlan2_en          random
      frer_loc          random
      frer_rtag_en      1
      frer_rtag_seqnum  inc
      type_len_field    random
      data_size         42
      data              random
      fcs               good

-- Since the above duplicated sequence is no longer a duplicate, and we didn't send in a duplicate
-- for it, it will be considered as a latent error when it is flushed out...

-- check receive statistics
apbrd     158 00000141  -- check frames received ok

-- Add delay to allow time for latent error handshakes to registers
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok
apbrd     158 00000000  -- check frames received ok

-- Check CB statistics
apbrd     8c8 00000001  -- Stats A for CB function 0. 0 Rogue, 1 latent errors.
apbrd     8cc 00000000  -- Stats B for CB function 0. 0 timeouts, 0 out of order frames.
apbrd     8d8 00000000  -- Stats A for CB function 1. Not used in this test.
apbrd     8dc 00000000  -- Stats B for CB function 1. Not used in this test.
apbrd     8e8 00000000  -- Stats A for CB function 2. Not used in this test.
apbrd     8ec 00000000  -- Stats B for CB function 2. Not used in this test.

-- Stats should be cleared on read...
apbrd     8c8 00000000  -- Stats A for CB function 0. 
apbrd     8cc 00000000  -- Stats B for CB function 0. 
apbrd     8d8 00000000  -- Stats A for CB function 1. 
apbrd     8dc 00000000  -- Stats B for CB function 1. 
apbrd     8e8 00000000  -- Stats A for CB function 2. 
apbrd     8ec 00000000  -- Stats B for CB function 2. 

-- force end of test in case it doesn't stop of its own accord

end(50000)

