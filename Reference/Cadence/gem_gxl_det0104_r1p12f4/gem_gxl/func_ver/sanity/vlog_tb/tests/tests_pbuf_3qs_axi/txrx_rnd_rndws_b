-- 64 bit,
-- gigabit, 
-- 250Mhz AHB

sel_ahb_freq 3 

randomize_hready -read_max 4 -write_max 4
--check_txlinerate
bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 45;
tog_cnt_en 1


pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 01a00701
apbwr      28 00000007  -- enable all interrupts
apbwr      600 00000c06 -- enable q1 interrupts
apbwr      604 00000c06 -- enable q2 interrupts
apbwr      440 88000000 -- write transmit queue pointer 1
apbwr      444 99000000 -- write transmit queue pointer 2
apbwr      480 f0010000 -- write receive queue pointer 1
apbwr      484 f0020000 -- write receive queue pointer 2
apbwr      04 0028040a  -- 64bit enable, gigabit mode, full duplex
apbwr      04 0128040a  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 11111100  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 11111100  -- check transmit queue pointer
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top
apbwr      90 abababab  -- specific address register 2 bottom (multicast)
apbwr      94 0000abab  -- specific address register 2 top
apbwr      98 abcdef10  -- specific address register 3 bottom (unicast)
apbwr      9C 0000a5a5  -- specific address register 3 top
apbwr      a0 cccccccc  -- specific address register 3 bottom (unicast)
apbwr      a4 00005a5a  -- specific address register 3 top
apbwr      4a0 00000001 -- Buffer size Q1
apbwr      4a4 00000001 -- Buffer size Q1
apbwr      500 31234aa0 -- Screener 1
apbwr      504 32345bb1 -- Screener 2 
apbwr      508 33456cc1 -- Screener 3
apbwr      50c 35678dd1 -- Screener 4
apbwr      510 36789ee1 -- Screener 5
apbwr      514 3789aff1 -- Screener 6
apbwr      518 389ab112 -- Screener 7
apbwr      51c 39abc222 -- Screener 8
apbwr      520 3abcd332 -- Screener 9
apbwr      524 3bcde442 -- Screener 10
apbwr      528 3cdef552 -- Screener 11
apbwr      52c 3def0662 -- Screener 12
apbwr      530 3ef01772 -- Screener 13
apbwr      534 3f012880 -- Screener 14
apbwr      538 3f5f5991 -- Screener 15
apbwr      53c 33d3daf2 -- Screener 16
apbwr      18 ffff0000  -- write receive queue pointer
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx

-- delay for enable rx to propagate though design
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     20 00000000  
apbrd     284 6ef13fff  -- read design cfg reg to set axi test in trans.pl
apbrdf    20 00000000  -- check contents of the receive status register 
                       -- and trigger reception of frame

rx_frame (apb)  1
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      num_dma_queues      3
      type_len_field random
      data_size      16 
      data           random
      auto_gen_int   1
      resource_err   0
      fcs            good

rx_frame (gap)  300
      preamble_size  1-14
      dest_addr      broadcast
      src_addr       111122222222
      num_dma_queues      3
      type_len_field random
      data_size      64-2000 
      data           random
      auto_gen_int   1
      resource_err   0
      #------------------------------
      # Level 3 Stuff
      ipv4_en             1
        num_ipv4_options  random
        ipv4_tos          aa
        ipv4_tos          bb
        ipv4_tos          cc
        ipv4_tos          dd
        ipv4_tos          ee
        ipv4_tos          ff
        ipv4_tos          11
        ipv4_tos          22
        ipv4_tos          33
        ipv4_tos          44
        ipv4_tos          55
        ipv4_tos          66
        ipv4_tos          77
        ipv4_tos          88
        ipv4_tos          99
        ipv4_tos          af
      ipv6_en             1
 
      #------------------------------
      # Level 4 Stuff
      udp_en              1
        udp_sport         1234
        udp_dport         1234
        udp_dport         2345
        udp_dport         3456
        udp_dport         5678
        udp_dport         6789
        udp_dport         789a
        udp_dport         89ab
        udp_dport         9abc
        udp_dport         abcd
        udp_dport         bcde
        udp_dport         cdef
        udp_dport         def0
        udp_dport         ef01
        udp_dport         f012
        udp_dport         f5f5
        udp_dport         3d3d
      fcs            good

tx_frame  300
      number_of_bufs 1
      auto_gen_int   0
      num_dma_queues      3
      buffer_size    64-1900
      data           random
      fcs            YES

 
-- force end of test in case it doesn't stop of its own accord
end(400000)

