--   Test Description
--   
--   This test ensures that the GEM deals with collisions in 10 or 100 mode.
--   It randomly sets the number of collisions between 1 and 15 and the collisions
--   themselves happen at various times throughout the frame
-------------------------------------------------------------------------------

-- define config compatibility (names are the verilog defines in the defs file without the IP prefix)
requires ext_fifo_interface 0
requires rx_pkt_buffer 1
requires tx_pkt_buffer 1

sel_ahb_freq 4

-- need no wait states to ensure the set_used_after_every_buffer argument on the transactor works
-- this is because the DUT will optimize the number of descriptor fetches and if a used bit is read
-- before it has sent the other accesses t complete a descriptor fetch, it will cancel sending out new ones. 
-- the trans.pl assumes the cancelling will always happen
wait_states 0

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- ************************************************************************** --
--   1. Initialise the GEM for 100M mode operation.
-- ************************************************************************** --
apbrd(100) 00 00000000  -- check reset value of network control register

# initialize the DMA specific options for random data xfers
init_dma -ext_bd random -addr_bus random  -burst random -min_buf_size 16320


# Enable the interrupts
# This is per queue, 
# Valid args are ..
#    -num_queues <1-16|take_from_cfg>
#    -vector <the actual interrupt vector as per userguide>
enable_ints -num_queues take_from_cfg   -vector ffffffff  # enable all ints

# Initialize the network configuration register 
init_ncr -duplex half -speed 100m -jumbo random -databus take_from_cfg -copy_all 0

apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbwr      88 12345678  -- specific address register 1 bottom
apbwr      8C 00001111  -- specific address register 1 top


# Initialize the transmit and receive DMA queue pointers (random values but can add specifics if required)
# use arg -rx_ptr_q<Q> and tx_ptr_q<Q> to set specific ptr values rather than the default random
init_q_ptr  -num_tx_queues take_from_cfg   -num_rx_queues take_from_cfg

apbrd      14 00000000  -- read transmit status register
apbwr      00 00000008  -- Enable transmit

apbrd     144 00000000 num=20 -- allow the enable to propagate ...

# Initialize the screener type 1 registers (random values)
# Note this will automatically force the transactor later on to
# randomly create frames that match on these screeners, thus routing
# frames to receive queues ..
init_screener_type1 -num_type1_screeners take_from_cfg   -num_rx_queues take_from_cfg 

apbwr      00 00000208  -- write transmit start bit

#speed_scale will divide the number of frames depending on speed mode
# divide by 20 for 10M, 5 for 100M
tx_frame  40 speed_scale
      number_of_bufs 1
      auto_gen_int   0
      num_dma_queues take_from_cfg
      num_collisions 15
#      set_used_after_every_buffer 1     -- Note this only works when there are 0 wait states in the test ..
      too_many_col   0
      buffer_size    64-250
      data           random
      fcs            YES


