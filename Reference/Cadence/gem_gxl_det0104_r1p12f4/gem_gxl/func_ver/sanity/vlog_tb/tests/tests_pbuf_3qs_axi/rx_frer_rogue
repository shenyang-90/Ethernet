      frer_auto_dup     1
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good

-- Additional non-FRER frame to give time for above duplicate to complete to sequence APB...
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good

-- check receive statistics
apbrd     158 00000009  -- check frames received ok

-- Check CB statistics
apbrd     8c8 00060000  -- Stats A for CB function 0. 6 Rogue, 0 latent errors.
apbrd     8cc 00000003  -- Stats B for CB function 0. 0 timeouts, 3 out of order frames.
apbrd     8d8 00000000  -- Stats A for CB function 1. 
apbrd     8dc 00000000  -- Stats B for CB function 1. 
apbrd     8e8 00000000  -- Stats A for CB function 2. 
apbrd     8ec 00000000  -- Stats B for CB function 2. 

-- Disable the FRER function and change settings
apbwr     8c0 50000000  -- Stream 0 setup A. Disable, Vect, No Timeout, RTag.
apbwr     8c4 00000020  -- Stream 0 setup B. Set to 16-bit sequence number. Window size 32.

-- Re-enable
apbwr     8c0 d0000000  -- Stream 0 setup A. Enable, Vect, No Timeout, RTag.
apbrdf    8c0 d0000000  -- Stream 0 setup A. Enable, Vect, No Timeout, RTag.

-- First frame to stream 0 to set first sequence number to 1.
rx_frame (apb)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_rtag_seqnum  0001        -- Set an initial value
      frer_auto_dup     1
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good

-- 600 (+duplicate) frames which will be rogue and discarded.
rx_frame (gap)  600
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_inc_val      33          -- Increment value of 33, all will be rogue.
      frer_rtag_seqnum  inc
      frer_auto_dup     1
      frer_discard      true        -- frame should be discarded
      includerxdma      0           -- do not add DMA activity since will be dropped
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good

-- Good receive frame with duplicate
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_rtag_seqnum  0002
      frer_auto_dup     1
      includerxdma      1           -- Reset field
      type_len_field    random
