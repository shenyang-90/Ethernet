      fcs               good

-- Followed by 2
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_rtag_seqnum  0002
      frer_auto_dup     1
      type_len_field    random
