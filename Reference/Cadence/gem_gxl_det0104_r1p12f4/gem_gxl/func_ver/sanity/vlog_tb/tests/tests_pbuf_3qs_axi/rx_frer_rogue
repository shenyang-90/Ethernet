      fcs               good

-- Followed by 3
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
