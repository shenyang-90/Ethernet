      frer_discard      true        -- frame should be discarded
      includerxdma      0           -- do not add DMA activity since will be dropped
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good

-- Followed by 0 - 3 = 0xfffd
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_rtag_seqnum  fffd
      frer_auto_dup     1
      includerxdma      1           -- Reset flag as this is not rogue.
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good

-- Followed by 0 - 2 = 0xfffe
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_rtag_seqnum  fffe
      frer_auto_dup     1
      type_len_field    random
      data_size         42
      data              random
      num_dma_queues    3
      fcs               good

-- Followed by 0 - 1 = 0xffff
rx_frame (gap)  1
      preamble_size     1-14
      auto_gen_int      1
      dest_addr         broadcast
      src_addr          111122222222
      vlan1_en          1           -- At least 1 VLAN
      vlan1_field       2210
      frer_loc          random      -- Randomly select location of redundancy tag wrt VLAN
      frer_rtag_en      1
      frer_rtag_seqnum  ffff
      frer_auto_dup     1
