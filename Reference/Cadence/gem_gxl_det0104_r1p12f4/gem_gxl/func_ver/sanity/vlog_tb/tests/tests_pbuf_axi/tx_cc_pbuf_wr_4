--
-- Test Description
-- The purpose of this test is to reach a few state transitions that are
-- missing on other tests and collect a 100% block coverage figure
-- 

wait_states 0
bus_grant_delay 0
sel_ahb_freq 3

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080400  --
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555510  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555510  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx




-- ********************************************************************
-- Test 1
-- Get the MAC side of PBUF to set pkt_has_been_read while we are in the 
-- READ_LSTATUS_WORD0 state
-- ********************************************************************
apbwr       00 00000208  -- write tx_go and enable tx
dma_rd tx_descr 55555514 40008005 -- start of frame
dma_rd tx_descr 55555510 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
dma_rd 98765000 04030201
dma_rd 98765004 00000005

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d50102030405000000000000
txd		       00000000000000000000000000000000
txd		       00000000000000000000000000000000
txd		       0000000000000000000000000000000000
txd          zzzzzzzz


-- write transmit complete status
dma_wr 55555514 c0008005 -- write used bit

apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr       24 00000080  -- write to clear



--------------------------------------------------

dma_rd tx_descr 55555514 00008005 -- start of frame
dma_rd tx_descr 55555510 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
dma_rd 98765000 04030201
dma_rd 98765004 00000005

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d50102030405000000000000
txd		       00000000000000000000000000000000
txd		       00000000000000000000000000000000
txd		       0000000000000000000000000000000000
txd          zzzzzzzz

-- write transmit complete status
dma_wr 55555514 80008005 -- write used bit

apbrd(int)  24 00000080  -- check interrupt status - transmit complete
apbwr       24 00000080  -- write to clear




--------------------------------------------------

dma_rd tx_descr 5555551c 80008000
dma_rd tx_descr 55555518 98765000 -- used

apbrd(int)  24 00000008  -- check interrupt status - transmit complete
apbwr       24 00000008  -- write to clear


-- force end of test in case it doesn't stop of its own accord
end(15000)

