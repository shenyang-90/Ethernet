--
-- This tests basic transmit functionality using random length buffers
-- at random locations
--
-- Enable transmit and interrupts, write transmit address and
-- control registers.
--
-- Check stats after time out
--
--
-- ************************************************************************** --

-- setup for a very high latency
fixed_latency_mode
set_rvalid_resp_latency -min 500 -max 500 
set_bvalid_resp_latency -min 500 -max 500 

--set_arready_delay -min 0 -max 2             -- max is only relevant when pipeline is not full

--set_awready_delay -min 0 -max 5             -- max is only relevant when pipeline is not full
--set_wready_delay -min 0 -max 2              -- max is only relevant when pipeline is not full



wait_states 0
bus_grant_delay 0
set_random_seed 1;

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 0000ffff  -- enable all interrupts
apbwr      04 0048040a  
apbrd      08 00000006  -- check reset value of network status register
apbwr      10 000207c0  -- Use unlimited size bursts !
apbwr      54 ffffffff  -- allow max length AXI pipelines
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx and rx



-- test 25 frames of random number of buffers with random data at random buffer locations
tx_frame  32
      number_of_bufs 1
      buffer_size    1518
      data           random
      fix_wrap       0
      fcs            YES


-- force end of test in case it doesn't stop of its own accord
end(150000)

