--
--   Description
----------------
--   This test ensures that the receive synchonization functionality in the PCS portion
--   of the GEM design works properly.
-- 
-- Functional Coverage
----------------------
--  * Tests different combinations of code groups(valid and invalid) to 
--    ensure the GEM will stay synchronized when prudent.
--
-- Detailed Test Description
----------------------------
-- 1. Initialise the GEM for Gigabit Operation with PCS enabled. Furthermore, Auto-Negotiation is 
--    disabled.
-- 2. Transmit a continuous stream of invalid code-groups. (Ensure the GEM is not synchronized
-- 3. Transmit a long stream of /I/ ordered_sets.  This should cause the GEM to 
--    become synchronized.
-- 4. Transmit 200 consecutive /INVALID/ code-groups followed by 100 transmissions of
--     /K28.5/D2.2/D0.0/D0.0/K28.5/D21.5/D0.0/D0.0/K28.5/invalid/. Then, transmit one /I/ ordered_set and receive a valid frame.  Follow the valid frame
--     with 100 /I/ ordered_sets and then receive another valid frame.
--     (GEM should ignore the first frame)
-- 5. Transmit 200 consecutive /INVALID/ code-groups followed by 100 transmissions of
--     /K28.5/D0.0/D0.0/D0.0/D0.0/D0.0/D0.0/invalid/. Then, transmit one /I/ ordered_set and receive a valid frame.  Follow the valid frame
--     with 100 /I/ ordered_sets and then receive another valid frame.
--     (GEM should ignore the first frame)
-- 6. Transmit 200 consecutive /INVALID/ code-groups followed by 100 transmissions of
--     /K28.5/D0.0/D0.0/D0.0/D0.0/D0.0/K28.5/D0.0/D0.0/D0.0/D0.0/D0.0/K28.5/invalid/. Then, transmit one /I/ ordered_set and receive a valid frame.  Follow the valid frame
--     with 100 /I/ ordered_sets and then receive another valid frame.
--     (GEM should ignore the first frame)
-- 7. Check statistic registers.
-- 8. Set the signal_detect pin low.  Then, receive an number of idle code groups.  The GEM
--    should lose synchronization.
-- 9. Set the signal_detect pin high. Then, receive an number of idle code groups.  The GEM
--    should regain synchronization.
--
--
-- Special Notes about pcs_synch_rx command:
--  1. To create invalid code groups, the k_encoder function (the function in
--     pcs.pm script which creates the special 10-bit code with proper disparity)
--     has invalid special code groups added to it:
--       Specifically, 0x1f, 0x0a, and 0xff.  All three of these invalid codes
--       positive and negative disparity values are compeltely incorrect. Thereby,
--       creating an invalid code group.
--  2. To create the /D0.0/D0.0/ code group, 0x00 was also added to the k_encoder function.
--     However, in this case the disparity values are correct.  This allows us to insert this code
--     group when necessary. 
--     
--     ie to create /K28.5/D0.0/D0.0/D0.0 you would use the following commands:
--                             pcs_synch_rx sbc o00
--                             pcs_synch_rx s00 o00           
--  3. To create invalid code groups in the data field of the pcs_synch_rx command use the 
--     following command:
--                             pcs_synch_rx s<dd> i<dd>
--
--                             where  sdd - special code group
--                             and idd - invalid data group  
--                             Use either 0x1f, 0x0a, and 0xff to create invalid
--                             codes in the data field.             
--
--  4. To create /K28.5/ code group in the data field of the pcs_synch_rx command use the 
--     following command:
--                             pcs_synch_rx s<dd> ibc
--
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- ********************************************************************************************* --
-- 1. Initialise the GEM for Gigabit Operation with PCS enabled. Furthermore, Auto-Negotiation is 
--    disabled.
-- ********************************************************************************************* --

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd     200 00009040  -- check value of pcs control register
apbwr     200 00000040  -- disable autonegotioation
apbrd     200 00008040  -- check autoneg disabled
apbwr      04 00080c00  -- Put MAC into gigabit mode with TBI
apbrd      04 00080c00  -- Check value of network config register
apbwr      00 00000004  -- enable receive
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      88 03020100  -- specific address register 1 bottom
apbwr      8C 00000504  -- specific address register 1 top
apbrd     200 00000040  -- check autoneg disabled and reset clear
apbrd     200 00000040  -- check autoneg disabled and reset clear
apbrd     200 00000040  -- check autoneg disabled and reset clear
apbrd     200 00000040  -- check autoneg disabled and reset clear
apbrd     200 00000040  -- check autoneg disabled and reset clear
apbrdf     20 00000000  -- check receive status register and trigger reception

apbrd(int)  24 00000200  -- check interrupt status - link change
apbrd    204   00000105  -- check value of pcs status register (link status should be high)

-- ********************************************************************************************* --
-- 2. Transmit a continuous stream of invalid code-groups. (Ensure the GEM is not synchronized)
-- ********************************************************************************************* --

pcs_synch_rx(apb)  s1f o1f
pcs_synch_rx      s1f o1f
pcs_synch_rx      s1f o1f
pcs_synch_rx      s1f o1f
pcs_synch_rx      s1f o1f
pcs_synch_rx      s1f o1f
pcs_synch_rx      s1f o1f
pcs_synch_rx      s1f o1f

apbrd(int)  24 00000200  -- check interrupt status - link change
apbrd    204   00000101  -- check value of pcs status register (link status should be low)

-- ********************************************************************************************* --
-- 3. Transmit a long stream of /I/ ordered_sets.  This should cause the GEM to 
--    become synchronized. 
--    /I2/ = /K28.5/D5.6/
-- ********************************************************************************************* --

pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50
pcs_synch_rx      sbc o50

apbrd(int)  24 00000200  -- check interrupt status - link change
apbrd    204   00000105  -- check value of pcs status register (link status should be high)

-- ********************************************************************************************* --
-- 4. Transmit 200 consecutive /INVALID/ code-groups followed by 100 transmissions of
--     /K28.5/D2.2/D0.0/D0.0/K28.5/D21.5/D0.0/D0.0/K28.5/invalid/. Then, transmit one /I/ ordered_set and receive a valid frame.  Follow the valid frame
--     with 100 /I/ ordered_sets and then receive another valid frame.
--     (GEM should ignore the first frame)
-- ********************************************************************************************* --

apbrd(int)  24 00000200  -- check interrupt status - link change
apbrd    204   00000101  -- check value of pcs status register (link status should be low)

