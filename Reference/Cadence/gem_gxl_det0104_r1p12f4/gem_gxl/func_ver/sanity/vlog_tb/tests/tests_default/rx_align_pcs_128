--
--   Description
----------------------
-- Test the realignment buffer of the GEM_RX block.
-- Try lots of RX with different lengths and preamble that check combinations
-- of the realignment buffer.
-- Test is run 3 times, once through each interface (MII, GMII and TBI)
-- 
-- Functional Coverage
----------------------
-- Test the realignment buffer of the GEM_RX block in 128 bit mode.
--
--  
-- Detailed Test Description
----------------------------
--
-- Each test is broken down into combinations of the following conditions
-- at the point the end_of_data signal in gem_rx is active. Not all combinations
-- are possible (e.g. can't get next residue if we don't already have residue).
--
--   aligned at 16 bits - whether the curr_rx_dv signal in gem_rx finishes
--                        the frame on a 16 bit boundary.
--                          FALSE : the value of curr_rx_dv @ end_of data is
--                                  either 01 or 10
--                          TRUE  : the value of curr_rx_dv @ end_of data is
--                                  either 11 and then 00 on next clock
--
--   current residue    - whether the value of prev_align_overflowd is high
--                        at end_of_data
--                          FALSE : the value of prev_align_overflowd @ 
--                                  end_of data is 1'b0
--                          TRUE  : the value of prev_align_overflowd @ 
--                                  end_of data is 1'b1
--                          
--   next residue       - whether the value of next_align_overflow is high
--                        at end_of_data
--                          FALSE : the value of next_align_overflowd @ 
--                                  end_of data is 1'b0
--                          TRUE  : the value of next_align_overflowd @ 
--                                  end_of data is 1'b1
--                        Note that if true this condition will activate
--                        the force_over_align mechanism.
--
-- 
--------------------------------------------------------------------------------

-- Setup wait states & hgrant delay to cope with gigabit 
-- operation into 128 bits.
wait_states 3
bus_grant_delay 3


pinsc(50) loopback 0 half_duplex 1  extint 0 speed 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbwr      98 12345678  -- specific address register 1 bottom
apbwr      9C 00001111  -- specific address register 1 top
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00680000  -- 128 bit AHB
apbrd      04 00680000  -- check new value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbrd      18 00000000  -- check reset value of receive queue pointer


--******************************************************************************
-- 10/100 MII mode
--******************************************************************************
apbwr      18 fffff000  -- write receive queue pointer
apbrd      18 fffff000  -- check receive queue pointer
apbwr      00 00000004  -- enable receive
apbrd      20 00000000  -- check contents of the receive status register


--******************************************************************************
-- PCS mode
--******************************************************************************

apbwr      00 00000000  -- disable receive
apbwr      18 fffff000  -- write receive queue pointer
apbrd      20 00000000  -- check contents of the receive status register and trigger reception of frame
apbrd     200 00009040  -- check value of pcs control register
apbwr     200 00000040  -- disable autonegotioation
apbrd     200 00008040  -- check autoneg disabled
apbwr      04 00680c00  -- Setup PCS mode and 128 bits
apbrd      04 00680c00  -- verify write
apbwr      00 00000004  -- enable receive again

-- check for link status change
apbrd(int) 24 00000200  -- check interrupt status - link status change


