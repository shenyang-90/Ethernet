-- Inputs a TCP frame which is split into 2 frames by the TCP secmentation offload
-- functionality
-- Acknowledgement number and window size fields are modified between the 2 reads of
-- the header buffer
--
-- ************************************************************************** --

wait_states 2
bus_grant_delay 1

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 10000000  -- write address of transmit buffer descriptor in memory
apbrd      1c 10000000  -- check transmit queue pointer
apbwr      10 00020c04  -- little endian, tx checksums enabled
apbwr      00 00000208  -- write tx_go and enable tx

-- FRAME 1
-- Header and payload in separate buffers with separate descriptors

-- Header Descriptor
dma_rd tx_descr 10000004 00040036 -- hardware CRC, TSO enable, seq num from header, stream 0, 54 bytes
dma_rd tx_descr 10000000 20000000 -- header buffer base address
-- Payload Descriptor
dma_rd tx_descr 1000000C 0032805a -- MSS of 50 bytes, last bit set, length 90 bytes
dma_rd tx_descr 10000008 30000000 -- payload buffer base address
-- Used Descriptor
dma_rd tx_descr 10000014 80000000 -- Used Bit
dma_rd tx_descr 10000010 00000000


-- Header buffer read
dma_rd 20000000 11111111    --  DA3      / DA2     / DA1   / DA0
dma_rd 20000004 22221111    --  SA1      / SA0     / DA5   / DA4
dma_rd 20000008 22222222    --  SA5      / SA4     / SA3   / SA2
dma_rd 2000000c 00450008    --  DSCP ECN / VER IHL / ET0   / ET1     --  ET = IPV4 = 0800
dma_rd 20000010 00000000    --  ID 0     / ID1     / TL0   / TL1
dma_rd 20000014 06000000    --  PROT     / TTL     / FO0   / FLG FO1 --  PROT = TCP = 06
dma_rd 20000018 66660000    --  SA1      / SA0     / CS0   / CS1
dma_rd 2000001c 55556666    --  DA1      / DA0     / SA3   / SA2
dma_rd 20000020 33335555    --  SP0      / SP1     / DA3   / DA2
dma_rd 20000024 34124444    --  SN2      / SN3     / DP0   / DP1
dma_rd 20000028 88887856    --  AN2      / AN3     / SN0   / SN1 
dma_rd 2000002c FF018888    --  FLG0     / DO FLG1 / AN0   / AN1 
dma_rd 20000030 00000000    --  CS0      / CS1     / WS0   / WS1 
dma_rd 20000034 00000000    --           /         / UP0   / UP1 

-- Data buffer read - 50 bytes
dma_rd 30000000 11111111
dma_rd 30000004 11111111
dma_rd 30000008 11111111
dma_rd 3000000c 11111111
dma_rd 30000010 11111111 
dma_rd 30000014 11111111 
dma_rd 30000018 11111111 
dma_rd 3000001c 11111111 
dma_rd 30000020 11111111 
dma_rd 30000024 11111111
dma_rd 30000028 11111111 
dma_rd 3000002c 11111111 
dma_rd 30000030 22221111 

-- Header buffer read
dma_rd 20000000 11111111    --  DA3      / DA2     / DA1   / DA0
dma_rd 20000004 22221111    --  SA1      / SA0     / DA5   / DA4
dma_rd 20000008 22222222    --  SA5      / SA4     / SA3   / SA2
dma_rd 2000000c 00450008    --  DSCP ECN / VER IHL / ET0   / ET1     --  ET = IPV4 = 0800
dma_rd 20000010 00000000    --  ID 0     / ID1     / TL0   / TL1
dma_rd 20000014 06000000    --  PROT     / TTL     / FO0   / FLG FO1 --  PROT = TCP = 06
dma_rd 20000018 66660000    --  SA1      / SA0     / CS0   / CS1
dma_rd 2000001c 55556666    --  DA1      / DA0     / SA3   / SA2
dma_rd 20000020 33335555    --  SP0      / SP1     / DA3   / DA2
dma_rd 20000024 34124444    --  SN2      / SN3     / DP0   / DP1
dma_rd 20000028 99997856    --  AN2      / AN3     / SN0   / SN1 
dma_rd 2000002c FF019999    --  FLG0     / DO FLG1 / AN0   / AN1 
dma_rd 20000030 00001111    --  CS0      / CS1     / WS0   / WS1 
dma_rd 20000034 00000000    --           /         / UP0   / UP1 

-- Data buffer read - 40 bytes - starting from end of first small frame
dma_rd 30000030 22221111
dma_rd 30000034 22222222
dma_rd 30000038 22222222
dma_rd 3000003c 22222222
dma_rd 30000040 22222222 
dma_rd 30000044 22222222 
dma_rd 30000048 22222222 
dma_rd 3000004c 22222222 
dma_rd 30000050 22222222 
dma_rd 30000054 22222222
dma_rd 30000058 33332222 


-- Segmented frame 1

txd    55555555555555d5   -- preamble
txd    111111111111       -- ethernet header - destination address
txd    222222222222       -- ethernet header - source address
txd    0800               -- ethernet header - ethertype

txd    45                 -- IPv4 header - version, IHL 
txd    00                 -- IPv4 header - DSCP, ECN
txd    005a               -- IPv4 header - Total Length
txd    0000               -- IPv4 header - Identification
txd    0000               -- IPv4 header - Flags, Fragment Offset
txd    00                 -- IPv4 header - Time to live
txd    06                 -- IPv4 header - Protocol
txd    4328               -- IPv4 header - Header Checksum
txd    66666666           -- IPv4 header - Source Address
txd    55555555           -- IPv4 header - Destination Address

txd    3333               -- TCP header  - Source Port
txd    4444               -- TCP header  - Destination Port
txd    12345678           -- TCP header  - Sequence Number
txd    88888888           -- TCP header  - Acknowledgement Number
txd    01F6               -- TCP header  - Data Offset, Flags
txd    0000               -- TCP header  - Window Size
txd    ea66               -- TCP header  - Checksum
txd    0000               -- TCP header  - Urgent Pointer

txd    11111111111111111111
txd    11111111111111111111
txd    11111111111111111111
txd    11111111111111111111
txd    11111111111111111111
txd    487571c4



-- Segmented frame 2

txd    55555555555555d5   -- preamble
txd    111111111111       -- ethernet header - destination address
txd    222222222222       -- ethernet header - source address
txd    0800               -- ethernet header - ethertype

txd    45                 -- IPv4 header - version, IHL 
txd    00                 -- IPv4 header - DSCP, ECN
txd    0050               -- IPv4 header - Total Length
txd    0000               -- IPv4 header - Identification
txd    0000               -- IPv4 header - Flags, Fragment Offset
txd    00                 -- IPv4 header - Time to live
txd    06                 -- IPv4 header - Protocol
txd    4332               -- IPv4 header - Header Checksum
txd    66666666           -- IPv4 header - Source Address
txd    55555555           -- IPv4 header - Destination Address

txd    3333               -- TCP header  - Source Port
txd    4444               -- TCP header  - Destination Port
txd    123456aa           -- TCP header  - Sequence Number
txd    99999999           -- TCP header  - Acknowledgement Number
txd    01FF               -- TCP header  - Data Offset, Flags
txd    1111               -- TCP header  - Window Size
txd    b702               -- TCP header  - Checksum
txd    0000               -- TCP header  - Urgent Pointer

txd    22222222222222222222
txd    22222222222222222222
txd    22222222222222222222
txd    22222222222222222222
txd    6eb8f3b6

-- write transmit complete status for frame
dma_wr 10000004 80040036 -- write used bit

-- check frame completion interrupts

apbrd(int)  24 00000088  -- check interrupt status - transmit complete, stop bit
apbwr       24 00000088  -- clear interrupt status
apbrd	    14 00000021  -- tx status - frame transmitted, stop bit



-- force end of test in case it doesn't stop of its own accord
end(20000)

