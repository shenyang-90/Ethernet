--
--   Description
----------------
--
-- This tests basic transmit functionality sending DMA frames and ext FIFO
-- frames simultaneously.
--
-- The fifo frames are sent after DMA frames have started and should take 
-- priority over DMA frames.
--
--
-- Functional Coverage
----------------------
-- · Checks transmission with all combinations of data code group present
--   within the one frame using 100Mbits/s mode.
-- 
--
-- Detailed Test Description
----------------------------
--
-- Enable transmit and interrupts, write transmit address and
-- control registers.
--
-- Supply transmit data to the AHB interface and check the
-- transmitted data, pad and crc.
--
-- On reception of the transmit complete interrupt check the
-- interrupt and trasnmit status registers and the statistics
-- registers
--
-- This tests a frame supplied with known CRC:-
--
--
-- 
--------------------------------------------------------------------------------

pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      28 ffffffff  -- enable all interrupts
apbwr      440 88000000  -- write transmit queue pointer 1
apbwr      444 99000000  -- write transmit queue pointer 2
apbrd      04 00080000  -- check reset value of network config register
apbwr      04 00080002  -- set to full duplex mode
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- write tx_go and enable tx
#apbwr      00 00000408  -- write tx halt immediately keeping tx enabled
#                        -- this stops fetch of second frame


