apbwr      1c 55555500  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      18 ffff0000  -- write receive queue pointer
apbwr      00 0000020c  -- write tx_go and enable tx, enable rx

-- delay for enable rx to propagate though design
