--
-- Use 0 wait states to maximize AHB rate
-- Increase AHB frequency to maximize AHB rate
-- The above will cause the packet data to flood in quickly
-- Transmit rate should be slow such that the packet buffer empties slowly (100M should be fine)
-- Apply extremely high Idleslope to queue B
-- Queue some frames to QB
-- Use ENST to block QB and allow the ccredit to start increasing
-- Allow the credit to reach maximum and ensure it doesnt rollover
-- 
--------------------------------------------------------------------------------

bus_grant_delay 0 -- This sets hgrant to 1 always

set_random_seed 94;
wait_states 0
pinsc(50) loopback 0 half_duplex 1  extint 0 --  check reset state

-- check and initialise the relevant registers
apbrd(100) 00 00000000  -- check reset value of network control register
apbwr      10 09a00710
apbwr      28 00000008  -- enable TX used bit read interrupt
apbwr     440 88000000  -- write transmit queue pointer 1
apbwr     444 99000000  -- write transmit queue pointer 2
apbwr     480 f0010000  -- write receive queue pointer 1
apbwr     484 f0020000  -- write receive queue pointer 2
apbwr      04 00080001  -- 100M
apbrd      04 00080001  -- 100M
apbrd      08 00000006  -- check reset value of network status register
apbwr      1c 11111100  -- write address of transmit buffer q0 descriptor in memory
apbrd      1c 11111100  -- check transmit queue pointer
apbwr     4bc 00000003  -- Enable both CBS queues
apbwr     4c0 ffffffff  -- IdleSlope for Queue A
apbwr     4c4 ffffffff  -- IdleSlope for Queue B
apbrd     4bc 00000003  -- Enable both CBS queues
apbrd     4c0 ffffffff  -- IdleSlope for Queue A
apbrd     4c4 ffffffff  -- IdleSlope for Queue B

-- setup ENST to block Q1 from transmitting for a while
apbwr     1d0 00000000  -- TSU timer seconds
apbwr     1d4 00000000  -- TSU timer nanoseconds
apbrd     1d0 00000000  
apbrd     1d4 00000000  
apbwr     1dc 00000064  -- TSU timer increment

apbwr     804 00050000  -- Q1 Start time
apbwr     824 ffffffff  -- Q1 On time 
apbwr     844 00000000  -- Q1 Off time
apbwr     880 00000007  -- EnST Enable


apbwr      00 0000020c  -- write tx_go and enable tx, enable rx

-- Now send some frames into Q1
tx_frame  5
      number_of_bufs              1
      buffer_size                 1024
      data                        random
      auto_gen_int                0
      num_dma_queues              3
      fix_queue_num               1
      set_used_after_every_buffer LAST
      fcs                         YES


-- force end of test in case it doesn't stop of its own accord
end(100000)

