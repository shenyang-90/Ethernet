--
-- Test Description
-- This test checks the operation of an underflow on TX DMA.
-- 
-- Functional Coverage
-- * Checks the DMA FIFO generation of the tx_r_underflow signal.
-- * Checks the TX DMA handling of an underflow.
-- * Checks the staus reporting of a DMA underflow.
-- 
-- Detailed Test Description
--  1. Initialise suitable wait states for the test.
--  2. Check reset values of registers and setup interrupts and then enable 
--     transmit in gigabit half duplex mode from a 32-bit DMA data bus.
--
--  tx_r_underflow testing
--  ----------------------
--  3. Transmit a 64 byte frame. Because of the wait states an underflow will
--     happen.
--     Ensure that the TX MAC terminates ongoing transmission correctly,
--     and that an underflow interrupt and status is reported.
--
--  Status update underflow
--  ------------------------------------------
--  4. Switch to 128-bit DMA gigabit mode.
--  5. Transmit a 64 byte frame, then supply a one-byte frame with no 
--     CRC/padding specified. Because of the delay in status handshaking, the
--     second frame should complete before the handshaking has completed for 
--     the first frame.
--     Ensure that the TX MAC completes the first frame correctly and then
--     successfully transmits the second frame, but signals an underrun status
--     and interrupt for the second frame.
--
--  6. Check statistics for above operations.
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states     6
bus_grant_delay 6



--******************************************************************************
--  2. Check reset values of registers and setup interrupts and then enable 
--     transmit in gigabit half duplex mode from a 32-bit DMA data bus.
--******************************************************************************
apbrd(100) 00 00000000  -- check reset value of network control register
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbwr      04 00080400  -- enable gigabit mode into 32-bit bus
apbwr      1c 55555500  -- write address of transmit buffer descriptor in memory
apbrd      1c 55555500  -- check transmit queue pointer
apbwr      00 00000208  -- enable transmit & write tx_go
apbwr      00 00000408  -- halt after one frame
apbrd      14 00000008  -- check tx status, always tx_go when enabled



--******************************************************************************
--  3. Transmit a 64 byte frame. Because of the wait states an underflow will
--     happen.
--     Ensure that the TX MAC terminates ongoing transmission correctly,
--     and that an underflow interrupt and status is reported.
--******************************************************************************

apbrd      14 00000008  "Scenario 1: TX DMA underflow"

dma_rd 55555504 0000803c -- start of frame, length 60 bytes
dma_rd 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
dma_rd 98765000 005e0001
dma_rd 98765004 d0000200
dma_rd 98765008 04e7ecbc
dma_rd 9876500c c0450008
dma_rd 98765010 00003000
dma_rd 98765014 11020000
dma_rd 98765018 8c9e7258
dma_rd 9876501c 00e0fce0
dma_rd 98765020 c1070200
dma_rd 98765024 1c00c107
dma_rd 98765028 0000e9b6
dma_rd 9876502c 640a0308
--dma_rd 98765030 69630002 -- stops here due to underflow
--dma_rd 98765034 006f6373
--dma_rd 98765038 8c9e0000

-- check for correct preamble, SFD, data, pad and crc
txd    55555555555555d501005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce0
txd                    00000000 -- 32-bit jam

-- write transmit complete status for the oldest frame 1
dma_wr 55555504 9000803c -- write used bit & underflow


-- check status on reception of transmit underrun interrupt
apbrd(int) 24 00000010  "Scenario 1: Complete"
                        -- check interrupt status - transmit underflow
apbrd      14 00000040  -- tx status - transmit underflow & halted
apbwr      14 00000040  -- clear it



--******************************************************************************
--  4. Switch to 128-bit DMA gigabit mode.
--******************************************************************************
apbwr      04 00680400  -- enable gigabit mode into 128-bit bus
apbwr      00 00000208  -- enable transmit & write tx_go
apbrd      14 00000000  -- check tx status, wait for tx_go when enabled
apbrd      14 00000008  -- check tx status, now tx_go
apbrd      14 00000008  -- check tx status, now tx_go


--******************************************************************************
-- Status update underflow
--  5. Transmit a 64 byte frame, then supply a one-byte frame with no 
--     CRC/padding specified. Because of the delay in status handshaking, the
--     second frame should complete before the handshaking has completed for 
--     the first frame.
--     Ensure that the TX MAC completes the first frame correctly and then
--     successfully transmits the second frame, but signals an underrun status
--     and interrupt for the second frame.
--******************************************************************************

apbrd      14 00000008  "Scenario 2: Status update underflow"

dma_rd 55555504 0000803c -- start of frame, length 60 bytes
dma_rd 55555500 98765000 -- dma reads pointer of 98765000

-- supply the transmit data to the AHB interface
dma_rd 98765000 005e0001
dma_rd 98765004 d0000200
dma_rd 98765008 04e7ecbc
dma_rd 9876500c c0450008
dma_rd 98765010 00003000
dma_rd 98765014 11020000
dma_rd 98765018 8c9e7258
dma_rd 9876501c 00e0fce0
dma_rd 98765020 c1070200
dma_rd 98765024 1c00c107
dma_rd 98765028 0000e9b6
dma_rd 9876502c 640a0308
dma_rd 98765030 69630002
dma_rd 98765034 006f6373
dma_rd 98765038 8c9e0000
dma_rd 9876503c 00000000 -- extra bits for 128-bit mode

-- check for correct txd
txd    55555555555555d501005e00000200d0bcece704080045c0
txd		       003000000000021158729e8ce0fce000
txd		       000207c107c1001cb6e9000008030a64
txd		       0200636973636f0000009e8c582eda99

-- write transmit complete status for the oldest frame 1
dma_wr 55555504 8000803c -- write used bit


-- check status on reception of transmit underrun interrupt
apbrd(int) 24 00000080  "Scenario 2: Received first frame"
                        -- check interrupt status - transmit complete
apbrd      14 00000028  -- tx status - transmit complete & tx_go
apbwr      14 00000028  -- clear it



-- descriptor reads for second frame
dma_rd 5555550c 0001800c -- start of frame, length 12 bytes, no CRC
dma_rd 55555508 98765000 -- dma reads pointer of 98765000

-- supply the transmit data for second frame
dma_rd 98765000 44332211
dma_rd 98765004 88776655
dma_rd 98765008 ccbbaa99
dma_rd 9876500c 00000000 -- extra bits for 128-bit mode

-- check for correct txd
txd    55555555555555d5112233445566778899aabbcc

-- write transmit complete status for frame 2
dma_wr 5555550c 9001800c -- write used bit & underflow


-- supply used bit to end test
dma_rd 55555514 80018001 -- used
dma_rd 55555510 98765000


-- check status on reception of transmit underrun interrupt
apbrd(int) 24 00000018  "Scenario 2: Complete"
                        -- check interrupt status - transmit underflow & exhaust
apbrd      14 00000041  -- tx status - transmit underflow & halted & exhausted
apbwr      14 00000041  -- clear it




--******************************************************************************
--  6. Check statistics for above operations.
--******************************************************************************

-- check transmit statistics
apbrd     100 00000040  -- check octets transmitted bottom
apbrd     104 00000000  -- check octets transmitted top
apbrd     108 00000001  -- check frames transmitted ok
apbrd     10C 00000000  -- check broadcast frames transmitted
apbrd     110 00000001  -- check multicast frames transmitted
apbrd     114 00000000  -- check pause frames transmitted
apbrd     118 00000001  -- check frames transmitted 64
apbrd     11C 00000000  -- check frames transmitted 65-127
apbrd     120 00000000  -- check frames transmitted 128-255
apbrd     124 00000000  -- check frames transmitted 256-511
apbrd     128 00000000  -- check frames transmitted 512-1023
apbrd     12C 00000000  -- check frames transmitted 1024-1518
apbrd     130 00000000  -- check frames transmitted 1519
apbrd     134 00000002  -- check transmit underruns errors
apbrd     138 00000000  -- check single collisions frames
apbrd     13C 00000000  -- check multiple collisions frames
apbrd     140 00000000  -- check excessive collisions frames
apbrd     144 00000000  -- check late collisions frames
apbrd     148 00000000  -- check deferred frames
apbrd     14C 00000000  -- check carrier sense errors

-- check receive statistics
apbrd     150 00000000  -- check octets received bottom
apbrd     154 00000000  -- check octets received top
apbrd     158 00000000  -- check frames received ok
apbrd     15C 00000000  -- check broadcast frames received
apbrd     160 00000000  -- check multicast frames received
apbrd     164 00000000  -- check pause frames received
apbrd     168 00000000  -- check frames received 64
apbrd     16C 00000000  -- check frames received 65-127
apbrd     170 00000000  -- check frames received 128-255
apbrd     174 00000000  -- check frames received 256-511
apbrd     178 00000000  -- check frames received 512-1023
apbrd     17C 00000000  -- check frames received 1024-1518
apbrd     180 00000000  -- check frames received 1519
apbrd     184 00000000  -- check undersize frame errors
apbrd     188 00000000  -- check excessive receive length errors
apbrd     18C 00000000  -- check receive jabbers errors
apbrd     190 00000000  -- check FCS errors
apbrd     194 00000000  -- check receive length errors
apbrd     198 00000000  -- check receive symbol errors
apbrd     19C 00000000  -- check alignment errors
apbrd     1A0 00000000  -- check receive resource errors
apbrd     1A4 00000000  -- check receive overrun errors




-- force end of test in case it doesn't stop of its own accord
end(10000)

