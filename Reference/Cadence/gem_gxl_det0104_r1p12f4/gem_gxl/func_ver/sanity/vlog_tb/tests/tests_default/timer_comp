--
-- Test Description
-- Check TSU timer comparison
--
--
--
--------------------------------------------------------------------------------


--******************************************************************************
--  1. Initialise suitable wait states for the test.
--******************************************************************************
wait_states 0
bus_grant_delay 0


--******************************************************************************
--  2. Check reset values of registers and setup interrupts.
--******************************************************************************
-- check and initialise the relevant registers
apbrd(100) 24 00000000  -- check interrupt status
apbwr      28 ffffffff  -- enable all interrupts
apbrd      24 00000000  -- check interrupt status
apbrd      30 00000000  -- check that all interrupts are now enabled
apbrd      04 00080000  -- check reset value of network config register
apbrd      08 00000006  -- check reset value of network status register


-- check TSU timer comparison registers
apbrd     0dc 00000000  -- TSU timer comparison nanoseconds
apbrd     0e0 00000000  -- TSU timer comparison seconds

pinsc(150) tsu_timer_cmp_val 0

--******************************************************************************
--  3. Check Timer increment -
--     Set different increment values.
--******************************************************************************

-- initialise timer and timer comparison register
apbwr     0e0 00000000  -- Timer compareseconds register
apbwr     1dc 00000010  -- Timer increment 16 decimal
apbwr     0dc 00000002  -- Timer compare nanoseconds register
apbwr     1d0 00000000  -- Timer seconds register
apbwr     1d4 00000000  -- Timer nanoseconds register
apbwr     1d8 00000000  -- Timer adjust

apbwr     1dc 00000010  -- Timer increment 16 decimal

pinsc(329) tsu_timer_cmp_val 1
pinsc(360) tsu_timer_cmp_val 0

-- check interrupt status
apbrd(int) 24 20000000  "TSU timer compare interrupt"
                        -- check interrupt status
apbwr      24 20000000  -- clear interrupt status register


apbwr     0e0 00000000  -- Timer compareseconds register
apbwr     0dc 00000100  -- Timer compare nanoseconds register
apbwr     1dc 000000ff  -- Timer increment 255 decimal

pinsc(1654) tsu_timer_cmp_val 1
pinsc(1660) tsu_timer_cmp_val 0

-- check interrupt status
apbrd(int) 24 20000000  "TSU timer compare interrupt"
                        -- check interrupt status
apbwr     1dc 00000001  -- Timer increment 1 decimal
apbwr      24 20000000  -- clear interrupt status register


apbwr     0e0 00000000  -- Timer compareseconds register
apbwr     0dc 0000010f  -- Timer compare nanoseconds register

pinsc(9889) tsu_timer_cmp_val 1
pinsc(9895) tsu_timer_cmp_val 0

-- check interrupt status
apbrd(int) 24 20000000  "TSU timer compare interrupt"
                        -- check interrupt status
apbwr      24 20000000  -- clear interrupt status register


apbwr     0e0 00000001  -- Timer compareseconds register
apbwr     0dc 00000002  -- Timer compare nanoseconds register
-- set timer adjust, timer seconds increment by 255
apbwr     1d8 20000000  -- write Timer adjust
apbwr     1dc 000000ff  -- Timer increment 255 decimal
apbrd     1d8 00000000  -- dummy reads because Timer is clocked with tsu_clk
apbrd     1d8 00000000  -- dummy reads because Timer is clocked with tsu_clk
apbrd     1d8 00000000  -- dummy reads because Timer is clocked with tsu_clk
apbrd     1d8 00000000  -- dummy reads because Timer is clocked with tsu_clk
apbrd     1d8 00000000  -- dummy reads because Timer is clocked with tsu_clk
apbrd     1d8 00000000  -- dummy reads because Timer is clocked with tsu_clk
apbrd     1d8 00000000  -- dummy reads because Timer is clocked with tsu_clk
apbwr     1d8 1b98b000  -- write Timer adjust

-- check interrupt status
apbrd(int) 24 04000000  "TSU timer seconds increment interrupt"
                        -- check interrupt status
apbwr      24 04000000  -- clear interrupt status register


pinsc(11299) tsu_timer_cmp_val 1
pinsc(11305) tsu_timer_cmp_val 0


apbrd(int) 24 20000000  "TSU timer compare interrupt"
                        -- check interrupt status
apbwr      24 20000000  -- clear interrupt status register



end(30000)


