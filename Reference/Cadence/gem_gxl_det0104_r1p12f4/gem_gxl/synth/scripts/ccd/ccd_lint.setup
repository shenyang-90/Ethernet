///=============================================================================
/// Configure the design rules
///=============================================================================
tclmode

set USE_REFINED_CCD_LINT_RULES "$env(USE_REFINED_CCD_LINT_RULES)"

if {$USE_REFINED_CCD_LINT_RULES} {
  dofile $IPF_DESIGN_FLOW_SCRIPTS/ccd/ccd_lint_refined_rules_Apr14.txt \
} 
vpxmode
  
///-----------------------------------------------------------------------------
/// Don't report Severity 'Ignore' or 'Note'
///-----------------------------------------------------------------------------

  //Add Rule Filter All_Notes    -rule hdl_default_checks -description "Don't report Notes"  -severity Note 
  //Add Rule Filter All_Ignores  -rule hdl_default_checks -description "Don't report Ignores"  -severity Ignore 

///-----------------------------------------------------------------------------
/// Disable rule check from: library files (read in as libs)
///-----------------------------------------------------------------------------

  set rule handling * -exclude -lib_file * 

