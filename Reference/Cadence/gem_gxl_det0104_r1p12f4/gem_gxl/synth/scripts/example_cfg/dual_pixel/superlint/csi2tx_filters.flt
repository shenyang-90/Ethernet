// Caused as stream zero can only be a master therefore that bit in the register is forced to zero
 <TAG> CNSTCN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v <VAR_LIST> {true}
 <TAG> CONSTC <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v 

// Required to operate on each bit of the bus from an array that is larger than 10
 <TAG> LOOPTM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v <VAR_LIST> {10}
 <TAG> LOOPTM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v <VAR_LIST> {10}
