// The following include address comparisons.  Address constants are 12-bit and are compared with paddr[11:0].
// This error appears to be flagged as an integer is added to the constant.  The specified integers will only modifiy 
// the lower bits so there is not risk or inequality on every evaluation.
 <TAG> ULCMPE <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v <VAR_LIST> {u_ctrl_reg} {12} {32}
 <TAG> ULCMPE <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v <VAR_LIST> {u_ctrl_reg} {12} {32}
