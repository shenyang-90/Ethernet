// waiver file valid for svn revission 4230. 14/1/15

// No issues with module constaining synchronous and asyncrhonous logic
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v <VAR_LIST> {csi2tx_ctrl_reg}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {csi2tx_ln_ctrl}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_protocol.v <VAR_LIST> {csi2tx_protocol}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_clk_ln_ctrl.v <VAR_LIST> {csi2tx_clk_ln_ctrl}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl_arb.v <VAR_LIST> {csi2tx_ln_ctrl_arb}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {csi2tx_data_packer}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_packet_ctrl.v <VAR_LIST> {csi2tx_packet_ctrl}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo}
 <TAG> SYNASN <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_toplevel.v <VAR_LIST> {csi2tx_toplevel}

// Glue logic in the top level is expected.
 <TAG> ATLGLC <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_toplevel.v <VAR_LIST> {csi2tx_toplevel}

// FSMs are not gray coded or one hot. This is expected.
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {3} {0, 0, 4}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_protocol.v <VAR_LIST> {1} {2}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_protocol.v <VAR_LIST> {2} {4}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_protocol.v <VAR_LIST> {3} {4}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_protocol.v <VAR_LIST> {6} {0}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_protocol.v <VAR_LIST> {7} {1, 0, 0}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {1} {4, 4}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {2} {4}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {3} {4}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {1} {2}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {3} {0}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_toplevel.v <VAR_LIST> {1} {2}
 <TAG> TRNMBT <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_toplevel.v <VAR_LIST> {3} {4}

// Current state logic is part of the debug vector that is passed to the register block. This warning flags if the state vector or next state
// vector is used in any other logic other than the FSM logic.
 <TAG> BADFSM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo} {popda_fsm_r}
 <TAG> BADFSM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_protocol.v <VAR_LIST> {csi2tx_protocol} {prot_fsm_r}
 <TAG> BADFSM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_clk_ln_ctrl.v <VAR_LIST> {csi2tx_clk_ln_ctrl} {hs_clk_fsm_r}
 <TAG> BADFSM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_clk_ln_ctrl.v <VAR_LIST> {csi2tx_clk_ln_ctrl} {ulps_clk_fsm_r}
 <TAG> BADFSM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {csi2tx_ln_ctrl} {line_fsm_st_r}
 <TAG> BADFSM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {csi2tx_ln_ctrl} {ulps_data_fsm_st_r}
 <TAG> BADFSM <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_toplevel.v <VAR_LIST> {csi2tx_toplevel} {SMCS}

// These are not unreachable states. The tools marks states unreachable if default state is the source of the transition.
 <TAG> UNRCHS <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo} {popda_fsm_r} {1, 2}
 <TAG> UNRCHS <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_clk_ln_ctrl.v <VAR_LIST> {csi2tx_clk_ln_ctrl} {hs_clk_fsm_r} {1}
 <TAG> UNRCHS <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_clk_ln_ctrl.v <VAR_LIST> {csi2tx_clk_ln_ctrl} {ulps_clk_fsm_r} {1}
 <TAG> UNRCHS <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {csi2tx_ln_ctrl} {line_fsm_st_r} {1, 2, 3}
 <TAG> UNRCHS <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl.v <VAR_LIST> {csi2tx_ln_ctrl} {ulps_data_fsm_st_r} {1}
 <TAG> UNRCHS <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_toplevel.v <VAR_LIST> {csi2tx_toplevel} {SMCS} {1, 3}

// It is expected that local variables for functions will be initialized at each invocation
 <TAG> NOLOCL <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_functions.v <VAR_LIST> {module} {csi2tx_data_packer} {chksum_gen_8b}
 <TAG> NOLOCL <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {module} {csi2tx_async_fifo} {gray2binary}

// Soft reset statement appears to be mistakingly recognised as a branch that can be overwritten.
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ctrl_reg.v <VAR_LIST> {csi2tx_ctrl_reg} {err_event_r}
// Default condition in place at the start of the else branch.  This is coding style is allowed.
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {csi2tx_data_packer} {data_out} { to same parts}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {csi2tx_data_packer} {data_out_valid}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {csi2tx_data_packer} {flush_crc}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {csi2tx_data_packer} {crc_extra}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo} {valid_b_r}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo} {valid_b_r}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo} {valid_b_r}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo} {valid_b_r}
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_async_fifo.v <VAR_LIST> {csi2tx_async_fifo} {valid_b_r}
// Written in seperate else branch so no issue
 <TAG> MULNBA <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_ln_ctrl_arb.v <VAR_LIST> {csi2tx_ln_ctrl_arb} {packet_grant_r} { to same parts}

// byte_cnt_r is restricted from causing an overflow with this addtion process.
 <TAG> POIASG <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {addition} {u_data_packer}
 <TAG> POIASG <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {addition} {u_data_packer}
 <TAG> POIASG <FILENAME> $MIPI_CSI2TX_CTRL_INSTALL_DIR/rtl/csi2tx_data_packer.v <VAR_LIST> {addition} {u_data_packer}
