# This file contains additional spyglass constraints that are not automatically added by the Cadence RDF flow
# They were generated for design configuration "pbuf_3qs_axi" on Mon Nov 20 09:34:29 GMT 2017


# Modify the CDC matrix default limits
    cdc_matrix_attributes -src_clock_limit 100
    cdc_matrix_attributes -gen_clock_limit 100
    cdc_matrix_attributes -sync_reset_limit 100
    cdc_matrix_attributes -async_reset_limit 100
    cdc_matrix_attributes -domain_limit 100
    cdc_matrix_attributes -crossing_limit 16000
    cdc_matrix_attributes -src_per_dest_limit 500
    cdc_matrix_attributes -crossing_per_clock_pair_limit 150000

# For the CDC analysis, we should force the transmit and receive enables high.  When these are low, they act as a software reset to the core, and virtually all CDC paths can be ignored.
    set_case_analysis -name gem_gxl.i_gem_ss.i_gem_top.enable_transmit -value 1
    set_case_analysis -name gem_gxl.i_gem_ss.i_gem_top.enable_receive -value 1
    set_case_analysis -name gem_gxl.i_gem_ss.i_gem_top.i_gem_reg_top.i_gem_registers.enable_transmit -value 1
    set_case_analysis -name gem_gxl.i_gem_ss.i_gem_top.i_gem_reg_top.i_gem_registers.enable_receive -value 1
    set_case_analysis -name "gem_top::enst_en*" -value 1
    set_case_analysis -name "gem_reg_enst::enst_en*" -value 1
# For the CDC analysis, we should force the following MMSL regs high.  In reality, SW will not toggle these close together, but formal will be able to find CDC violations unless we force it here
    set_case_analysis -name "gem_mmsl_reg::pre_enable" -value 1

    set_case_analysis -name "gem_mmsl_reg::restart_ver_tog" -value 1

    set_case_analysis -name "gem_mmsl_reg::disable_verify*" -value 1

    set_case_analysis -name "gem_mmsl_reg::route_rx_to_pmac*" -value 1

# False path the loopback paths. This is done because in loopback rx_clk must be synchonous to tx_clk
# but dont want to put that clock constraint in as it would mask lots of other paths
   cdc_false_path -from "gem.i_gem_ss.i_gem_top.i_gem_mac.\gen_int_loopback.i_gem_loop .rx_dv_looped" -to "gem.i_gem_ss.i_gem_top.i_gem_mac.i_gem_rx.rx_dv_gmii_sync"
   cdc_false_path -from "gem.i_gem_ss.i_gem_top.i_gem_mac.\gen_int_loopback.i_gem_loop .rx_er_looped" -to "gem.i_gem_ss.i_gem_top.i_gem_mac.i_gem_rx.rx_er_gmii_sync"
   cdc_false_path -from "gem.i_gem_ss.i_gem_top.i_gem_mac.\gen_int_loopback.i_gem_loop .rxd_looped"   -to "gem.i_gem_ss.i_gem_top.i_gem_mac.i_gem_rx.rxd_gmii_sync"
   cdc_false_path -from "gem.i_gem_ss.i_gem_top.i_gem_mac.\gen_int_loopback.i_gem_loop .rxd_looped"   -to "gem.i_gem_ss.i_gem_top.i_gem_mac.\gen_dp_parity.rxd_par_prev "
   cdc_false_path -from "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.\gen_int_loopback.i_gem_loop .rx_dv_looped" -to "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.i_gem_rx.rx_dv_gmii_sync"
   cdc_false_path -from "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.\gen_int_loopback.i_gem_loop .rx_er_looped" -to "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.i_gem_rx.rx_er_gmii_sync"
   cdc_false_path -from "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.\gen_int_loopback.i_gem_loop .rxd_looped"   -to "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.i_gem_rx.rxd_gmii_sync"
   cdc_false_path -from "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.\gen_int_loopback.i_gem_loop .rxd_looped"   -to "gem.i_gem_ss.\gen_has_802p3_br.i_gem_top .i_gem_mac.\gen_dp_parity.rxd_par_prev "

# The TSU timer is sampled safely into tx_clk but the spyglass tool doesnt recognize the qualifier properly. It has been reviewed. 
   cdc_false_path -from "gem_tx::\gen_tsu.gen_tsu_par.tsu_timer_par_sampled_on_sof*"   -to "gem_tx::\gen_txd_par.txd_par*"
   cdc_false_path -from "gem_tx::\gen_tsu.tsu_timer_sampled_on_sof*"   -to "gem_tx::txd*"
   cdc_false_path -from "gem_tx::\gen_tsu.tsu_timer_sampled_on_sof*"   -to "gem_tx::\gen_txd_par.txd*"


# --------------------
# Convergence Rules ..

# Multiple sources expected to converge on prdata.  This is mainly due to status reporting.
  cdc_filter_coherency -conv_gates  "gem.prdata*"
  cdc_filter_coherency -conv_gates  "gem_registers::prdata*"
  cdc_filter_coherency -conv_gates  "gem_registers::prdata_i_nq*"
