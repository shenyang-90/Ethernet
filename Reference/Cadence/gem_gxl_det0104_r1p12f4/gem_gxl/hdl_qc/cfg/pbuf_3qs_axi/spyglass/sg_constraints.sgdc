  cdc_filter_coherency -conv_gates  "gem_reg_tsu::\gen_dap_chk.tsu_dap_err_int *"
  cdc_filter_coherency -conv_gates  "gem.i_gem_ss.i_gem_top.i_gem_reg_top.i_gem_registers.\gen_duplc_int_sts.i_reg_int_sts_asf_duplc .\gen_remaining_queues.gen_int_q[1].int_* "
  cdc_filter_coherency -conv_gates  "gem.i_gem_ss.i_gem_top.i_gem_reg_top.i_gem_registers.\gen_duplc_int_sts.i_reg_int_sts_asf_duplc .\gen_remaining_queues.gen_int_q[2].int_* "
  cdc_filter_coherency -conv_gates  "gem.i_gem_ss.mmsl_int"
